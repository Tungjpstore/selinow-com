---
/**
 * SparklineCanvas.astro
 * HTML5 2D Canvas component for high-performance interactive trendlines.
 */
interface Props {
  data: readonly { label: string; value: number }[];
  height?: number;
  title?: string;
}

const { data = [], height = 180, title } = Astro.props;
const serializedData = JSON.stringify(data);
---

<div class="sparkline-card">
  {title && (
    <div class="sparkline-header">
      <h3>{title}</h3>
      <span class="sparkline-badge">60fps Live</span>
    </div>
  )}
  <div class="sparkline-canvas-wrap" style={`height: ${height}px;`}>
    <canvas class="sparkline-canvas" data-velocity-chart data-chart-data={serializedData}></canvas>
  </div>
</div>

<script src="../../scripts/dashboard/overview-charts.ts"></script>

<style>
  .sparkline-card {
    border-radius: var(--sln-console-radius-container);
    border: 1px solid var(--sln-glass-border);
    background: var(--sln-glass-bg);
    backdrop-filter: blur(12px);
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: var(--sln-console-shadow-card);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sparkline-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--sln-console-shadow-glow);
  }

  .sparkline-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .sparkline-header h3 {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--sln-console-ink);
  }

  .sparkline-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: var(--sln-console-radius-pill);
    background: var(--sln-console-accent-soft);
    color: var(--sln-console-accent);
    font-size: 11px;
    font-weight: 600;
  }

  .sparkline-canvas-wrap {
    width: 100%;
    position: relative;
  }

  .sparkline-canvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: crosshair;
  }
</style>

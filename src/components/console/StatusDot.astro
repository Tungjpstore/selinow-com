---
/**
 * Status dot + label — the console status primitive.
 * Color carries the meaning; the surface stays neutral (proposal §4.3).
 */
type Props = {
  label: string;
  tone: "neutral" | "info" | "success" | "warning" | "danger";
};
const { label, tone } = Astro.props;
---

<span class:list={["console-status", `is-${tone}`]}>
  <span class="console-status__dot" aria-hidden="true"></span>
  {label}
</span>

<style>
  .console-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 0;
    color: var(--sln-console-ink-2);
    font: var(--sln-console-label);
    font-weight: 500;
  }
  .console-status__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--sln-console-ink-3); }
  .console-status.is-info .console-status__dot { background: var(--sln-console-info); }
  .console-status.is-info { color: var(--sln-console-info-text); }
  .console-status.is-success .console-status__dot { background: var(--sln-console-success); }
  .console-status.is-success { color: var(--sln-console-success-text); }
  .console-status.is-warning .console-status__dot { background: var(--sln-console-warning); }
  .console-status.is-warning { color: var(--sln-console-warning-text); }
  .console-status.is-danger .console-status__dot { background: var(--sln-console-danger); }
  .console-status.is-danger { color: var(--sln-console-danger-text); }
</style>

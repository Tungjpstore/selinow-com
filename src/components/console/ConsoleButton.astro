---
/**
 * Console button — Lumina elevated actions.
 * Variants: primary (vibrant indigo gradient), secondary (hairline glass), quiet (text),
 * danger (state-colored for destructive actions).
 */
type Props = {
  variant?: "primary" | "secondary" | "quiet" | "danger";
  size?: "sm" | "md";
  type?: "button" | "submit";
  href?: string;
  target?: string;
  rel?: string;
  disabled?: boolean;
  class?: string;
};
const { variant = "secondary", size = "md", type = "button", href, target, rel, disabled = false, class: className } = Astro.props;
const Tag = href === undefined ? "button" : "a";
---

<Tag
  class:list={["console-btn", `console-btn--${variant}`, `console-btn--${size}`, className]}
  {type}
  {href}
  {target}
  {rel}
  aria-disabled={disabled ? "true" : undefined}
  {...disabled && href === undefined ? { disabled: true } : {}}
>
  <slot />
</Tag>

<style>
  .console-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: 1px solid transparent;
    border-radius: var(--sln-console-radius);
    font: var(--sln-console-text-sm);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.16s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .console-btn:focus-visible { outline: none; box-shadow: var(--sln-console-focus); }
  .console-btn--md { height: 34px; padding: 0 14px; }
  .console-btn--sm { height: 28px; padding: 0 10px; font-size: 12px; }
  .console-btn--primary {
    background: linear-gradient(135deg, #6552E8 0%, #4F46E5 100%);
    color: #FFFFFF;
    box-shadow: 0 2px 8px rgba(101, 82, 232, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.3);
    font-weight: 600;
  }
  .console-btn--primary:hover {
    background: linear-gradient(135deg, #5744DE 0%, #4338CA 100%);
    box-shadow: 0 4px 14px rgba(101, 82, 232, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.4);
    transform: translateY(-1px);
  }
  .console-btn--secondary {
    background: var(--sln-console-surface);
    border-color: var(--sln-console-line);
    color: var(--sln-console-ink);
    box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04);
  }
  .console-btn--secondary:hover {
    background: #FFFFFF;
    border-color: var(--sln-console-accent);
    color: var(--sln-console-accent);
    box-shadow: 0 2px 6px rgba(101, 82, 232, 0.10);
    transform: translateY(-1px);
  }
  .console-btn--quiet { background: transparent; color: var(--sln-console-ink-2); }
  .console-btn--quiet:hover { color: var(--sln-console-ink); background: var(--sln-console-raised); }
  .console-btn--danger { background: transparent; border-color: color-mix(in srgb, var(--sln-console-danger) 35%, var(--sln-console-line)); color: var(--sln-console-danger); }
  .console-btn--danger:hover { background: var(--sln-console-danger-tint); }
  .console-btn[disabled], .console-btn[aria-disabled="true"] { opacity: 0.45; cursor: not-allowed; }
</style>

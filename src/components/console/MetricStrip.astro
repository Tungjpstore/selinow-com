---
/**
 * Metric strip — Lumina elevated metric cards.
 */
type Metric = {
  label: string;
  value: string;
  hint?: string;
  tone?: "neutral" | "danger" | "success" | "warning";
};
type Props = { metrics: readonly Metric[] };
const { metrics } = Astro.props;
---

<div class="console-metrics" role="list">
  {metrics.map((metric) => (
    <div class="console-metric" role="listitem">
      <div class="console-metric__header">
        <span class="console-metric__label">{metric.label}</span>
      </div>
      <span class:list={["console-metric__value", metric.tone && metric.tone !== "neutral" ? `is-${metric.tone}` : ""]}>{metric.value}</span>
      {metric.hint && <span class="console-metric__hint">{metric.hint}</span>}
    </div>
  ))}
</div>

<style>
  .console-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 12px;
    padding: 0;
  }
  .console-metric {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    border-radius: var(--sln-console-radius-container);
    border: 1px solid var(--sln-glass-border);
    background: var(--sln-glass-bg);
    backdrop-filter: blur(12px);
    box-shadow: var(--sln-console-shadow-card);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .console-metric:hover {
    transform: translateY(-2px);
    box-shadow: var(--sln-console-shadow-glow);
    border-color: var(--sln-console-accent);
  }
  .console-metric__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .console-metric__label { color: var(--sln-console-ink-3); font: var(--sln-console-label); font-size: 12px; font-weight: 500; }
  .console-metric__value { color: var(--sln-console-ink); font: var(--sln-console-metric); font-variant: var(--sln-console-metric-font-variant); font-size: 22px; font-weight: 600; }
  .console-metric__value.is-danger { color: var(--sln-console-danger); }
  .console-metric__value.is-success { color: var(--sln-console-success); }
  .console-metric__value.is-warning { color: var(--sln-console-warning); }
  .console-metric__hint { color: var(--sln-console-ink-3); font: var(--sln-console-label); font-size: 11px; }
  @media (max-width: 767px) {
    .console-metrics {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
  }
</style>

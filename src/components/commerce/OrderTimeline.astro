---
import FulfillmentState from "./FulfillmentState.astro";
import PaymentState from "./PaymentState.astro";
import { createSystemTranslator } from "../../lib/i18n";

type TimelineItem = { detail?: string; label: string; timestamp?: string };

interface Props {
  fulfillmentItems?: readonly TimelineItem[];
  fulfillmentStatus: string;
  locale?: unknown;
  paymentItems?: readonly TimelineItem[];
  paymentStatus: string;
}

const { fulfillmentItems = [], fulfillmentStatus, locale = Astro.locals.locale, paymentItems = [], paymentStatus } = Astro.props;
const t = createSystemTranslator(locale);
---

<section class="sln-order-timeline" aria-label={t("timeline.aria")}>
  <article>
    <header><div><p>{t("timeline.payment_kicker")}</p><h2>{t("timeline.payment")}</h2></div><PaymentState locale={locale} value={paymentStatus} /></header>
    {paymentItems.length > 0 && <ol>{paymentItems.map((item) => <li><span aria-hidden="true"></span><div><strong>{item.label}</strong>{item.detail && <p>{item.detail}</p>}{item.timestamp && <time datetime={item.timestamp}>{item.timestamp}</time>}</div></li>)}</ol>}
  </article>
  <article>
    <header><div><p>{t("timeline.fulfillment_kicker")}</p><h2>{t("timeline.fulfillment")}</h2></div><FulfillmentState locale={locale} value={fulfillmentStatus} /></header>
    {fulfillmentItems.length > 0 && <ol>{fulfillmentItems.map((item) => <li><span aria-hidden="true"></span><div><strong>{item.label}</strong>{item.detail && <p>{item.detail}</p>}{item.timestamp && <time datetime={item.timestamp}>{item.timestamp}</time>}</div></li>)}</ol>}
  </article>
</section>

<style>
  .sln-order-timeline { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sln-space-5); }
  .sln-order-timeline article { min-width: 0; padding: var(--sln-space-5); border: 1px solid var(--sln-border-default); border-radius: var(--sln-radius-lg); background: var(--sln-bg-surface); }
  .sln-order-timeline header { display: flex; align-items: start; justify-content: space-between; gap: var(--sln-space-4); padding-bottom: var(--sln-space-4); border-bottom: 1px solid var(--sln-border-default); }
  .sln-order-timeline header p { margin: 0 0 var(--sln-space-1); color: var(--sln-text-muted); font: var(--sln-font-caption); }
  .sln-order-timeline h2 { margin: 0; font: var(--sln-font-h4); }
  .sln-order-timeline ol { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
  .sln-order-timeline li { display: grid; grid-template-columns: 12px minmax(0, 1fr); gap: var(--sln-space-3); padding-top: var(--sln-space-4); }
  .sln-order-timeline li > span { width: 9px; height: 9px; margin-top: 5px; border-radius: 50%; background: var(--sln-action-primary); box-shadow: 0 0 0 4px var(--sln-tint-indigo); }
  .sln-order-timeline li strong { font: var(--sln-font-label); }
  .sln-order-timeline li p, .sln-order-timeline time { display: block; margin-top: var(--sln-space-1); color: var(--sln-text-secondary); font: var(--sln-font-caption); }
  @media (max-width: 720px) { .sln-order-timeline { grid-template-columns: 1fr; } }
</style>

---
import { createSystemTranslator } from "../../lib/i18n";

interface Props { locale?: unknown; state: "available" | "low_stock" | "out_of_stock"; }
const { locale = Astro.locals.locale, state } = Astro.props;
const copy = createSystemTranslator(locale)(`status.stock.${state}`);
---
<span class="sln-stock-label" data-stock={state}><span aria-hidden="true"></span>{copy}</span>

<style>
  .sln-stock-label { display: inline-flex; align-items: center; gap: var(--sln-space-2); color: var(--sln-text-secondary); font: var(--sln-font-caption); }
  .sln-stock-label > span { width: 8px; height: 8px; border-radius: 50%; background: var(--sln-state-success); }
  .sln-stock-label[data-stock="low_stock"] { color: var(--sln-warning-text); }
  .sln-stock-label[data-stock="low_stock"] > span { background: var(--sln-state-warning); }
  .sln-stock-label[data-stock="out_of_stock"] { color: var(--sln-danger-text); }
  .sln-stock-label[data-stock="out_of_stock"] > span { background: var(--sln-state-danger); }
</style>

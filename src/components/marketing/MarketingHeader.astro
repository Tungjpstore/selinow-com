---
interface Props {
  dashboardOrigin: string;
  locale?: unknown;
}

import { createMarketingTranslator } from "../../lib/i18n/catalogs/marketing";

const { dashboardOrigin, locale } = Astro.props;
const t = createMarketingTranslator(locale ?? Astro.locals.locale);
const activeLocale = locale === "vi-VN" ? "vi-VN" : "en";
const languageLabel = activeLocale === "vi-VN" ? "Ngôn ngữ" : "Language";
const marketingHref = (pathname: string): string => {
  const url = new URL(pathname, Astro.url.origin);
  if (activeLocale !== "en") url.searchParams.set("lang", activeLocale);
  return `${url.pathname}${url.search}${url.hash}`;
};
const localeHref = (targetLocale: "en" | "vi-VN"): string => {
  const url = new URL(Astro.url.pathname, Astro.url.origin);
  if (targetLocale !== "en") url.searchParams.set("lang", targetLocale);
  return `${url.pathname}${url.search}`;
};
---

<header class="platform-shell platform-nav" data-marketing-nav>
  <a class="platform-logo" href="/" aria-label={t("marketing.header.home_aria")}>
    <img src="/brand/logo/selinow-logo-primary.svg" alt="Selinow" width="152" height="40" />
  </a>
  <nav class="platform-nav-desktop" aria-label={t("marketing.header.nav_aria")}>
    <a href={marketingHref("/#channels")}>{t("marketing.header.product")}</a>
    <a href={marketingHref("/solutions")}>{t("marketing.header.solutions")}</a>
    <a href={marketingHref("/pricing")}>{t("marketing.header.pricing")}</a>
    <a href={marketingHref("/#faq")}>{t("marketing.header.resources")}</a>
    <a href={marketingHref("/#architecture")}>{t("marketing.header.partners")}</a>
    <a href={`${dashboardOrigin}/login`}>{t("marketing.header.login")}</a>
    <span class="platform-language-switcher" aria-label={languageLabel}>
      <a href={localeHref("en")} aria-current={activeLocale === "en" ? "page" : undefined}>EN</a>
      <span aria-hidden="true">/</span>
      <a href={localeHref("vi-VN")} aria-current={activeLocale === "vi-VN" ? "page" : undefined}>VI</a>
    </span>
    <a class="nav-cta" href={`${dashboardOrigin}/login`}>{t("marketing.header.cta")}</a>
  </nav>
  <div class="platform-nav-mobile-actions">
    <a class="platform-nav-mobile-login" href={`${dashboardOrigin}/login`}>{t("marketing.header.login")}</a>
    <details class="platform-nav-mobile" data-marketing-menu>
      <summary
        aria-label={t("marketing.header.menu_open")}
        aria-expanded="false"
        data-marketing-menu-close-label={t("marketing.header.menu_close")}
        data-marketing-menu-open-label={t("marketing.header.menu_open")}
        data-marketing-menu-trigger
      ><span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span></summary>
      <nav aria-label={t("marketing.header.mobile_nav_aria")}>
        <a href={marketingHref("/#channels")}>{t("marketing.header.product")}</a>
        <a href={marketingHref("/solutions")}>{t("marketing.header.solutions")}</a>
        <a href={marketingHref("/pricing")}>{t("marketing.header.pricing")}</a>
        <a href={marketingHref("/#faq")}>{t("marketing.header.resources")}</a>
        <a href={marketingHref("/#architecture")}>{t("marketing.header.partners")}</a>
        <div class="platform-language-switcher" aria-label={languageLabel}>
          <a href={localeHref("en")} aria-current={activeLocale === "en" ? "page" : undefined}>EN</a>
          <span aria-hidden="true">/</span>
          <a href={localeHref("vi-VN")} aria-current={activeLocale === "vi-VN" ? "page" : undefined}>VI</a>
        </div>
        <a class="nav-cta" href={`${dashboardOrigin}/login`}>{t("marketing.header.cta")}</a>
      </nav>
    </details>
  </div>
</header>

<script>
  import "../../scripts/marketing/navigation";
</script>

---
interface Props {
  locale?: unknown;
}

import { createMarketingTranslator } from "../../lib/i18n/catalogs/marketing";
import { normalizeSupportedLocale } from "../../lib/i18n/locale";
import { icons } from "./icons";

const { locale: propLocale } = Astro.props;
const locale = normalizeSupportedLocale(propLocale ?? Astro.locals.locale);
const t = createMarketingTranslator(locale);

const flow = [
  { icon: icons.send(14), label: t("marketing.home.flow.channel"), detail: t("marketing.home.flow.channel_detail"), chip: t("marketing.home.channels.name.telegram"), state: "processing", mono: false },
  { icon: icons.receipt(14), label: "#SLN-2084", detail: t("marketing.home.flow.order_detail"), chip: t("marketing.home.sim.created"), state: "processing", mono: true },
  { icon: icons.shieldCheck(14), label: t("marketing.home.flow.payment"), detail: t("marketing.home.flow.payment_detail"), chip: t("marketing.home.sim.verified"), state: "verified", mono: false },
  { icon: icons.package(14), label: t("marketing.home.flow.delivery"), detail: t("marketing.home.flow.delivery_detail"), chip: t("marketing.home.sim.delivered"), state: "delivered", mono: false },
];
---

<aside class="auth-product-flow" aria-label={t("marketing.home.sim.aria")}>
  <div class="auth-flow-card">
    <div class="auth-flow-head">
      <span class="auth-flow-brand">SELINOW OS · {t("marketing.home.sim.panel_label")}</span>
      <span class="status-chip" data-status="verified">
        <span class="status-chip-dot" aria-hidden="true"></span>
        {t("marketing.home.sim.operational")}
      </span>
    </div>

    <ol class="auth-flow-sequence">
      {flow.map((row, index) => (
        <li class:list={["auth-seq-item", index === 2 && "auth-seq-verify", index === 3 && "auth-seq-success"]}>
          <span class="seq-num">{String(index + 1).padStart(2, "0")}</span>
          <span class="seq-icon" set:html={row.icon} aria-hidden="true"></span>
          <div class="seq-content">
            <strong class:list={[row.mono === true && "seq-label-mono"]}>{row.label}</strong>
            <small>{row.detail}</small>
          </div>
          <span class="status-chip" data-status={row.state}>
            <span class="status-chip-dot" aria-hidden="true"></span>
            {row.chip}
          </span>
        </li>
      ))}
    </ol>

    <div class="auth-flow-footer">
      <p>{t("marketing.home.sim.caption")}</p>
    </div>
  </div>
</aside>

<style>
  /* Scoped status chips: the login shell does not load components.css. */
  .status-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 999px;
    border: 1px solid var(--border-soft);
    background-color: var(--surface-raised);
    color: var(--text-secondary);
    flex-shrink: 0;
  }

  .status-chip-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--text-tertiary);
  }

  .status-chip[data-status="verified"],
  .status-chip[data-status="delivered"] {
    background-color: var(--success-surface);
    border-color: var(--success-border);
    color: var(--success-text);
  }

  .status-chip[data-status="verified"] .status-chip-dot,
  .status-chip[data-status="delivered"] .status-chip-dot {
    background-color: var(--success);
  }

  .status-chip[data-status="processing"] {
    background-color: var(--brand-50);
    border-color: var(--brand-200);
    color: var(--brand-700);
  }

  .status-chip[data-status="processing"] .status-chip-dot {
    background-color: var(--brand-500);
  }

  .auth-product-flow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: var(--space-8);
    box-sizing: border-box;
  }

  .auth-flow-card {
    width: 100%;
    max-width: 480px;
    background: #FFFFFF;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .auth-flow-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-soft);
    margin-bottom: var(--space-4);
  }

  .auth-flow-brand {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 750;
    letter-spacing: 0.1em;
    color: var(--brand-700);
  }

  .auth-flow-sequence {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .auth-seq-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 10px 14px;
    background-color: var(--surface-page);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-sm);
  }

  .seq-num {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--brand-600);
    flex-shrink: 0;
  }

  .seq-icon {
    width: 24px;
    height: 24px;
    border-radius: var(--radius-xs);
    background-color: var(--brand-50);
    color: var(--brand-600);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .seq-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .seq-content strong {
    font-size: 12.5px;
    color: var(--text-primary);
  }

  .seq-content .seq-label-mono {
    font-family: var(--font-mono);
  }

  .seq-content small {
    font-size: 11.5px;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .auth-seq-verify {
    border-color: var(--brand-200);
    background-color: #FDFDFF;
  }

  .auth-seq-success {
    border-color: var(--success-border);
    background-color: #FBFEFC;
  }

  .auth-seq-success .seq-icon {
    background-color: var(--success-surface);
    color: var(--success);
  }

  .auth-flow-footer {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px dashed var(--border-soft);
  }

  .auth-flow-footer p {
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--text-tertiary);
    margin: 0;
    text-align: center;
  }
</style>

---
interface Props {
  slug: string;
  index: number;
  eyebrow: string;
  title: string;
  lead: string;
  href: string;
  locale?: unknown;
}

import { normalizeSupportedLocale } from "../../lib/i18n/locale";
import { createMarketingTranslator } from "../../lib/i18n/catalogs/marketing";
import { solutionRail } from "./solutionRails";

const { slug, index, eyebrow, title, lead, href, locale: propLocale } = Astro.props;
const locale = normalizeSupportedLocale(propLocale ?? Astro.locals.locale);
const t = createMarketingTranslator(locale);
const rail = solutionRail(slug, t);
---

<article class="solution-tile" data-solution-slug={slug}>
  <header class="solution-tile-head">
    <span class="solution-tile-index">{String(index).padStart(2, "0")}</span>
    <span class="solution-tile-eyebrow">{eyebrow}</span>
  </header>
  <div class="solution-tile-copy">
    <h3><a href={href}>{title}</a></h3>
    <p>{lead}</p>
  </div>

  <ol class="solution-tile-rail" aria-hidden="true">
    {rail.map((step) => (
      <li data-rail-state={step.state}>
        <span class="solution-tile-rail-icon" set:html={step.icon}></span>
        <span class="solution-tile-rail-label">{step.label}</span>
      </li>
    ))}
  </ol>

  <div class="solution-tile-footer">
    <a class="kit-button kit-button-secondary" href={href}>
      <span>{t("marketing.home.solutions.explore")}</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

---
interface Props {
  locale?: unknown;
}

import { createMarketingTranslator } from "../../lib/i18n/catalogs/marketing";
import { normalizeSupportedLocale } from "../../lib/i18n/locale";
import { icons } from "./icons";

const { locale: propLocale } = Astro.props;
const locale = normalizeSupportedLocale(propLocale ?? Astro.locals.locale);
const t = createMarketingTranslator(locale);

const stages = [
  { icon: icons.send(18), label: t("marketing.home.flow.channel"), detail: t("marketing.home.flow.channel_detail") },
  { icon: icons.receipt(18), label: t("marketing.home.flow.order"), detail: t("marketing.home.flow.order_detail") },
  { icon: icons.shieldCheck(18), label: t("marketing.home.flow.payment"), detail: t("marketing.home.flow.payment_detail") },
  { icon: icons.package(18), label: t("marketing.home.flow.delivery"), detail: t("marketing.home.flow.delivery_detail") },
  { icon: icons.user(18), label: t("marketing.home.flow.customer"), detail: t("marketing.home.flow.customer_detail") },
];
---

<section class="flow-rail-section" id="flow" aria-labelledby="flow-rail-title">
  <div class="platform-shell">
    <div class="kit-section-heading kit-section-heading-centered">
      <p class="kit-kicker">{t("marketing.home.flow_section.eyebrow")}</p>
      <h2 class="section-title" id="flow-rail-title">{t("marketing.home.flow_section.title")}</h2>
      <p class="section-description">{t("marketing.home.flow_section.description")}</p>
    </div>

    <ol class="flow-rail" aria-label={t("marketing.home.flow.aria")}>
      {stages.map((stage, index) => (
        <li class="flow-rail-node">
          <span class="flow-rail-dot" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          <div class="flow-rail-copy">
            <span class="flow-rail-icon" set:html={stage.icon} aria-hidden="true"></span>
            <h3>{stage.label}</h3>
            <p>{stage.detail}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

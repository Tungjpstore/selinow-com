---
interface Props {
  locale?: unknown;
}

import { createMarketingTranslator } from "../../lib/i18n/catalogs/marketing";
import { normalizeSupportedLocale } from "../../lib/i18n/locale";

const { locale: propLocale } = Astro.props;
const locale = normalizeSupportedLocale(propLocale ?? Astro.locals.locale);
const t = createMarketingTranslator(locale);
const isVi = locale.toLowerCase().startsWith("vi");

const stages = [
  {
    index: "01",
    label: t("marketing.home.flow.channel"),
    detail: t("marketing.home.flow.channel_detail"),
    status: isVi ? "Đầu vào" : "Channel Entry",
    glyph: "➤",
  },
  {
    index: "02",
    label: isVi ? "Catalog & Sản phẩm" : "Catalog & Products",
    detail: isVi ? "Dữ liệu thống nhất cho mọi kênh" : "Unified catalog across surfaces",
    status: isVi ? "Quản lý tập trung" : "Single Catalog",
    glyph: "▦",
  },
  {
    index: "03",
    label: t("marketing.home.flow.order"),
    detail: t("marketing.home.flow.order_detail"),
    status: isVi ? "Theo dõi đơn" : "Order Core",
    glyph: "◈",
  },
  {
    index: "04",
    label: t("marketing.home.flow.payment"),
    detail: t("marketing.home.flow.payment_detail"),
    status: isVi ? "Xác minh PayOS" : "Verified Event",
    glyph: "✓",
  },
  {
    index: "05",
    label: t("marketing.home.flow.delivery"),
    detail: t("marketing.home.flow.delivery_detail"),
    status: isVi ? "Bàn giao an toàn" : "Secure Delivery",
    glyph: "✦",
  },
];
---

<section class="commerce-flow-strip" aria-label={t("marketing.home.flow.aria")}>
  <div class="platform-shell">
    <div class="kit-section-heading kit-section-heading-centered">
      <p class="kit-kicker">{isVi ? "LUỒNG THƯƠNG MẠI HOÀN TẤT" : "END-TO-END COMMERCE FLOW"}</p>
      <h2 class="section-title">{isVi ? "Một luồng bán hàng, từ hội thoại đến giao hàng." : "One connected sales flow, from chat to delivery."}</h2>
      <p class="section-description">{isVi ? "Mọi đơn hàng từ Website và Telegram đều đi qua cùng một cỗ máy vận hành, đảm bảo thanh toán chuẩn xác trước khi giao sản phẩm." : "Orders from Website and Telegram pass through one authoritative operating layer, verifying payment before releasing content."}</p>
    </div>

    <div class="flow-strip-grid">
      {stages.map((stage, idx) => (
        <article class="flow-node">
          <div class="flow-node-header">
            <span class="flow-node-index">{stage.index}</span>
            <span class="flow-node-glyph" aria-hidden="true">{stage.glyph}</span>
          </div>
          <h3>{stage.label}</h3>
          <p>{stage.detail}</p>
          <div class="flow-node-footer">
            <span class="status-chip" data-status={idx === 3 || idx === 4 ? "verified" : "next"}>
              <span class="status-chip-dot" aria-hidden="true"></span>
              {stage.status}
            </span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .flow-node-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .flow-node-glyph {
    font-size: 14px;
    color: var(--brand-600);
    background-color: var(--brand-50);
    width: 24px;
    height: 24px;
    border-radius: var(--radius-xs);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .flow-node-footer {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px dashed var(--border-soft);
  }
</style>

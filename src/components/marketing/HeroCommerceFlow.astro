---
interface Props {
  locale?: unknown;
}

import { createMarketingTranslator } from "../../lib/i18n/catalogs/marketing";
import { normalizeSupportedLocale } from "../../lib/i18n/locale";

const { locale: propLocale } = Astro.props;
const locale = normalizeSupportedLocale(propLocale ?? Astro.locals.locale);
const t = createMarketingTranslator(locale);
const isVi = locale.toLowerCase().startsWith("vi");
---

<div class="hero-simulation-canvas" aria-label={t("marketing.home.hero.orbit_aria")}>
  <div class="sim-header">
    <div class="sim-brand-tag">
      <span class="sim-pulse-dot" aria-hidden="true"></span>
      <span class="sim-title">{isVi ? "Luồng giao dịch Selinow" : "Selinow Transaction Flow"}</span>
    </div>
    <span class="status-chip" data-status="verified">
      <span class="status-chip-dot" aria-hidden="true"></span>
      {isVi ? "Đang vận hành" : "Operational"}
    </span>
  </div>

  <div class="sim-flow-container">
    <!-- Channel Layer -->
    <div class="sim-card sim-card-channel">
      <div class="sim-card-head">
        <div class="sim-channel-badge">
          <span class="sim-icon" aria-hidden="true">➤</span>
          <strong>Telegram / Web</strong>
        </div>
        <span class="sim-timestamp">14:02:45</span>
      </div>
      <div class="sim-message-preview">
        <p><em>"Mua gói Bản quyền Pro / Buy Pro License"</em></p>
      </div>
    </div>

    <!-- Connector 1 -->
    <div class="sim-connector" aria-hidden="true">
      <span class="sim-connector-line"></span>
      <span class="sim-connector-arrow">↓</span>
    </div>

    <!-- Core Order & Payment Layer -->
    <div class="sim-card sim-card-core">
      <div class="sim-core-header">
        <div class="sim-order-meta">
          <span class="sim-order-id">#SLN-2084</span>
          <span class="sim-badge-created">{isVi ? "Đã tạo" : "Created"}</span>
        </div>
        <span class="sim-order-amount">{isVi ? "299.000 ₫" : "$15.00"}</span>
      </div>

      <div class="sim-sub-steps">
        <div class="sim-sub-step">
          <span class="sim-sub-icon sim-icon-check" aria-hidden="true">✓</span>
          <div class="sim-sub-copy">
            <strong>{t("marketing.home.flow.payment")}</strong>
            <small>{t("marketing.home.flow.payment_detail")}</small>
          </div>
          <span class="status-chip" data-status="verified">
            <span class="status-chip-dot" aria-hidden="true"></span>
            Verified
          </span>
        </div>

        <div class="sim-sub-step">
          <span class="sim-sub-icon sim-icon-lock" aria-hidden="true">◈</span>
          <div class="sim-sub-copy">
            <strong>{t("marketing.home.flow.inventory")}</strong>
            <small><code>SLN-XXXX-••••-••••</code></small>
          </div>
          <span class="status-chip" data-status="processing">
            <span class="status-chip-dot" aria-hidden="true"></span>
            Allocated
          </span>
        </div>
      </div>
    </div>

    <!-- Connector 2 -->
    <div class="sim-connector" aria-hidden="true">
      <span class="sim-connector-line"></span>
      <span class="sim-connector-arrow">↓</span>
    </div>

    <!-- Delivery Layer -->
    <div class="sim-card sim-card-delivery">
      <div class="sim-delivery-inner">
        <span class="sim-delivery-icon" aria-hidden="true">✦</span>
        <div class="sim-delivery-copy">
          <strong>{t("marketing.home.flow.delivery")}</strong>
          <small>{t("marketing.home.flow.delivery_detail")}</small>
        </div>
        <span class="status-chip" data-status="delivered">
          <span class="status-chip-dot" aria-hidden="true"></span>
          Delivered
        </span>
      </div>
    </div>
  </div>

  <p class="sim-caption">
    <small>✦ {isVi ? "Minh họa luồng thương mại — không hiển thị secret hay dữ liệu thật" : "Illustrative commerce workflow — no real secrets or customer PII"}</small>
  </p>
</div>

<style>
  .hero-simulation-canvas {
    background: #FFFFFF;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-xl);
    box-shadow: 0 4px 6px -1px rgba(16, 24, 40, 0.04), 0 20px 40px -4px rgba(101, 82, 232, 0.08);
    padding: var(--space-6);
    position: relative;
    box-sizing: border-box;
    width: 100%;
  }

  .sim-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-soft);
    margin-bottom: var(--space-5);
  }

  .sim-brand-tag {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .sim-pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--brand-600);
    box-shadow: 0 0 0 3px rgba(101, 82, 232, 0.2);
  }

  .sim-title {
    font-size: 12px;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .sim-flow-container {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .sim-card {
    background-color: var(--surface-page);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    transition: all 0.2s ease;
  }

  .sim-card:hover {
    border-color: var(--brand-300);
  }

  .sim-card-channel {
    background: #FAFBFD;
  }

  .sim-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .sim-channel-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--brand-700);
  }

  .sim-timestamp {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-tertiary);
  }

  .sim-message-preview {
    background: #FFFFFF;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-xs);
    padding: 6px 10px;
  }

  .sim-message-preview p {
    margin: 0;
    font-size: 12px;
    color: var(--text-secondary);
  }

  .sim-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 20px;
    color: var(--brand-400);
    font-size: 12px;
    line-height: 1;
  }

  .sim-card-core {
    background: #FFFFFF;
    border: 1.5px solid var(--brand-300);
    box-shadow: 0 4px 16px rgba(101, 82, 232, 0.06);
  }

  .sim-core-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-3);
    border-bottom: 1px dashed var(--border-soft);
    margin-bottom: var(--space-3);
  }

  .sim-order-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .sim-order-id {
    font-family: var(--font-mono);
    font-weight: 750;
    font-size: 14px;
    color: var(--text-primary);
  }

  .sim-badge-created {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: var(--radius-pill);
    background-color: var(--brand-50);
    color: var(--brand-700);
  }

  .sim-order-amount {
    font-weight: 750;
    font-size: 15px;
    color: var(--text-primary);
  }

  .sim-sub-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .sim-sub-step {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 6px 10px;
    background-color: var(--surface-page);
    border-radius: var(--radius-xs);
  }

  .sim-sub-icon {
    font-size: 12px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--brand-50);
    color: var(--brand-600);
  }

  .sim-sub-copy {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .sim-sub-copy strong {
    font-size: 12px;
    color: var(--text-primary);
  }

  .sim-sub-copy small {
    font-size: 11px;
    color: var(--text-secondary);
  }

  .sim-sub-copy code {
    font-family: var(--font-mono);
    color: var(--brand-700);
  }

  .sim-card-delivery {
    background: #F4FDF8;
    border-color: #A7F3D0;
  }

  .sim-delivery-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .sim-delivery-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: var(--success-surface);
    color: var(--success);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    flex-shrink: 0;
  }

  .sim-delivery-copy {
    flex-grow: 1;
  }

  .sim-delivery-copy strong {
    display: block;
    font-size: 13px;
    color: var(--text-primary);
  }

  .sim-delivery-copy small {
    display: block;
    font-size: 11px;
    color: var(--text-secondary);
  }

  .sim-caption {
    margin: var(--space-4) 0 0;
    text-align: center;
    color: var(--text-tertiary);
    font-size: 11px;
  }
</style>

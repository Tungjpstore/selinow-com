---
interface Props {
  slug: "telegram-commerce" | "digital-product-delivery" | "license-key-inventory" | string;
  locale?: unknown;
}

import { normalizeSupportedLocale } from "../../lib/i18n/locale";

const { slug, locale: propLocale } = Astro.props;
const locale = normalizeSupportedLocale(propLocale ?? Astro.locals.locale);
const isVi = locale.toLowerCase().startsWith("vi");
---

<div class="solution-diagram-wrap" aria-label={`Workflow diagram for ${slug}`}>
  {slug === "telegram-commerce" && (
    <div class="diagram-canvas diagram-telegram">
      <div class="diagram-step">
        <div class="diagram-step-box step-source">
          <span class="diagram-badge">01</span>
          <span class="diagram-icon">➤</span>
          <strong>{isVi ? "Chat Telegram" : "Telegram Chat"}</strong>
          <small>{isVi ? "Khách chọn sản phẩm" : "Buyer selects item"}</small>
        </div>
      </div>
      <div class="diagram-arrow">→</div>
      <div class="diagram-step">
        <div class="diagram-step-box step-core">
          <span class="diagram-badge">02</span>
          <span class="diagram-icon">▦</span>
          <strong>{isVi ? "Selinow Core" : "Selinow Core"}</strong>
          <small>{isVi ? "Tạo đơn & snapshot giá" : "Create order & snapshot"}</small>
        </div>
      </div>
      <div class="diagram-arrow">→</div>
      <div class="diagram-step">
        <div class="diagram-step-box step-verify">
          <span class="diagram-badge">03</span>
          <span class="diagram-icon">✓</span>
          <strong>{isVi ? "Xác minh PayOS" : "Verify Payment"}</strong>
          <small>{isVi ? "Khớp mã & đúng tiền" : "Exact amount matched"}</small>
        </div>
      </div>
      <div class="diagram-arrow">→</div>
      <div class="diagram-step">
        <div class="diagram-step-box step-fulfill">
          <span class="diagram-badge">04</span>
          <span class="diagram-icon">✦</span>
          <strong>{isVi ? "Giao trong Chat" : "Chat Delivery"}</strong>
          <small>{isVi ? "Mở quyền & gửi thông báo" : "Release grant & notify"}</small>
        </div>
      </div>
    </div>
  )}

  {slug === "digital-product-delivery" && (
    <div class="diagram-canvas diagram-delivery">
      <div class="diagram-step">
        <div class="diagram-step-box step-source">
          <span class="diagram-badge">01</span>
          <span class="diagram-icon">🛒</span>
          <strong>{isVi ? "Checkout đơn hàng" : "Buyer Checkout"}</strong>
          <small>{isVi ? "Snapshot requirement" : "Requirement captured"}</small>
        </div>
      </div>
      <div class="diagram-arrow">→</div>
      <div class="diagram-step">
        <div class="diagram-step-box step-verify">
          <span class="diagram-badge">02</span>
          <span class="diagram-icon">🛡️</span>
          <strong>{isVi ? "Payment Boundary" : "Payment Gate"}</strong>
          <small>{isVi ? "Chỉ giao khi xác minh" : "Wait for exact evidence"}</small>
        </div>
      </div>
      <div class="diagram-arrow">→</div>
      <div class="diagram-step">
        <div class="diagram-step-box step-core">
          <span class="diagram-badge">03</span>
          <span class="diagram-icon">🔑</span>
          <strong>{isVi ? "Private Grant" : "Private Grant"}</strong>
          <small>{isVi ? "Cấp quyền theo tenant" : "Tenant-scoped access"}</small>
        </div>
      </div>
      <div class="diagram-arrow">→</div>
      <div class="diagram-step">
        <div class="diagram-step-box step-fulfill">
          <span class="diagram-badge">04</span>
          <span class="diagram-icon">📦</span>
          <strong>{isVi ? "Durable History" : "Durable History"}</strong>
          <small>{isVi ? "Lưu bằng chứng giao" : "Safe audit trail"}</small>
        </div>
      </div>
    </div>
  )}

  {slug === "license-key-inventory" && (
    <div class="diagram-canvas diagram-license">
      <div class="diagram-step">
        <div class="diagram-step-box step-source">
          <span class="diagram-badge">01</span>
          <span class="diagram-icon">🔒</span>
          <strong>{isVi ? "Kho mã mã hóa" : "Encrypted Pool"}</strong>
          <small><code>SLN-••••-••••</code></small>
        </div>
      </div>
      <div class="diagram-arrow">→</div>
      <div class="diagram-step">
        <div class="diagram-step-box step-core">
          <span class="diagram-badge">02</span>
          <span class="diagram-icon">🛡️</span>
          <strong>{isVi ? "Guard chống trùng" : "Concurrency Guard"}</strong>
          <small>{isVi ? "1 người thắng / 1 key" : "One-winner allocation"}</small>
        </div>
      </div>
      <div class="diagram-arrow">→</div>
      <div class="diagram-step">
        <div class="diagram-step-box step-verify">
          <span class="diagram-badge">03</span>
          <span class="diagram-icon">✓</span>
          <strong>{isVi ? "Đơn đủ điều kiện" : "Order Eligible"}</strong>
          <small>{isVi ? "Khớp trạng thái paid" : "Replay-safe boundary"}</small>
        </div>
      </div>
      <div class="diagram-arrow">→</div>
      <div class="diagram-step">
        <div class="diagram-step-box step-fulfill">
          <span class="diagram-badge">04</span>
          <span class="diagram-icon">✦</span>
          <strong>{isVi ? "Reveal tại Edge" : "Edge Decrypt"}</strong>
          <small>{isVi ? "Chỉ hiện cho buyer" : "Buyer-only access"}</small>
        </div>
      </div>
    </div>
  )}
</div>

<style>
  .solution-diagram-wrap {
    width: 100%;
    margin-block: var(--space-4);
  }

  .diagram-canvas {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    gap: var(--space-2);
    align-items: center;
    background-color: var(--surface-page);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    box-shadow: var(--shadow-xs);
  }

  .diagram-step-box {
    background-color: var(--surface-raised);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    transition: all 0.18s ease;
  }

  .diagram-step-box:hover {
    border-color: var(--brand-400);
    box-shadow: var(--shadow-xs);
  }

  .diagram-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--brand-600);
    background-color: var(--brand-50);
    padding: 1px 6px;
    border-radius: var(--radius-pill);
  }

  .diagram-icon {
    font-size: 16px;
    margin: 2px 0;
  }

  .diagram-step-box strong {
    font-size: 13px;
    color: var(--text-primary);
  }

  .diagram-step-box small {
    font-size: 11px;
    color: var(--text-secondary);
    line-height: 1.3;
  }

  .diagram-step-box code {
    font-family: var(--font-mono);
    color: var(--brand-700);
  }

  .diagram-arrow {
    font-size: 18px;
    font-weight: 700;
    color: var(--brand-400);
    text-align: center;
  }

  .step-core {
    border-color: var(--brand-300);
    background: linear-gradient(180deg, var(--brand-50) 0%, var(--surface-raised) 100%);
  }

  .step-verify {
    border-color: #A7F3D0;
    background: #F4FDF8;
  }

  @media (max-width: 768px) {
    .diagram-canvas {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .diagram-arrow {
      transform: rotate(90deg);
      height: 18px;
    }
  }
</style>

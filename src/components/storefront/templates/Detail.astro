---
/**
 * Product-detail dispatcher mirroring StoreHome: maps shop.template.id to the
 * template's ProductDetail component; swift stays the structural fallback so
 * an unknown id can never break the page.
 */
import AuroraProductDetail from "./aurora/ProductDetail.astro";
import BustleProductDetail from "./bustle/ProductDetail.astro";
import ClinicProductDetail from "./clinic/ProductDetail.astro";
import CraftProductDetail from "./craft/ProductDetail.astro";
import SerenityProductDetail from "./serenity/ProductDetail.astro";
import DeskProductDetail from "./desk/ProductDetail.astro";
import MetroProductDetail from "./metro/ProductDetail.astro";
import PulseProductDetail from "./pulse/ProductDetail.astro";
import SwiftProductDetail from "./swift/ProductDetail.astro";
import type { StorefrontProduct, StorefrontPromotion, StorefrontShop } from "../../../lib/storefront/store";

interface Props {
  locale: string;
  product: StorefrontProduct;
  promotions: StorefrontPromotion[];
  related: StorefrontProduct[];
  shop: StorefrontShop;
}

const { locale, product, promotions, related, shop } = Astro.props;
const detailByTemplate: Record<string, typeof SwiftProductDetail> = {
  aurora: AuroraProductDetail,
  bustle: BustleProductDetail,
  clinic: ClinicProductDetail,
  craft: CraftProductDetail,
  serenity: SerenityProductDetail,
  desk: DeskProductDetail,
  metro: MetroProductDetail,
  pulse: PulseProductDetail,
  swift: SwiftProductDetail,
};
const DetailComponent = detailByTemplate[shop.template.id] ?? SwiftProductDetail;
---
<DetailComponent locale={locale} product={product} promotions={promotions} related={related} shop={shop} />

---
import BuyBox from "../../sections/BuyBox.astro";
import PolicyPanel from "../../sections/PolicyPanel.astro";
import RelatedGrid from "../../sections/RelatedGrid.astro";
import SlotPickerInline from "../../sections/SlotPickerInline.astro";
import SpecTable from "../../sections/SpecTable.astro";
import { formatMoney } from "../../../../lib/storefront/view";
import { createStorefrontTranslator } from "../../../../lib/i18n/catalogs/storefront";
import type { StorefrontProduct, StorefrontPromotion, StorefrontShop } from "../../../../lib/storefront/store";

interface Props {
  locale: string;
  product: StorefrontProduct;
  promotions: StorefrontPromotion[];
  related: StorefrontProduct[];
  shop: StorefrontShop;
}

const { locale, product, related, shop } = Astro.props;
const t = createStorefrontTranslator(locale);
const firstVariant = product.variants.find((variant) => variant.stockState !== "out_of_stock") ?? product.variants[0];
const durationMinutes = firstVariant?.durationMinutes ?? null;
const recordRows = [
  firstVariant ? { label: t("storefront.spec.record.service"), value: product.title } : null,
  durationMinutes !== null ? { label: t("storefront.spec.record.duration"), value: t("storefront.slot_picker.duration", { minutes: durationMinutes }) } : null,
  firstVariant ? { label: t("storefront.spec.record.price"), value: formatMoney(firstVariant.priceMinor, firstVariant.currency, locale) } : null,
].filter((row): row is { label: string; value: string } => row !== null);
---
<section class="product-detail clinic-detail">
  <div class="clinic-record">
    <a class="back-link" href="/">{t("storefront.product.back")}</a>
    <h1>{product.title}</h1>
    <dl class="clinic-record-table">
      {recordRows.map((row) => <div><dt>{row.label}</dt><dd>{row.value}</dd></div>)}
    </dl>
    <p class="description">{product.description || t("storefront.product.description_fallback")}</p>
    <SpecTable attributes={product.attributes} locale={locale} />
    <BuyBox locale={locale} product={product} />
    <SlotPickerInline locale={locale} product={product} />
    <PolicyPanel locale={locale} shop={shop} />
  </div>
</section>
<RelatedGrid locale={locale} related={related} />

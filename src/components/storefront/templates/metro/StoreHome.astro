---
import ProductCard from "../../../storefront/ProductCard.astro";
import USPGrid from "../../sections/USPGrid.astro";
import FAQSection from "../../sections/FAQSection.astro";
import { resolveUniversalSections, universalSectionSettings } from "../../../../lib/storefront/sections/registry";
import { createStorefrontTranslator } from "../../../../lib/i18n/catalogs/storefront";
import type { StorefrontCategory, StorefrontProduct, StorefrontPromotion, StorefrontShop } from "../../../../lib/storefront/store";

interface Props {
  categories: StorefrontCategory[];
  locale: string;
  products: StorefrontProduct[];
  promotions?: StorefrontPromotion[];
  shop: StorefrontShop;
}

const { categories, locale, products, shop } = Astro.props;
const t = createStorefrontTranslator(locale);
const universalTail = resolveUniversalSections(shop.template.id, shop.content.sections);
const trustItems = [
  t("storefront.template.metro.trust.warranty"),
  t("storefront.template.metro.trust.delivery"),
  t("storefront.template.metro.trust.support"),
];
---
<section class="store-hero metro-hero" data-mark={shop.name.slice(0, 1).toUpperCase()}>
  <div class="store-hero-heading">
    <p class="store-kicker">{shop.name}</p>
    <h1>{shop.content.headline}</h1>
  </div>
  <div class="store-hero-copy">
    <p>{shop.content.description}</p>
    <form class="store-search" role="search" data-store-search-form>
      <label for="store-search">{t("storefront.search.label")}</label>
      <div><input id="store-search" type="search" name="q" placeholder={t("storefront.search.placeholder")} autocomplete="off" data-store-search-input /><button type="submit" aria-label={t("storefront.search.aria")}>⌕</button></div>
    </form>
    <a class="store-hero-cta" href="#products">{t("storefront.search.cta")} <span aria-hidden="true">↓</span></a>
  </div>
</section>
<ul class="hero-stats-bar">
          <li><strong>{String(products.length)}</strong><small>{t("storefront.ca.stats.products")}</small></li>
          <li><strong>{String(products.reduce((sum, product) => sum + product.soldCount, 0))}</strong><small>{t("storefront.ca.stats.sold")}</small></li>
          <li><strong>24/7</strong><small>{t("storefront.ca.stats.support")}</small></li>
        </ul>
        <div class="hero-trust-bar">
          <span>{t("storefront.ca.trust.secure")}</span>
          <span>{t("storefront.ca.trust.instant")}</span>
          <span>{t("storefront.ca.trust.support")}</span>
        </div>
        <div class="hero-deco-ring" aria-hidden="true"></div>
        metro-trust-strip" aria-label={t("storefront.support_aria")}>
  {trustItems.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}
</ul>
<section class="catalog-section" id="products">
  <div class="catalog-heading">
    <div><h2>{t("storefront.catalog.heading")}</h2><p>{t("storefront.catalog.count", { count: products.length, shop: shop.name })}</p></div>
    {categories.length > 0 && <label class="store-filter-control" for="store-category-filter">
      <span>{t("storefront.catalog.category")}</span>
      <select id="store-category-filter" data-store-category-filter>
        <option value="">{t("storefront.catalog.all_categories")}</option>
        {categories.map((category) => <option value={category.id}>{category.name}</option>)}
      </select>
    </label>}
  </div>
  <div class="product-list metro-product-list">
    {products.map((product, index) => (
  <div data-spec-peek={product.attributes.slice(0, 3).map((attribute) => `${attribute.label}: ${attribute.value}`).join("|")}>
    <ProductCard locale={locale} product={product} index={index} />
  </div>
))}
    {products.length === 0 && <p class="empty-cart">{t("storefront.catalog.empty")}</p>}
  </div>
  {products.length > 0 && <p class="empty-cart catalog-no-results" data-store-search-empty hidden>{t("storefront.catalog.no_results")} <a href="#products" data-store-search-reset>{t("storefront.catalog.show_all")}</a>.</p>}
</section>
<section class="recently-viewed-section" aria-label="Recently viewed" hidden>
  <h2>{t("storefront.tm4.recently_viewed.heading")}</h2>
  <div class="recently-viewed-scroll" data-recently-viewed-rail></div>
</section>
{universalTail.map((type) => type === "usp"
  ? <USPGrid locale={locale} settings={universalSectionSettings(shop.content.sections ?? [], "usp")} vertical={shop.template.vertical} />
  : <FAQSection locale={locale} settings={universalSectionSettings(shop.content.sections ?? [], "faq")} vertical={shop.template.vertical} />)}
<script src="../../../../scripts/storefront/store-search.ts"></script>
<script src="../../../../scripts/marketing/reveal-boot.ts"></script>
<script src="../../../../scripts/storefront/tm3-signatures.ts"></script>
<script src="../../../../scripts/storefront/tm4-merchandising.ts"></script>

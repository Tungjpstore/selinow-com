---
import { createStorefrontTranslator } from "../../../lib/i18n/catalogs/storefront";
import { parseSectionItems } from "../../../lib/storefront/sections/registry";

/**
 * TM0 universal section — native details/summary FAQ. TM2: merchants override
 * the per-vertical defaults through the sections settings plane; answers that
 * reference the shop's real policy surfaces stay honest.
 */
interface Props {
  locale: string;
  settings?: Record<string, unknown>;
  vertical: string;
}

const { locale, settings, vertical } = Astro.props;
const t = createStorefrontTranslator(locale);
const safeVertical = vertical === "physical" || vertical === "booking" ? vertical : "digital";
const defaults = [1, 2, 3].map((index) => ({
  a: t(`storefront.section.faq.${safeVertical}.${index}.a`),
  q: t(`storefront.section.faq.${safeVertical}.${index}.q`),
}));
const custom = parseSectionItems(settings?.items);
const items = custom.length > 0
  ? [...custom, ...defaults].slice(0, 3).map((item) => ({
      a: item.a ?? "",
      q: item.q ?? "",
    }))
  : defaults;
---
<section class="faq-section" data-vertical={safeVertical} aria-labelledby="faq-section-title">
  <h2 id="faq-section-title">{t("storefront.section.faq.heading")}</h2>
  {items.map((item) => (
    <details class="faq-item">
      <summary>{item.q}</summary>
      <p>{item.a}</p>
    </details>
  ))}
</section>

---
import { formatMoney } from "../../../lib/storefront/view";
import { createStorefrontTranslator } from "../../../lib/i18n/catalogs/storefront";
import type { StorefrontProduct, StorefrontVariant } from "../../../lib/storefront/store";
import VariantList from "./VariantList.astro";

/**
 * Option swatches for variant selection. Only takes over when every variant
 * carries exactly one shared option key with non-empty string values (e.g.
 * {"color": "Đỏ"} or {"size": "L"}); anything else degrades to the standard
 * variant list so the purchase contract never breaks. The chips wrap the real
 * radio inputs, keeping product-detail.ts fully functional without JS changes.
 */
interface Props {
  locale: string;
  product: StorefrontProduct;
}

const { locale, product } = Astro.props;
const t = createStorefrontTranslator(locale);

function swatchDimension(variants: StorefrontVariant[]): { key: string; values: string[] } | null {
  if (variants.length < 2) return null;
  const keys = new Set<string>();
  for (const variant of variants) {
    const entries = Object.entries(variant.options).filter(([, value]) => typeof value === "string" && value.trim() !== "");
    if (entries.length !== 1) return null;
    keys.add(entries[0]?.[0] ?? "");
  }
  if (keys.size !== 1) return null;
  const key = [...keys][0] as string;
  const values: string[] = [];
  for (const variant of variants) {
    const value = variant.options[key];
    if (typeof value !== "string") return null;
    const trimmed = value.trim();
    if (trimmed !== "" && !values.includes(trimmed)) values.push(trimmed);
  }
  if (values.length < 2) return null;
  return { key, values };
}

const dimension = swatchDimension(product.variants);
const defaultVariant = product.variants.find((variant) => variant.stockState !== "out_of_stock") ?? product.variants[0];
---
{dimension === null ? <VariantList locale={locale} product={product} /> : (
  <div class="swatch-group" role="radiogroup" aria-label={t("storefront.product.variant_aria")}>
    <p class="swatch-label">{dimension.key}</p>
    <div class="swatch-row">
      {product.variants.map((variant) => {
        const value = variant.options[dimension.key];
        const soldOut = variant.stockState === "out_of_stock";
        return <label class:list={["swatch-chip", soldOut && "is-disabled"]} data-swatch-value={typeof value === "string" ? value : undefined}>
          <input type="radio" name="variant" value={variant.id} checked={variant.id === defaultVariant?.id} disabled={soldOut} data-min={variant.minPerOrder} data-max={variant.maxPerOrder} data-price-minor={variant.priceMinor} data-stock-state={variant.stockState} data-version={variant.version} />
          <span>
            <strong>{typeof value === "string" ? value : variant.title}</strong>
            <small>{formatMoney(variant.priceMinor, variant.currency, locale)}</small>
          </span>
        </label>;
      })}
    </div>
  </div>
)}

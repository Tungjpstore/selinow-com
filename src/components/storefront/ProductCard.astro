---
import type { StorefrontProduct } from "../../lib/storefront/store";
import { formatMoney, stockLabel } from "../../lib/storefront/view";
import { createStorefrontTranslator } from "../../lib/i18n/catalogs/storefront";

interface Props {
  dealBadge?: string;
  index: number;
  locale?: string;
  product: StorefrontProduct;
}

const { dealBadge, index, locale = "en", product } = Astro.props;
const t = createStorefrontTranslator(locale);
const firstVariant = product.variants[0];
const purchasableVariant = product.variants.find((variant) => variant.stockState !== "out_of_stock") ?? firstVariant;
const soldOut = purchasableVariant === undefined || purchasableVariant.stockState === "out_of_stock";
const isDeal = dealBadge !== undefined && purchasableVariant?.compareAtMinor !== undefined && purchasableVariant.compareAtMinor !== null;
// TM4 auto badges — real signals only, no invented numbers:
// NEW = product created ≤21 days ago; BEST = ≥5 real paid orders; HOT = has compare-at.
const badge: "best" | "hot" | "new" | null = product.soldCount >= 5
  ? "best"
  : isDeal
    ? "hot"
    : Date.now() - Date.parse(product.createdAt) <= 21 * 86_400_000
      ? "new"
      : null;
---

<article class:list={["product-card", isDeal && "is-deal"]} data-product-card data-category-id={product.categoryId ?? ""} data-product-slug={product.slug} data-search-text={`${product.title} ${product.description} ${product.variants.map((variant) => variant.title).join(" ")}`}>
  <div class="product-visual" data-visual={product.imageUrl !== null ? "image" : "mark"}>
    {product.imageUrl !== null ? (
      <img src={product.imageUrl} alt="" loading={index < 4 ? "eager" : "lazy"} decoding="async" />
    ) : (
      <>
        <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
        <strong aria-hidden="true">{product.title.slice(0, 1).toUpperCase()}</strong>
      </>
    )}
    {isDeal && <span class="product-deal-badge" aria-hidden="true">{dealBadge}</span>}
    <div class="card-price-overlay">
      <div class="price-tag">
        {purchasableVariant?.compareAtMinor && <del>{formatMoney(purchasableVariant.compareAtMinor, purchasableVariant.currency, locale)}</del>}
        <strong>{purchasableVariant ? formatMoney(purchasableVariant.priceMinor, purchasableVariant.currency, locale) : t("storefront.product.contact")}</strong>
      </div>
      <div class="card-actions">
        {purchasableVariant && <button type="button" data-cart-add data-variant-id={purchasableVariant.id} data-max-quantity={purchasableVariant.maxPerOrder} disabled={soldOut} aria-label={`${soldOut ? t("storefront.product.sold_out") : t("storefront.product.add")}: ${product.title}`} title={soldOut ? t("storefront.product.sold_out") : t("storefront.product.add")}>＋</button>}
        <a href={`/products/${product.slug}`} aria-label={product.title} title={product.title}>→</a>
      </div>
    </div>
    {badge !== null && <span class:list={["product-auto-badge", `is-${badge}`]} aria-hidden="true">{badge === "best" ? t("storefront.tm4.badge.best", { count: product.soldCount }) : badge === "hot" ? t("storefront.tm4.badge.hot") : t("storefront.tm4.badge.new")}</span>}
  </div>
  <div class="product-copy">
    <p class:list={["stock", purchasableVariant?.stockState]}>{purchasableVariant ? stockLabel(purchasableVariant.stockState, purchasableVariant.availableStock, locale) : t("storefront.product.no_variant")}</p>
    <h2><a href={`/products/${product.slug}`}>{product.title}</a></h2>
    <p>{product.description || t("storefront.product.description_fallback")}</p>
    <div class="product-meta">
      {product.soldCount >= 5 && <span>{t("storefront.tm4.badge.best", { count: product.soldCount })}</span>}
      {product.variants.length > 1 && <span>{t("storefront.product.variant_count", { count: product.variants.length })}</span>}
    </div>
    {product.variants.length > 1 && <p class="product-variant-count">{t("storefront.product.variant_count", { count: product.variants.length })}</p>}
    <div class="product-buy-row">
      <div>
        {purchasableVariant?.compareAtMinor && <del>{formatMoney(purchasableVariant.compareAtMinor, purchasableVariant.currency, locale)}</del>}
        <strong>{purchasableVariant ? formatMoney(purchasableVariant.priceMinor, purchasableVariant.currency, locale) : t("storefront.product.contact")}</strong>
      </div>
      {purchasableVariant && <button type="button" data-cart-add data-variant-id={purchasableVariant.id} data-max-quantity={purchasableVariant.maxPerOrder} disabled={soldOut} aria-label={`${soldOut ? t("storefront.product.sold_out") : t("storefront.product.add")}: ${product.title}`}>{soldOut ? t("storefront.product.sold_out") : t("storefront.product.add")}</button>}
    </div>
  </div>
</article>

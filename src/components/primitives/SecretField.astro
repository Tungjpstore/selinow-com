---
interface Props {
  autocomplete?: "current-password" | "new-password" | "off";
  description?: string;
  disabled?: boolean;
  error?: string;
  id: string;
  label: string;
  maxLength?: number;
  minLength?: number;
  name: string;
  placeholder?: string;
  required?: boolean;
  saved?: boolean;
  savedLabel?: string;
}

const {
  autocomplete = "off",
  description,
  disabled = false,
  error,
  id,
  label,
  maxLength,
  minLength,
  name,
  placeholder = "Enter a new value",
  required = false,
  saved = false,
  savedLabel = "Saved securely. The current value is not shown again.",
} = Astro.props;
const descriptionId = description ? `${id}-description` : undefined;
const errorId = error ? `${id}-error` : undefined;
const savedId = saved ? `${id}-saved` : undefined;
const describedBy = [descriptionId, savedId, errorId].filter(Boolean).join(" ") || undefined;
---

<div class="sln-field sln-secret-field" data-state={error ? "error" : disabled ? "disabled" : "default"}>
  <label class="sln-field__label" for={id}>{label}{required && <span aria-hidden="true"> *</span>}</label>
  <div class="sln-field__control">
    <input
      aria-describedby={describedBy}
      aria-label={label}
      aria-invalid={error ? "true" : undefined}
      autocomplete={autocomplete}
      disabled={disabled}
      id={id}
      maxlength={maxLength}
      minlength={minLength}
      name={name}
      placeholder={placeholder}
      required={required}
      type="password"
    />
  </div>
  {description && <p class="sln-field__description" id={descriptionId}>{description}</p>}
  {saved && <p class="sln-field__saved sln-secret-field__saved" id={savedId}>{savedLabel}</p>}
  {error && <p class="sln-field__error" id={errorId} role="alert">{error}</p>}
</div>

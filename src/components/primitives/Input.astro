---
interface Props {
  autocomplete?: string;
  className?: string;
  description?: string;
  disabled?: boolean;
  error?: string;
  id: string;
  inputmode?: "decimal" | "email" | "numeric" | "search" | "tel" | "text" | "url";
  label: string;
  max?: number | string;
  maxLength?: number;
  min?: number | string;
  minLength?: number;
  name: string;
  pattern?: string;
  placeholder?: string;
  readonly?: boolean;
  required?: boolean;
  type?: "date" | "email" | "hidden" | "number" | "search" | "tel" | "text" | "url";
  value?: number | string;
}

const {
  autocomplete,
  className,
  description,
  disabled = false,
  error,
  id,
  inputmode,
  label,
  max,
  maxLength,
  min,
  minLength,
  name,
  pattern,
  placeholder,
  readonly = false,
  required = false,
  type = "text",
  value,
} = Astro.props;
const descriptionId = description ? `${id}-description` : undefined;
const errorId = error ? `${id}-error` : undefined;
const describedBy = [descriptionId, errorId].filter(Boolean).join(" ") || undefined;
const classes = ["sln-field", className].filter(Boolean).join(" ");
---

<div class={classes} data-state={error ? "error" : readonly ? "readonly" : disabled ? "disabled" : "default"}>
  <label class="sln-field__label" for={id}>{label}{required && <span aria-hidden="true"> *</span>}</label>
  <div class="sln-field__control">
    <input
      aria-describedby={describedBy}
      aria-label={label}
      aria-invalid={error ? "true" : undefined}
      autocomplete={autocomplete}
      disabled={disabled}
      id={id}
      inputmode={inputmode}
      max={max}
      maxlength={maxLength}
      min={min}
      minlength={minLength}
      name={name}
      pattern={pattern}
      placeholder={placeholder}
      readonly={readonly}
      required={required}
      type={type}
      value={value}
    />
  </div>
  {description && <p class="sln-field__description" id={descriptionId}>{description}</p>}
  {error && <p class="sln-field__error" id={errorId} role="alert">{error}</p>}
</div>

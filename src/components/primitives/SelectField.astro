---
type Option = { disabled?: boolean; label: string; value: string };

interface Props {
  description?: string;
  disabled?: boolean;
  error?: string;
  id: string;
  label: string;
  name: string;
  options: readonly Option[];
  required?: boolean;
  value?: string;
}

const { description, disabled = false, error, id, label, name, options, required = false, value } = Astro.props;
const descriptionId = description ? `${id}-description` : undefined;
const errorId = error ? `${id}-error` : undefined;
const describedBy = [descriptionId, errorId].filter(Boolean).join(" ") || undefined;
---

<div class="sln-field" data-state={error ? "error" : disabled ? "disabled" : "default"}>
  <label class="sln-field__label" for={id}>{label}{required && <span aria-hidden="true"> *</span>}</label>
  <div class="sln-field__control">
    <select aria-describedby={describedBy} aria-label={label} aria-invalid={error ? "true" : undefined} disabled={disabled} id={id} name={name} required={required}>
      {options.map((option) => <option disabled={option.disabled} selected={option.value === value} value={option.value}>{option.label}</option>)}
    </select>
  </div>
  {description && <p class="sln-field__description" id={descriptionId}>{description}</p>}
  {error && <p class="sln-field__error" id={errorId} role="alert">{error}</p>}
</div>

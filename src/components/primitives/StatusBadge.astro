---
interface Props {
  label: string;
  tone?: "danger" | "info" | "neutral" | "success" | "warning";
}

const { label, tone = "neutral" } = Astro.props;
---

<span class="sln-status" data-tone={tone}><span aria-hidden="true"></span>{label}</span>

<style>
  .sln-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    width: fit-content;
    min-height: 28px;
    padding: 4px 10px;
    border: 1px solid var(--sln-border-default);
    border-radius: var(--sln-radius-pill);
    background: var(--sln-bg-subtle);
    color: var(--sln-text-secondary);
    font: var(--sln-font-caption);
    white-space: nowrap;
  }
  .sln-status > span { width: 7px; height: 7px; border-radius: 50%; background: currentcolor; }
  .sln-status[data-tone="success"] { border-color: color-mix(in srgb, var(--sln-state-success) 24%, transparent); background: var(--sln-tint-success); color: var(--sln-success-text); }
  .sln-status[data-tone="warning"] { border-color: color-mix(in srgb, var(--sln-state-warning) 24%, transparent); background: var(--sln-tint-warning); color: var(--sln-warning-text); }
  .sln-status[data-tone="danger"] { border-color: color-mix(in srgb, var(--sln-state-danger) 24%, transparent); background: var(--sln-tint-danger); color: var(--sln-danger-text); }
  .sln-status[data-tone="info"] { border-color: color-mix(in srgb, var(--sln-state-info) 24%, transparent); background: var(--sln-tint-info); color: var(--sln-info-text); }
</style>

  .text-button { min-height: 44px; border: 0; padding: 6px 0; background: transparent; color: var(--selinow-action-primary-hover); font-size: 12px; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
  .domain-list { display: grid; gap: 1rem; }

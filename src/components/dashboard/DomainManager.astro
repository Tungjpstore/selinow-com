---
import DomainConnectForm from "./domains/DomainConnectForm.astro";
import DomainDeleteDialog from "./domains/DomainDeleteDialog.astro";
import DomainGuide from "./domains/DomainGuide.astro";
import DomainList from "./domains/DomainList.astro";
import PermissionState from "../states/PermissionState.astro";
import PlanLimitState from "../states/PlanLimitState.astro";
import SuspendedState from "../states/SuspendedState.astro";
import { createDashboardTranslator } from "../../lib/i18n/catalogs/dashboard";
import type { DomainView } from "../../lib/domains/store";
import type { ShopView } from "../../lib/tenants/store";

type Props = {
  csrfCookieName: string;
  initialDomains: DomainView[];
  initialLoadFailed: boolean;
  platformBaseDomain: string;
  shop?: ShopView | undefined;
};

const { csrfCookieName, initialDomains, initialLoadFailed, platformBaseDomain, shop } = Astro.props;
const locale = Astro.locals.locale;
const t = createDashboardTranslator(locale);
const canManage = shop?.role === "owner";
const domainEntitled = shop?.featureFlags.customDomain === true;
const mutationBlocked = shop?.status === "suspended" || shop?.status === "archived";
const initialLoadStatus = canManage ? initialLoadFailed ? "unavailable" : "ready" : "permission";
const initialDomainsJson = JSON.stringify(initialDomains.map((domain) => ({
  dnsInstructions: domain.dnsInstructions,
  dnsStatus: domain.dnsStatus,
  hostname: domain.hostname,
  hostnameStatus: domain.hostnameStatus,
  id: domain.id,
  isPrimary: domain.isPrimary,
  lastCheckedAt: domain.lastCheckedAt,
  lastSafeErrorCode: domain.lastSafeErrorCode,
  ownershipStatus: domain.ownershipStatus,
  sslStatus: domain.sslStatus,
  status: domain.status,
  turnstileStatus: domain.turnstileStatus,
  type: domain.type,
}))).replaceAll("<", "\\u003c");
const initialPanelState = !canManage
  ? t("dashboard.domains.panel.permission_state")
  : initialLoadFailed
    ? t("dashboard.domains.panel.unavailable_state")
    : t("dashboard.domains.panel.count", { count: initialDomains.length });
---

<section
  class="domain-workspace"
  id="domains"
  data-domain-workspace
  data-csrf-cookie-name={csrfCookieName}
  data-locale={locale ?? "en"}
  data-domain-entitled={domainEntitled ? "true" : "false"}
  data-initial-load-status={initialLoadStatus}
  data-shop-id={shop?.publicId}
  data-shop-name={shop?.name}
  data-shop-role={shop?.role}
  data-shop-status={shop?.status}
  data-shop-timezone={shop?.timezone}
>
  {shop === undefined ? (
    <div class="domain-empty">
      <strong>{t("dashboard.domains.no_store.title")}</strong>
      <p>{t("dashboard.domains.no_store.description")}</p>
    </div>
  ) : (
    <>
      <div
        class="domain-panel"
        id="domain-panel"
        aria-labelledby="domain-panel-title"
        aria-busy="false"
        data-domain-panel
      >
        <div class="panel-head">
          <div>
            <p class="panel-label">{t("dashboard.domains.panel.current_store")}</p>
            <h3 id="domain-panel-title">{shop.name}</h3>
            <p class="platform-address">{shop.slug}.{platformBaseDomain}</p>
          </div>
          <p class="panel-state" data-panel-state role="status" aria-live="polite" aria-atomic="true">{initialPanelState}</p>
        </div>

        <div class="state-note" data-permission-note hidden={canManage}>
          <PermissionState description={t("dashboard.domains.panel.permission.description")} title={t("dashboard.domains.panel.permission.title")} />
        </div>

        <div class="state-note" data-entitlement-note hidden={!canManage || domainEntitled}>
          <PlanLimitState description={t("dashboard.domains.panel.entitlement.description")} title={t("dashboard.domains.panel.entitlement.title")} />
        </div>

        <div class="state-note" data-suspended-note hidden={!mutationBlocked}>
          <SuspendedState description={t("dashboard.domains.panel.suspended.description")} title={t("dashboard.domains.panel.suspended.title")} />
        </div>

        <div class="feedback" data-feedback role="status" aria-live="polite" aria-atomic="true" hidden></div>

        <div class="domain-layout" data-domain-content hidden={!canManage}>
          <DomainList
            domains={initialDomains}
            domainEntitled={domainEntitled}
            initialLoadFailed={initialLoadFailed}
            mutationBlocked={mutationBlocked}
            shopTimezone={shop.timezone}
          />
          <DomainConnectForm domainEntitled={domainEntitled} mutationBlocked={mutationBlocked} />
        </div>

        <DomainGuide hidden={!canManage} />
      </div>

      <script type="application/json" data-domain-initial set:html={initialDomainsJson} is:inline></script>

      <DomainDeleteDialog />
    </>
  )}
</section>

<script src="../../scripts/dashboard/domains.ts"></script>

<style>
  [hidden] { display: none !important; }
  .domain-workspace { color: var(--sln-text-primary); }
  .domain-panel { overflow: hidden; border: 1px solid var(--sln-border-default); border-radius: var(--sln-radius-xl); background: var(--sln-bg-surface); box-shadow: var(--sln-shadow-sm); }
  .panel-head { display: flex; align-items: end; justify-content: space-between; gap: 16px; padding: 24px 28px; border-bottom: 1px solid var(--sln-border-default); }
  .panel-label { margin: 0 0 7px; color: var(--sln-action-primary-hover); font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .panel-head h3 { margin: 0; font-size: 28px; line-height: 1.1; letter-spacing: -.02em; }
  .platform-address { margin: 7px 0 0; color: var(--sln-text-muted); font-family: var(--sln-font-mono); font-size: 12px; overflow-wrap: anywhere; }
  .panel-state { margin: 0; color: var(--sln-text-muted); font-size: 13px; }
  .state-note { margin: 24px; }
  .feedback { margin: 24px; padding: 16px 18px; border-left: 3px solid var(--sln-border-default); border-radius: 0 var(--sln-radius-md) var(--sln-radius-md) 0; background: var(--sln-bg-subtle); color: var(--sln-text-primary); overflow-wrap: anywhere; }
  .feedback[data-tone="success"] { border-color: var(--sln-state-success); background: var(--sln-tint-success); }
  .feedback[data-tone="error"] { border-color: var(--sln-state-danger); background: var(--sln-tint-danger); }
  .domain-layout { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(19rem, .55fr); }
  .domain-empty { padding: 24px; border: 1px dashed var(--sln-border-strong); border-radius: var(--sln-radius-md); }
  .domain-empty p { margin: 8px 0 0; color: var(--sln-text-secondary); line-height: 1.55; }
  @media (max-width: 900px) { .domain-layout { grid-template-columns: 1fr; } }
  @media (max-width: 650px) {
    .panel-head { align-items: start; display: grid; }
  }
</style>

---
import DomainLifecycle from "../DomainLifecycle.astro";
import StatusBadge from "../../primitives/StatusBadge.astro";
import { domainStatusLabel, domainStatusTone, isDomainReady } from "../../../lib/dashboard/domain-ui";
import { createDashboardTranslator } from "../../../lib/i18n/catalogs/dashboard";
import type { DomainView } from "../../../lib/domains/store";

type Props = {
  domains: DomainView[];
  domainEntitled: boolean;
  initialLoadFailed: boolean;
  mutationBlocked: boolean;
  shopTimezone?: string | undefined;
};

const { domains, domainEntitled, initialLoadFailed, mutationBlocked, shopTimezone } = Astro.props;
const locale = Astro.locals.locale;
const t = createDashboardTranslator(locale);
const domainKindLabel = (type: string): string => type === "custom" ? t("dashboard.domains.kind.custom") : t("dashboard.domains.kind.platform");
type BadgeTone = "danger" | "info" | "neutral" | "success" | "warning";
const statusBadgeTone = (status: string | null): BadgeTone => {
  const tone = domainStatusTone(status);
  return tone === "error" ? "danger" : tone;
};
const formatCheckedAt = (value: string | null): string => {
  if (value === null) return t("dashboard.domains.checked.never");
  const timestamp = Date.parse(value);
  if (!Number.isFinite(timestamp)) return t("dashboard.domains.checked.recent");
  return t("dashboard.domains.checked.at", { time: new Intl.DateTimeFormat(locale ?? "en", {
    dateStyle: "short",
    timeStyle: "short",
    timeZone: shopTimezone,
  }).format(new Date(timestamp)) });
};
---

<div class="domain-list-column">
  <div class="list-heading">
    <h4>{t("dashboard.domains.panel.list.title")}</h4>
    <button type="button" class="text-button" data-refresh-list>{t("dashboard.domains.panel.list.refresh")}</button>
  </div>
  <div class="domain-loading" data-domain-loading hidden>
    <span aria-hidden="true"></span>
    <p>{t("dashboard.domains.panel.list.loading")}</p>
  </div>
  <div class="list-error" data-list-error role="alert" aria-atomic="true" hidden={!initialLoadFailed}>
    <strong>{t("dashboard.domains.panel.list.error.title")}</strong>
    <p data-list-error-message>{t("dashboard.domains.panel.list.error.description")}</p>
    <button type="button" class="secondary-button" data-list-retry>{t("dashboard.domains.panel.list.retry")}</button>
  </div>
  <div class="domain-list" data-domain-list aria-live="polite" aria-atomic="true">
    {!initialLoadFailed && domains.length === 0 && (
      <div class="domain-empty compact">
        <strong>{t("dashboard.domains.panel.list.empty.title")}</strong>
        <p>{t("dashboard.domains.panel.list.empty.description")}</p>
      </div>
    )}
    {!initialLoadFailed && domains.map((domain) => (
      <article class="domain-card" data-domain-card data-domain-id={domain.id} data-domain-type={domain.type} tabindex="-1" aria-label={t("dashboard.domains.card.aria", { hostname: domain.hostname })}>
        <header class="domain-card-head">
          <div>
            <p class="domain-kind">{domainKindLabel(domain.type)}</p>
            <h5>{domain.hostname}</h5>
          </div>
          <StatusBadge label={domainStatusLabel(domain.status, locale)} tone={statusBadgeTone(domain.status)} />
        </header>
        {domain.isPrimary && <p class="primary-note">{t("dashboard.domains.card.primary")}</p>}
        {domain.type === "custom" && <DomainLifecycle domain={domain} />}
        {domain.dnsInstructions !== null && (
          <div class="dns-record">
            <div class="dns-record-head"><strong>{t("dashboard.domains.card.dns.title")}</strong><span>{domain.dnsInstructions.type}</span></div>
            <dl>
              <div><dt>{t("dashboard.domains.card.dns.name")}</dt><dd><code>{domain.dnsInstructions.name}</code><button type="button" data-copy-name>{t("dashboard.domains.card.dns.copy")}</button></dd></div>
              <div><dt>{domain.dnsInstructions.type === "TXT" ? t("dashboard.domains.card.dns.value") : t("dashboard.domains.card.dns.target")}</dt><dd><code>{domain.dnsInstructions.target}</code><button type="button" data-copy-target>{t("dashboard.domains.card.dns.copy")}</button></dd></div>
            </dl>
            <p>{domain.dnsInstructions.type === "TXT" ? t("dashboard.domains.card.dns.txt_note") : t("dashboard.domains.card.dns.cname_note")}</p>
          </div>
        )}
        {domain.type === "custom" && domain.turnstileStatus !== "active" && domain.ownershipStatus === "verified" && domain.hostnameStatus === "active" && domain.sslStatus === "active" && domain.dnsStatus === "active" && (
          <p class="turnstile-note">{t("dashboard.domains.card.turnstile_pending")}</p>
        )}
        <div class="domain-meta">
          <span>{formatCheckedAt(domain.lastCheckedAt)}</span>
          {(domain.lastSafeErrorCode !== null || domain.status === "ownership_expired") && (
            <span>{domain.status === "ownership_expired" ? t("dashboard.domains.card.ownership_expired") : t("dashboard.domains.card.safe_error", { status: domainStatusLabel(domain.lastSafeErrorCode, locale) })}</span>
          )}
        </div>
        <footer class="domain-actions">
          <button type="button" class="secondary-button" data-action="check" hidden={domain.type !== "custom" || domain.status === "ownership_expired"} disabled={mutationBlocked} aria-label={t("dashboard.domains.card.check.aria", { hostname: domain.hostname })}>{t("dashboard.domains.card.check.action")}</button>
          <button type="button" class="secondary-button" data-action="primary" hidden={domain.isPrimary} disabled={!isDomainReady(domain) || !domainEntitled || mutationBlocked} aria-label={t("dashboard.domains.card.primary.aria", { hostname: domain.hostname })}>{t("dashboard.domains.card.primary.action")}</button>
          <button type="button" class="danger-button" data-action="delete" hidden={domain.type !== "custom"} disabled={mutationBlocked} aria-label={t("dashboard.domains.card.delete.aria", { hostname: domain.hostname })}>{t("dashboard.domains.card.delete.action")}</button>
        </footer>
      </article>
    ))}
  </div>
</div>

<template data-domain-template>
  <article class="domain-card" data-domain-card tabindex="-1">
    <header class="domain-card-head">
      <div>
        <p class="domain-kind" data-domain-kind></p>
        <h5 data-domain-hostname></h5>
      </div>
      <span class="status-badge" data-domain-status></span>
    </header>
    <p class="primary-note" data-primary-note hidden>{t("dashboard.domains.card.primary")}</p>

    <div data-custom-readiness><DomainLifecycle /></div>

    <div class="dns-record" data-dns-record hidden>
      <div class="dns-record-head">
        <strong>{t("dashboard.domains.card.dns.title")}</strong>
        <span data-dns-type>CNAME</span>
      </div>
      <dl>
        <div>
          <dt>{t("dashboard.domains.card.dns.name")}</dt>
          <dd><code data-dns-name></code><button type="button" data-copy-name>{t("dashboard.domains.card.dns.copy")}</button></dd>
        </div>
        <div>
          <dt data-dns-target-label>{t("dashboard.domains.card.dns.target")}</dt>
          <dd><code data-dns-target></code><button type="button" data-copy-target>{t("dashboard.domains.card.dns.copy")}</button></dd>
        </div>
      </dl>
      <p data-dns-note>{t("dashboard.domains.card.dns.cname_note")}</p>
    </div>

    <p class="turnstile-note" data-turnstile-note hidden>{t("dashboard.domains.card.turnstile_pending")}</p>

    <div class="domain-meta">
      <span data-last-checked></span>
      <span data-safe-error hidden></span>
    </div>
    <footer class="domain-actions">
      <button type="button" class="secondary-button" data-action="check" aria-label={t("dashboard.domains.card.check.action")}>{t("dashboard.domains.card.check.action")}</button>
      <button type="button" class="secondary-button" data-action="primary" aria-label={t("dashboard.domains.card.primary.action")}>{t("dashboard.domains.card.primary.action")}</button>
      <button type="button" class="danger-button" data-action="delete" aria-label={t("dashboard.domains.card.delete.action")}>{t("dashboard.domains.card.delete.action")}</button>
    </footer>
  </article>
</template>

<style>
  [hidden] { display: none !important; }
  .domain-list-column { min-width: 0; padding: 28px; border-right: 1px solid var(--sln-border-default); }
  .list-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .list-heading h4 { margin: 0; font-size: 24px; line-height: 1.2; letter-spacing: -.02em; }
  .text-button { min-height: 44px; border: 0; padding: 6px 0; background: transparent; color: var(--sln-action-primary-hover); font-size: 12px; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
  .domain-list { display: grid; gap: 1rem; }
  .domain-loading { display: flex; align-items: center; gap: 12px; min-height: 112px; color: var(--sln-text-secondary); }
  .domain-loading span { width: 18px; height: 18px; border: 2px solid var(--sln-border-default); border-top-color: var(--sln-brand-blue); border-radius: 50%; animation: spin .85s linear infinite; }
  .list-error, .domain-empty { padding: 24px; border: 1px dashed var(--sln-border-strong); border-radius: var(--sln-radius-md); }
  .list-error p, .domain-empty p { margin: 8px 0 16px; color: var(--sln-text-secondary); line-height: 1.55; }
  .domain-empty.compact p { margin-bottom: 0; }
  .domain-card { padding: 20px; border: 1px solid var(--sln-border-default); border-radius: var(--sln-radius-lg); background: var(--sln-bg-surface); box-shadow: var(--sln-shadow-xs); outline: none; }
  .domain-card:focus-visible { outline: 3px solid var(--sln-focus-ring); outline-offset: 3px; }
  .domain-card-head { display: flex; align-items: start; justify-content: space-between; gap: 1rem; }
  .domain-card-head > .sln-status { flex: 0 0 auto; }
  .domain-kind { margin: 0 0 6px; color: var(--sln-action-primary-hover); font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .domain-card h5 { overflow-wrap: anywhere; margin: 0; font-size: clamp(22px, 3vw, 30px); line-height: 1.15; letter-spacing: -.02em; }
  .status-badge { flex: 0 0 auto; padding: 7px 9px; border: 1px solid var(--sln-border-default); border-radius: var(--sln-radius-pill); color: var(--sln-text-secondary); font-size: 11px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .status-badge[data-tone="success"] { border-color: transparent; background: var(--sln-tint-success); color: var(--selinow-success-text); }
  .status-badge[data-tone="warning"] { border-color: transparent; background: var(--sln-tint-warning); color: var(--selinow-warning-text); }
  .status-badge[data-tone="error"] { border-color: transparent; background: var(--sln-tint-danger); color: var(--selinow-danger-text); }
  .primary-note { margin: 16px 0 0; padding: 11px 13px; border-radius: var(--sln-radius-sm); background: var(--sln-tint-indigo); color: var(--sln-action-primary-hover); font-size: 12px; font-weight: 700; }
  .dns-record { margin-top: 16px; padding: 16px; border-radius: var(--sln-radius-md); background: var(--sln-bg-subtle); }
  .dns-record-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .dns-record-head span { color: var(--sln-action-primary-hover); font-size: 11px; font-weight: 700; letter-spacing: .1em; }
  .dns-record dl { margin: .8rem 0 0; }
  .dns-record dl > div { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 12px; align-items: center; padding: 10px 0; border-top: 1px solid var(--sln-border-default); }
  .dns-record dt { color: var(--sln-text-muted); font-size: 11px; font-weight: 700; text-transform: uppercase; }
  .dns-record dd { display: flex; align-items: center; justify-content: space-between; gap: .75rem; min-width: 0; margin: 0; }
  .dns-record code { min-width: 0; color: var(--sln-text-primary); font-size: 12px; overflow-wrap: anywhere; white-space: normal; }
  .dns-record button { flex: 0 0 auto; min-height: 44px; border: 0; padding: 6px; background: transparent; color: var(--sln-action-primary-hover); font-size: 11px; font-weight: 700; cursor: pointer; }
  .dns-record > p { margin: 10px 0 0; color: var(--sln-text-muted); font-size: 12px; line-height: 1.5; }
  .turnstile-note { margin: 14px 0 0; padding: 11px 13px; border: 1px solid var(--selinow-warning-text); border-radius: var(--sln-radius-sm); background: var(--sln-tint-warning); color: var(--selinow-warning-text); font-size: 12px; line-height: 1.5; }
  .domain-meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 16px; margin-top: 14px; color: var(--sln-text-muted); font-size: 11px; }
  .domain-meta span:last-child { color: var(--sln-state-danger); }
  .domain-actions { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1rem; }
  .secondary-button, .danger-button { min-height: 44px; border: 1px solid transparent; border-radius: var(--sln-radius-pill); padding: 10px 16px; font-family: var(--sln-font-sans); font-size: 12px; font-weight: 700; cursor: pointer; }
  .secondary-button { background: var(--sln-bg-surface); border-color: var(--sln-slate-500); color: var(--sln-text-primary); }
  .secondary-button:hover { border-color: var(--sln-slate-500); background: var(--sln-bg-subtle); }
  .danger-button { margin-left: auto; background: transparent; border-color: var(--sln-state-danger); color: var(--sln-state-danger); }
  button:disabled { border-color: var(--sln-slate-500); background: var(--sln-slate-200); color: var(--sln-slate-600); cursor: not-allowed; opacity: 1; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (max-width: 900px) { .domain-list-column { border-right: 0; border-bottom: 1px solid var(--sln-border-default); } }
  @media (max-width: 650px) {
    .domain-list-column { padding: 1.1rem; }
    .dns-record dl > div { grid-template-columns: 1fr; gap: .3rem; }
    .domain-card-head { display: grid; }
    .status-badge, .domain-card-head > .sln-status { justify-self: start; }
    .domain-actions > button { flex: 1 1 100%; margin-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .domain-loading span { animation: none; } }
</style>

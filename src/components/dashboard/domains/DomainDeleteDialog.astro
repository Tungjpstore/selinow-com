---
import { createDashboardTranslator } from "../../../lib/i18n/catalogs/dashboard";

const t = createDashboardTranslator(Astro.locals.locale);
---

<dialog class="delete-dialog" data-delete-dialog aria-labelledby="delete-dialog-title" aria-describedby="delete-dialog-impact">
  <form method="dialog">
    <p class="step">{t("dashboard.domains.dialog.step")}</p>
    <h4 id="delete-dialog-title">{t("dashboard.domains.dialog.delete_prefix")} <span data-delete-hostname></span>?</h4>
    <p id="delete-dialog-impact" data-delete-impact></p>
    <div class="dialog-warning">
      <strong>{t("dashboard.domains.dialog.after_title")}</strong>
      <p>{t("dashboard.domains.dialog.after_description")}</p>
    </div>
    <div class="dialog-actions">
      <button type="button" class="secondary-button" data-delete-cancel>{t("dashboard.domains.dialog.keep")}</button>
      <button type="button" class="danger-button" data-delete-confirm>{t("dashboard.domains.dialog.confirm")}</button>
    </div>
  </form>
</dialog>

<style>
  .step { margin: 0 0 7px; color: var(--sln-action-primary-hover); font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .delete-dialog { width: min(100% - 2rem, 544px); border: 1px solid var(--sln-state-danger); border-radius: var(--sln-radius-xl); padding: 0; background: var(--sln-bg-surface); color: var(--sln-text-primary); box-shadow: var(--sln-shadow-lg); }
  .delete-dialog::backdrop { background: rgb(8 11 20 / 82%); }
  .delete-dialog form { padding: 1.75rem; }
  .delete-dialog h4 { margin: 0; font-size: 24px; line-height: 1.2; letter-spacing: -.02em; overflow-wrap: anywhere; }
  .delete-dialog > form > p:not(.step) { color: var(--sln-text-secondary); line-height: 1.6; }
  .dialog-warning { margin-top: 16px; padding: 16px; border-left: 1px solid var(--sln-state-danger); background: rgb(220 38 38 / 8%); }
  .dialog-warning p { margin: 6px 0 0; color: var(--sln-text-secondary); line-height: 1.55; }
  .dialog-actions { display: flex; justify-content: end; gap: .65rem; margin-top: 1.5rem; }
  .secondary-button, .danger-button { min-height: 44px; border: 1px solid transparent; border-radius: var(--sln-radius-pill); padding: 10px 16px; font-family: var(--sln-font-sans); font-size: 12px; font-weight: 700; cursor: pointer; }
  .secondary-button { background: var(--sln-bg-surface); border-color: var(--sln-slate-500); color: var(--sln-text-primary); }
  .secondary-button:hover { border-color: var(--sln-slate-500); background: var(--sln-bg-subtle); }
  .danger-button { background: transparent; border-color: var(--sln-state-danger); color: var(--sln-state-danger); }
  .secondary-button:disabled, .danger-button:disabled { border-color: var(--sln-slate-500); background: var(--sln-slate-200); color: var(--sln-slate-600); cursor: not-allowed; opacity: 1; }
  @media (max-width: 650px) { .dialog-actions { display: grid; } }
</style>

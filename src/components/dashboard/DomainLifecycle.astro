---
import {
  DOMAIN_LIFECYCLE_ORDER,
  deriveDomainLifecycle,
  domainStatusLabel,
  domainStatusTone,
  type DomainLifecycleInput,
  type DomainLifecycleStep,
} from "../../lib/dashboard/domain-ui";
import { createDashboardTranslator } from "../../lib/i18n/catalogs/dashboard";

interface Props {
  domain?: DomainLifecycleInput;
}

const { domain } = Astro.props;
const t = createDashboardTranslator(Astro.locals.locale);
const lifecycleLabels: Readonly<Record<(typeof DOMAIN_LIFECYCLE_ORDER)[number], string>> = {
  ownership: t("dashboard.domains.lifecycle.ownership"),
  hostname: t("dashboard.domains.lifecycle.hostname"),
  dns: t("dashboard.domains.lifecycle.dns"),
  ssl: t("dashboard.domains.lifecycle.ssl"),
  turnstile: t("dashboard.domains.lifecycle.turnstile"),
  primary: t("dashboard.domains.lifecycle.primary"),
  routing: t("dashboard.domains.lifecycle.routing"),
};
const steps: readonly DomainLifecycleStep[] = domain === undefined
  ? DOMAIN_LIFECYCLE_ORDER.map((key) => ({ key, label: lifecycleLabels[key], status: null }))
  : deriveDomainLifecycle(domain, Astro.locals.locale);
const iconFor = (status: string | null): string => {
  const tone = domainStatusTone(status);
  // Typographic glyphs (not emoji): check mark is U+2713-free on purpose —
  // use a plain dot/bang so the console no-emoji contract stays simple.
  return tone === "success" ? "●" : tone === "error" ? "!" : "·";
};
---

<ol class="domain-lifecycle" aria-label={t("dashboard.domains.lifecycle.aria")} data-domain-lifecycle>
  {steps.map((step) => (
    <li data-lifecycle-step={step.key}>
      <span class="lifecycle-icon" data-lifecycle-icon={step.key} data-tone={domainStatusTone(step.status)} aria-hidden="true">
        {iconFor(step.status)}
      </span>
      <span>
        <strong>{step.label}</strong>
        <small data-lifecycle-value={step.key}>{domainStatusLabel(step.status, Astro.locals.locale)}</small>
      </span>
    </li>
  ))}
</ol>

<style>
  .domain-lifecycle { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); margin: 16px 0 0; padding: 0; border-block: 1px solid var(--sln-border-default); list-style: none; }
  .domain-lifecycle li { position: relative; display: flex; align-items: center; gap: 8px; min-width: 0; padding: 14px 8px; border-right: 1px solid var(--sln-border-default); }
  .domain-lifecycle li:last-child { border-right: 0; }
  .domain-lifecycle strong, .domain-lifecycle small { display: block; }
  .domain-lifecycle strong { font-size: .72rem; }
  .domain-lifecycle small { overflow: hidden; margin-top: 3px; color: var(--sln-text-muted); font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
  .lifecycle-icon { display: grid; flex: 0 0 auto; place-items: center; width: 24px; height: 24px; border: 1px solid var(--sln-border-default); border-radius: 50%; color: var(--sln-text-secondary); font-weight: 600; }
  .lifecycle-icon[data-tone="success"] { border-color: var(--sln-success-text); background: var(--sln-tint-success); color: var(--sln-success-text); }
  .lifecycle-icon[data-tone="warning"] { border-color: var(--sln-warning-text); background: var(--sln-tint-warning); color: var(--sln-warning-text); }
  .lifecycle-icon[data-tone="error"] { border-color: var(--sln-danger-text); background: var(--sln-tint-danger); color: var(--sln-danger-text); }

  @media (max-width: 1080px) {
    .domain-lifecycle { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .domain-lifecycle li:nth-child(4) { border-right: 0; }
    .domain-lifecycle li:nth-child(-n + 4) { border-bottom: 1px solid var(--sln-border-default); }
  }

  @media (max-width: 650px) {
    .domain-lifecycle { grid-template-columns: 1fr; }
    .domain-lifecycle li, .domain-lifecycle li:nth-child(4) { border-right: 0; border-bottom: 1px solid var(--sln-border-default); }
    .domain-lifecycle li:last-child { border-bottom: 0; }
    .domain-lifecycle small { white-space: normal; }
  }
</style>

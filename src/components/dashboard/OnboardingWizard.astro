<script>
  import "../../scripts/dashboard/onboarding";
  import { WIZARD_STEPS } from "../../lib/dashboard/onboarding-ui";

  const onboardingRoot = document.querySelector<HTMLElement>("[data-onboarding-root]");
  function readCopy(): Readonly<Record<string, string>> {
    try {
      const value = JSON.parse(onboardingRoot?.dataset.copy ?? "null") as unknown;
      if (typeof value !== "object" || value === null || Array.isArray(value)) return {};
      return Object.fromEntries(Object.entries(value).filter((entry): entry is [string, string] => typeof entry[1] === "string"));
    } catch {
      return {};
    }
  }
  const onboardingCopy = readCopy();
  const copy = (key: string, fallback: string): string => onboardingCopy[key] ?? fallback;
  const mobileStatusLabels: Record<string, string> = {
    blocked: copy("onboarding.progress.blocked", "Blocked"),
    in_progress: copy("onboarding.progress.in_progress", "In progress"),
    not_started: copy("onboarding.progress.not_started", "Not started"),
    ready: copy("onboarding.progress.ready", "Complete"),
    warning: copy("onboarding.progress.warning", "Safely skipped"),
  };

  function syncMobileStepSummary(): void {
    if (onboardingRoot === null) return;
    for (const step of WIZARD_STEPS) {
      const buttons = [...onboardingRoot.querySelectorAll<HTMLButtonElement>(`[data-step-button="${step.code}"]`)];
      const status = buttons.find((button) => button.dataset.status !== undefined)?.dataset.status ?? "not_started";
      const label = mobileStatusLabels[status] ?? mobileStatusLabels.not_started ?? "Not started";
      const stepLabel = copy(step.labelKey, step.label);
      for (const button of buttons) {
        if (button.dataset.status !== status) button.dataset.status = status;
        const ariaLabel = `${stepLabel}: ${label}`;
        if (button.getAttribute("aria-label") !== ariaLabel) button.setAttribute("aria-label", ariaLabel);
      }
      if (!buttons.some((button) => button.getAttribute("aria-current") === "step")) continue;
      const number = onboardingRoot.querySelector<HTMLElement>("[data-mobile-current-number]");
      const currentLabel = onboardingRoot.querySelector<HTMLElement>("[data-mobile-current-label]");
      const chip = onboardingRoot.querySelector<HTMLElement>("[data-mobile-step-status]");
      if (number !== null && number.textContent !== step.number) number.textContent = step.number;
      if (currentLabel !== null && currentLabel.textContent !== stepLabel) currentLabel.textContent = stepLabel;
      if (chip !== null) {
        if (chip.dataset.status !== status) chip.dataset.status = status;
        if (chip.textContent !== label) chip.textContent = label;
      }
    }

    const progressCopy = onboardingRoot.querySelector<HTMLElement>("[data-progress-copy]")?.textContent ?? "";
    const completed = /^(\d+)\/(\d+)/u.exec(progressCopy)?.[1];
    const mobileCompleted = onboardingRoot.querySelector<HTMLElement>("[data-mobile-progress-completed]");
    if (completed !== undefined && mobileCompleted !== null && mobileCompleted.textContent !== completed) {
      mobileCompleted.textContent = completed;
    }
  }

  if (onboardingRoot !== null) {
    const observer = new MutationObserver(syncMobileStepSummary);
    observer.observe(onboardingRoot, {
      attributeFilter: ["aria-current", "data-status"],
      attributes: true,
      characterData: true,
      childList: true,
      subtree: true,
    });
    for (const button of onboardingRoot.querySelectorAll<HTMLButtonElement>("[data-mobile-step-button]")) {
      button.addEventListener("click", () => {
        const selector = button.closest<HTMLDetailsElement>("[data-mobile-step-selector]");
        if (selector !== null) selector.open = false;
      });
    }
    syncMobileStepSummary();
  }
</script>


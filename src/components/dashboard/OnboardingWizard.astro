---
import { WIZARD_STEPS } from "../../lib/dashboard/onboarding-ui";
import { currencyInputStep, formatMinorAmountForInput, SUPPORTED_CURRENCY_CODES } from "../../lib/i18n/currency";
import { createOnboardingTranslator, getOnboardingClientCopy } from "../../lib/i18n/catalogs/onboarding";
import type { ShopView } from "../../lib/tenants/store";

type Props = {
  csrfCookieName: string;
  defaultCurrency: string;
  defaultLocale: string;
  locale?: string | undefined;
  platformBaseDomain: string;
  shops: ShopView[];
};

const { csrfCookieName, defaultCurrency, defaultLocale, locale, platformBaseDomain, shops } = Astro.props;
const t = createOnboardingTranslator(locale);
const clientCopy = getOnboardingClientCopy(locale);
const wizardSteps = WIZARD_STEPS.map((step) => ({ ...step, label: t(step.labelKey) }));
const initialShop = shops[0];
---

<div
  class="onboarding-shell"
  data-onboarding-root
  data-csrf-cookie-name={csrfCookieName}
  data-copy={JSON.stringify(clientCopy)}
  data-default-currency={defaultCurrency}
  data-default-locale={defaultLocale}
  data-locale={locale ?? "en"}
  data-platform-base-domain={platformBaseDomain}
  data-shops={JSON.stringify(shops)}
>
  <section class="onboarding-intro" aria-labelledby="onboarding-title">
    <div>
      <p class="eyebrow">{t("onboarding.intro.eyebrow")}</p>
      <h1 id="onboarding-title">{t("onboarding.intro.heading_line1")}<br />{t("onboarding.intro.heading_line2")}</h1>
      <p class="intro-copy">{t("onboarding.intro.copy")}</p>
    </div>
    <div class="progress-poster" role="progressbar" aria-label={t("onboarding.aria.progress")} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-progress-poster>
      <p>{t("onboarding.progress.current")}</p>
      <strong data-progress-percent>0%</strong>
      <div class="progress-track" aria-hidden="true"><span data-progress-bar></span></div>
      <small data-progress-copy>{t("onboarding.progress.reading")}</small>
    </div>
  </section>

  <div id="onboarding-global-feedback" class="global-feedback" data-global-feedback role="status" aria-live="polite" aria-atomic="true" hidden></div>
  <div class="resume-recovery" data-onboarding-resume-recovery hidden>
    <p>{t("onboarding.feedback.create_recovery")}</p>
    <button type="button" class="secondary-action" data-onboarding-resume-reload>{t("onboarding.button.reload_saved_setup")}</button>
  </div>

  <section class="wizard-frame" aria-label={t("onboarding.aria.steps")}>
    <div class="mobile-step-summary">
      <div class="mobile-step-heading">
        <div>
          <p>{t("onboarding.progress.setup")}</p>
          <strong><span data-mobile-progress-completed>0</span>{t("onboarding.progress.mobile_suffix", { total: WIZARD_STEPS.length })}</strong>
        </div>
        <span class="mobile-step-status" data-mobile-step-status data-status="not_started">{t("onboarding.progress.not_started")}</span>
      </div>
      <p class="mobile-current-step"><span data-mobile-current-number>01</span> · <strong data-mobile-current-label>{wizardSteps[0]?.label}</strong></p>
      <details class="mobile-step-selector" data-mobile-step-selector>
        <summary>{t("onboarding.aria.steps")} <span aria-hidden="true">⌄</span></summary>
        <ol>
          {wizardSteps.map((step, index) => (
            <li>
              <button
                type="button"
                data-step-button={step.code}
                data-mobile-step-button
                aria-controls={`onboarding-step-${step.code}`}
                aria-current={index === 0 ? "step" : undefined}
              >
                <span>{step.number}</span>
                <strong>{step.label}</strong>
                <i data-step-indicator aria-hidden="true"></i>
              </button>
            </li>
          ))}
        </ol>
      </details>
    </div>

    <nav class="step-rail" id="onboarding-step-list" aria-label={t("onboarding.aria.progress")}>
      <ol>
        {wizardSteps.map((step, index) => (
          <li>
            <button
              type="button"
              id={`onboarding-step-trigger-${step.code}`}
              data-step-button={step.code}
              aria-controls={`onboarding-step-${step.code}`}
              aria-current={index === 0 ? "step" : undefined}
            >
              <span>{step.number}</span>
              <strong>{step.label}</strong>
              <i data-step-indicator aria-hidden="true"></i>
            </button>
          </li>
        ))}
      </ol>
      <div class="rail-note">
        <strong>{t("onboarding.rail.note_title")}</strong>
        <p>{t("onboarding.rail.note_copy")}</p>
      </div>
    </nav>

    <div class="step-stage">
      <article class="step-panel" id="onboarding-step-shop" role="region" aria-labelledby="onboarding-step-trigger-shop" data-step-panel="shop">
        <header class="panel-heading">
          <p><span>{wizardSteps[0]?.number}</span> {t("onboarding.step.shop")}</p>
          <h2>{t("onboarding.shop.title")}</h2>
          <p>{t("onboarding.shop.description")}</p>
        </header>

        <div class="existing-shop" data-existing-shop-block hidden={shops.length === 0}>
          <label for="onboarding-shop-select">{t("onboarding.shop.existing")}</label>
          <div class="select-row">
            <select id="onboarding-shop-select" data-shop-select>
              {shops.map((shop) => <option value={shop.publicId}>{shop.name} — {shop.slug}</option>)}
            </select>
            <button type="button" class="secondary-action" data-refresh-shop>{t("onboarding.button.refresh")}</button>
          </div>
          <p class="selection-summary" data-shop-summary>{initialShop === undefined ? "" : `${initialShop.slug}.${platformBaseDomain} · ${initialShop.planCode}`}</p>
          <form class="shop-rename-form" data-shop-rename-form hidden novalidate>
            <label for="onboarding-shop-name">{t("onboarding.form.rename_label")}</label>
            <div class="select-row">
              <input id="onboarding-shop-name" name="name" type="text" autocomplete="organization" minlength="2" maxlength="80" required data-shop-rename-name />
              <button type="submit" class="secondary-action" data-shop-rename-submit>{t("onboarding.button.save_name")}</button>
            </div>
            <small>{t("onboarding.form.rename_note")}</small>
          </form>
        </div>

        <details class="create-shop-box" open={shops.length === 0} hidden={shops.length > 0} data-create-shop-box>
          <summary>{shops.length === 0 ? t("onboarding.shop.create_first") : t("onboarding.shop.create_more")}</summary>
          <form class="form-grid" data-shop-form novalidate>
            <label class="field field-wide">
              <span>{t("onboarding.form.name_label")}</span>
              <input name="name" type="text" autocomplete="organization" minlength="2" maxlength="80" placeholder={t("onboarding.form.name_placeholder")} required data-shop-name />
            </label>
            <label class="field">
              <span>{t("onboarding.form.slug_label")}</span>
              <input name="slug" type="text" autocomplete="off" autocapitalize="none" spellcheck="false" minlength="3" maxlength="48" pattern="[a-z0-9](?:[a-z0-9-]*[a-z0-9])?" placeholder={t("onboarding.form.slug_placeholder")} required data-shop-slug />
              <small data-slug-preview>slug.{platformBaseDomain}</small>
            </label>
            <label class="field">
              <span>{t("onboarding.form.plan_label")}</span>
              <select name="planCode" data-shop-plan>
                <option value="starter">{t("onboarding.form.plan_starter")}</option>
                <option value="pro">{t("onboarding.form.plan_pro")}</option>
              </select>
              <small data-plan-summary>{t("onboarding.form.plan_loading")}</small>
            </label>
            <label class="field">
              <span>{t("onboarding.form.merchant_country")}</span>
              <input name="merchantCountry" type="text" inputmode="text" autocapitalize="characters" maxlength="2" pattern="[A-Za-z]{2}" placeholder="US" data-shop-merchant-country />
              <small>{t("onboarding.form.country_note")}</small>
            </label>
            <label class="field">
              <span>{t("onboarding.form.business_country")}</span>
              <input name="businessCountry" type="text" inputmode="text" autocapitalize="characters" maxlength="2" pattern="[A-Za-z]{2}" placeholder="US" data-shop-business-country />
            </label>
            <label class="field">
              <span>{t("onboarding.form.currency")}</span>
              <select name="currency" data-shop-currency>
                {SUPPORTED_CURRENCY_CODES.map((code) => <option value={code} selected={code === (initialShop?.currency ?? defaultCurrency)}>{code}</option>)}
              </select>
            </label>
            <label class="field">
              <span>{t("onboarding.form.default_locale")}</span>
              <select name="defaultLocale" data-shop-default-locale>
                <option value="en" selected={(initialShop?.defaultLocale ?? defaultLocale) === "en"}>English</option>
                <option value="vi-VN" selected={(initialShop?.defaultLocale ?? defaultLocale) === "vi-VN"}>Tiếng Việt</option>
              </select>
            </label>
            <div class="form-actions field-wide">
              <p>{t("onboarding.form.slug_reserved")}</p>
              <button type="submit" class="primary-action" data-shop-submit>{t("onboarding.button.create_shop")}</button>
            </div>
          </form>
        </details>
        <footer class="panel-footer"><button type="button" class="next-action" data-next-step="channels">{t("onboarding.button.next_channels")} <span>→</span></button></footer>
      </article>

      <article class="step-panel" id="onboarding-step-channels" role="region" aria-labelledby="onboarding-step-trigger-channels" data-step-panel="channels" hidden>
        <header class="panel-heading">
          <p><span>{wizardSteps[1]?.number}</span> {t("onboarding.step.channels")}</p>
          <h2>{t("onboarding.channels.title")}</h2>
          <p>{t("onboarding.channels.description")}</p>
        </header>
        <form data-channels-form novalidate>
          <fieldset class="choice-grid">
            <legend class="sr-only">{t("onboarding.channels.legend")}</legend>
            <label class="choice-card">
              <input type="checkbox" name="websiteEnabled" data-channel-website />
              <span class="choice-number">WEB</span>
              <strong>{t("onboarding.channels.website")}</strong>
              <small>{t("onboarding.channels.website_copy")}</small>
            </label>
            <label class="choice-card">
              <input type="checkbox" name="telegramEnabled" data-channel-telegram />
              <span class="choice-number">BOT</span>
              <strong>{t("onboarding.channels.telegram")}</strong>
              <small>{t("onboarding.channels.telegram_copy")}</small>
            </label>
          </fieldset>
          <label class="field domain-preference">
            <span>{t("onboarding.channels.domain_label")}</span>
            <select name="customDomainPreference" data-domain-preference>
              <option value="later">{t("onboarding.channels.domain_later")}</option>
              <option value="connect">{t("onboarding.channels.domain_connect")}</option>
              <option value="skip">{t("onboarding.channels.domain_skip")}</option>
            </select>
          </label>
          <div class="form-actions">
            <p data-channel-entitlement>{t("onboarding.channels.entitlement")}</p>
            <button type="submit" class="primary-action" data-channels-submit>{t("onboarding.button.save_channels")}</button>
          </div>
        </form>
        <footer class="panel-footer"><button type="button" class="next-action" data-next-step="catalog">{t("onboarding.button.next_catalog")} <span>→</span></button></footer>
      </article>

      <article class="step-panel" id="onboarding-step-catalog" role="region" aria-labelledby="onboarding-step-trigger-catalog" data-step-panel="catalog" hidden>
        <header class="panel-heading">
          <p><span>{wizardSteps[2]?.number}</span> {t("onboarding.step.catalog")}</p>
          <h2>{t("onboarding.catalog.title")}</h2>
          <p>{t("onboarding.catalog.description")}</p>
        </header>
        <div class="catalog-summary" data-catalog-summary>
          <p>{t("onboarding.catalog.summary_loading")}</p>
        </div>
        <form class="form-grid" data-product-form novalidate>
          <label class="field field-wide">
            <span>{t("onboarding.catalog.product_label")}</span>
            <input name="title" type="text" minlength="2" maxlength="120" placeholder="Windows 11 Pro" required data-product-title />
          </label>
          <label class="field">
            <span>{t("onboarding.catalog.product_slug_label")}</span>
            <input name="productSlug" type="text" autocomplete="off" autocapitalize="none" spellcheck="false" minlength="2" maxlength="80" pattern="[a-z0-9](?:[a-z0-9-]*[a-z0-9])?" placeholder="windows-11-pro" required data-product-slug />
          </label>
          <label class="field">
            <span>{t("onboarding.catalog.fulfillment_label")}</span>
            <select name="fulfillmentType" data-fulfillment-type>
              <option value="license_key">{t("onboarding.catalog.fulfillment_license")}</option>
              <option value="manual">{t("onboarding.catalog.fulfillment_manual")}</option>
            </select>
          </label>
          <label class="field field-wide">
            <span>{t("onboarding.catalog.description_label")}</span>
            <textarea name="description" rows="3" maxlength="10000" placeholder={t("onboarding.catalog.description_placeholder")} data-product-description></textarea>
          </label>
          <label class="field">
            <span>SKU</span>
            <input name="sku" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="64" pattern="[A-Za-z0-9][A-Za-z0-9._-]*" placeholder="WIN11-PRO" required data-product-sku />
          </label>
          <label class="field">
            <span>{t("onboarding.catalog.variant_label")}</span>
            <input name="variantTitle" type="text" minlength="2" maxlength="120" value={t("onboarding.catalog.variant_default")} required data-variant-title />
          </label>
          <label class="field">
            <span data-product-price-label>{t("onboarding.catalog.price_label", { currency: initialShop?.currency ?? "—" })}</span>
            <input name="priceMajor" type="number" inputmode="decimal" min="0" step={initialShop === undefined ? "1" : currencyInputStep(initialShop.currency)} placeholder={initialShop === undefined ? "0" : formatMinorAmountForInput(199000, initialShop.currency)} required data-product-price />
          </label>
          <div class="form-actions field-wide">
            <p>{t("onboarding.catalog.price_note")}</p>
            <button type="submit" class="primary-action" data-product-submit>{t("onboarding.button.create_product")}</button>
          </div>
        </form>
        <footer class="panel-footer"><button type="button" class="next-action" data-next-step="inventory">{t("onboarding.button.next_inventory")} <span>→</span></button></footer>
      </article>

      <article class="step-panel" id="onboarding-step-inventory" role="region" aria-labelledby="onboarding-step-trigger-inventory" data-step-panel="inventory" hidden>
        <header class="panel-heading">
          <p><span>{wizardSteps[3]?.number}</span> {t("onboarding.step.inventory")}</p>
          <h2>{t("onboarding.inventory.title")}</h2>
          <p>{t("onboarding.inventory.description")}</p>
        </header>
        <form data-inventory-form novalidate>
          <div class="form-grid">
            <label class="field">
              <span>{t("onboarding.form.inventory_variant")}</span>
              <select name="variantId" required data-inventory-variant><option value="">{t("onboarding.catalog.select_variant")}</option></select>
            </label>
            <label class="field">
              <span>{t("onboarding.form.inventory_source")}</span>
              <select name="source" data-inventory-source><option value="paste">{t("onboarding.form.inventory_paste")}</option><option value="csv">{t("onboarding.form.inventory_csv")}</option></select>
            </label>
            <label class="field field-wide secret-area">
              <span>{t("onboarding.form.inventory_data")}</span>
              <textarea name="data" rows="8" spellcheck="false" autocomplete="off" placeholder={t("onboarding.form.inventory_placeholder")} required data-inventory-data></textarea>
              <small>{t("onboarding.form.inventory_note")}</small>
            </label>
          </div>
          <div class="preview-strip" data-inventory-preview aria-live="polite" aria-atomic="true">
            <div><span>{t("onboarding.form.preview_total")}</span><strong data-preview-total>0</strong></div>
            <div><span>{t("onboarding.form.preview_accepted")}</span><strong data-preview-accepted>0</strong></div>
            <div><span>{t("onboarding.form.preview_duplicate")}</span><strong data-preview-duplicate>0</strong></div>
            <div><span>{t("onboarding.form.preview_rejected")}</span><strong data-preview-rejected>0</strong></div>
          </div>
          <div class="form-actions split-actions">
            <p data-preview-expiry>{t("onboarding.inventory.preview_not_created")}</p>
            <div><button type="button" class="secondary-action" data-inventory-preview-button>{t("onboarding.button.preview")}</button><button type="submit" class="primary-action" data-inventory-confirm disabled>{t("onboarding.button.confirm_import")}</button></div>
          </div>
        </form>
        <footer class="panel-footer"><button type="button" class="next-action" data-next-step="telegram">{t("onboarding.button.next_telegram")} <span>→</span></button></footer>
      </article>

      <article class="step-panel" id="onboarding-step-telegram" role="region" aria-labelledby="onboarding-step-trigger-telegram" data-step-panel="telegram" hidden>
        <header class="panel-heading">
          <p><span>{wizardSteps[4]?.number}</span> {t("onboarding.step.telegram")}</p>
          <h2>{t("onboarding.telegram.title")}</h2>
          <p>{t("onboarding.telegram.description")}</p>
        </header>
        <div class="integration-card" data-telegram-status><p>{t("onboarding.integration.telegram.loading")}</p></div>
        <form class="credential-form" data-telegram-form novalidate>
          <label class="field secret-area">
            <span>{t("onboarding.form.telegram_token")}</span>
            <input name="botToken" type="password" autocomplete="new-password" spellcheck="false" placeholder={t("onboarding.form.telegram_placeholder")} required data-telegram-token />
          </label>
          <div class="form-actions">
            <p>{t("onboarding.form.telegram_note")}</p>
            <button type="submit" class="primary-action" data-telegram-submit>{t("onboarding.button.connect_bot")}</button>
          </div>
        </form>
        <div class="health-action"><button type="button" class="secondary-action" data-telegram-health>{t("onboarding.button.check_connection")}</button><p>{t("onboarding.form.telegram_health_note")}</p></div>
        <footer class="panel-footer"><button type="button" class="next-action" data-next-step="payos">{t("onboarding.button.next_payos")} <span>→</span></button></footer>
      </article>

      <article class="step-panel" id="onboarding-step-payos" role="region" aria-labelledby="onboarding-step-trigger-payos" data-step-panel="payos" hidden>
        <header class="panel-heading">
          <p><span>{wizardSteps[5]?.number}</span> {t("onboarding.step.payos")}</p>
          <h2>{t("onboarding.payos.title")}</h2>
          <p>{t("onboarding.payos.description")}</p>
        </header>
        <div class="integration-card" data-payos-status><p>{t("onboarding.integration.payos.loading")}</p></div>
        <form class="credential-form" data-payos-form novalidate>
          <div class="form-grid">
            <label class="field field-wide secret-area"><span>{t("onboarding.form.payos_client")}</span><input name="clientId" type="password" autocomplete="new-password" required data-payos-client-id /></label>
            <label class="field secret-area"><span>{t("onboarding.form.payos_api")}</span><input name="apiKey" type="password" autocomplete="new-password" required data-payos-api-key /></label>
            <label class="field secret-area"><span>{t("onboarding.form.payos_checksum")}</span><input name="checksumKey" type="password" autocomplete="new-password" required data-payos-checksum-key /></label>
          </div>
          <div class="provider-warning"><strong>{t("onboarding.form.payos_warning_title")}</strong><p>{t("onboarding.form.payos_warning_copy")}</p></div>
          <div class="form-actions"><p>{t("onboarding.form.payos_note")}</p><button type="submit" class="primary-action" data-payos-submit>{t("onboarding.button.verify_connect")}</button></div>
        </form>
        <div class="health-action"><button type="button" class="secondary-action" data-payos-health>{t("onboarding.button.check_payos")}</button><p data-payos-health-copy>{t("onboarding.form.payos_health_note")}</p></div>
        <footer class="panel-footer"><button type="button" class="next-action" data-next-step="settings">{t("onboarding.button.next_settings")} <span>→</span></button></footer>
      </article>

      <article class="step-panel" id="onboarding-step-settings" role="region" aria-labelledby="onboarding-step-trigger-settings" data-step-panel="settings" hidden>
        <header class="panel-heading">
          <p><span>{wizardSteps[6]?.number}</span> {t("onboarding.step.settings")}</p>
          <h2>{t("onboarding.settings.title")}</h2>
          <p>{t("onboarding.settings.description")}</p>
        </header>
        <form class="form-grid" data-settings-form novalidate>
          <fieldset class="field-wide settings-globalization">
            <legend>{t("onboarding.form.globalization_legend")}</legend>
            <div class="form-grid">
              <label class="field"><span>{t("onboarding.form.merchant_country")}</span><input name="merchantCountry" type="text" inputmode="text" autocapitalize="characters" maxlength="2" pattern="[A-Za-z]{2}" data-settings-merchant-country /><small>{t("onboarding.form.country_note")}</small></label>
              <label class="field"><span>{t("onboarding.form.business_country")}</span><input name="businessCountry" type="text" inputmode="text" autocapitalize="characters" maxlength="2" pattern="[A-Za-z]{2}" data-settings-business-country /></label>
              <label class="field"><span>{t("onboarding.form.currency")}</span><select name="currency" data-settings-currency>{SUPPORTED_CURRENCY_CODES.map((code) => <option value={code}>{code}</option>)}</select></label>
              <label class="field"><span>{t("onboarding.form.default_locale")}</span><select name="defaultLocale" data-settings-default-locale><option value="en">English</option><option value="vi-VN">Tiếng Việt</option></select></label>
            </div>
          </fieldset>
          <label class="field field-wide"><span>{t("onboarding.form.support")}</span><input name="supportContact" type="text" minlength="3" maxlength="180" placeholder={t("onboarding.form.support_placeholder")} required data-support-contact /></label>
          <label class="field"><span>{t("onboarding.form.terms")}</span><input name="termsUrl" type="url" inputmode="url" maxlength="512" placeholder="https://example.com/terms" required data-terms-url /></label>
          <label class="field"><span>{t("onboarding.form.privacy")}</span><input name="privacyUrl" type="url" inputmode="url" maxlength="512" placeholder="https://example.com/privacy" required data-privacy-url /></label>
          <label class="field field-wide"><span>{t("onboarding.form.refund")}</span><input name="refundPolicyUrl" type="url" inputmode="url" maxlength="512" placeholder="https://example.com/refund" required data-refund-url /></label>
          <label class="attestation field-wide"><input name="attestationAccepted" type="checkbox" required data-attestation /><span>{t("onboarding.form.attestation")}</span></label>
          <div class="domain-callout field-wide">
            <div><strong>{t("onboarding.form.domain_optional_title")}</strong><p>{t("onboarding.form.domain_optional_copy")}</p></div>
            <a href={initialShop === undefined ? "/app/domains" : `/app/domains?shop=${encodeURIComponent(initialShop.publicId)}`} data-domain-management-link>{t("onboarding.form.domain_link")}</a>
          </div>
          <div class="form-actions field-wide"><p>{t("onboarding.form.audit_note")}</p><button type="submit" class="primary-action" data-settings-submit>{t("onboarding.button.save_settings")}</button></div>
        </form>
        <footer class="panel-footer"><button type="button" class="next-action" data-next-step="readiness">{t("onboarding.button.next_readiness")} <span>→</span></button></footer>
      </article>

      <article class="step-panel readiness-panel" id="onboarding-step-readiness" role="region" aria-labelledby="onboarding-step-trigger-readiness" data-step-panel="readiness" hidden>
        <header class="panel-heading">
          <p><span>{wizardSteps[7]?.number}</span> {t("onboarding.readiness.eyebrow")}</p>
          <h2>{t("onboarding.readiness.title")}</h2>
          <p>{t("onboarding.readiness.description")}</p>
        </header>
        <div class="readiness-command">
          <div><strong data-readiness-title>{t("onboarding.readiness.not_run")}</strong><p data-readiness-meta>{t("onboarding.readiness.choose_shop")}</p></div>

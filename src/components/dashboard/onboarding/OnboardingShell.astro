---
import OnboardingPreviewDrawer from "./OnboardingPreviewDrawer.astro";
import OnboardingStepConnect from "./OnboardingStepConnect.astro";
import OnboardingStepInventory from "./OnboardingStepInventory.astro";
import OnboardingStepLaunch from "./OnboardingStepLaunch.astro";
import OnboardingStepProduct from "./OnboardingStepProduct.astro";
import OnboardingStepStore from "./OnboardingStepStore.astro";

type ShopView = {
  name: string;
  publicId: string;
  role: string;
  slug: string;
};

type Props = {
  csrfCookieName: string;
  defaultCurrency?: string;
  defaultLocale?: string;
  displayName: string;
  email: string;
  platformBaseDomain: string;
  shops: ShopView[];
};

const {
  csrfCookieName,
  defaultCurrency = "VND",
  defaultLocale = "vi-VN",
  displayName,
  email,
  platformBaseDomain,
  shops,
} = Astro.props;

const initialShop = shops[0];

const steps = [
  { code: "store", label: "Cửa hàng" },
  { code: "product", label: "Sản phẩm" },
  { code: "inventory", label: "Kho key" },
  { code: "connect", label: "Kết nối" },
  { code: "launch", label: "Mở bán" },
] as const;
---

<div
  class="onboarding-v2-shell"
  data-quickstart-root
  data-csrf-cookie-name={csrfCookieName}
  data-platform-base-domain={platformBaseDomain}
  data-default-currency={defaultCurrency}
  data-default-locale={defaultLocale}
  data-shops={JSON.stringify(shops)}
  data-active-shop-public-id={initialShop?.publicId ?? ""}
>
  <!-- Top navigation bar -->
  <header class="v2-topbar">
    <div class="v2-topbar-inner">
      <div class="topbar-brand">
        <a href="/app" class="brand-link" aria-label="Selinow">
          <img src="/brand/logo/selinow-logo-primary.svg" alt="Selinow" width="100" height="28" />
        </a>
        <span class="topbar-mode-badge">Thiết lập</span>
      </div>

      <!-- Progress bar -->
      <div class="topbar-progress-section" aria-label="Tiến trình thiết lập">
        <div class="progress-track" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
          <div class="progress-fill" data-progress-fill></div>
        </div>
        <div class="progress-step-labels" aria-hidden="true">
          {steps.map((step, i) => (
            <span class="progress-label-item" data-progress-label={step.code}>
              {i + 1}. {step.label}
            </span>
          ))}
        </div>
      </div>

      <div class="topbar-user">
        <span class="user-avatar" title={displayName}>{displayName.trim().charAt(0).toUpperCase() || "S"}</span>
        <span class="user-email">{email}</span>
        <a href="/app" class="btn-exit" title="Lưu tiến trình và vào Dashboard">
          Dashboard ↗
        </a>
      </div>
    </div>
  </header>

  <!-- Toast notification -->
  <div class="v2-toast" data-onboarding-toast role="status" aria-live="polite" hidden></div>

  <!-- Main step content area -->
  <main class="v2-main">
    <div class="v2-step-container">
      <OnboardingStepStore
        defaultCurrency={defaultCurrency}
        defaultLocale={defaultLocale}
        initialShopName={initialShop?.name}
        initialShopSlug={initialShop?.slug}
        platformBaseDomain={platformBaseDomain}
        shopsCount={shops.length}
      />
      <OnboardingStepProduct defaultCurrency={defaultCurrency} />
      <OnboardingStepInventory />
      <OnboardingStepConnect />
      <OnboardingStepLaunch platformBaseDomain={platformBaseDomain} />
    </div>
  </main>

  <!-- Preview drawer -->
  <OnboardingPreviewDrawer
    defaultCurrency={defaultCurrency}
    initialShopName={initialShop?.name}
    initialShopSlug={initialShop?.slug}
    platformBaseDomain={platformBaseDomain}
  />
</div>

<script>
  import "../../../scripts/dashboard/onboarding-quickstart";
</script>

<style>
  :global(*) { box-sizing: border-box; }

  :global(body) {
    margin: 0;
    min-width: 320px;
    min-height: 100vh;
    background: var(--sln-bg-canvas);
    color: var(--sln-text-primary);
    font-family: var(--sln-font-sans);
  }

  .onboarding-v2-shell {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background: var(--sln-bg-canvas);
  }

  /* ---- Top bar ---- */
  .v2-topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--sln-bg-surface);
    border-bottom: 1px solid var(--sln-border-default);
    box-shadow: var(--sln-shadow-xs);
  }

  .v2-topbar-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 12px 32px;
  }

  .topbar-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .brand-link {
    display: flex;
    text-decoration: none;
  }

  .topbar-mode-badge {
    padding: 2px 10px;
    border-radius: var(--sln-radius-pill);
    background: var(--sln-tint-primary);
    color: var(--sln-action-primary);
    font-size: 10px;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ---- Progress bar ---- */
  .topbar-progress-section {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .progress-track {
    width: 100%;
    height: 6px;
    border-radius: var(--sln-radius-pill);
    background: var(--sln-border-strong);
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--sln-action-primary), #06b6d4);
    width: 0%;
    transition: width 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .progress-step-labels {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }

  .progress-label-item {
    font-size: 11px;
    font-weight: 600;
    color: var(--sln-text-muted);
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .progress-label-item.active {
    color: var(--sln-action-primary);
    font-weight: 700;
  }

  .progress-label-item.done {
    color: var(--sln-state-success);
  }

  /* ---- User & exit ---- */
  .topbar-user {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }

  .user-avatar {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--sln-tint-primary);
    color: var(--sln-action-primary);
    font-size: 13px;
    font-weight: 750;
    flex-shrink: 0;
  }

  .user-email {
    font-size: 12px;
    color: var(--sln-text-muted);
  }

  .btn-exit {
    display: inline-flex;
    align-items: center;
    padding: 7px 14px;
    border: 1px solid var(--sln-border-strong);
    border-radius: var(--sln-radius-pill);
    background: var(--sln-bg-surface);
    color: var(--sln-text-secondary);
    font-size: 12px;
    font-weight: 650;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-exit:hover {
    background: var(--sln-bg-subtle);
    color: var(--sln-text-primary);
    border-color: var(--sln-action-primary);
  }

  /* ---- Toast ---- */
  .v2-toast {
    position: fixed;
    top: 72px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    min-width: 320px;
    max-width: 90%;
    padding: 12px 20px;
    border-radius: var(--sln-radius-md);
    font-size: 13px;
    font-weight: 600;
    box-shadow: var(--sln-shadow-lg);
    animation: toastSlideDown 0.25s ease;
  }

  @keyframes toastSlideDown {
    from { opacity: 0; transform: translate(-50%, -10px); }
    to { opacity: 1; transform: translate(-50%, 0); }
  }

  .v2-toast[data-tone="success"] {
    background: var(--sln-tint-success);
    color: var(--sln-state-success);
    border: 1px solid color-mix(in srgb, var(--sln-state-success) 30%, transparent);
  }

  .v2-toast[data-tone="error"] {
    background: var(--sln-tint-danger);
    color: var(--sln-state-danger);
    border: 1px solid color-mix(in srgb, var(--sln-state-danger) 30%, transparent);
  }

  /* ---- Main content ---- */
  .v2-main {
    flex: 1;
    padding: 40px 32px 80px;
    overflow: hidden;
  }

  .v2-step-container {
    max-width: 720px;
    margin: 0 auto;
    position: relative;
  }

  /* Step pane animation system — :global because panes are rendered by child components */
  :global(.onboarding-step-pane) {
    display: none;
    flex-direction: column;
    gap: 24px;
  }

  :global(.onboarding-step-pane.is-active) {
    display: flex;
    animation: stepEnter 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  :global(.onboarding-step-pane.is-exiting-left) {
    display: flex;
    animation: stepExitLeft 0.25s ease forwards;
  }

  :global(.onboarding-step-pane.is-exiting-right) {
    display: flex;
    animation: stepExitRight 0.25s ease forwards;
  }

  @keyframes stepEnter {
    from {
      opacity: 0;
      transform: translateX(40px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes stepExitLeft {
    from {
      opacity: 1;
      transform: translateX(0);
    }
    to {
      opacity: 0;
      transform: translateX(-40px);
    }
  }

  @keyframes stepExitRight {
    from {
      opacity: 1;
      transform: translateX(0);
    }
    to {
      opacity: 0;
      transform: translateX(40px);
    }
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .v2-topbar-inner {
      padding: 10px 16px;
      gap: 12px;
    }

    .progress-step-labels {
      display: none;
    }

    .user-email {
      display: none;
    }

    .v2-main {
      padding: 24px 16px 64px;
    }
  }

  @media (max-width: 600px) {
    .v2-topbar-inner {
      flex-wrap: wrap;
    }

    .topbar-progress-section {
      order: 3;
      flex-basis: 100%;
    }

    .v2-main {
      padding: 16px 12px 56px;
    }
  }
</style>

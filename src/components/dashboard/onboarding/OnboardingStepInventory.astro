---
import Icon from "../../console/Icon.astro";
---

<div class="onboarding-step-pane" data-step-pane="inventory">
  <!-- 3D Hero Banner -->
  <div class="step-hero-card">
    <div class="hero-content">
      <span class="hero-step-pill">BƯỚC 3 / 5</span>
      <h2>Nhập kho Mã Kích Hoạt (License Keys)</h2>
      <p>Nạp sẵn danh sách key vào két bảo mật số để hệ thống tự động trả ngay cho khách hàng 24/7 sau khi họ thanh toán thành công.</p>
    </div>
    <div class="hero-image-wrap">
      <img src="/illustrations/onboarding-inventory.jpg" alt="" class="hero-illustration" width="130" height="130" />
    </div>
  </div>

  <!-- Quick Action Bar -->
  <div class="inventory-quick-actions">
    <button type="button" class="btn-sample-keys" data-action-generate-sample-keys>
      <Icon name="zap" size={16} />
      <span>Nạp nhanh 5 Key Thử Nghiệm Mẫu</span>
    </button>
    <span class="or-separator">hoặc dán danh sách key thực tế của bạn vào ô dưới</span>
  </div>

  <form class="step-form-grid" data-inventory-form novalidate>
    <div class="form-group full-width">
      <div class="label-with-count">
        <label for="inventory-keys-input">Danh sách License Keys (Mỗi dòng 1 key) <span class="required-star">*</span></label>
        <span class="keys-count-badge" data-inventory-count-badge>0 key trong kho</span>
      </div>
      <div class="textarea-keys-wrap">
        <textarea
          id="inventory-keys-input"
          name="keysData"
          rows="6"
          spellcheck="false"
          placeholder="W269N-WFGWX-YVC9B-4J6C9-T83GX
VK7JG-NPHTM-C97JM-9MPGT-3V66T
MH37W-N47XK-V7XM9-C7227-GCQG9"
          data-input-inventory-keys
        ></textarea>
      </div>
      <div class="security-vault-note">
        <Icon name="lock" size={15} />
        <span>Toàn bộ key được mã hóa phong bì cấp quân sự (AES-256-GCM + Cloudflare KMS) trước khi lưu vào D1 Database.</span>
      </div>
    </div>

    <!-- Live Parser Strip -->
    <div class="keys-metrics-strip full-width" data-inventory-metrics>
      <div class="metric-item">
        <span class="metric-label">Tổng dòng nhận</span>
        <strong class="metric-value" data-metric-total>0</strong>
      </div>
      <div class="metric-item highlight-success">
        <span class="metric-label">Key hợp lệ</span>
        <strong class="metric-value" data-metric-valid>0</strong>
      </div>
      <div class="metric-item">
        <span class="metric-label">Trùng lặp / Trống</span>
        <strong class="metric-value" data-metric-duplicate>0</strong>
      </div>
    </div>
  </form>

  <div class="step-actions split-actions full-width">
    <button type="button" class="btn-secondary-back" data-step-back="product">
      ← Quay lại
    </button>
    <div class="right-actions">
      <button type="button" class="btn-skip-link" data-step-skip="inventory">
        Nhập kho sau
      </button>
      <button type="button" class="btn-primary-next" data-step-submit="inventory">
        <span data-btn-label>Tiếp Tục: Kết Nối Cổng Thanh Toán</span>
        <span class="btn-arrow" aria-hidden="true">→</span>
      </button>
    </div>
  </div>
</div>

<style>
  .onboarding-step-pane {
    display: none;
    flex-direction: column;
    gap: 24px;
  }

  .onboarding-step-pane.is-active {
    display: flex;
  }

  /* 3D Hero Card */
  .step-hero-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 24px 28px;
    border-radius: var(--sln-console-radius-container, 16px);
    background: linear-gradient(135deg, #FFFFFF 0%, #F5F3FF 100%);
    border: 2px solid #E5E0F0;
    box-shadow: 0 4px 20px rgba(108, 92, 231, 0.06);
  }

  .hero-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hero-step-pill {
    align-self: flex-start;
    padding: 3px 10px;
    border-radius: var(--sln-console-radius-pill, 999px);
    background: #6C5CE7;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .hero-content h2 {
    margin: 0;
    font-size: clamp(20px, 3vw, 24px);
    font-weight: 700;
    color: #101828;
    letter-spacing: -0.02em;
  }

  .hero-content p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: #475467;
  }

  .hero-image-wrap {
    flex-shrink: 0;
  }

  .hero-illustration {
    border-radius: 12px;
    object-fit: cover;
    box-shadow: 0 4px 12px rgba(108, 92, 231, 0.12);
  }

  /* Quick Actions */
  .inventory-quick-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn-sample-keys {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border: 1.5px dashed #6C5CE7;
    border-radius: 999px;
    background: #F0EDFC;
    color: #6C5CE7;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .btn-sample-keys:hover {
    background: #F0EDFC;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(108, 92, 231, 0.15);
  }

  .or-separator {
    font-size: 12.5px;
    color: #667085;
  }

  /* Form */
  .step-form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .label-with-count {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  label {
    font-size: 13.5px;
    font-weight: 700;
    color: #101828;
  }

  .keys-count-badge {
    font-size: 12px;
    font-weight: 700;
    color: #6C5CE7;
    background: #F0EDFC;
    padding: 2px 8px;
    border-radius: 999px;
  }

  .textarea-keys-wrap textarea {
    width: 100%;
    border: 2px solid #E5E0F0;
    border-radius: 12px;
    padding: 12px 16px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 13.5px;
    line-height: 1.6;
    color: #101828;
    background: #FFFFFF;
    transition: all 0.15s ease;
  }

  .textarea-keys-wrap textarea:focus {
    outline: none;
    border-color: #6C5CE7;
    box-shadow: 0 0 0 3px rgba(108, 92, 231, 0.15);
  }

  .security-vault-note {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: #0E9F6E;
    font-weight: 500;
  }

  /* Metrics Strip */
  .keys-metrics-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    padding: 14px 18px;
    border-radius: 12px;
    background: #F8FAFC;
    border: 2px solid #E5E0F0;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .metric-label {
    font-size: 11.5px;
    color: #667085;
    font-weight: 600;
  }

  .metric-value {
    font-size: 18px;
    font-weight: 800;
    color: #101828;
    font-variant-numeric: tabular-nums;
  }

  .highlight-success .metric-value {
    color: #0E9F6E;
  }

  /* Actions */
  .step-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
  }

  .split-actions {
    justify-content: space-between;
  }

  .right-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .btn-skip-link {
    background: transparent;
    border: none;
    color: #667085;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    padding: 8px 14px;
    text-decoration: underline;
    transition: color 0.15s ease;
  }

  .btn-skip-link:hover {
    color: #101828;
  }

  .btn-secondary-back {
    padding: 12px 22px;
    border-radius: 999px;
    background: #FFFFFF;
    border: 2px solid #E5E0F0;
    color: #344054;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-secondary-back:hover {
    background: #F9FAFB;
    border-color: #98A2B3;
  }

  .btn-primary-next {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    border-radius: 999px;
    background: #6C5CE7;
    color: #FFFFFF;
    border: none;
    font-size: 14.5px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(108, 92, 231, 0.35);
    transition: all 0.18s ease;
  }

  .btn-primary-next:hover {
    background: #5546CF;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(108, 92, 231, 0.45);
  }

  @media (max-width: 768px) {
    .step-hero-card {
      flex-direction: column-reverse;
      text-align: center;
      padding: 20px 16px;
    }

    .hero-step-pill {
      align-self: center;
    }

    .keys-metrics-strip {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>

---
import Icon from "../../console/Icon.astro";
import type { StorefrontVertical } from "../../../lib/storefront/templates";

type Props = {
  initialVertical?: string;
};

const { initialVertical = "digital" } = Astro.props;
const activeVertical: StorefrontVertical = initialVertical === "physical" || initialVertical === "booking" ? initialVertical : "digital";

// Per-vertical inventory copy (OB-A3): digital shops stock license keys,
// physical shops stock serial/SKU codes, booking services need no vault.
const inventoryConfig: Record<StorefrontVertical, {
  heroDesc: string;
  heroTitle: string;
  label: string;
  metricValid: string;
  orSeparator: string;
  placeholder: string;
  sampleBtn: string;
  skipLabel: string;
  submitLabel: string;
  unitBadge: string;
  vaultNote: string;
}> = {
  booking: {
    heroDesc: "Sản phẩm dịch vụ được xác nhận theo khung giờ khách chọn — không cần nhập kho. Bạn có thể bổ sung khung giờ hoạt động sau trong Dashboard.",
    heroTitle: "Dịch vụ theo lịch hẹn — không cần kho",
    label: "",
    metricValid: "",
    orSeparator: "",
    placeholder: "",
    sampleBtn: "",
    skipLabel: "Bỏ qua",
    submitLabel: "Tiếp Tục: Kết Nối Cổng Thanh Toán",
    unitBadge: "không cần kho",
    vaultNote: "",
  },
  digital: {
    heroDesc: "Nạp sẵn danh sách key vào két bảo mật số để hệ thống tự động trả ngay cho khách hàng 24/7 sau khi họ thanh toán thành công.",
    heroTitle: "Nhập kho Mã Kích Hoạt (License Keys)",
    label: "Danh sách License Keys (Mỗi dòng 1 key)",
    metricValid: "Key hợp lệ",
    orSeparator: "hoặc dán danh sách key thực tế của bạn vào ô dưới",
    placeholder: "W269N-WFGWX-YVC9B-4J6C9-T83GX\nVK7JG-NPHTM-C97JM-9MPGT-3V66T\nMH37W-N47XK-V7XM9-C7227-GCQG9",
    sampleBtn: "Nạp nhanh 5 Key Thử Nghiệm Mẫu",
    skipLabel: "Nhập kho sau",
    submitLabel: "Tiếp Tục: Kết Nối Cổng Thanh Toán",
    unitBadge: "key trong kho",
    vaultNote: "Toàn bộ key được mã hóa phong bì (AES-256-GCM + Cloudflare KMS) trước khi lưu vào D1 Database.",
  },
  physical: {
    heroDesc: "Dán mã serial / SKU của từng món hàng để hệ thống trừ đúng tồn kho mỗi khi có đơn; bạn cũng có thể bỏ qua và quản lý tồn kho sau trong Dashboard.",
    heroTitle: "Nhập kho & Mã Hàng Hoá",
    label: "Danh sách mã serial / SKU (Mỗi dòng 1 mã)",
    metricValid: "Mã hợp lệ",
    orSeparator: "hoặc dán mã serial / SKU thực tế của bạn vào ô dưới",
    placeholder: "TEE-LOCAL-0001\nTEE-LOCAL-0002\nTEE-LOCAL-0003",
    sampleBtn: "Tạo nhanh 5 mã hàng thử nghiệm",
    skipLabel: "Nhập kho sau",
    submitLabel: "Tiếp Tục: Kết Nối Cổng Thanh Toán",
    unitBadge: "mã trong kho",
    vaultNote: "Mã hàng được mã hoá và đối chiếu từng đơn giống hệt kho key số (AES-256-GCM + Cloudflare KMS).",
  },
};
const config = inventoryConfig[activeVertical];
const isKeyless = activeVertical === "booking";
---

<div class="onboarding-step-pane" data-step-pane="inventory" data-inventory-config={JSON.stringify(inventoryConfig)} data-active-vertical={activeVertical}>
  <!-- 3D Hero Banner -->
  <div class="step-hero-card">
    <div class="hero-content">
      <span class="hero-step-pill">BƯỚC 3 / 5</span>
      <h2 data-inv-hero-title>{config.heroTitle}</h2>
      <p data-inv-hero-desc>{config.heroDesc}</p>
    </div>
    <div class="hero-image-wrap">
      <img src="/illustrations/onboarding-inventory.jpg" alt="" class="hero-illustration" width="130" height="130" />
    </div>
  </div>

  <!-- Booking: services run on appointment slots, no vault needed -->
  <div class="keyless-info-box" data-inventory-keyless-panel hidden={!isKeyless}>
    <div class="keyless-icon"><Icon name="calendar" size={28} /></div>
    <div class="keyless-body">
      <strong>Dịch vụ của bạn không cần nhập kho</strong>
      <p>Khách chọn khung giờ trống trên storefront, hệ thống chặn trùng lịch và xác nhận thanh toán. Khung giờ làm việc có thể tinh chỉnh sau trong Dashboard.</p>
    </div>
  </div>

  <!-- Quick Action Bar -->
  <div class="inventory-quick-actions" data-inventory-key-section hidden={isKeyless}>
    <button type="button" class="btn-sample-keys" data-action-generate-sample-keys>
      <Icon name="zap" size={16} />
      <span data-inv-sample-btn>{config.sampleBtn}</span>
    </button>
    <span class="or-separator" data-inv-or-separator>{config.orSeparator}</span>
  </div>

  <form class="step-form-grid" data-inventory-form novalidate>
    <div class="form-group full-width" data-inventory-key-section hidden={isKeyless}>
      <div class="label-with-count">
        <label for="inventory-keys-input" data-inv-label>{config.label} <span class="required-star">*</span></label>
        <span class="keys-count-badge" data-inventory-count-badge>0 {config.unitBadge}</span>
      </div>
      <div class="textarea-keys-wrap">
        <textarea
          id="inventory-keys-input"
          name="keysData"
          rows="6"
          spellcheck="false"
          placeholder={config.placeholder}
          data-input-inventory-keys
        ></textarea>
      </div>
      <div class="security-vault-note">
        <Icon name="lock" size={15} />
        <span data-inv-vault-note>{config.vaultNote}</span>
      </div>
    </div>

    <!-- Live Parser Strip -->
    <div class="keys-metrics-strip full-width" data-inventory-metrics data-inventory-key-section hidden={isKeyless}>
      <div class="metric-item">
        <span class="metric-label">Tổng dòng nhận</span>
        <strong class="metric-value" data-metric-total>0</strong>
      </div>
      <div class="metric-item highlight-success">
        <span class="metric-label" data-inv-metric-valid>{config.metricValid}</span>
        <strong class="metric-value" data-metric-valid>0</strong>
      </div>
      <div class="metric-item">
        <span class="metric-label">Trùng lặp / Trống</span>
        <strong class="metric-value" data-metric-duplicate>0</strong>
      </div>
    </div>
  </form>

  <div class="step-actions split-actions full-width">
    <button type="button" class="btn-secondary-back" data-step-back="product">
      ← Quay lại
    </button>
    <div class="right-actions">
      <button type="button" class="btn-skip-link" data-step-skip="inventory" data-inv-skip-label>
        {config.skipLabel}
      </button>
      <button type="button" class="btn-primary-next" data-step-submit="inventory">
        <span data-btn-label data-inv-submit-label>{config.submitLabel}</span>
        <span class="btn-arrow" aria-hidden="true">→</span>
      </button>
    </div>
  </div>
</div>

<style>
  .onboarding-step-pane {
    display: none;
    flex-direction: column;
    gap: 24px;
  }

  .onboarding-step-pane.is-active {
    display: flex;
  }

  /* Booking vertical: no-vault info panel */
  .keyless-info-box {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 20px 24px;
    border-radius: 14px;
    border: 2px solid #BBF7D0;
    background: #F0FDF4;
  }

  .keyless-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: #DCFCE7;
    color: #166534;
    flex-shrink: 0;
  }

  .keyless-body strong {
    display: block;
    font-size: 14.5px;
    font-weight: 700;
    color: #14532D;
    margin-bottom: 4px;
  }

  .keyless-body p {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: #166534;
  }

  /* 3D Hero Card */
  .step-hero-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 24px 28px;
    border-radius: var(--sln-console-radius-container, 16px);
    background: linear-gradient(135deg, #FFFFFF 0%, #F5F3FF 100%);
    border: 2px solid var(--sln-soft-border);
    box-shadow: 0 4px 20px rgba(124, 106, 240, 0.06);
  }

  .hero-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hero-step-pill {
    align-self: flex-start;
    padding: 3px 10px;
    border-radius: var(--sln-console-radius-pill, 999px);
    background: var(--sln-soft-accent);
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .hero-content h2 {
    margin: 0;
    font-size: clamp(20px, 3vw, 24px);
    font-weight: 700;
    color: #101828;
    letter-spacing: -0.02em;
  }

  .hero-content p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: #475467;
  }

  .hero-image-wrap {
    flex-shrink: 0;
  }

  .hero-illustration {
    border-radius: 12px;
    object-fit: cover;
    box-shadow: 0 4px 12px rgba(124, 106, 240, 0.12);
  }

  /* Quick Actions */
  .inventory-quick-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn-sample-keys {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border: 1.5px dashed var(--sln-soft-accent);
    border-radius: 999px;
    background: var(--sln-soft-tint);
    color: var(--sln-soft-accent);
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .btn-sample-keys:hover {
    background: var(--sln-soft-tint);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(124, 106, 240, 0.15);
  }

  .or-separator {
    font-size: 12.5px;
    color: #667085;
  }

  /* Form */
  .step-form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .label-with-count {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  label {
    font-size: 13.5px;
    font-weight: 700;
    color: #101828;
  }

  .keys-count-badge {
    font-size: 12px;
    font-weight: 700;
    color: var(--sln-soft-accent);
    background: var(--sln-soft-tint);
    padding: 2px 8px;
    border-radius: 999px;
  }

  .textarea-keys-wrap textarea {
    width: 100%;
    border: 2px solid var(--sln-soft-border);
    border-radius: 12px;
    padding: 12px 16px;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 13.5px;
    line-height: 1.6;
    color: #101828;
    background: #FFFFFF;
    transition: all 0.15s ease;
  }

  .textarea-keys-wrap textarea:focus {
    outline: none;
    border-color: var(--sln-soft-accent);
    box-shadow: 0 0 0 3px rgba(124, 106, 240, 0.15);
  }

  .security-vault-note {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: #0E9F6E;
    font-weight: 500;
  }

  /* Metrics Strip */
  .keys-metrics-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    padding: 14px 18px;
    border-radius: 12px;
    background: #F8FAFC;
    border: 2px solid var(--sln-soft-border);
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .metric-label {
    font-size: 11.5px;
    color: #667085;
    font-weight: 600;
  }

  .metric-value {
    font-size: 18px;
    font-weight: 800;
    color: #101828;
    font-variant-numeric: tabular-nums;
  }

  .highlight-success .metric-value {
    color: #0E9F6E;
  }

  /* Actions */
  .step-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
  }

  .split-actions {
    justify-content: space-between;
  }

  .right-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .btn-skip-link {
    background: transparent;
    border: none;
    color: #667085;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    padding: 8px 14px;
    text-decoration: underline;
    transition: color 0.15s ease;
  }

  .btn-skip-link:hover {
    color: #101828;
  }

  .btn-secondary-back {
    padding: 12px 22px;
    border-radius: 999px;
    background: #FFFFFF;
    border: 2px solid var(--sln-soft-border);
    color: #344054;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-secondary-back:hover {
    background: #F9FAFB;
    border-color: #98A2B3;
  }

  .btn-primary-next {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    border-radius: 999px;
    background: var(--sln-soft-accent);
    color: #FFFFFF;
    border: none;
    font-size: 14.5px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(124, 106, 240, 0.35);
    transition: all 0.18s ease;
  }

  .btn-primary-next:hover {
    background: var(--sln-soft-accent-strong);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(124, 106, 240, 0.45);
  }

  @media (max-width: 768px) {
    .step-hero-card {
      flex-direction: column-reverse;
      text-align: center;
      padding: 20px 16px;
    }

    .hero-step-pill {
      align-self: center;
    }

    .keys-metrics-strip {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>

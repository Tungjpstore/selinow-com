---
type Props = {
  defaultCurrency?: string;
  initialShopName?: string | undefined;
  initialShopSlug?: string | undefined;
  platformBaseDomain: string;
};

const {
  defaultCurrency = "VND",
  initialShopName = "Cửa Hàng Của Bạn",
  initialShopSlug = "cua-hang",
  platformBaseDomain,
} = Astro.props;
---

<div class="live-preview-card" data-live-preview-root>
  <div class="preview-header">
    <div class="preview-title-wrap">
      <span class="preview-dot"></span>
      <strong class="preview-title">Xem trước trực tiếp (Live Preview)</strong>
    </div>
    <div class="preview-switcher" role="tablist">
      <button type="button" class="preview-tab active" data-preview-mode="web" aria-selected="true" role="tab">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
        <span>Website</span>
      </button>
      <button type="button" class="preview-tab" data-preview-mode="telegram" aria-selected="false" role="tab">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path></svg>
        <span>Telegram Bot</span>
      </button>
    </div>
  </div>

  <div class="preview-viewport-frame">
    <!-- Web Storefront Mockup -->
    <div class="preview-canvas web-canvas" data-canvas="web">
      <div class="browser-bar">
        <div class="browser-dots">
          <span></span><span></span><span></span>
        </div>
        <div class="browser-url">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          <span>https://<strong data-preview-slug>{initialShopSlug}</strong>.{platformBaseDomain}</span>
        </div>
      </div>
      <div class="storefront-mockup-body">
        <header class="mock-nav">
          <div class="mock-logo">
            <span class="mock-logo-icon">⚡</span>
            <strong data-preview-shop-name>{initialShopName}</strong>
          </div>
          <div class="mock-nav-badge">
            <span>Giỏ hàng (0)</span>
          </div>
        </header>

        <div class="mock-hero">
          <span class="mock-badge">Bản quyền chính hãng 24/7</span>
          <h4 data-preview-shop-name>{initialShopName}</h4>
          <p>Nhận key tự động ngay sau khi thanh toán QR chuyển khoản</p>
        </div>

        <div class="mock-product-grid">
          <article class="mock-product-card">
            <div class="mock-product-thumb">
              <span class="mock-product-emoji" data-preview-product-icon>🪟</span>
              <span class="mock-tag" data-preview-fulfillment>Tự động giao key</span>
            </div>
            <div class="mock-product-info">
              <h5 data-preview-product-title>Windows 11 Pro Retail Bản Quyền</h5>
              <p data-preview-product-desc>Khóa kích hoạt bản quyền Windows 11 Pro Retail vĩnh viễn, nhận key và kích hoạt ngay.</p>
              <div class="mock-product-footer">
                <strong class="mock-price" data-preview-product-price>199.000 {defaultCurrency}</strong>
                <button type="button" class="mock-buy-btn" tabindex="-1">Mua ngay</button>
              </div>
            </div>
          </article>
        </div>
      </div>
    </div>

    <!-- Telegram Bot Mockup -->
    <div class="preview-canvas tg-canvas" data-canvas="telegram" hidden>
      <div class="tg-header">
        <div class="tg-bot-avatar">🤖</div>
        <div class="tg-bot-info">
          <strong data-preview-bot-name>Selinow Store Bot</strong>
          <small>bot • trực tuyến</small>
        </div>
      </div>
      <div class="tg-messages-body">
        <div class="tg-message tg-bot-msg">
          <div class="tg-msg-bubble">
            <p>👋 Chào mừng bạn đến với <strong data-preview-shop-name>{initialShopName}</strong>!</p>
            <p>Hệ thống hỗ trợ đặt mua sản phẩm số và nhận mã kích hoạt tự động 100% qua VietQR.</p>
            <hr class="tg-msg-divider" />
            <p>🔥 <strong>Sản phẩm nổi bật:</strong></p>
            <p>• <span data-preview-product-title>Windows 11 Pro Retail Bản Quyền</span> — <span data-preview-product-price>199.000 {defaultCurrency}</span></p>
          </div>
          <div class="tg-inline-keyboard">
            <button type="button" class="tg-btn" tabindex="-1">
              <span>🛒 Mua <span data-preview-product-title-short>Windows 11 Pro</span></span>
            </button>
            <button type="button" class="tg-btn tg-btn-subtle" tabindex="-1">
              <span>📋 Xem danh mục sản phẩm</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .live-preview-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    border: 1px solid var(--sln-border-default);
    border-radius: var(--sln-radius-xl);
    background: var(--sln-bg-surface);
    box-shadow: var(--sln-shadow-md);
    overflow: hidden;
    position: sticky;
    top: 24px;
  }

  .preview-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-bottom: 1px solid var(--sln-border-default);
    background: var(--sln-bg-subtle);
  }

  .preview-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .preview-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sln-state-success);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--sln-state-success) 20%, transparent);
    animation: pulse 2s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .preview-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--sln-text-primary);
  }

  .preview-switcher {
    display: flex;
    background: var(--sln-bg-canvas);
    border: 1px solid var(--sln-border-default);
    border-radius: var(--sln-radius-pill);
    padding: 2px;
  }

  .preview-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border: none;
    border-radius: var(--sln-radius-pill);
    background: transparent;
    color: var(--sln-text-secondary);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .preview-tab.active {
    background: var(--sln-action-primary);
    color: var(--sln-white);
    box-shadow: var(--sln-shadow-xs);
  }

  .preview-viewport-frame {
    padding: 16px;
    background: var(--sln-bg-canvas);
    min-height: 480px;
    display: flex;
    flex-direction: column;
  }

  .preview-canvas {
    border: 1px solid var(--sln-border-strong);
    border-radius: var(--sln-radius-lg);
    background: var(--sln-bg-surface);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    flex: 1;
    box-shadow: var(--sln-shadow-sm);
  }

  /* Web Canvas */
  .browser-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 14px;
    border-bottom: 1px solid var(--sln-border-default);
    background: var(--sln-bg-subtle);
  }

  .browser-dots {
    display: flex;
    gap: 5px;
  }

  .browser-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sln-slate-300);
  }

  .browser-dots span:nth-child(1) { background: #ef4444; }
  .browser-dots span:nth-child(2) { background: #f59e0b; }
  .browser-dots span:nth-child(3) { background: #10b981; }

  .browser-url {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--sln-bg-surface);
    border: 1px solid var(--sln-border-default);
    border-radius: var(--sln-radius-sm);
    padding: 4px 10px;
    font-size: 11px;
    color: var(--sln-text-muted);
    font-family: var(--sln-font-mono);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .browser-url strong {
    color: var(--sln-action-primary);
  }

  .storefront-mockup-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .mock-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--sln-border-default);
  }

  .mock-logo {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--sln-text-primary);
  }

  .mock-logo-icon {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: var(--sln-radius-sm);
    background: var(--sln-tint-primary);
    color: var(--sln-action-primary);
    font-size: 13px;
  }

  .mock-nav-badge {
    font-size: 11px;
    padding: 4px 10px;
    border-radius: var(--sln-radius-pill);
    background: var(--sln-bg-subtle);
    color: var(--sln-text-secondary);
    font-weight: 600;
  }

  .mock-hero {
    padding: 12px 14px;
    border-radius: var(--sln-radius-md);
    background: linear-gradient(135deg, color-mix(in srgb, var(--sln-action-primary) 10%, transparent), transparent);
    border: 1px solid color-mix(in srgb, var(--sln-action-primary) 20%, transparent);
  }

  .mock-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--sln-radius-pill);
    background: var(--sln-tint-success);
    color: var(--sln-state-success);
    font-size: 10px;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .mock-hero h4 {
    margin: 0 0 4px;
    font-size: 16px;
    font-weight: 700;
    color: var(--sln-text-primary);
  }

  .mock-hero p {
    margin: 0;
    font-size: 11px;
    color: var(--sln-text-secondary);
  }

  .mock-product-grid {
    display: grid;
    gap: 12px;
  }

  .mock-product-card {
    border: 1px solid var(--sln-border-default);
    border-radius: var(--sln-radius-md);
    padding: 12px;
    background: var(--sln-bg-surface);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mock-product-thumb {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--sln-bg-subtle);
    border-radius: var(--sln-radius-sm);
    padding: 10px 12px;
  }

  .mock-product-emoji {
    font-size: 24px;
  }

  .mock-tag {
    font-size: 10px;
    padding: 2px 8px;
    border-radius: var(--sln-radius-pill);
    background: var(--sln-tint-info);
    color: var(--sln-state-info);
    font-weight: 600;
  }

  .mock-product-info h5 {
    margin: 0 0 4px;
    font-size: 13px;
    font-weight: 700;
    color: var(--sln-text-primary);
  }

  .mock-product-info p {
    margin: 0 0 10px;
    font-size: 11px;
    color: var(--sln-text-muted);
    line-height: 1.4;
  }

  .mock-product-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 8px;
    border-top: 1px dashed var(--sln-border-default);
  }

  .mock-price {
    font-size: 14px;
    font-weight: 750;
    color: var(--sln-state-success);
  }

  .mock-buy-btn {
    padding: 6px 14px;
    border-radius: var(--sln-radius-pill);
    background: var(--sln-action-primary);
    color: var(--sln-white);
    border: none;
    font-size: 11px;
    font-weight: 700;
    cursor: default;
  }

  /* Telegram Canvas */
  .tg-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: #24A1DE;
    color: white;
  }

  .tg-bot-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    display: grid;
    place-items: center;
    font-size: 18px;
  }

  .tg-bot-info {
    display: flex;
    flex-direction: column;
  }

  .tg-bot-info strong {
    font-size: 13px;
    font-weight: 600;
  }

  .tg-bot-info small {
    font-size: 10px;
    opacity: 0.85;
  }

  .tg-messages-body {
    padding: 16px 12px;
    background: #0e1621;
    color: #f5f5f5;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .tg-bot-msg {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 92%;
  }

  .tg-msg-bubble {
    background: #182533;
    padding: 12px 14px;
    border-radius: 12px 12px 12px 2px;
    font-size: 12px;
    line-height: 1.5;
  }

  .tg-msg-bubble p {
    margin: 0 0 6px;
  }

  .tg-msg-bubble p:last-child {
    margin-bottom: 0;
  }

  .tg-msg-divider {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin: 8px 0;
  }

  .tg-inline-keyboard {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .tg-btn {
    padding: 9px 12px;
    border-radius: 8px;
    background: #2b5278;
    color: #64b5f6;
    border: none;
    font-size: 12px;
    font-weight: 600;
    text-align: center;
    cursor: default;
  }

  .tg-btn-subtle {
    background: rgba(255, 255, 255, 0.08);
    color: #e0e0e0;
  }
</style>

---
import { ONBOARDING_PRODUCT_PRESETS } from "../../../lib/onboarding/presets";
import type { StorefrontVertical } from "../../../lib/storefront/templates";
import Icon from "../../console/Icon.astro";

type Props = {
  defaultCurrency?: string;
  initialVertical?: string;
};

const { defaultCurrency = "VND", initialVertical = "digital" } = Astro.props;

const activeVertical: StorefrontVertical = initialVertical === "physical" || initialVertical === "booking" ? initialVertical : "digital";

// Presets are vertical-scoped (OB-A2): each selling category only offers its
// own samples. One map powers the client swap when the seller changes
// category in step 1.
const presetsMap: Record<StorefrontVertical, typeof ONBOARDING_PRODUCT_PRESETS> = {
  booking: ONBOARDING_PRODUCT_PRESETS.filter((preset) => preset.vertical === "booking"),
  digital: ONBOARDING_PRODUCT_PRESETS.filter((preset) => preset.vertical === "digital"),
  physical: ONBOARDING_PRODUCT_PRESETS.filter((preset) => preset.vertical === "physical"),
};
const initialPresets = presetsMap[activeVertical];

// Per-vertical copy + form defaults; applied server-side for the initial
// vertical and re-applied by the client on category change (OB-A3).
const productConfig: Record<StorefrontVertical, {
  customDescDefault: string;
  customDescPlaceholder: string;
  customTitleDefault: string;
  customTitlePlaceholder: string;
  fulfillmentLabel: string;
  fulfillmentOptions: Array<{ label: string; value: string }>;
  heroDesc: string;
  heroTitle: string;
  presetsSublabel: string;
  priceDefault: number;
  submitLabel: string;
}> = {
  booking: {
    customDescDefault: "Buổi tư vấn 1-1 kéo dài 60 phút qua video call về chiến lược bán hàng số, đặt lịch theo khung giờ bạn chọn.",
    customDescPlaceholder: "Thời lượng, phạm vi công việc, kết quả nhận được...",
    customTitleDefault: "Tư Vấn 1-1 Trực Tuyến (60 phút)",
    customTitlePlaceholder: "Ví dụ: Buổi tư vấn 1-1, Khóa học trực tuyến...",
    fulfillmentLabel: "Hình thức xác nhận & hoàn thành",
    fulfillmentOptions: [{ label: "📅 Khách đặt lịch — xác nhận và hoàn thành thủ công", value: "manual" }],
    heroDesc: "Chọn mẫu dịch vụ có sẵn hoặc tự tạo với giá và mô tả; khách đặt lịch trực tiếp trên trang của bạn.",
    heroTitle: "Thêm Dịch vụ Đầu tiên",
    presetsSublabel: "Chọn một mẫu dưới đây để tự động điền giá và mô tả dịch vụ:",
    priceDefault: 500000,
    submitLabel: "Tiếp Tục: Kết Nối Thanh Toán",
  },
  digital: {
    customDescDefault: "Khóa kích hoạt bản quyền Windows 11 Pro Retail vĩnh viễn, nhận key và kích hoạt ngay.",
    customDescPlaceholder: "Thời hạn, quyền lợi và bảo hành...",
    customTitleDefault: "Windows 11 Pro Retail Bản Quyền",
    customTitlePlaceholder: "Ví dụ: Windows 11 Pro Bản Quyền, Netflix 1 Tháng...",
    fulfillmentLabel: "Hình thức giao hàng",
    fulfillmentOptions: [
      { label: "⚡ Giao License Key / Mã thẻ tự động 24/7", value: "license_key" },
      { label: "📁 Giao thủ công (Tài khoản / Link tải / Liên hệ)", value: "manual" },
    ],
    heroDesc: "Chọn nhanh một mẫu sản phẩm bán chạy có sẵn (được cấu hình sẵn giá, mô tả và kho key) hoặc tự tạo sản phẩm của riêng bạn.",
    heroTitle: "Thêm Sản phẩm Đầu tiên",
    presetsSublabel: "Chọn một mẫu dưới đây để tự động điền giá, mô tả & nạp key thử nghiệm:",
    priceDefault: 199000,
    submitLabel: "Tiếp Tục: Quản Lý Kho Key",
  },
  physical: {
    customDescDefault: "Áo thun cotton 100% form regular unisex, in ấn theo thiết kế riêng, giao toàn quốc.",
    customDescPlaceholder: "Chất liệu, kích cỡ, chính sách đổi trả...",
    customTitleDefault: "Áo Thun Local Brand Unisex",
    customTitlePlaceholder: "Ví dụ: Áo thun local brand, Ốp lưng điện thoại...",
    fulfillmentLabel: "Hình thức giao hàng",
    fulfillmentOptions: [{ label: "🚚 Giao hàng vận chuyển — xử lý từng đơn thủ công", value: "manual" }],
    heroDesc: "Chọn mẫu sản phẩm vật lý có sẵn hoặc tự tạo với giá, mô tả và hình thức giao hàng.",
    heroTitle: "Thêm Sản phẩm Đầu tiên",
    presetsSublabel: "Chọn một mẫu dưới đây để tự động điền giá và mô tả sản phẩm:",
    priceDefault: 250000,
    submitLabel: "Tiếp Tục: Kết Nối Thanh Toán",
  },
};
const config = productConfig[activeVertical];
---

<div class="onboarding-step-pane" data-step-pane="product" data-product-config={JSON.stringify(productConfig)} data-presets-map={JSON.stringify(presetsMap)} data-active-vertical={activeVertical}>
  <!-- 3D Hero Banner -->
  <div class="step-hero-card">
    <div class="hero-content">
      <span class="hero-step-pill">BƯỚC 2 / 5</span>
      <h2 data-product-hero-title>{config.heroTitle}</h2>
      <p data-product-hero-desc>{config.heroDesc}</p>
    </div>
    <div class="hero-image-wrap">
      <img src="/illustrations/onboarding-product.jpg" alt="" class="hero-illustration" width="130" height="130" />
    </div>
  </div>

  <!-- Mode Switcher -->
  <div class="product-mode-tabs" role="tablist" aria-label="Chế độ tạo sản phẩm">
    <button type="button" class="mode-tab active" data-product-mode="preset" role="tab" aria-selected="true">
      <Icon name="zap" size={16} />
      <span>Chọn Mẫu Có Sẵn (Khuyên Dùng)</span>
    </button>
    <button type="button" class="mode-tab" data-product-mode="custom" role="tab" aria-selected="false">
      <Icon name="plus" size={16} />
      <span>Tự Nhập Sản Phẩm Mới</span>
    </button>
  </div>

  <!-- Presets Grid — renders only the active category's samples -->
  <div class="presets-section" data-presets-container>
    <div class="presets-header-row">
      <p class="section-sublabel" data-presets-sublabel>{config.presetsSublabel}</p>
    </div>
    <div class="presets-grid" data-presets-grid>
      {initialPresets.map((preset, index) => (
        <button
          type="button"
          class={`preset-card ${index === 0 ? "selected" : ""}`}
          data-preset-card={preset.id}
          data-preset-title={preset.title}
          data-preset-price={preset.priceMinor}
          data-preset-currency={preset.currency}
          data-preset-icon={preset.icon}
          data-preset-fulfillment={preset.fulfillmentType}
          data-preset-desc={preset.description}
        >
          <span class="preset-icon"><Icon name={preset.icon} size={22} /></span>
          <div class="preset-details">
            <strong class="preset-title">{preset.title}</strong>
            <span class="preset-price">{preset.priceMinor.toLocaleString("vi-VN")} {preset.currency}</span>
            <span class="preset-type-badge">
              {preset.fulfillmentType === "license_key" ? "⚡ Giao key tự động" : preset.vertical === "booking" ? "📅 Dịch vụ đặt lịch" : "🚚 Giao hàng thủ công"}
            </span>
          </div>
          <span class="preset-badge-check">✓</span>
        </button>
      ))}
    </div>
  </div>

  <!-- Custom Product Form -->
  <form class="step-form-grid" data-product-form hidden novalidate>
    <div class="form-group full-width">
      <label for="product-title-input">Tên sản phẩm <span class="required-star">*</span></label>
      <input
        id="product-title-input"
        name="title"
        type="text"
        minlength="2"
        maxlength="120"
        placeholder={config.customTitlePlaceholder}
        value={config.customTitleDefault}
        required
        data-input-product-title
      />
    </div>

    <div class="form-group">
      <label for="product-price-input">Giá bán ({defaultCurrency}) <span class="required-star">*</span></label>
      <input
        id="product-price-input"
        name="price"
        type="number"
        min="0"
        step="1000"
        placeholder="199000"
        value={config.priceDefault}
        required
        data-input-product-price
      />
    </div>

    <div class="form-group">
      <label for="product-fulfillment-select" data-fulfillment-label>{config.fulfillmentLabel}</label>
      <select id="product-fulfillment-select" name="fulfillmentType" data-input-product-fulfillment>
        {config.fulfillmentOptions.map((option) => (
          <option value={option.value} selected={option.value === config.fulfillmentOptions[0]?.value}>{option.label}</option>
        ))}
      </select>
    </div>

    <div class="form-group full-width">
      <label for="product-desc-input">Mô tả ngắn sản phẩm</label>
      <textarea
        id="product-desc-input"
        name="description"
        rows="2"
        maxlength="500"
        placeholder={config.customDescPlaceholder}
        data-input-product-desc
      >{config.customDescDefault}</textarea>
    </div>
  </form>

  <div class="step-actions split-actions full-width">
    <button type="button" class="btn-secondary-back" data-step-back="store">
      ← Quay lại
    </button>
    <button type="button" class="btn-primary-next" data-step-submit="product">
      <span data-btn-label data-product-submit-label>{config.submitLabel}</span>
      <span class="btn-arrow" aria-hidden="true">→</span>
    </button>
  </div>
</div>

<style>
  .onboarding-step-pane {
    display: none;
    flex-direction: column;
    gap: 24px;
  }

  .onboarding-step-pane.is-active {
    display: flex;
  }

  /* 3D Hero Card */
  .step-hero-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 24px 28px;
    border-radius: var(--sln-console-radius-container, 16px);
    background: linear-gradient(135deg, #FFFFFF 0%, #F5F3FF 100%);
    border: 2px solid var(--sln-soft-border);
    box-shadow: 0 4px 20px rgba(124, 106, 240, 0.06);
  }

  .hero-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hero-step-pill {
    align-self: flex-start;
    padding: 3px 10px;
    border-radius: var(--sln-console-radius-pill, 999px);
    background: var(--sln-soft-accent-strong);
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .hero-content h2 {
    margin: 0;
    font-size: clamp(20px, 3vw, 24px);
    font-weight: 700;
    color: #101828;
    letter-spacing: -0.02em;
  }

  .hero-content p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: #475467;
  }

  .hero-image-wrap {
    flex-shrink: 0;
  }

  .hero-illustration {
    border-radius: 12px;
    object-fit: cover;
    box-shadow: 0 4px 12px rgba(124, 106, 240, 0.12);
  }

  /* Mode Tabs */
  .product-mode-tabs {
    display: flex;
    gap: 8px;
    background: #F2F4F7;
    padding: 4px;
    border-radius: 12px;
    border: 2px solid var(--sln-soft-border);
  }

  .mode-tab {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 16px;
    border: none;
    border-radius: 9px;
    background: transparent;
    color: #475467;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .mode-tab:hover {
    color: #101828;
  }

  .mode-tab.active {
    background: #FFFFFF;
    color: var(--sln-soft-accent);
    box-shadow: 0 2px 8px rgba(16, 24, 40, 0.08);
  }

  /* Presets Section */
  .presets-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .section-sublabel {
    margin: 0;
    font-size: 13px;
    color: #475467;
    font-weight: 500;
  }

  .presets-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
  }

  .preset-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    border: 2px solid var(--sln-soft-border);
    border-radius: 14px;
    background: #FFFFFF;
    text-align: start;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .preset-card:hover {
    border-color: var(--sln-soft-border-strong);
    background: var(--sln-soft-surface);
    transform: translateY(-1px);
  }

  .preset-card.selected {
    border-color: var(--sln-soft-accent);
    background: var(--sln-soft-tint);
    box-shadow: 0 0 0 1px var(--sln-soft-accent), 0 4px 12px rgba(124, 106, 240, 0.1);
  }

  .preset-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--sln-soft-tint);
    color: var(--sln-soft-accent);
  }

  .preset-details {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
  }

  .preset-title {
    font-size: 14px;
    font-weight: 700;
    color: #101828;
    line-height: 1.35;
  }

  .preset-price {
    font-size: 13.5px;
    font-weight: 800;
    color: var(--sln-soft-accent);
    font-variant-numeric: tabular-nums;
  }

  .preset-type-badge {
    align-self: flex-start;
    padding: 2px 8px;
    border-radius: 4px;
    background: #F2F4F7;
    color: #475467;
    font-size: 11px;
    font-weight: 600;
  }

  .preset-card.selected .preset-type-badge {
    background: var(--sln-soft-tint);
    color: var(--sln-soft-accent);
  }

  .preset-badge-check {
    position: absolute;
    top: 12px;
    inset-inline-end: 12px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--sln-soft-accent);
    color: #FFFFFF;
    display: grid;
    place-items: center;
    font-size: 11px;
    font-weight: 800;
    opacity: 0;
    transform: scale(0.6);
    transition: all 0.18s ease;
  }

  .preset-card.selected .preset-badge-check {
    opacity: 1;
    transform: scale(1);
  }

  /* Form Elements */
  .step-form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group.full-width {
    grid-column: 1 / -1;
  }

  label {
    font-size: 13px;
    font-weight: 600;
    color: #344054;
  }

  .required-star {
    color: #E02424;
  }

  input, select, textarea {
    width: 100%;
    border: 2px solid var(--sln-soft-border);
    border-radius: var(--sln-console-radius, 8px);
    background: #FFFFFF;
    padding: 10px 14px;
    font-size: 14px;
    color: #101828;
    transition: all 0.15s ease;
  }

  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--sln-soft-accent);
    box-shadow: 0 0 0 3px rgba(124, 106, 240, 0.15);
  }

  /* Action Buttons */
  .step-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
  }

  .split-actions {
    justify-content: space-between;
  }

  .btn-secondary-back {
    padding: 12px 22px;
    border-radius: 999px;
    background: #FFFFFF;
    border: 2px solid var(--sln-soft-border);
    color: #344054;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-secondary-back:hover {
    background: #F9FAFB;
    border-color: #98A2B3;
  }

  .btn-primary-next {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    border-radius: 999px;
    background: var(--sln-soft-accent);
    color: #FFFFFF;
    border: none;
    font-size: 14.5px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(124, 106, 240, 0.35);
    transition: all 0.18s ease;
  }

  .btn-primary-next:hover {
    background: var(--sln-soft-accent-strong);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(124, 106, 240, 0.45);
  }

  @media (max-width: 768px) {
    .step-hero-card {
      flex-direction: column-reverse;
      text-align: center;
      padding: 20px 16px;
    }

    .hero-step-pill {
      align-self: center;
    }

    .presets-grid {
      grid-template-columns: 1fr;
    }

    .step-form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

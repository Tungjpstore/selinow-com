---
import { ONBOARDING_PRODUCT_PRESETS } from "../../../lib/onboarding/presets";
import Icon from "../../console/Icon.astro";

type Props = {
  defaultCurrency?: string;
};

const { defaultCurrency = "VND" } = Astro.props;
---

<div class="onboarding-step-pane" data-step-pane="product">
  <!-- 3D Hero Banner -->
  <div class="step-hero-card">
    <div class="hero-content">
      <span class="hero-step-pill">BƯỚC 2 / 5</span>
      <h2>Thêm Sản phẩm Đầu tiên</h2>
      <p>Chọn nhanh một mẫu sản phẩm bán chạy có sẵn (được cấu hình sẵn giá, mô tả và kho key) hoặc tự tạo sản phẩm của riêng bạn.</p>
    </div>
    <div class="hero-image-wrap">
      <img src="/illustrations/onboarding-product.jpg" alt="" class="hero-illustration" width="130" height="130" />
    </div>
  </div>

  <!-- Mode Switcher -->
  <div class="product-mode-tabs" role="tablist" aria-label="Chế độ tạo sản phẩm">
    <button type="button" class="mode-tab active" data-product-mode="preset" role="tab" aria-selected="true">
      <Icon name="zap" size={16} />
      <span>Chọn Mẫu Có Sẵn (Khuyên Dùng)</span>
    </button>
    <button type="button" class="mode-tab" data-product-mode="custom" role="tab" aria-selected="false">
      <Icon name="plus" size={16} />
      <span>Tự Nhập Sản Phẩm Mới</span>
    </button>
  </div>

  <!-- Presets Grid -->
  <div class="presets-section" data-presets-container>
    <div class="presets-header-row">
      <p class="section-sublabel">Chọn một mẫu dưới đây để tự động điền giá, mô tả & nạp key thử nghiệm:</p>
    </div>
    <div class="presets-grid">
      {ONBOARDING_PRODUCT_PRESETS.map((preset, index) => (
        <button
          type="button"
          class={`preset-card ${index === 0 ? "selected" : ""}`}
          data-preset-card={preset.id}
          data-preset-title={preset.title}
          data-preset-price={preset.priceMinor}
          data-preset-currency={preset.currency}
          data-preset-icon={preset.icon}
          data-preset-fulfillment={preset.fulfillmentType}
          data-preset-desc={preset.description}
          data-preset-sample-keys={JSON.stringify(preset.sampleKeys)}
        >
          <span class="preset-icon"><Icon name={preset.icon} size={22} /></span>
          <div class="preset-details">
            <strong class="preset-title">{preset.title}</strong>
            <span class="preset-price">{preset.priceMinor.toLocaleString("vi-VN")} {preset.currency}</span>
            <span class="preset-type-badge">
              {preset.fulfillmentType === "license_key" ? "⚡ Giao key tự động" : "📁 Giao thủ công"}
            </span>
          </div>
          <span class="preset-badge-check">✓</span>
        </button>
      ))}
    </div>
  </div>

  <!-- Custom Product Form -->
  <form class="step-form-grid" data-product-form hidden novalidate>
    <div class="form-group full-width">
      <label for="product-title-input">Tên sản phẩm <span class="required-star">*</span></label>
      <input
        id="product-title-input"
        name="title"
        type="text"
        minlength="2"
        maxlength="120"
        placeholder="Ví dụ: Windows 11 Pro Bản Quyền, Netflix 1 Tháng..."
        value="Windows 11 Pro Retail Bản Quyền"
        required
        data-input-product-title
      />
    </div>

    <div class="form-group">
      <label for="product-price-input">Giá bán ({defaultCurrency}) <span class="required-star">*</span></label>
      <input
        id="product-price-input"
        name="price"
        type="number"
        min="0"
        step="1000"
        placeholder="199000"
        value="199000"
        required
        data-input-product-price
      />
    </div>

    <div class="form-group">
      <label for="product-fulfillment-select">Hình thức giao hàng <span class="required-star">*</span></label>
      <select id="product-fulfillment-select" name="fulfillmentType" data-input-product-fulfillment>
        <option value="license_key" selected>⚡ Giao License Key / Mã thẻ tự động 24/7</option>
        <option value="manual">📁 Giao thủ công (Tài khoản / Link tải / Liên hệ)</option>
      </select>
    </div>

    <div class="form-group full-width">
      <label for="product-desc-input">Mô tả ngắn sản phẩm</label>
      <textarea
        id="product-desc-input"
        name="description"
        rows="2"
        maxlength="500"
        placeholder="Thời hạn, quyền lợi và bảo hành..."
        data-input-product-desc
      >Khóa kích hoạt bản quyền Windows 11 Pro Retail vĩnh viễn, nhận key và kích hoạt ngay.</textarea>
    </div>
  </form>

  <div class="step-actions split-actions full-width">
    <button type="button" class="btn-secondary-back" data-step-back="store">
      ← Quay lại
    </button>
    <button type="button" class="btn-primary-next" data-step-submit="product">
      <span data-btn-label>Tiếp Tục: Quản Lý Kho Key</span>
      <span class="btn-arrow" aria-hidden="true">→</span>
    </button>
  </div>
</div>

<style>
  .onboarding-step-pane {
    display: none;
    flex-direction: column;
    gap: 24px;
  }

  .onboarding-step-pane.is-active {
    display: flex;
  }

  /* 3D Hero Card */
  .step-hero-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 24px 28px;
    border-radius: var(--sln-console-radius-container, 16px);
    background: linear-gradient(135deg, #FFFFFF 0%, #F5F3FF 100%);
    border: 2px solid var(--sln-soft-border);
    box-shadow: 0 4px 20px rgba(124, 106, 240, 0.06);
  }

  .hero-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hero-step-pill {
    align-self: flex-start;
    padding: 3px 10px;
    border-radius: var(--sln-console-radius-pill, 999px);
    background: var(--sln-soft-accent);
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .hero-content h2 {
    margin: 0;
    font-size: clamp(20px, 3vw, 24px);
    font-weight: 700;
    color: #101828;
    letter-spacing: -0.02em;
  }

  .hero-content p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: #475467;
  }

  .hero-image-wrap {
    flex-shrink: 0;
  }

  .hero-illustration {
    border-radius: 12px;
    object-fit: cover;
    box-shadow: 0 4px 12px rgba(124, 106, 240, 0.12);
  }

  /* Mode Tabs */
  .product-mode-tabs {
    display: flex;
    gap: 8px;
    background: #F2F4F7;
    padding: 4px;
    border-radius: 12px;
    border: 2px solid var(--sln-soft-border);
  }

  .mode-tab {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 16px;
    border: none;
    border-radius: 9px;
    background: transparent;
    color: #475467;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .mode-tab:hover {
    color: #101828;
  }

  .mode-tab.active {
    background: #FFFFFF;
    color: var(--sln-soft-accent);
    box-shadow: 0 2px 8px rgba(16, 24, 40, 0.08);
  }

  /* Presets Section */
  .presets-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .section-sublabel {
    margin: 0;
    font-size: 13px;
    color: #475467;
    font-weight: 500;
  }

  .presets-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
  }

  .preset-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    border: 2px solid var(--sln-soft-border);
    border-radius: 14px;
    background: #FFFFFF;
    text-align: start;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .preset-card:hover {
    border-color: var(--sln-soft-border-strong);
    background: var(--sln-soft-surface);
    transform: translateY(-1px);
  }

  .preset-card.selected {
    border-color: var(--sln-soft-accent);
    background: var(--sln-soft-tint);
    box-shadow: 0 0 0 1px var(--sln-soft-accent), 0 4px 12px rgba(124, 106, 240, 0.1);
  }

  .preset-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--sln-soft-tint);
    color: var(--sln-soft-accent);
  }

  .preset-details {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
  }

  .preset-title {
    font-size: 14px;
    font-weight: 700;
    color: #101828;
    line-height: 1.35;
  }

  .preset-price {
    font-size: 13.5px;
    font-weight: 800;
    color: var(--sln-soft-accent);
    font-variant-numeric: tabular-nums;
  }

  .preset-type-badge {
    align-self: flex-start;
    padding: 2px 8px;
    border-radius: 4px;
    background: #F2F4F7;
    color: #475467;
    font-size: 11px;
    font-weight: 600;
  }

  .preset-card.selected .preset-type-badge {
    background: var(--sln-soft-tint);
    color: var(--sln-soft-accent);
  }

  .preset-badge-check {
    position: absolute;
    top: 12px;
    inset-inline-end: 12px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--sln-soft-accent);
    color: #FFFFFF;
    display: grid;
    place-items: center;
    font-size: 11px;
    font-weight: 800;
    opacity: 0;
    transform: scale(0.6);
    transition: all 0.18s ease;
  }

  .preset-card.selected .preset-badge-check {
    opacity: 1;
    transform: scale(1);
  }

  /* Form Elements */
  .step-form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group.full-width {
    grid-column: 1 / -1;
  }

  label {
    font-size: 13px;
    font-weight: 600;
    color: #344054;
  }

  .required-star {
    color: #E02424;
  }

  input, select, textarea {
    width: 100%;
    border: 2px solid var(--sln-soft-border);
    border-radius: var(--sln-console-radius, 8px);
    background: #FFFFFF;
    padding: 10px 14px;
    font-size: 14px;
    color: #101828;
    transition: all 0.15s ease;
  }

  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--sln-soft-accent);
    box-shadow: 0 0 0 3px rgba(124, 106, 240, 0.15);
  }

  /* Action Buttons */
  .step-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
  }

  .split-actions {
    justify-content: space-between;
  }

  .btn-secondary-back {
    padding: 12px 22px;
    border-radius: 999px;
    background: #FFFFFF;
    border: 2px solid var(--sln-soft-border);
    color: #344054;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .btn-secondary-back:hover {
    background: #F9FAFB;
    border-color: #98A2B3;
  }

  .btn-primary-next {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    border-radius: 999px;
    background: var(--sln-soft-accent);
    color: #FFFFFF;
    border: none;
    font-size: 14.5px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(124, 106, 240, 0.35);
    transition: all 0.18s ease;
  }

  .btn-primary-next:hover {
    background: var(--sln-soft-accent-strong);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(124, 106, 240, 0.45);
  }

  @media (max-width: 768px) {
    .step-hero-card {
      flex-direction: column-reverse;
      text-align: center;
      padding: 20px 16px;
    }

    .hero-step-pill {
      align-self: center;
    }

    .presets-grid {
      grid-template-columns: 1fr;
    }

    .step-form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

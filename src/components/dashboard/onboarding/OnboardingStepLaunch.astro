---
import Icon from "../../console/Icon.astro";
import ProviderLogo from "../../console/ProviderLogo.astro";

type Props = {
  platformBaseDomain: string;
};

const { platformBaseDomain } = Astro.props;
---

<div class="onboarding-step-pane" data-step-pane="launch">
  <!-- Pre-launch review -->
  <div data-launch-review>
    <!-- 3D Hero Banner -->
    <div class="step-hero-card">
      <div class="hero-content">
        <span class="hero-step-pill">BƯỚC 5 / 5</span>
        <h2>Kiểm tra Sẵn sàng & Mở Bán</h2>
        <p>Kiểm tra danh mục cấu hình, xác nhận kết nối và mở bán cửa hàng trực tuyến của bạn ngay hôm nay.</p>
      </div>
      <div class="hero-image-wrap">
        <img src="/illustrations/onboarding-launch.jpg" alt="" class="hero-illustration" width="130" height="130" />
      </div>
    </div>

    <!-- Configuration summary -->
    <div class="summary-grid">
      <div class="summary-card">
        <span class="summary-icon"><Icon name="store" size={20} /></span>
        <div class="summary-body">
          <small>Cửa hàng</small>
          <strong data-launch-summary-shop>Cửa hàng của bạn</strong>
          <span class="summary-sub" data-launch-summary-slug>—</span>
        </div>
      </div>
      <div class="summary-card">
        <span class="summary-icon"><Icon name="box" size={20} /></span>
        <div class="summary-body">
          <small>Sản phẩm</small>
          <strong data-launch-summary-product>Chưa tạo</strong>
          <span class="summary-sub" data-launch-summary-keys>0 key trong kho</span>
        </div>
      </div>
      <div class="summary-card" data-launch-card-payos>
        <div class="summary-provider-logo"><ProviderLogo name="payos" size={24} /></div>
        <div class="summary-body">
          <small>Thanh toán PayOS</small>
          <strong data-launch-summary-payos>Chưa kết nối</strong>
        </div>
      </div>
      <div class="summary-card" data-launch-card-telegram>
        <div class="summary-provider-logo"><ProviderLogo name="telegram" size={24} /></div>
        <div class="summary-body">
          <small>Bot Telegram</small>
          <strong data-launch-summary-telegram>Chưa kết nối</strong>
        </div>
      </div>
    </div>

    <!-- Optional settings -->
    <details class="optional-settings">
      <summary>
        <span>Thông tin liên hệ & chính sách <em>(không bắt buộc)</em></span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
      </summary>
      <form class="settings-form" data-launch-settings-form novalidate>
        <div class="form-group">
          <label for="launch-support-input">Liên hệ hỗ trợ</label>
          <input
            id="launch-support-input"
            type="text"
            maxlength="180"
            placeholder="support@example.com hoặc @shop_support"
            data-input-launch-support
          />
          <small class="field-hint">Để người mua biết cách liên hệ khi cần hỗ trợ.</small>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="launch-terms-input">Điều khoản bán hàng (HTTPS)</label>
            <input id="launch-terms-input" type="url" placeholder="https://..." data-input-launch-terms />
          </div>
          <div class="form-group">
            <label for="launch-privacy-input">Chính sách riêng tư (HTTPS)</label>
            <input id="launch-privacy-input" type="url" placeholder="https://..." data-input-launch-privacy />
          </div>
        </div>
        <div class="form-group">
          <label for="launch-refund-input">Chính sách hoàn tiền (HTTPS)</label>
          <input id="launch-refund-input" type="url" placeholder="https://..." data-input-launch-refund />
        </div>
        <button type="submit" class="btn-save-settings" data-btn-save-settings>
          Lưu thông tin
        </button>
      </form>
    </details>

    <!-- Launch checklist -->
    <div class="launch-checklist">
      <div class="checklist-row" data-launch-check="shop">
        <span class="check-dot"></span>
        <span class="check-text">Cửa hàng đã được tạo thành công</span>
      </div>
      <div class="checklist-row" data-launch-check="product">
        <span class="check-dot"></span>
        <span class="check-text">Có ít nhất một sản phẩm khởi đầu</span>
      </div>
      <div class="checklist-row" data-launch-check="inventory">
        <span class="check-dot"></span>
        <span class="check-text">Kho key đã sẵn sàng giao tự động</span>
      </div>
      <div class="checklist-row" data-launch-check="payos">
        <span class="check-dot"></span>
        <span class="check-text">PayOS VietQR đã kết nối nhận tiền</span>
      </div>
      <div class="checklist-row" data-launch-check="telegram">
        <span class="check-dot"></span>
        <span class="check-text">Bot Telegram đã kết nối 24/7</span>
      </div>
    </div>

    <div class="step-actions split-actions full-width">
      <button type="button" class="btn-secondary-back" data-step-back="connect">
        ← Quay lại
      </button>
      <button type="button" class="btn-primary-launch" data-step-submit="launch">
        <span data-btn-label>🚀 Xác Nhận & Mở Bán Cửa Hàng</span>
      </button>
    </div>
  </div>

  <!-- Celebration (revealed on publish) -->
  <div class="celebration-pane" data-launch-celebration hidden>
    <div class="celebration-hero-art">
      <img src="/illustrations/onboarding-launch.jpg" alt="" class="celebration-illustration" width="160" height="160" />
    </div>
    <div class="celebration-badge-wrap">
      <span class="celebration-glow-pill">KÍCH HOẠT THÀNH CÔNG 🎉</span>
      <h2>Cửa Hàng Của Bạn Đã Mở Bán Trực Tuyến!</h2>
      <p>Chúc mừng bạn! Cửa hàng đã được triển khai hoàn chỉnh. Hệ thống sẵn sàng nhận đơn, tạo mã QR ngân hàng và tự động trả key cho khách hàng 24/7.</p>
    </div>

    <div class="celebration-links-cards">
      <a href="#" target="_blank" rel="noreferrer" class="launch-link-card" data-celebration-storefront-link>
        <div class="launch-card-icon"><ProviderLogo name="domain" size={28} /></div>
        <div class="launch-card-info">
          <strong>Website Storefront Bán Hàng</strong>
          <span data-celebration-slug-display>https://shop.{platformBaseDomain}</span>
        </div>
        <span class="launch-arrow">↗ Mở Ngay</span>
      </a>

      <a href="#" target="_blank" rel="noreferrer" class="launch-link-card" data-celebration-telegram-link hidden>
        <div class="launch-card-icon"><ProviderLogo name="telegram" size={28} /></div>
        <div class="launch-card-info">
          <strong>Bot Telegram Tự Động 24/7</strong>
          <span data-celebration-bot-display>@bot</span>
        </div>
        <span class="launch-arrow">↗ Mở Chat</span>
      </a>
    </div>

    <div class="celebration-actions">
      <a href="/app" class="btn-to-dashboard">
        <span>Vào Trang Quản Trị Cửa Hàng (Dashboard)</span>
        <span class="btn-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</div>

<style>
  .onboarding-step-pane {
    display: none;
    flex-direction: column;
    gap: 24px;
  }

  .onboarding-step-pane.is-active {
    display: flex;
  }

  /* 3D Hero Card */
  .step-hero-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 24px 28px;
    border-radius: var(--sln-console-radius-container, 16px);
    background: linear-gradient(135deg, #FFFFFF 0%, #F5F3FF 100%);
    border: 1px solid #E4E1FC;
    box-shadow: 0 4px 20px rgba(101, 82, 232, 0.06);
    margin-bottom: 20px;
  }

  .hero-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .hero-step-pill {
    align-self: flex-start;
    padding: 3px 10px;
    border-radius: var(--sln-console-radius-pill, 999px);
    background: #6552E8;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .hero-content h2 {
    margin: 0;
    font-size: clamp(20px, 3vw, 24px);
    font-weight: 700;
    color: #101828;
    letter-spacing: -0.02em;
  }

  .hero-content p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: #475467;
  }

  .hero-image-wrap {
    flex-shrink: 0;
  }

  .hero-illustration {
    border-radius: 12px;
    object-fit: cover;
    box-shadow: 0 4px 12px rgba(101, 82, 232, 0.12);
  }

  /* Summary Grid */
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 16px;
  }

  .summary-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    border-radius: 12px;
    background: #FFFFFF;
    border: 1.5px solid #EAECF0;
    box-shadow: 0 2px 6px rgba(16, 24, 40, 0.03);
  }

  .summary-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: #ECE9FF;
    color: #6552E8;
    flex-shrink: 0;
  }

  .summary-provider-logo {
    flex-shrink: 0;
  }

  .summary-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .summary-body small {
    font-size: 11.5px;
    color: #667085;
    font-weight: 600;
  }

  .summary-body strong {
    font-size: 14px;
    font-weight: 700;
    color: #101828;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .summary-sub {
    font-size: 12px;
    color: #0E9F6E;
    font-weight: 500;
  }

  /* Optional Settings */
  .optional-settings {
    border: 1px solid #EAECF0;
    border-radius: 12px;
    background: #FFFFFF;
    padding: 14px 18px;
    margin-bottom: 16px;
  }

  .optional-settings summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13.5px;
    font-weight: 600;
    color: #344054;
    cursor: pointer;
    user-select: none;
  }

  .optional-settings summary em {
    font-style: normal;
    color: #667085;
    font-weight: 400;
  }

  .settings-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid #EAECF0;
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  label {
    font-size: 12.5px;
    font-weight: 600;
    color: #344054;
  }

  input {
    width: 100%;
    border: 1px solid #D0D5DD;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    color: #101828;
  }

  .btn-save-settings {
    align-self: flex-start;
    padding: 8px 16px;
    border-radius: 6px;
    background: #F2F4F7;
    border: 1px solid #D0D5DD;
    color: #344054;
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
  }

  /* Checklist */
  .launch-checklist {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px 20px;
    border-radius: 12px;
    background: #F8FAFC;
    border: 1px solid #EAECF0;
    margin-bottom: 20px;
  }

  .checklist-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 500;
    color: #475467;
  }

  .check-dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #E2E8F0;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .checklist-row.is-complete .check-dot {
    background: #0E9F6E;
  }

  .checklist-row.is-complete .check-dot::after {
    content: "✓";
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 800;
  }

  .checklist-row.is-complete {
    color: #101828;
    font-weight: 600;
  }

  /* Actions */
  .step-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .split-actions {
    justify-content: space-between;
  }

  .btn-secondary-back {
    padding: 12px 22px;
    border-radius: 999px;
    background: #FFFFFF;
    border: 1.5px solid #D0D5DD;
    color: #344054;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  .btn-primary-launch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 32px;
    border-radius: 999px;
    background: linear-gradient(135deg, #6552E8 0%, #4338CA 100%);
    color: #FFFFFF;
    border: none;
    font-size: 15px;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(101, 82, 232, 0.4);
    transition: all 0.18s ease;
  }

  .btn-primary-launch:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(101, 82, 232, 0.5);
  }

  /* Celebration Pane */
  .celebration-pane {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
    padding: 32px 20px;
    animation: celebrationFadeIn 0.4s ease forwards;
  }

  @keyframes celebrationFadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .celebration-hero-art {
    margin-bottom: 8px;
  }

  .celebration-illustration {
    border-radius: 20px;
    box-shadow: 0 8px 30px rgba(101, 82, 232, 0.2);
  }

  .celebration-badge-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 580px;
  }

  .celebration-glow-pill {
    padding: 4px 14px;
    border-radius: 999px;
    background: #DCFCE7;
    color: #15803D;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .celebration-badge-wrap h2 {
    margin: 0;
    font-size: clamp(24px, 4vw, 30px);
    font-weight: 800;
    color: #101828;
    letter-spacing: -0.03em;
  }

  .celebration-badge-wrap p {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: #475467;
  }

  .celebration-links-cards {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-width: 520px;
  }

  .launch-link-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    border-radius: 14px;
    background: #FFFFFF;
    border: 1.5px solid #EAECF0;
    text-decoration: none;
    transition: all 0.18s ease;
    box-shadow: 0 2px 8px rgba(16, 24, 40, 0.04);
  }

  .launch-link-card:hover {
    border-color: #6552E8;
    background: #F4F3FF;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(101, 82, 232, 0.15);
  }

  .launch-card-icon {
    flex-shrink: 0;
  }

  .launch-card-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  .launch-card-info strong {
    font-size: 14.5px;
    font-weight: 700;
    color: #101828;
  }

  .launch-card-info span {
    font-size: 13px;
    color: #6552E8;
    font-weight: 500;
  }

  .launch-arrow {
    font-size: 13px;
    font-weight: 700;
    color: #6552E8;
  }

  .celebration-actions {
    margin-top: 12px;
  }

  .btn-to-dashboard {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 36px;
    border-radius: 999px;
    background: #101828;
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.18s ease;
    box-shadow: 0 4px 16px rgba(16, 24, 40, 0.2);
  }

  .btn-to-dashboard:hover {
    background: #1D2939;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(16, 24, 40, 0.3);
  }

  @media (max-width: 768px) {
    .step-hero-card {
      flex-direction: column-reverse;
      text-align: center;
      padding: 20px 16px;
    }

    .hero-step-pill {
      align-self: center;
    }

    .summary-grid, .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

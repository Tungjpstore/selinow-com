---
type Props = {
  platformBaseDomain: string;
};

const { platformBaseDomain } = Astro.props;
import Icon from "../../console/Icon.astro";
---

<div class="onboarding-step-pane celebration-pane" data-step-pane="celebration" hidden>
  <div class="celebration-badge-wrap">
    
    <span class="celebration-glow-pill">KÍCH HOẠT THÀNH CÔNG</span>
    <h2>Cửa Hàng Của Bạn Đã Sẵn Sàng!</h2>
    <p>Chúc mừng bạn! Tất cả cấu hình cốt lõi đã hoàn tất. Cửa hàng số và bot tự động của bạn đã sẵn sàng nhận đơn và giao key cho khách hàng 24/7.</p>
  </div>

  <div class="celebration-links-cards">
    <!-- Storefront Link -->
    <a href="#" target="_blank" rel="noreferrer" class="launch-link-card web-link" data-celebration-storefront-link>
      <div class="launch-card-icon"><Icon name="globe" size={20} /></div>
      <div class="launch-card-info">
        <strong>Mở Website Bán Hàng</strong>
        <span data-celebration-slug-display>https://shop.{platformBaseDomain}</span>
      </div>
      <span class="launch-arrow">↗</span>
    </a>

    <!-- Telegram Bot Link -->
    <a href="#" target="_blank" rel="noreferrer" class="launch-link-card tg-link" data-celebration-telegram-link hidden>
      <div class="launch-card-icon"><Icon name="bot" size={20} /></div>
      <div class="launch-card-info">
        <strong>Mở Bot Telegram</strong>
        <span data-celebration-bot-display>@your_bot</span>
      </div>
      <span class="launch-arrow">↗</span>
    </a>
  </div>

  <div class="celebration-footer-action">
    <a href="/app" class="btn-go-dashboard" data-celebration-dashboard-link>
      <span>Đi Tới Bảng Điều Khiển Quản Lý (Dashboard)</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</div>

<style>
  .celebration-pane {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 28px;
    padding: 24px 12px 12px;
    animation: celebrationPop 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes celebrationPop {
    0% { opacity: 0; transform: scale(0.92); }
    100% { opacity: 1; transform: scale(1); }
  }

  .celebration-badge-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 520px;
  }

  .celebration-fireworks {
    font-size: 54px;
    line-height: 1;
    animation: bounce 1.5s infinite alternate ease-in-out;
  }

  @keyframes bounce {
    0% { transform: translateY(0) scale(1); }
    100% { transform: translateY(-8px) scale(1.1); }
  }

  .celebration-glow-pill {
    padding: 4px 14px;
    border-radius: var(--sln-radius-pill);
    background: var(--sln-tint-success);
    color: var(--sln-state-success);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    border: 1px solid color-mix(in srgb, var(--sln-state-success) 30%, transparent);
  }

  .celebration-badge-wrap h2 {
    margin: 0;
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 600;
    color: var(--sln-text-primary);
    letter-spacing: -0.03em;
  }

  .celebration-badge-wrap p {
    margin: 0;
    font-size: 15px;
    color: var(--sln-text-secondary);
    line-height: 1.6;
  }

  .celebration-links-cards {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    max-width: 480px;
  }

  .launch-link-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    border: 1px solid var(--sln-border-strong);
    border-radius: var(--sln-radius-lg);
    background: var(--sln-bg-surface);
    text-decoration: none;
    transition: all 0.15s ease;
    box-shadow: var(--sln-shadow-xs);
  }

  .launch-link-card:hover {
    border-color: var(--sln-action-primary);
    transform: translateY(-2px);
    box-shadow: var(--sln-shadow-md);
  }

  .launch-card-icon {
    font-size: 26px;
    flex-shrink: 0;
  }

  .launch-card-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: left;
    min-width: 0;
  }

  .launch-card-info strong {
    font-size: 14px;
    font-weight: 600;
    color: var(--sln-text-primary);
  }

  .launch-card-info span {
    font-size: 12px;
    color: var(--sln-action-primary);
    font-family: var(--sln-font-mono);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .launch-arrow {
    font-size: 16px;
    font-weight: 600;
    color: var(--sln-text-muted);
  }

  .celebration-footer-action {
    margin-top: 8px;
    width: 100%;
    max-width: 480px;
  }

  .btn-go-dashboard {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 52px;
    border-radius: var(--sln-radius-pill);
    background: var(--sln-action-primary);
    color: var(--sln-white);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 4px 16px color-mix(in srgb, var(--sln-action-primary) 35%, transparent);
    transition: transform 0.15s, background 0.15s;
  }

  .btn-go-dashboard:hover {
    background: var(--sln-action-primary-hover);
    transform: translateY(-2px);
  }
</style>

---
import { createAdminTranslator } from "../../lib/i18n/catalogs/admin";

interface Props {
  actionHref?: string;
  actionLabel?: string;
  code?: string;
  description: string;
  eyebrow?: string;
  headingLevel?: "h1" | "h2";
  title: string;
  tone?: "danger" | "info" | "neutral" | "warning";
}

const {
  actionHref,
  actionLabel,
  code,
  description,
  eyebrow,
  headingLevel = "h1",
  title,
  tone = "neutral",
} = Astro.props;
const t = createAdminTranslator(Astro.locals.locale);
const resolvedEyebrow = eyebrow ?? t("admin.state.default_eyebrow");
---

<section class="admin-state" data-tone={tone} role={tone === "danger" ? "alert" : "status"} aria-atomic="true">
  <span class="admin-state-icon" aria-hidden="true"></span>
  <div>
    <p>{resolvedEyebrow}</p>
    {headingLevel === "h1" ? <h1>{title}</h1> : <h2>{title}</h2>}
    <span>{description}</span>
    {code && <code>{code}</code>}
    {actionHref && actionLabel && <a href={actionHref}>{actionLabel}</a>}
  </div>
</section>

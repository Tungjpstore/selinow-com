---
import { createDashboardTranslator } from "../../lib/i18n/catalogs/dashboard";

interface Props {
  actionHref?: string | undefined;
  actionLabel?: string | undefined;
  description: string;
  eyebrow?: string;
  role?: "alert" | "status" | undefined;
  state: State;
  title: string;
}

type State =
  | "blocked"
  | "empty"
  | "error"
  | "forbidden"
  | "loading"
  | "plan_limited"
  | "success"
  | "suspended"
  | "waiting_provider"
  | "waiting_user"
  | "warning";

const t = createDashboardTranslator(Astro.locals.locale);
const {
  actionHref,
  actionLabel,
  description,
  eyebrow = t("dashboard.state.eyebrow"),
  role,
  state,
  title,
} = Astro.props;
const alertStates: readonly State[] = ["blocked", "error", "forbidden", "suspended"];
const computedRole = role ?? (alertStates.includes(state) ? "alert" : "status");
---

<section class="sln-state-panel" data-state={state} role={computedRole} aria-atomic="true">
  <div class="sln-state-panel__signal" aria-hidden="true"><span></span></div>
  <div class="sln-state-panel__copy">
    <p class="sln-state-panel__eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    <p class="sln-state-panel__description">{description}</p>
    {actionHref && actionLabel && <a class="sln-link-button" data-variant="inline" href={actionHref}>{actionLabel}<span aria-hidden="true"> →</span></a>}
    <div class="sln-state-panel__meta"><slot name="meta" /></div>
    <div class="sln-state-panel__actions"><slot name="actions" /></div>
  </div>
</section>

<style>
  .sln-state-panel { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: var(--sln-space-4); padding: var(--sln-space-8); border: 1px solid var(--sln-border-default); border-radius: var(--sln-radius-lg); background: var(--sln-bg-surface); box-shadow: var(--sln-shadow-xs); }
  .sln-state-panel__signal { display: grid; place-items: start center; padding-top: 7px; }
  .sln-state-panel__signal span { width: 12px; height: 12px; border-radius: 50%; background: var(--sln-text-muted); box-shadow: 0 0 0 6px color-mix(in srgb, var(--sln-text-muted) 10%, transparent); }
  .sln-state-panel[data-state="loading"] .sln-state-panel__signal span { border: 2px solid var(--sln-action-primary); border-right-color: transparent; background: transparent; box-shadow: none; animation: sln-state-spin 720ms linear infinite; }
  .sln-state-panel[data-state="success"] .sln-state-panel__signal span { background: var(--sln-state-success); box-shadow: 0 0 0 6px var(--sln-tint-success); }
  .sln-state-panel[data-state="warning"], .sln-state-panel[data-state="waiting_user"], .sln-state-panel[data-state="waiting_provider"] { border-color: color-mix(in srgb, var(--sln-state-warning) 28%, var(--sln-border-default)); }
  .sln-state-panel[data-state="warning"] .sln-state-panel__signal span, .sln-state-panel[data-state="waiting_user"] .sln-state-panel__signal span, .sln-state-panel[data-state="waiting_provider"] .sln-state-panel__signal span { background: var(--sln-state-warning); box-shadow: 0 0 0 6px var(--sln-tint-warning); }
  .sln-state-panel[data-state="error"] .sln-state-panel__signal span, .sln-state-panel[data-state="blocked"] .sln-state-panel__signal span, .sln-state-panel[data-state="forbidden"] .sln-state-panel__signal span, .sln-state-panel[data-state="suspended"] .sln-state-panel__signal span { background: var(--sln-state-danger); box-shadow: 0 0 0 6px var(--sln-tint-danger); }
  .sln-state-panel[data-state="plan_limited"] .sln-state-panel__signal span { background: var(--sln-state-info); box-shadow: 0 0 0 6px var(--sln-tint-info); }
  .sln-state-panel__copy { min-width: 0; }
  .sln-state-panel__eyebrow { margin: 0 0 var(--sln-space-2); color: var(--sln-text-muted); font: var(--sln-font-caption); letter-spacing: .08em; text-transform: uppercase; }
  .sln-state-panel h2 { margin: 0; font: var(--sln-font-h4); }
  .sln-state-panel__description { max-width: 680px; margin: var(--sln-space-2) 0 0; color: var(--sln-text-secondary); font: var(--sln-font-body-sm); }
  .sln-state-panel .sln-link-button { display: inline-flex; margin-top: var(--sln-space-3); }
  .sln-state-panel__meta:empty, .sln-state-panel__actions:empty { display: none; }
  .sln-state-panel__meta { display: flex; flex-wrap: wrap; gap: var(--sln-space-3); margin-top: var(--sln-space-3); color: var(--sln-text-muted); font: var(--sln-font-caption); }
  .sln-state-panel__actions { display: flex; flex-wrap: wrap; gap: var(--sln-space-3); margin-top: var(--sln-space-3); }
  @keyframes sln-state-spin { to { transform: rotate(360deg); } }
  @media (max-width: 480px) { .sln-state-panel { padding: var(--sln-space-6); } }
</style>

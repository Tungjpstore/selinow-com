---
import { createDashboardTranslator } from "../../lib/i18n/catalogs/dashboard";
import StatePanel from "./StatePanel.astro";

interface Props { actionHref?: string; actionLabel?: string; description: string; lastCheckedAt?: string; title: string; }
const t = createDashboardTranslator(Astro.locals.locale);
const { actionHref, actionLabel, description, lastCheckedAt, title } = Astro.props;
---
<StatePanel actionHref={actionHref} actionLabel={actionLabel} description={description} state="waiting_provider" title={title}>
  {lastCheckedAt && <span slot="meta">{t("dashboard.state.waiting_provider.last_checked", { time: lastCheckedAt })}</span>}
  <slot name="actions" slot="actions" />
</StatePanel>

---
import { createDashboardTranslator } from "../../lib/i18n/catalogs/dashboard";
import StatePanel from "./StatePanel.astro";

interface Props { actionHref?: string; actionLabel?: string; description?: string; requestId?: string; safeCode?: string; title?: string; }
const t = createDashboardTranslator(Astro.locals.locale);
const {
  actionHref,
  actionLabel = t("dashboard.state.error.retry"),
  description = t("dashboard.state.error.description"),
  requestId,
  safeCode,
  title = t("dashboard.state.error.title"),
} = Astro.props;
const safeCodeLabel = safeCode === undefined ? null : t("dashboard.state.error.meta_code", { code: safeCode });
const requestIdLabel = requestId === undefined ? null : t("dashboard.state.error.meta_request", { requestId });
---
<StatePanel actionHref={actionHref} actionLabel={actionLabel} description={description} role="alert" state="error" title={title}>
  {(safeCodeLabel !== null || requestIdLabel !== null) && <span slot="meta">{safeCodeLabel}{safeCodeLabel !== null && requestIdLabel !== null && " · "}{requestIdLabel}</span>}
</StatePanel>

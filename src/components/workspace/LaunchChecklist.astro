---
type ChecklistItem = {
  actionLabel?: string;
  actionUrl: string;
  completed: boolean;
  description: string;
  id: string;
  title: string;
};

type Props = {
  items: ChecklistItem[];
  percent: number;
  shopName?: string;
};

const {
  items,
  percent,
  shopName = "Cửa hàng của bạn",
} = Astro.props;

const completedCount = items.filter((item) => item.completed).length;
const totalCount = items.length;
const isAllDone = percent >= 100;
---

{totalCount > 0 && !isAllDone && (
  <section class="launch-checklist-card" aria-labelledby="launch-checklist-title">
    <div class="checklist-top-bar">
      <div class="checklist-title-group">
        <span class="checklist-rocket-icon">🚀</span>
        <div>
          <h2 id="launch-checklist-title">Tiến trình kích hoạt {shopName}</h2>
          <p>Hoàn thành các bước quan trọng dưới đây để kích hoạt hệ thống thanh toán và bán hàng tự động 24/7.</p>
        </div>
      </div>

      <div class="checklist-progress-wrap">
        <div class="progress-info-row">
          <span class="progress-label">Tiến độ</span>
          <strong class="progress-percentage">{percent}%</strong>
        </div>
        <div class="progress-track-bar" role="progressbar" aria-valuenow={percent} aria-valuemin="0" aria-valuemax="100">
          <div class="progress-fill-bar" style={`width: ${percent}%`}></div>
        </div>
        <small class="progress-count-text">{completedCount}/{totalCount} bước hoàn thành</small>
      </div>
    </div>

    <div class="checklist-items-stack">
      {items.map((item) => (
        <article class={`checklist-item-row ${item.completed ? "is-completed" : "is-pending"}`}>
          <div class="item-check-circle" aria-hidden="true">
            {item.completed ? "✓" : ""}
          </div>
          <div class="item-text-body">
            <strong>{item.title}</strong>
            <p>{item.description}</p>
          </div>
          <div class="item-action-wrap">
            {item.completed ? (
              <span class="badge-done">Đã hoàn thành</span>
            ) : (
              <a href={item.actionUrl} class="btn-item-action">
                <span>{item.actionLabel ?? "Kích hoạt"}</span>
                <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .launch-checklist-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: var(--sln-space-6);
    padding: clamp(18px, 3vw, 24px);
    border: 1px solid color-mix(in srgb, var(--sln-action-primary) 25%, var(--sln-border-default));
    border-left: 4px solid var(--sln-action-primary);
    border-radius: var(--sln-radius-xl);
    background: var(--sln-bg-surface);
    box-shadow: var(--sln-shadow-sm);
  }

  .checklist-top-bar {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(220px, 0.7fr);
    gap: 20px;
    align-items: center;
  }

  .checklist-title-group {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .checklist-rocket-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: var(--sln-radius-md);
    background: var(--sln-tint-primary);
    font-size: 22px;
    flex-shrink: 0;
  }

  .checklist-title-group h2 {
    margin: 0 0 4px;
    font-size: clamp(16px, 2.5vw, 19px);
    font-weight: 600;
    color: var(--sln-text-primary);
    letter-spacing: -0.025em;
  }

  .checklist-title-group p {
    margin: 0;
    font-size: 13px;
    color: var(--sln-text-secondary);
    line-height: 1.45;
  }

  /* Progress Bar */
  .checklist-progress-wrap {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px 16px;
    border-radius: var(--sln-radius-lg);
    background: var(--sln-bg-subtle);
    border: 1px solid var(--sln-border-default);
  }

  .progress-info-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .progress-label {
    font-size: 12px;
    color: var(--sln-text-muted);
    font-weight: 600;
  }

  .progress-percentage {
    font-size: 15px;
    font-weight: 600;
    color: var(--sln-action-primary);
    font-family: var(--sln-font-mono);
  }

  .progress-track-bar {
    width: 100%;
    height: 8px;
    border-radius: var(--sln-radius-pill);
    background: var(--sln-border-strong);
    overflow: hidden;
  }

  .progress-fill-bar {
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--sln-action-primary), #06b6d4);
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .progress-count-text {
    font-size: 11px;
    color: var(--sln-text-muted);
  }

  /* Items Stack */
  .checklist-items-stack {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--sln-border-default);
    border-radius: var(--sln-radius-lg);
    overflow: hidden;
    background: var(--sln-bg-surface);
  }

  .checklist-item-row {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) auto;
    gap: 14px;
    align-items: center;
    padding: 14px 18px;
    border-bottom: 1px solid var(--sln-border-default);
    transition: background 0.15s ease;
  }

  .checklist-item-row:last-child {
    border-bottom: none;
  }

  .checklist-item-row.is-completed {
    background: color-mix(in srgb, var(--sln-bg-subtle) 40%, transparent);
  }

  .item-check-circle {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid var(--sln-border-strong);
    color: transparent;
    font-size: 13px;
    font-weight: 600;
    flex-shrink: 0;
  }

  .checklist-item-row.is-completed .item-check-circle {
    background: var(--sln-state-success);
    border-color: var(--sln-state-success);
    color: var(--sln-white);
  }

  .item-text-body strong {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--sln-text-primary);
  }

  .checklist-item-row.is-completed .item-text-body strong {
    color: var(--sln-text-secondary);
    text-decoration: line-through;
    opacity: 0.85;
  }

  .item-text-body p {
    margin: 2px 0 0;
    font-size: 12px;
    color: var(--sln-text-muted);
    line-height: 1.4;
  }

  .badge-done {
    padding: 3px 10px;
    border-radius: var(--sln-radius-pill);
    background: var(--sln-tint-success);
    color: var(--sln-state-success);
    font-size: 11px;
    font-weight: 600;
  }

  .btn-item-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: var(--sln-radius-pill);
    background: var(--sln-tint-primary);
    color: var(--sln-action-primary);
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-item-action:hover {
    background: var(--sln-action-primary);
    color: var(--sln-white);
  }

  @media (max-width: 820px) {
    .checklist-top-bar {
      grid-template-columns: 1fr;
    }

    .checklist-item-row {
      grid-template-columns: 24px minmax(0, 1fr);
      gap: 10px 12px;
    }

    .item-action-wrap {
      grid-column: 2;
    }
  }
</style>

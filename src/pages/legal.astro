<style>:global(body){margin:0;background:#f0eadc;color:#202019;font-family:Georgia,serif}main{width:min(980px,calc(100% - 40px));margin:9vh auto}a{color:#7b321e;font:700 1rem ui-monospace,monospace}.eyebrow{margin-top:56px;font:700 .78rem ui-monospace,monospace;letter-spacing:.14em}h1{max-width:800px;font-size:clamp(2.7rem,7vw,5.8rem);line-height:.92;letter-spacing:-.055em}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:48px}article{min-height:170px;padding:24px;border:1px solid #8e806a;background:#fffaf0}h2{font-size:1.6rem}p{line-height:1.6}@media(max-width:700px){.grid{grid-template-columns:1fr}}</style>

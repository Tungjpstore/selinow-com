---
import AppLayout from "../../layouts/AppLayout.astro";
import ConfirmDialog from "../../components/primitives/ConfirmDialog.astro";
import StatusBadge from "../../components/primitives/StatusBadge.astro";
import WorkspaceState from "../../components/states/WorkspaceState.astro";
import PageHeader from "../../components/workspace/PageHeader.astro";
import { authenticateRequest } from "../../lib/auth/session";
import { isAppError } from "../../lib/core/errors";
import { getBindings } from "../../lib/platform/bindings";
import { withSelectedShop } from "../../lib/dashboard/shop-navigation";
import { createDashboardTranslator } from "../../lib/i18n";
import { listMemberInvitations, type MemberInvitationView } from "../../lib/tenants/member-management";
import { listSellerMembers, type SellerMemberView } from "../../lib/tenants/seller-management";
import { listShopsForMember, selectShopForMember, type ShopView } from "../../lib/tenants/store";

const env = getBindings();
const auth = await authenticateRequest(Astro.request, env).catch(() => null);
if (auth === null) return Astro.redirect("/login");
const locale = Astro.locals.locale;
const t = createDashboardTranslator(locale);
let shops: ShopView[] = [];
let state: "ready" | "unavailable" | "forbidden" = "ready";
try { shops = await listShopsForMember({ env, userId: auth.userId }); } catch { state = "unavailable"; }
const shop = selectShopForMember(shops, Astro.url.searchParams.get("shop"));
const workspaceHref = (href: string): string => withSelectedShop(href, shop?.publicId, Astro.url.origin);
let members: SellerMemberView[] = [];
let invitations: MemberInvitationView[] = [];
const canManageTeam = shop?.role === "owner";
if (shop !== undefined && state === "ready") {
  try { members = await listSellerMembers({ env, shopPublicId: shop.publicId, userId: auth.userId }); }
  catch (error) { state = isAppError(error) && error.status === 403 ? "forbidden" : "unavailable"; }
  if (state === "ready" && canManageTeam) {
    try { invitations = await listMemberInvitations({ env, shopPublicId: shop.publicId, userId: auth.userId }); }
    catch (error) { state = isAppError(error) && error.status === 403 ? "forbidden" : "unavailable"; }
  }
}
if (state === "forbidden") Astro.response.status = 403;
if (state === "unavailable") Astro.response.status = 503;
const roleLabel = (role: string): string => {
  const key = role === "owner" || role === "manager" || role === "support" || role === "viewer" ? `dashboard.role.${role}` : "dashboard.members.role.unknown";
  return t(key);
};
const statusLabel = (status: string): string => status === "active"
  ? t("dashboard.members.status.active")
  : status === "suspended" ? t("dashboard.members.status.suspended") : t("dashboard.members.status.unknown");
---

<AppLayout activePath="/app/members" displayName={auth.displayName.trim() || t("dashboard.commerce.you")} email={auth.email} selectedShopName={shop?.name} selectedShopPublicId={shop?.publicId} shops={shops} title={t("dashboard.members.title")}>
  <PageHeader eyebrow={t("dashboard.members.eyebrow")} title={t("dashboard.members.title")} description={t("dashboard.members.description")}>
    {canManageTeam ? <button slot="actions" class="sln-button" data-variant="primary" type="button" data-members-open-invite>{t("dashboard.members.invite")}</button> : <span slot="actions" class="sln-badge">{t("dashboard.members.invite_unavailable")}</span>}
  </PageHeader>
  {state === "unavailable" ? <div class="state-space"><WorkspaceState title={t("dashboard.members.unavailable.title")} description={t("dashboard.members.unavailable.description")} actionHref={workspaceHref("/app/members")} actionLabel={t("dashboard.members.retry")} tone="danger" /></div>
    : shop === undefined ? <div class="state-space"><WorkspaceState title={t("dashboard.members.no_store.title")} description={t("dashboard.members.no_store.description")} actionHref={workspaceHref("/onboarding")} actionLabel={t("dashboard.members.no_store.action")} tone="info" /></div>
    : state === "forbidden" ? <div class="state-space"><WorkspaceState title={t("dashboard.members.forbidden.title")} description={t("dashboard.members.forbidden.description")} tone="warning" /></div>
    : <div class="members-workspace" data-members-root data-shop-public-id={shop.publicId} data-csrf-cookie-name={`${env.SESSION_COOKIE_NAME}_csrf`} data-can-manage={canManageTeam ? "true" : "false"} data-copy={JSON.stringify({
      feedbackUpdated: t("dashboard.members.feedback.updated"),
      feedbackWorking: t("dashboard.members.feedback.working"),
      errorGeneric: t("dashboard.members.error.generic"),
      inviteSending: t("dashboard.members.invite_sending"),
      inviteSent: t("dashboard.members.invite_sent"),
      inviteInvalid: t("dashboard.members.invite_invalid"),
      invitationCancel: t("dashboard.members.invitation_revoke"),
      invitationResend: t("dashboard.members.invitation_resend"),
      invitationWorking: t("dashboard.members.invitation_working"),
      invitationConfirm: t("dashboard.members.invitation_confirm"),
      roleSave: t("dashboard.members.role_save"),
      roleSaving: t("dashboard.members.role_saving"),
      suspend: t("dashboard.members.suspend"),
      suspending: t("dashboard.members.suspending"),
      suspendConfirm: t("dashboard.members.suspend_confirm"),
      statusInvited: t("dashboard.members.status.invited"),
      statusPending: t("dashboard.members.invitation.pending"),
      statusExpired: t("dashboard.members.invitation.expired"),
      statusAccepted: t("dashboard.members.invitation.accepted"),
      statusRevoked: t("dashboard.members.invitation.revoked"),
    })}>
      <section class="member-panel" aria-labelledby="member-ledger-title">
        <header><div><p class="eyebrow">{t("dashboard.members.ledger.eyebrow")}</p><h2 id="member-ledger-title">{shop.name}</h2></div><span>{t("dashboard.members.ledger.count", { count: members.length })}</span></header>
        {members.length === 0 ? <WorkspaceState title={t("dashboard.members.empty.title")} description={t("dashboard.members.empty.description")} tone="info" /> : <div class="member-ledger" role="list" aria-label={t("dashboard.members.ledger.aria")}>
          {members.map((member) => <article role="listitem" data-member-row data-member-public-id={member.memberPublicId} data-version={member.version}>
            <div class="member-mark" aria-hidden="true">{member.displayName.slice(0,1).toUpperCase()}</div>
            <div><strong>{member.displayName}</strong><span>{member.emailMasked}</span></div>
            {canManageTeam && member.role !== "owner" ? <label class="member-role-field"><span class="sr-only">{t("dashboard.members.role_label")}</span><select data-member-role><option value="manager" selected={member.role === "manager"}>{t("dashboard.role.manager")}</option><option value="support" selected={member.role === "support"}>{t("dashboard.role.support")}</option><option value="viewer" selected={member.role === "viewer"}>{t("dashboard.role.viewer")}</option></select></label> : <StatusBadge label={roleLabel(member.role)} tone="info" />}
            <StatusBadge label={statusLabel(member.status)} tone={member.status === "active" ? "success" : member.status === "suspended" ? "danger" : "neutral"} />
            {canManageTeam && member.role !== "owner" && member.status === "active" && <div class="member-actions"><button class="text-action" type="button" data-member-save>{t("dashboard.members.role_save")}</button><div data-member-suspend-dialog data-member-public-id={member.memberPublicId} data-version={member.version}><ConfirmDialog dialogId={`suspend-member-${member.memberPublicId}`} title={t("dashboard.members.suspend")} impact={t("dashboard.members.suspend_confirm")} triggerLabel={t("dashboard.members.suspend")} confirmLabel={t("dashboard.members.suspend")} cancelLabel={t("dashboard.members.dialog.cancel")} pendingLabel={t("dashboard.members.feedback.working")} variant="danger" /></div></div>}
          </article>)}
        </div>}
        <p class="scope-note">{t("dashboard.members.scope")}</p>
      </section>
      {canManageTeam && <section class="member-panel invitation-panel" aria-labelledby="invitation-title" data-invitations-panel>
        <header><div><p class="eyebrow">{t("dashboard.members.invitation.eyebrow")}</p><h2 id="invitation-title">{t("dashboard.members.invitation.title")}</h2></div><span data-invitation-count>{t("dashboard.members.invitation.count", { count: invitations.length })}</span></header>
        <div class="workspace-feedback" data-members-feedback role="status" aria-live="polite" hidden></div>
        <form class="invitation-form" data-invitation-form novalidate>
          <label>{t("dashboard.members.invite_email")}<input name="email" type="email" autocomplete="email" maxlength="254" required /></label>
          <label>{t("dashboard.members.invite_role")}<select name="role"><option value="manager">{t("dashboard.role.manager")}</option><option value="support">{t("dashboard.role.support")}</option><option value="viewer">{t("dashboard.role.viewer")}</option></select></label>
          <button class="sln-button" data-variant="primary" type="submit">{t("dashboard.members.invite_submit")}</button>
        </form>
        <div class="invitation-ledger" data-invitation-ledger role="list" aria-label={t("dashboard.members.invitation.aria")}>
          {invitations.map((invitation) => <article role="listitem" data-invitation-row data-invitation-public-id={invitation.invitationPublicId} data-version={invitation.version}>
            <div><strong>{invitation.emailMasked}</strong><span>{roleLabel(invitation.role)} · {invitation.expiresAt}</span></div>
            <StatusBadge label={invitation.status === "pending" ? t("dashboard.members.invitation.pending") : invitation.status === "accepted" ? t("dashboard.members.invitation.accepted") : invitation.status === "expired" ? t("dashboard.members.invitation.expired") : t("dashboard.members.invitation.revoked")} tone={invitation.status === "accepted" ? "success" : invitation.status === "pending" ? "warning" : invitation.status === "revoked" ? "danger" : "neutral"} />
            {(invitation.status === "pending" || invitation.status === "expired") && <div class="member-actions"><button class="text-action" type="button" data-invitation-resend>{t("dashboard.members.invitation_resend")}</button>{invitation.status === "pending" && <div data-invitation-revoke-dialog data-invitation-public-id={invitation.invitationPublicId} data-version={invitation.version}><ConfirmDialog dialogId={`revoke-invitation-${invitation.invitationPublicId}`} title={t("dashboard.members.invitation_revoke")} impact={t("dashboard.members.invitation_confirm")} triggerLabel={t("dashboard.members.invitation_revoke")} confirmLabel={t("dashboard.members.invitation_revoke")} cancelLabel={t("dashboard.members.dialog.cancel")} pendingLabel={t("dashboard.members.feedback.working")} variant="danger" /></div>}</div>}
          </article>)}
        </div>
      </section>}
    </div>}
</AppLayout>

<script src="../../scripts/dashboard/members.ts"></script>

<style>
  .sln-badge { display:inline-flex; align-items:center; min-height:36px; border:1px solid var(--sln-border-default); border-radius:var(--sln-radius-pill); padding:7px 12px; color:var(--sln-text-muted); font:var(--sln-font-caption); }
  .state-space { margin-top:var(--sln-space-8); }
  .members-workspace { display:grid; gap:var(--sln-space-8); }
  .member-panel { display:grid; gap:20px; margin-top:var(--sln-space-8); border:1px solid var(--sln-border-default); border-radius:var(--sln-radius-lg); padding:var(--sln-space-6); background:var(--sln-bg-surface); }
  .member-panel > header { display:flex; align-items:end; justify-content:space-between; gap:16px; padding-bottom:16px; border-bottom:1px solid var(--sln-border-default); }
  .member-panel h2 { margin:0; font:var(--sln-font-h3); letter-spacing:-.035em; }
  .member-panel header > span, .member-panel span, .scope-note { color:var(--sln-text-muted); font:var(--sln-font-caption); }
  .eyebrow { margin:0 0 7px; color:var(--sln-action-primary); font:var(--sln-font-caption); font-weight: 600; letter-spacing:.1em; text-transform:uppercase; }
  .member-ledger { display:grid; overflow:hidden; border:1px solid var(--sln-border-default); border-radius:var(--sln-radius-md); }
  .member-ledger article { display:grid; grid-template-columns:40px minmax(0,1fr) auto auto auto; gap:14px; align-items:center; min-height:74px; padding:14px 16px; border-top:1px solid var(--sln-border-default); }
  .member-ledger article:first-child { border-top:0; }
  .member-mark { display:grid; place-items:center; width:34px; height:34px; border-radius:50%; background:var(--sln-tint-indigo); color:var(--sln-action-primary-strong); font-weight: 600; }
  .member-ledger article > div:not(.member-mark) { display:grid; gap:4px; min-width:0; }
  .member-ledger strong { overflow:hidden; color:var(--sln-text-primary); font:var(--sln-font-label); text-overflow:ellipsis; white-space:nowrap; }
  .scope-note { margin:0; }
  .member-role-field select, .invitation-form input, .invitation-form select { min-height:40px; border:1px solid var(--sln-border-strong); border-radius:var(--sln-radius-md); padding:8px 10px; background:var(--sln-bg-canvas); color:var(--sln-text-primary); font:var(--sln-font-body-sm); }
  .member-actions { display:flex; align-items:center; gap:10px; justify-content:end; }
  .text-action { border:0; padding:4px 0; background:transparent; color:var(--sln-action-primary); font:var(--sln-font-label); cursor:pointer; }
  .text-action:hover { text-decoration:underline; text-underline-offset:3px; }
  .danger-text { color:var(--sln-state-danger); }
  .invitation-form { display:grid; grid-template-columns:minmax(0,1.5fr) minmax(160px,.7fr) auto; gap:12px; align-items:end; }
  .invitation-form label { display:grid; gap:6px; color:var(--sln-text-secondary); font:var(--sln-font-caption); }
  .invitation-ledger { display:grid; overflow:hidden; border:1px solid var(--sln-border-default); border-radius:var(--sln-radius-md); }
  .invitation-ledger article { display:grid; grid-template-columns:minmax(0,1fr) auto auto; gap:14px; align-items:center; min-height:66px; padding:12px 16px; border-top:1px solid var(--sln-border-default); }
  .invitation-ledger article:first-child { border-top:0; }
  .invitation-ledger article > div:first-child { display:grid; gap:4px; min-width:0; }
  .invitation-ledger strong { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .invitation-ledger span { color:var(--sln-text-muted); font:var(--sln-font-caption); }
  .workspace-feedback { padding:12px 14px; border:1px solid var(--sln-border-default); border-radius:var(--sln-radius-md); background:var(--sln-bg-subtle); color:var(--sln-text-secondary); font:var(--sln-font-body-sm); }
  .workspace-feedback[data-tone="danger"] { border-color:var(--sln-state-danger); color:var(--sln-state-danger); }
  .workspace-feedback[data-tone="success"] { border-color:var(--sln-state-success); color:var(--sln-state-success); }
  .sr-only { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; }
  @media (max-width:760px) { .invitation-form { grid-template-columns:1fr; } .invitation-form .sln-button { width:100%; } }
  @media (max-width:600px) { .member-panel { padding:16px; } .member-panel > header { align-items:start; flex-direction:column; } .member-ledger article { grid-template-columns:40px minmax(0,1fr); gap:10px; } :global(.member-ledger .sln-status) { justify-self:start; } .member-ledger article > .member-role-field, .member-ledger article > .member-actions { grid-column:2; justify-self:start; } :global(.member-ledger article > .sln-status), :global(.invitation-ledger .sln-status) { grid-column:2; justify-self:start; } .invitation-ledger article { grid-template-columns:1fr; gap:8px; } .invitation-ledger .member-actions { justify-content:start; } }
</style>

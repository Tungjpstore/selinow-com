              <label>{t("dashboard.products.dialog.variants.field.min_per_order")}<input name="minPerOrder" type="number" min="1" max="1000" required value={String(variant.minPerOrder ?? 1)} /></label>
              <label>{t("dashboard.products.dialog.variants.field.max_per_order")}<input name="maxPerOrder" type="number" min="1" max="1000" required value={String(variant.maxPerOrder ?? 10)} /></label>

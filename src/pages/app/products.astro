<script>
  import { buildCsv, downloadCsv } from "../../lib/dashboard/csv-export";

  type ProductExportRow = { lowest: string; status: string; stock: string; title: string; updated: string };

  const ledger = document.querySelector<HTMLElement>("[data-product-ledger]");
  if (ledger !== null) {
    const copy: { headers?: readonly string[] } = (() => {
      try { return JSON.parse(ledger.dataset.exportCopy ?? "{}") as { headers?: readonly string[] }; }
      catch { return {}; }
    })();
    const rows: ProductExportRow[] = (() => {
      try {
        const parsed: unknown = JSON.parse(ledger.dataset.exportRows ?? "[]");
        return Array.isArray(parsed) ? parsed as ProductExportRow[] : [];
      } catch { return []; }
    })();
    const headers = copy.headers ?? [];

    ledger.querySelector<HTMLButtonElement>("[data-product-export]")?.addEventListener("click", () => {
      const csv = buildCsv(rows, [
        { header: headers[0] ?? "", value: (row: ProductExportRow) => row.title },
        { header: headers[1] ?? "", value: (row: ProductExportRow) => row.lowest },
        { header: headers[2] ?? "", value: (row: ProductExportRow) => row.stock },
        { header: headers[3] ?? "", value: (row: ProductExportRow) => row.status },
        { header: headers[4] ?? "", value: (row: ProductExportRow) => row.updated },
      ]);
      const stamp = new Date().toISOString().slice(0, 10).replaceAll("-", "");
      downloadCsv(`products-${stamp}.csv`, csv);
    });

    const pageSizeSelect = ledger.querySelector("[data-page-size-select]");
    if (pageSizeSelect instanceof HTMLSelectElement) {
      pageSizeSelect.addEventListener("change", () => {
        pageSizeSelect.form?.requestSubmit();
      });
    }
  }
</script>


              <input name="compareAtMinor" type="hidden" aria-label={t("dashboard.products.dialog.variants.field.compare_at")} value={variant.compareAtMinor === null || variant.compareAtMinor === undefined ? "" : String(variant.compareAtMinor)} />
              <input name="optionsJson" type="hidden" aria-label={t("dashboard.products.dialog.variants.field.options")} value={String(variant.optionsJson ?? "{}")} />
              <label>{t("dashboard.products.dialog.product_editor.field.status")}<select name="status"><option value="active" selected={variant.status === "active"}>{t("dashboard.products.status.active")}</option><option value="archived" selected={variant.status === "archived"}>{t("dashboard.products.status.archived")}</option><option value="suspended" selected={variant.status === "suspended"}>{t("dashboard.products.status.suspended")}</option></select></label>
            </fieldset>)}
            <fieldset class="new-variant-fieldset" data-new-variant>
              <legend>{t("dashboard.products.dialog.variants.new.title")}</legend>
              <p class="dialog-copy">{t("dashboard.products.dialog.variants.new.description")}</p>
              <label>{t("dashboard.products.dialog.variants.new.field.sku")}<input name="newVariantSku" maxlength="64" placeholder="WIN11-PRO-2PC" /></label>
              <label>{t("dashboard.products.dialog.variants.new.field.title")}<input name="newVariantTitle" maxlength="120" placeholder={t("dashboard.products.dialog.variants.new.placeholder.title")} /></label>
              <label>{t("dashboard.products.dialog.variants.new.field.price", { currency: shop.currency })}<input name="newVariantPriceMajor" type="number" min="0" step={currencyInputStep(shop.currency)} inputmode="decimal" placeholder={formatMinorAmountForInput(299000, shop.currency)} /></label>
              <div class="variant-number-grid"><label>{t("dashboard.products.dialog.variants.new.field.min_per_order")}<input name="newVariantMinPerOrder" type="number" min="1" max="1000" value="1" /></label><label>{t("dashboard.products.dialog.variants.new.field.max_per_order")}<input name="newVariantMaxPerOrder" type="number" min="1" max="1000" value="10" /></label></div>
              <label>{t("dashboard.products.dialog.variants.new.field.status")}<select name="newVariantStatus"><option value="active">{t("dashboard.products.status.active")}</option><option value="archived">{t("dashboard.products.status.archived")}</option></select></label>
            </fieldset>
          </div>
          <div class="dialog-actions"><a class="sln-button sln-button-secondary" href={`/app/products?shop=${encodeURIComponent(shop.publicId)}`}>{t("dashboard.products.dialog.actions.cancel")}</a><button class="sln-button sln-button-secondary" type="button" data-archive-product aria-controls="product-archive-confirmation" aria-expanded="false" disabled={selectedProduct.status === "archived"}>{t("dashboard.products.dialog.actions.archive_product")}</button><button class="sln-button sln-button-primary" type="button" data-save-product>{t("dashboard.products.dialog.actions.save_changes")}</button></div>
          <div id="product-archive-confirmation" class="archive-confirmation" data-product-archive-confirm hidden role="alert"><p>{t("dashboard.products.dialog.archive_product.description")}</p><div><button class="sln-button sln-button-secondary" type="button" data-cancel-product-archive>{t("dashboard.products.category.action.cancel_archive")}</button><button class="sln-button sln-button-danger" type="button" data-confirm-product-archive>{t("dashboard.products.category.action.confirm_archive")}</button></div></div>
          <p class="form-feedback" data-editor-feedback role="status" aria-live="polite"></p>
        </form>
      </dialog>}
    </>
  )}
</AppLayout>


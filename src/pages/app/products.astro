---
import AppLayout from "../../layouts/AppLayout.astro";
import PageHeader from "../../components/workspace/PageHeader.astro";
import DataTable from "../../components/workspace/DataTable.astro";
import Button from "../../components/primitives/Button.astro";
import StatusBadge from "../../components/primitives/StatusBadge.astro";
import WorkspaceState from "../../components/states/WorkspaceState.astro";
import Money from "../../components/commerce/Money.astro";
import { authenticateRequest } from "../../lib/auth/session";
import { listSellerCatalog, listSellerProductsPage, parseSellerProductSort, parseSellerProductStatusFilter } from "../../lib/catalog/store";
import { withSelectedShop } from "../../lib/dashboard/shop-navigation";
import { getBindings } from "../../lib/platform/bindings";
import { listShopsForMember, selectShopForMember } from "../../lib/tenants/store";
import { createDashboardTranslator } from "../../lib/i18n";
import { currencyInputStep, formatMinorAmountForInput } from "../../lib/i18n/currency";
import { isChannelCatalogPublishingAllowed } from "../../lib/channels/expansion";

const env = getBindings();
const auth = await authenticateRequest(Astro.request, env).catch(() => null);
if (auth === null) return Astro.redirect("/login");
const shops = await listShopsForMember({ env, userId: auth.userId });
const shop = selectShopForMember(shops, Astro.url.searchParams.get("shop"));
const workspaceHref = (href: string): string => withSelectedShop(href, shop?.publicId, Astro.url.origin);
const locale = Astro.locals.locale;
const t = createDashboardTranslator(locale);
// The product ledger parses the table URL contract itself (q/status/sort/
// page/pageSize) and passes explicit values into the service; the full
// catalog load below still feeds the summary, visibility and category panels.
const searchParams = Astro.url.searchParams;
const ledgerQuery = searchParams.get("q")?.trim().slice(0, 64) ?? "";
const ledgerStatus = parseSellerProductStatusFilter(searchParams.get("status"));
const ledgerSort = parseSellerProductSort(searchParams.get("sort"));
let catalog: { categories: unknown[]; products: unknown[]; variants: unknown[] } = { categories: [], products: [], variants: [] };
let ledgerPage = 1;
let ledgerPageSize = 25;
let ledgerProducts: Array<Record<string, unknown>> = [];
let ledgerTotalCount = 0;
let ledgerTotalPages = 1;
let canManage = false;
let catalogLoadFailed = false;
if (shop !== undefined && (shop.role === "owner" || shop.role === "manager")) {
  canManage = true;
  const loadedCatalog = await listSellerCatalog({ env, shopPublicId: shop.publicId, userId: auth.userId }).catch(() => null);
  if (loadedCatalog === null) catalogLoadFailed = true;
  else catalog = loadedCatalog;
  const parsedLedgerPage = Number.parseInt(searchParams.get("page") ?? "", 10);
  const requestedLedgerPage = Number.isSafeInteger(parsedLedgerPage) && parsedLedgerPage >= 1 ? parsedLedgerPage : 1;
  const parsedLedgerPageSize = Number.parseInt(searchParams.get("pageSize") ?? "", 10);
  const requestedLedgerPageSize = parsedLedgerPageSize === 25 || parsedLedgerPageSize === 50 || parsedLedgerPageSize === 100 ? parsedLedgerPageSize : 25;
  const result = await listSellerProductsPage({ env, page: requestedLedgerPage, pageSize: requestedLedgerPageSize, search: ledgerQuery === "" ? null : ledgerQuery, shopPublicId: shop.publicId, sort: ledgerSort, status: ledgerStatus, userId: auth.userId }).catch(() => null);
  if (result !== null) {
    ledgerPage = result.page;
    ledgerPageSize = result.pageSize;
    ledgerProducts = result.products as Array<Record<string, unknown>>;
    ledgerTotalCount = result.totalCount;
    ledgerTotalPages = result.totalPages;
  }
}
const products = catalog.products as Array<Record<string, unknown>>;
const categories = catalog.categories as Array<Record<string, unknown>>;
const variants = catalog.variants as Array<Record<string, unknown>>;
const productVariants = new Map<string, Array<Record<string, unknown>>>();
for (const variant of variants) {
  const productId = typeof variant.productId === "string" ? variant.productId : "";
  const list = productVariants.get(productId) ?? [];
  list.push(variant);
  productVariants.set(productId, list);
}
const labelForStatus: Record<string, string> = { active: t("dashboard.products.status.active"), archived: t("dashboard.products.status.archived"), draft: t("dashboard.products.status.draft"), suspended: t("dashboard.products.status.suspended") };
const toneForStatus = (status: unknown): "danger" | "neutral" | "success" | "warning" => status === "active" ? "success" : status === "suspended" ? "danger" : status === "draft" ? "warning" : "neutral";
// Low-stock threshold is shop-level (shop_settings.low_stock_threshold,
// migration 0002); the catalog projects it per variant.
const lowStockThreshold = variants.reduce<number>((threshold, variant) => {
  const value = Number(variant.lowStockThreshold);
  return Number.isSafeInteger(value) && value >= 0 ? value : threshold;
}, 5);
const updatedAtFormatter = new Intl.DateTimeFormat(locale ?? "en", { dateStyle: "medium", timeStyle: "short", timeZone: shop?.timezone ?? "Asia/Ho_Chi_Minh" });
const catalogVisibilityChannels = [
  { code: "website", label: t("dashboard.nav.website") },
  { code: "telegram", label: t("dashboard.nav.telegram") },
  { code: "telegram.mini_app", label: t("dashboard.integrations.channel_expansion.name.telegram_mini_app") },
  { code: "zalo.mini_app", label: t("dashboard.integrations.channel_expansion.name.zalo_mini_app") },
  { code: "zalo.oa", label: t("dashboard.integrations.channel_expansion.name.zalo_oa") },
  { code: "whatsapp.cloud", label: t("dashboard.integrations.channel_expansion.name.whatsapp_cloud") },
  { code: "discord.bot", label: t("dashboard.integrations.channel_expansion.name.discord_bot") },
].map((channel) => ({ ...channel, providerPending: !isChannelCatalogPublishingAllowed(channel.code) }));
const productRows = products.map((product, index) => {
  const productId = String(product.id ?? "");
  const rows = productVariants.get(productId) ?? [];
  const lowest = rows.reduce<number | null>((current, row) => {
    const value = typeof row.priceMinor === "number" ? row.priceMinor : null;
    return value === null ? current : current === null ? value : Math.min(current, value);
  }, null);
  const stock = rows.reduce((sum, row) => sum + (typeof row.availableStock === "number" ? row.availableStock : Number(row.availableStock ?? 0)), 0);
  const projectedUpdatedAt = typeof product.updatedAt === "string" ? product.updatedAt : "";
  const updatedDate = new Date(projectedUpdatedAt);
  const updatedAt = projectedUpdatedAt !== "" && !Number.isNaN(updatedDate.getTime()) ? projectedUpdatedAt : "";
  const updatedLabel = updatedAt === "" ? t("dashboard.commerce.not_recorded") : updatedAtFormatter.format(updatedDate);
  return { product, productId, rows, lowest, stock, index, updatedAt, updatedLabel };
});
const ledgerRows = ledgerProducts.map((product, index) => {
  const productId = String(product.id ?? "");
  const lowest = typeof product.lowestPriceMinor === "number" ? product.lowestPriceMinor : null;
  const stock = Number(product.stock ?? 0);
  const variantCount = Number(product.variantCount ?? 0);
  const projectedUpdatedAt = typeof product.updatedAt === "string" ? product.updatedAt : "";
  const updatedDate = new Date(projectedUpdatedAt);
  const updatedAt = projectedUpdatedAt !== "" && !Number.isNaN(updatedDate.getTime()) ? projectedUpdatedAt : "";
  const updatedLabel = updatedAt === "" ? t("dashboard.commerce.not_recorded") : updatedAtFormatter.format(updatedDate);
  return { product, productId, index, lowest, stock, variantCount, updatedAt, updatedLabel };
});
const ledgerHref = (params: Record<string, number | string | null | undefined>): string => {
  const next = new URLSearchParams();
  for (const [key, value] of Object.entries(params)) {
    if (value === null || value === undefined || value === "") continue;
    next.set(key, String(value));
  }
  const suffix = next.toString();
  return workspaceHref(`/app/products${suffix === "" ? "" : `?${suffix}`}`);
};
const ledgerPageHref = (page: number): string => ledgerHref({
  page,
  pageSize: ledgerPageSize,
  q: ledgerQuery === "" ? null : ledgerQuery,
  sort: searchParams.get("sort"),
  status: ledgerStatus === "all" ? null : ledgerStatus,
});
const ledgerSortBase = ledgerSort.endsWith("_desc") ? ledgerSort.slice(0, -5) : ledgerSort.slice(0, -4);
const ledgerSortDirection: "asc" | "desc" = ledgerSort.endsWith("_desc") ? "desc" : "asc";
const productTableColumns = [
  { key: "title", label: t("dashboard.products.table.product") },
  { label: t("dashboard.products.table.price_variant") },
  { key: "stock", label: t("dashboard.products.table.stock") },
  { label: t("dashboard.products.table.status") },
  { key: "updated", label: t("dashboard.products.table.updated") },
  { label: t("dashboard.products.table.actions") },
];
type ProductExportRow = { lowest: string; status: string; stock: string; title: string; updated: string };
const productExportRows: ProductExportRow[] = shop === undefined ? [] : ledgerRows.map(({ product, lowest, stock, updatedAt }) => ({
  lowest: lowest === null ? "" : `${lowest} ${shop.currency}`,
  status: String(product.status ?? ""),
  stock: String(stock),
  title: String(product.title ?? ""),
  updated: updatedAt,
}));
const productExportHeaders = [
  t("dashboard.products.table.product"),
  t("dashboard.products.table.price_variant"),
  t("dashboard.products.table.stock"),
  t("dashboard.products.table.status"),
  t("dashboard.products.table.updated"),
];
const selectedProductId = Astro.url.searchParams.get("product");
const selectedProduct = selectedProductId === null ? undefined : products.find((product) => product.id === selectedProductId);
const selectedVariants = selectedProduct === undefined ? [] : productVariants.get(String(selectedProduct.id)) ?? [];
---

<AppLayout activePath="/app/products" displayName={auth.displayName.trim() || t("dashboard.commerce.you")} email={auth.email} selectedShopName={shop?.name} selectedShopPublicId={shop?.publicId} shops={shops} title={t("dashboard.products.title")}>
  <PageHeader eyebrow={t("dashboard.products.eyebrow")} title={t("dashboard.products.title")} description={t("dashboard.products.description")}>
    {canManage && <div slot="actions" class="header-actions"><button class="sln-button" data-variant="secondary" type="button" data-open-category-form>{t("dashboard.products.action.add_category")}</button><button class="sln-button" data-variant="primary" type="button" data-open-product-form>{t("dashboard.products.action.add_product")} <span aria-hidden="true">+</span></button></div>}
  </PageHeader>

  {shop === undefined ? (
    <WorkspaceState title={t("dashboard.products.no_store.title")} description={t("dashboard.products.no_store.description")} actionHref={workspaceHref("/onboarding")} actionLabel={t("dashboard.products.no_store.action")} tone="info" />
  ) : !canManage ? (
    <WorkspaceState title={t("dashboard.products.forbidden.title")} description={t("dashboard.products.forbidden.description")} tone="warning" />
  ) : catalogLoadFailed ? (
    <WorkspaceState title={t("dashboard.products.unavailable.title")} description={t("dashboard.products.unavailable.description")} actionHref={workspaceHref("/app/products")} actionLabel={t("dashboard.state.error.retry")} tone="danger" />
  ) : (
    <>
      <section class="catalog-summary" aria-label={t("dashboard.products.summary.aria")}>
        <div><span>{t("dashboard.products.summary.products")}</span><strong>{products.length}</strong><small>{t("dashboard.products.summary.products_caption")}</small></div>
        <div><span>{t("dashboard.products.summary.variants")}</span><strong>{variants.length}</strong><small>{t("dashboard.products.summary.variants_caption")}</small></div>
        <div><span>{t("dashboard.products.summary.active")}</span><strong>{products.filter((product) => product.status === "active").length}</strong><small>{t("dashboard.products.summary.active_caption")}</small></div>
        <div><span>{t("dashboard.products.summary.low_stock")}</span><strong class="warn">{variants.filter((variant) => Number(variant.availableStock ?? 0) <= lowStockThreshold).length}</strong><small>{t("dashboard.products.summary.low_stock_caption")}</small></div>
      </section>

      <section class="visibility-panel" data-channel-visibility-panel data-shop-public-id={shop.publicId} data-csrf-cookie-name={`${env.SESSION_COOKIE_NAME}_csrf`} aria-labelledby="catalog-visibility-title">
        <div class="panel-heading"><div><p class="eyebrow">{t("dashboard.products.visibility.eyebrow")}</p><h2 id="catalog-visibility-title">{t("dashboard.products.visibility.title")}</h2><p class="panel-copy">{t("dashboard.products.visibility.description")}</p></div><span class="record-count">{t("dashboard.products.visibility.count", { count: products.length })}</span></div>
        <p class="form-feedback visibility-feedback" data-channel-visibility-feedback role="status" aria-live="polite">{t("dashboard.products.visibility.loading")}</p><button class="visibility-retry" type="button" data-channel-visibility-retry hidden>{t("dashboard.state.error.retry")}</button>
        {products.length === 0 ? (
          <p class="visibility-empty">{t("dashboard.products.visibility.empty")}</p>
        ) : (
          <div class="visibility-list">
            {productRows.map(({ product, productId, rows }) => (
              <article class="visibility-product" data-channel-visibility-product data-product-id={productId}>
                <div class="visibility-product-heading"><div><strong>{String(product.title ?? t("dashboard.products.product.untitled"))}</strong><small>/{String(product.slug ?? "")}</small></div><StatusBadge label={labelForStatus[String(product.status)] ?? t("dashboard.products.status.unknown")} tone={toneForStatus(product.status)} /></div>
                <div class="visibility-channel-grid" role="group" aria-label={t("dashboard.products.visibility.product_aria", { product: String(product.title ?? t("dashboard.products.product.untitled")) })}>
                  {catalogVisibilityChannels.map((channel) => (
                    <button class="visibility-toggle" type="button" data-visibility-toggle data-product-id={productId} data-channel-code={channel.code} data-channel-label={channel.label} data-provider-pending={channel.providerPending ? "true" : "false"} data-visible="false" data-version="0" aria-pressed="false" aria-disabled={channel.providerPending ? "true" : undefined} disabled>
                      <span class="visibility-channel-name">{channel.label}</span><span class="visibility-state" data-visibility-state>{channel.providerPending ? t("dashboard.integrations.channel_expansion.status_provider_pending") : t("dashboard.products.visibility.hidden")}</span>
                    </button>
                  ))}
                </div>
                <small class="visibility-product-note">{t("dashboard.products.visibility.product_note", { variants: rows.length })}</small>
              </article>
            ))}
          </div>
        )}
      </section>

      <section class="category-panel" aria-labelledby="category-ledger-title" data-category-manager data-shop-public-id={shop.publicId} data-csrf-cookie-name={`${env.SESSION_COOKIE_NAME}_csrf`}>
        <div class="panel-heading"><div><p class="eyebrow">{t("dashboard.products.category.eyebrow")}</p><h2 id="category-ledger-title">{t("dashboard.products.category.title")}</h2></div><span class="record-count">{t("dashboard.products.category.count", { count: categories.length })}</span></div>
        {categories.length === 0 ? (
          <p class="category-empty">{t("dashboard.products.category.empty")}</p>
        ) : (
          <div class="category-list">
            {categories.map((category) => <article class="category-row" data-category-editor data-category-id={String(category.id)}>
              <div class="category-fields">
                <label>{t("dashboard.products.category.field.name")}<input name="name" required minlength="2" maxlength="120" value={String(category.name ?? "")} /></label>
                <label>{t("dashboard.products.category.field.slug")}<input name="slug" required minlength="2" maxlength="80" pattern="[a-z0-9](?:[a-z0-9-]*[a-z0-9])?" value={String(category.slug ?? "")} /></label>
                <label>{t("dashboard.products.category.field.sort_order")}<input name="sortOrder" type="number" min="-10000" max="10000" step="1" value={String(category.sortOrder ?? 0)} /></label>
                <label>{t("dashboard.products.category.field.status")}<select name="status"><option value="active" selected={category.status === "active"}>{t("dashboard.products.category.status.active")}</option><option value="draft" selected={category.status === "draft"}>{t("dashboard.products.category.status.draft")}</option>{category.status === "archived" && <option value="archived" selected>{t("dashboard.products.category.status.archived")}</option>}</select></label>
                <label class="category-description">{t("dashboard.products.category.field.description")}<textarea name="description" rows="2" maxlength="10000">{String(category.description ?? "")}</textarea></label>
              </div>
              <div class="category-actions"><button class="sln-button" data-variant="secondary" type="button" data-save-category>{t("dashboard.products.category.action.save")}</button><button class="sln-button" data-variant="secondary" type="button" data-request-category-archive aria-controls={`category-archive-${String(category.id)}`} aria-expanded="false" disabled={category.status === "archived"}>{t("dashboard.products.category.action.archive")}</button></div>
              <div id={`category-archive-${String(category.id)}`} class="archive-confirmation" data-category-archive-confirm hidden role="alert"><p>{t("dashboard.products.category.archive.description")}</p><div><button class="sln-button" data-variant="secondary" type="button" data-cancel-category-archive>{t("dashboard.products.category.action.cancel_archive")}</button><button class="sln-button" data-variant="danger" type="button" data-confirm-category-archive>{t("dashboard.products.category.action.confirm_archive")}</button></div></div>
              <p class="form-feedback" data-category-editor-feedback role="status" aria-live="polite"></p>
            </article>)}
          </div>
        )}
      </section>

      <section class="ledger-panel" aria-labelledby="product-ledger-title" data-product-ledger data-locale={locale ?? "en"} data-export-copy={JSON.stringify({ headers: productExportHeaders })} data-export-rows={JSON.stringify(productExportRows)}>
        <div class="panel-heading">
          <div><p class="eyebrow">{t("dashboard.products.ledger.eyebrow")}</p><h2 id="product-ledger-title">{t("dashboard.products.ledger.title")}</h2></div>
          <div class="panel-heading-tools">
            <span class="record-count">{t("dashboard.products.ledger.count", { count: ledgerTotalCount })}</span>
            {ledgerRows.length > 0 && <Button type="button" variant="secondary" data-product-export>{t("dashboard.table.export")}</Button>}
          </div>
        </div>
        {products.length === 0 ? (
          <WorkspaceState title={t("dashboard.products.ledger.empty.title")} description={t("dashboard.products.ledger.empty.description")} tone="info" />
        ) : (
          <>
            <form class="catalog-toolbar" method="get" aria-label={t("dashboard.products.filters.aria")}>
              {searchParams.get("shop") !== null && <input type="hidden" name="shop" value={searchParams.get("shop") ?? ""} aria-label="shop" />}
              <label>{t("dashboard.products.search.label")}<input type="search" name="q" value={ledgerQuery} placeholder={t("dashboard.products.search.placeholder")} maxlength="64" autocomplete="off" data-product-search /></label>
              <label>{t("dashboard.products.filter.status_label")}<select name="status" data-product-status><option value="" selected={ledgerStatus === "all"}>{t("dashboard.products.filter.all")}</option><option value="active" selected={ledgerStatus === "active"}>{t("dashboard.products.filter.active")}</option><option value="draft" selected={ledgerStatus === "draft"}>{t("dashboard.products.filter.draft")}</option><option value="suspended" selected={ledgerStatus === "suspended"}>{t("dashboard.products.filter.suspended")}</option><option value="archived" selected={ledgerStatus === "archived"}>{t("dashboard.products.filter.archived")}</option><option value="out_of_stock" selected={ledgerStatus === "out_of_stock"}>{t("dashboard.products.filter.out_of_stock")}</option></select></label>
              <Button type="submit" variant="secondary">{t("dashboard.table.apply")}</Button>
            </form>
            {ledgerRows.length === 0 ? (
              <p class="catalog-no-results">{t("dashboard.products.no_results")}</p>
            ) : (
              <DataTable caption={t("dashboard.products.table.aria")} columns={productTableColumns} currentSort={ledgerSortBase} currentSortDirection={ledgerSortDirection} currentUrl={Astro.url}>
                <tbody>
                  {ledgerRows.map(({ product, productId, index, lowest, stock, variantCount, updatedAt, updatedLabel }) => (
                    <tr data-product-row data-product-status={String(product.status ?? "")} data-product-stock={stock === 0 ? "out_of_stock" : "available"} data-product-search-text={`${String(product.title ?? "")} ${String(product.slug ?? "")}`}>
                      <td data-label={t("dashboard.products.table.product")}><span class="product-index">{String((ledgerPage - 1) * ledgerPageSize + index + 1).padStart(2, "0")}</span><div class="product-cell-title"><strong>{String(product.title ?? t("dashboard.products.product.untitled"))}</strong><small>/{String(product.slug ?? "")}</small></div></td>
                      <td data-label={t("dashboard.products.table.price_variant")}>{lowest === null ? <span>{t("dashboard.products.price.none")}</span> : <Money value={lowest} currency={shop.currency} locale={locale ?? "en"} />}<small>{t("dashboard.products.variant.count", { count: variantCount })}</small></td>
                      <td data-label={t("dashboard.products.table.stock")}><strong>{stock}</strong><small>{stock === 0 ? t("dashboard.products.stock.out") : stock <= lowStockThreshold ? t("dashboard.products.stock.low") : t("dashboard.products.stock.available")}</small></td>
                      <td data-label={t("dashboard.products.table.status")}><StatusBadge label={labelForStatus[String(product.status)] ?? t("dashboard.products.status.unknown")} tone={toneForStatus(product.status)} /></td>
                      <td data-label={t("dashboard.products.table.updated")}>{updatedAt === "" ? <span>{updatedLabel}</span> : <time datetime={updatedAt}>{updatedLabel}</time>}<small>{t("dashboard.products.updated.record")}</small></td>
                      <td class="cell-end" data-label={t("dashboard.products.table.actions")}><a href={workspaceHref(`/app/products?product=${encodeURIComponent(productId)}`)} aria-label={t("dashboard.products.row.open_aria", { product: String(product.title ?? t("dashboard.products.product.untitled")) })}>{t("dashboard.products.row.open")} <span aria-hidden="true">→</span></a></td>
                    </tr>
                  ))}
                </tbody>
                <nav slot="pagination" class="table-pagination" aria-label={t("dashboard.products.pagination.aria")}>
                  {ledgerPage > 1 && <a href={ledgerPageHref(ledgerPage - 1)}>← {t("dashboard.table.previous")}</a>}
                  <span>{t("dashboard.table.page_info", { page: ledgerPage, totalPages: ledgerTotalPages })}</span>
                  {ledgerPage < ledgerTotalPages && <a href={ledgerPageHref(ledgerPage + 1)}>{t("dashboard.table.next")} →</a>}
                  <form class="page-size-form" method="get">
                    {searchParams.get("shop") !== null && <input type="hidden" name="shop" value={searchParams.get("shop") ?? ""} aria-label="shop" />}
                    {ledgerQuery !== "" && <input type="hidden" name="q" value={ledgerQuery} aria-label="q" />}
                    {ledgerStatus !== "all" && <input type="hidden" name="status" value={ledgerStatus} aria-label="status" />}
                    {searchParams.get("sort") !== null && <input type="hidden" name="sort" value={searchParams.get("sort") ?? ""} aria-label="sort" />}
                    <label>{t("dashboard.table.rows_per_page")}
                      <select name="pageSize" data-page-size-select>
                        {[25, 50, 100].map((size) => <option value={size} selected={ledgerPageSize === size}>{size}</option>)}
                      </select>
                    </label>
                  </form>
                </nav>
              </DataTable>
            )}
            <p class="catalog-no-results" data-product-no-results hidden>{t("dashboard.products.no_results")}</p>
          </>
        )}
      </section>

      {canManage && (
        <section class="ledger-panel discounts-panel" aria-labelledby="discount-ledger-title" data-discounts-workspace data-shop-public-id={shop.publicId} data-csrf-cookie-name={`${env.SESSION_COOKIE_NAME}_csrf`} data-default-currency={shop.currency} data-time-zone={shop?.timezone ?? "Asia/Ho_Chi_Minh"}>
          <div class="panel-heading">
            <p class="eyebrow">{t("dashboard.discounts.eyebrow")}</p>
            <h2 id="discount-ledger-title">{t("dashboard.discounts.title")}</h2>
            <span>{t("dashboard.discounts.description")}</span>
            <button class="sln-button" data-variant="secondary" type="button" data-open-discount-form>{t("dashboard.discounts.action.create")}</button>
          </div>
          <p class="dialog-copy" data-discounts-feedback hidden></p>
          <div class="discount-table-wrap" tabindex="0" role="region" aria-labelledby="discount-ledger-title">
            <table class="discount-table">
              <thead>
                <tr>
                  <th scope="col">{t("dashboard.discounts.table.code")}</th>
                  <th scope="col">{t("dashboard.discounts.table.value")}</th>
                  <th scope="col">{t("dashboard.discounts.table.minimum")}</th>
                  <th scope="col">{t("dashboard.discounts.table.window")}</th>
                  <th scope="col">{t("dashboard.discounts.table.status")}</th>
                  <th scope="col">{t("dashboard.discounts.table.actions")}</th>
                </tr>
              </thead>
              <tbody data-discount-rows></tbody>
            </table>
            <p class="catalog-no-results" data-discounts-empty hidden>{t("dashboard.discounts.empty")}</p>
          </div>
        </section>
      )}

      {canManage && (

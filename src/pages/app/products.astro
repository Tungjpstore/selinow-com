---
import AppLayout from "../../layouts/AppLayout.astro";
import PageHeader from "../../components/workspace/PageHeader.astro";
import StatusBadge from "../../components/primitives/StatusBadge.astro";
import WorkspaceState from "../../components/states/WorkspaceState.astro";
import Money from "../../components/commerce/Money.astro";
import { authenticateRequest } from "../../lib/auth/session";
import { listSellerCatalog } from "../../lib/catalog/store";
import { withSelectedShop } from "../../lib/dashboard/shop-navigation";
import { getBindings } from "../../lib/platform/bindings";
import { listShopsForMember, selectShopForMember } from "../../lib/tenants/store";
import { createDashboardTranslator } from "../../lib/i18n";
import { currencyInputStep, formatMinorAmountForInput } from "../../lib/i18n/currency";
import { isChannelCatalogPublishingAllowed } from "../../lib/channels/expansion";

const env = getBindings();
const auth = await authenticateRequest(Astro.request, env).catch(() => null);
if (auth === null) return Astro.redirect("/login");
const shops = await listShopsForMember({ env, userId: auth.userId });
const shop = selectShopForMember(shops, Astro.url.searchParams.get("shop"));
const workspaceHref = (href: string): string => withSelectedShop(href, shop?.publicId, Astro.url.origin);
const locale = Astro.locals.locale;
const t = createDashboardTranslator(locale);
let catalog: { categories: unknown[]; products: unknown[]; variants: unknown[] } = { categories: [], products: [], variants: [] };
let canManage = false;
if (shop !== undefined && (shop.role === "owner" || shop.role === "manager")) {
  canManage = true;
  catalog = await listSellerCatalog({ env, shopPublicId: shop.publicId, userId: auth.userId }).catch(() => catalog);
}
const products = catalog.products as Array<Record<string, unknown>>;
const categories = catalog.categories as Array<Record<string, unknown>>;
const variants = catalog.variants as Array<Record<string, unknown>>;
const productVariants = new Map<string, Array<Record<string, unknown>>>();
for (const variant of variants) {
  const productId = typeof variant.productId === "string" ? variant.productId : "";
  const list = productVariants.get(productId) ?? [];
  list.push(variant);
  productVariants.set(productId, list);
}
const labelForStatus: Record<string, string> = { active: t("dashboard.products.status.active"), archived: t("dashboard.products.status.archived"), draft: t("dashboard.products.status.draft"), suspended: t("dashboard.products.status.suspended") };
const toneForStatus = (status: unknown): "danger" | "neutral" | "success" | "warning" => status === "active" ? "success" : status === "suspended" ? "danger" : status === "draft" ? "warning" : "neutral";
const updatedAtFormatter = new Intl.DateTimeFormat(locale ?? "en", { dateStyle: "medium", timeStyle: "short", timeZone: shop?.timezone ?? "Asia/Ho_Chi_Minh" });
const catalogVisibilityChannels = [
  { code: "website", label: t("dashboard.nav.website") },
  { code: "telegram", label: t("dashboard.nav.telegram") },
  { code: "telegram.mini_app", label: t("dashboard.integrations.channel_expansion.name.telegram_mini_app") },
  { code: "zalo.mini_app", label: t("dashboard.integrations.channel_expansion.name.zalo_mini_app") },
  { code: "zalo.oa", label: t("dashboard.integrations.channel_expansion.name.zalo_oa") },
  { code: "whatsapp.cloud", label: t("dashboard.integrations.channel_expansion.name.whatsapp_cloud") },
  { code: "discord.bot", label: t("dashboard.integrations.channel_expansion.name.discord_bot") },
].map((channel) => ({ ...channel, providerPending: !isChannelCatalogPublishingAllowed(channel.code) }));
const productRows = products.map((product, index) => {
  const productId = String(product.id ?? "");
  const rows = productVariants.get(productId) ?? [];
  const lowest = rows.reduce<number | null>((current, row) => {
    const value = typeof row.priceMinor === "number" ? row.priceMinor : null;
    return value === null ? current : current === null ? value : Math.min(current, value);
  }, null);
  const stock = rows.reduce((sum, row) => sum + (typeof row.availableStock === "number" ? row.availableStock : Number(row.availableStock ?? 0)), 0);
  const projectedUpdatedAt = typeof product.updatedAt === "string" ? product.updatedAt : "";
  const updatedDate = new Date(projectedUpdatedAt);
  const updatedAt = projectedUpdatedAt !== "" && !Number.isNaN(updatedDate.getTime()) ? projectedUpdatedAt : "";
  const updatedLabel = updatedAt === "" ? t("dashboard.commerce.not_recorded") : updatedAtFormatter.format(updatedDate);
  return { product, productId, rows, lowest, stock, index, updatedAt, updatedLabel };
});
const selectedProductId = Astro.url.searchParams.get("product");
const selectedProduct = selectedProductId === null ? undefined : products.find((product) => product.id === selectedProductId);
const selectedVariants = selectedProduct === undefined ? [] : productVariants.get(String(selectedProduct.id)) ?? [];
---

<AppLayout activePath="/app/products" displayName={auth.displayName.trim() || t("dashboard.commerce.you")} email={auth.email} selectedShopName={shop?.name} selectedShopPublicId={shop?.publicId} shops={shops} title={t("dashboard.products.title")}>
  <PageHeader eyebrow={t("dashboard.products.eyebrow")} title={t("dashboard.products.title")} description={t("dashboard.products.description")}>
    {canManage && <div slot="actions" class="header-actions"><button class="sln-button sln-button-secondary" type="button" data-open-category-form>{t("dashboard.products.action.add_category")}</button><button class="sln-button sln-button-primary" type="button" data-open-product-form>{t("dashboard.products.action.add_product")} <span aria-hidden="true">+</span></button></div>}
  </PageHeader>

  {shop === undefined ? (
    <WorkspaceState title={t("dashboard.products.no_store.title")} description={t("dashboard.products.no_store.description")} actionHref={workspaceHref("/onboarding")} actionLabel={t("dashboard.products.no_store.action")} tone="info" />
  ) : !canManage ? (
    <WorkspaceState title={t("dashboard.products.forbidden.title")} description={t("dashboard.products.forbidden.description")} tone="warning" />
  ) : (
    <>
      <section class="catalog-summary" aria-label={t("dashboard.products.summary.aria")}>
        <div><span>{t("dashboard.products.summary.products")}</span><strong>{products.length}</strong><small>{t("dashboard.products.summary.products_caption")}</small></div>
        <div><span>{t("dashboard.products.summary.variants")}</span><strong>{variants.length}</strong><small>{t("dashboard.products.summary.variants_caption")}</small></div>
        <div><span>{t("dashboard.products.summary.active")}</span><strong>{products.filter((product) => product.status === "active").length}</strong><small>{t("dashboard.products.summary.active_caption")}</small></div>
        <div><span>{t("dashboard.products.summary.low_stock")}</span><strong class="warn">{variants.filter((variant) => Number(variant.availableStock ?? 0) < 5).length}</strong><small>{t("dashboard.products.summary.low_stock_caption")}</small></div>
      </section>

      <section class="visibility-panel" data-channel-visibility-panel data-shop-public-id={shop.publicId} data-csrf-cookie-name={`${env.SESSION_COOKIE_NAME}_csrf`} aria-labelledby="catalog-visibility-title">
        <div class="panel-heading"><div><p class="eyebrow">{t("dashboard.products.visibility.eyebrow")}</p><h2 id="catalog-visibility-title">{t("dashboard.products.visibility.title")}</h2><p class="panel-copy">{t("dashboard.products.visibility.description")}</p></div><span class="record-count">{t("dashboard.products.visibility.count", { count: products.length })}</span></div>
        <p class="form-feedback visibility-feedback" data-channel-visibility-feedback role="status" aria-live="polite">{t("dashboard.products.visibility.loading")}</p><button class="visibility-retry" type="button" data-channel-visibility-retry hidden>{t("dashboard.state.error.retry")}</button>
        {products.length === 0 ? (
          <p class="visibility-empty">{t("dashboard.products.visibility.empty")}</p>
        ) : (
          <div class="visibility-list">
            {productRows.map(({ product, productId, rows }) => (
              <article class="visibility-product" data-channel-visibility-product data-product-id={productId}>
                <div class="visibility-product-heading"><div><strong>{String(product.title ?? t("dashboard.products.product.untitled"))}</strong><small>/{String(product.slug ?? "")}</small></div><StatusBadge label={labelForStatus[String(product.status)] ?? t("dashboard.products.status.unknown")} tone={toneForStatus(product.status)} /></div>
                <div class="visibility-channel-grid" role="group" aria-label={t("dashboard.products.visibility.product_aria", { product: String(product.title ?? t("dashboard.products.product.untitled")) })}>
                  {catalogVisibilityChannels.map((channel) => (
                    <button class="visibility-toggle" type="button" data-visibility-toggle data-product-id={productId} data-channel-code={channel.code} data-channel-label={channel.label} data-provider-pending={channel.providerPending ? "true" : "false"} data-visible="false" data-version="0" aria-pressed="false" aria-disabled={channel.providerPending ? "true" : undefined} disabled>
                      <span class="visibility-channel-name">{channel.label}</span><span class="visibility-state" data-visibility-state>{channel.providerPending ? t("dashboard.integrations.channel_expansion.status_provider_pending") : t("dashboard.products.visibility.hidden")}</span>
                    </button>
                  ))}
                </div>
                <small class="visibility-product-note">{t("dashboard.products.visibility.product_note", { variants: rows.length })}</small>
              </article>
            ))}
          </div>
        )}
      </section>

      <section class="category-panel" aria-labelledby="category-ledger-title" data-category-manager data-shop-public-id={shop.publicId} data-csrf-cookie-name={`${env.SESSION_COOKIE_NAME}_csrf`}>
        <div class="panel-heading"><div><p class="eyebrow">{t("dashboard.products.category.eyebrow")}</p><h2 id="category-ledger-title">{t("dashboard.products.category.title")}</h2></div><span class="record-count">{t("dashboard.products.category.count", { count: categories.length })}</span></div>
        {categories.length === 0 ? (
          <p class="category-empty">{t("dashboard.products.category.empty")}</p>
        ) : (
          <div class="category-list">
            {categories.map((category) => <article class="category-row" data-category-editor data-category-id={String(category.id)}>
              <div class="category-fields">
                <label>{t("dashboard.products.category.field.name")}<input name="name" required minlength="2" maxlength="120" value={String(category.name ?? "")} /></label>
                <label>{t("dashboard.products.category.field.slug")}<input name="slug" required minlength="2" maxlength="80" pattern="[a-z0-9](?:[a-z0-9-]*[a-z0-9])?" value={String(category.slug ?? "")} /></label>
                <label>{t("dashboard.products.category.field.sort_order")}<input name="sortOrder" type="number" min="-10000" max="10000" step="1" value={String(category.sortOrder ?? 0)} /></label>
                <label>{t("dashboard.products.category.field.status")}<select name="status"><option value="active" selected={category.status === "active"}>{t("dashboard.products.category.status.active")}</option><option value="draft" selected={category.status === "draft"}>{t("dashboard.products.category.status.draft")}</option>{category.status === "archived" && <option value="archived" selected>{t("dashboard.products.category.status.archived")}</option>}</select></label>
                <label class="category-description">{t("dashboard.products.category.field.description")}<textarea name="description" rows="2" maxlength="10000">{String(category.description ?? "")}</textarea></label>
              </div>
              <div class="category-actions"><button class="sln-button sln-button-secondary" type="button" data-save-category>{t("dashboard.products.category.action.save")}</button><button class="sln-button sln-button-secondary" type="button" data-request-category-archive aria-controls={`category-archive-${String(category.id)}`} aria-expanded="false" disabled={category.status === "archived"}>{t("dashboard.products.category.action.archive")}</button></div>
              <div id={`category-archive-${String(category.id)}`} class="archive-confirmation" data-category-archive-confirm hidden role="alert"><p>{t("dashboard.products.category.archive.description")}</p><div><button class="sln-button sln-button-secondary" type="button" data-cancel-category-archive>{t("dashboard.products.category.action.cancel_archive")}</button><button class="sln-button sln-button-danger" type="button" data-confirm-category-archive>{t("dashboard.products.category.action.confirm_archive")}</button></div></div>
              <p class="form-feedback" data-category-editor-feedback role="status" aria-live="polite"></p>
            </article>)}
          </div>
        )}
      </section>

      <section class="ledger-panel" aria-labelledby="product-ledger-title">
        <div class="panel-heading"><div><p class="eyebrow">{t("dashboard.products.ledger.eyebrow")}</p><h2 id="product-ledger-title">{t("dashboard.products.ledger.title")}</h2></div><span class="record-count">{t("dashboard.products.ledger.count", { count: products.length })}</span></div>
        {products.length === 0 ? (
          <WorkspaceState title={t("dashboard.products.ledger.empty.title")} description={t("dashboard.products.ledger.empty.description")} tone="info" />
        ) : (
          <><div class="catalog-toolbar">
            <label>{t("dashboard.products.search.label")}<input type="search" placeholder={t("dashboard.products.search.placeholder")} data-product-search /></label>
            <label>{t("dashboard.products.filter.status_label")}<select data-product-status><option value="">{t("dashboard.products.filter.all")}</option><option value="active">{t("dashboard.products.filter.active")}</option><option value="draft">{t("dashboard.products.filter.draft")}</option><option value="suspended">{t("dashboard.products.filter.suspended")}</option><option value="archived">{t("dashboard.products.filter.archived")}</option><option value="out_of_stock">{t("dashboard.products.filter.out_of_stock")}</option></select></label>
          </div><div class="product-table" role="table" aria-label={t("dashboard.products.table.aria")}>
            <div class="table-head" role="row"><span role="columnheader">{t("dashboard.products.table.product")}</span><span role="columnheader">{t("dashboard.products.table.price_variant")}</span><span role="columnheader">{t("dashboard.products.table.stock")}</span><span role="columnheader">{t("dashboard.products.table.status")}</span><span role="columnheader">{t("dashboard.products.table.updated")}</span><span role="columnheader">{t("dashboard.products.table.actions")}</span></div>
            {productRows.map(({ product, productId, rows, lowest, stock, index, updatedAt, updatedLabel }) => (
              <article class="table-row" role="row" data-product-row data-product-status={String(product.status ?? "")} data-product-stock={stock === 0 ? "out_of_stock" : "available"} data-product-search-text={`${String(product.title ?? "")} ${String(product.slug ?? "")} ${rows.map((row) => `${String(row.sku ?? "")} ${String(row.title ?? "")}`).join(" ")}`}>
                <div class="product-cell" role="cell"><span class="product-index">{String(index + 1).padStart(2, "0")}</span><div><strong>{String(product.title ?? t("dashboard.products.product.untitled"))}</strong><small>/{String(product.slug ?? "")}</small></div></div>
                <div class="price-cell" role="cell">{lowest === null ? <span>{t("dashboard.products.price.none")}</span> : <Money value={lowest} currency={shop.currency} locale={locale ?? "en"} />}<small>{t("dashboard.products.variant.count", { count: rows.length })}</small></div>
                <div class="stock-cell" role="cell"><strong>{stock}</strong><small>{stock === 0 ? t("dashboard.products.stock.out") : stock < 5 ? t("dashboard.products.stock.low") : t("dashboard.products.stock.available")}</small></div>
                <div role="cell"><StatusBadge label={labelForStatus[String(product.status)] ?? t("dashboard.products.status.unknown")} tone={toneForStatus(product.status)} /></div>
                <div class="updated-cell" role="cell">{updatedAt === "" ? <span>{updatedLabel}</span> : <time datetime={updatedAt}>{updatedLabel}</time>}<small>{t("dashboard.products.updated.record")}</small></div>
                <div class="row-action" role="cell"><a href={workspaceHref(`/app/products?product=${encodeURIComponent(productId)}`)} aria-label={t("dashboard.products.row.open_aria", { product: String(product.title ?? t("dashboard.products.product.untitled")) })}>{t("dashboard.products.row.open")} <span aria-hidden="true">→</span></a></div>
              </article>
            ))}
          </div><p class="catalog-no-results" data-product-no-results hidden>{t("dashboard.products.no_results")}</p></>
        )}
      </section>

      <dialog class="product-dialog" data-product-dialog data-shop-public-id={shop.publicId} data-default-currency={shop.currency} data-csrf-cookie-name={`${env.SESSION_COOKIE_NAME}_csrf`} aria-labelledby="product-dialog-title">
        <form method="dialog" class="dialog-card" data-product-form>
          <button class="dialog-close" type="submit" aria-label={t("dashboard.products.dialog.actions.close")}>×</button>
          <p class="eyebrow">{t("dashboard.products.dialog.product_create.eyebrow")}</p><h2 id="product-dialog-title">{t("dashboard.products.dialog.product_create.title")}</h2>
          <p class="dialog-copy">{t("dashboard.products.dialog.product_create.description")}</p>
          <label>{t("dashboard.products.dialog.product_create.field.title")}<input name="title" required minlength="2" maxlength="120" placeholder={t("dashboard.products.dialog.product_create.placeholder.title")} /></label>
          <label>{t("dashboard.products.dialog.product_create.field.slug")}<input name="slug" required minlength="2" maxlength="80" pattern="[a-z0-9](?:[a-z0-9-]*[a-z0-9])?" placeholder={t("dashboard.products.dialog.product_create.placeholder.slug")} /></label>
          <label>{t("dashboard.products.dialog.product_create.field.category")}<select name="categoryId"><option value="">{t("dashboard.products.dialog.product_create.field.uncategorized")}</option>{categories.map((category) => <option value={String(category.id)}>{String(category.name ?? t("dashboard.products.product.category_fallback"))}</option>)}</select></label>
          <label>{t("dashboard.products.dialog.product_create.field.description")}<textarea name="description" rows="3" maxlength="10000" placeholder={t("dashboard.products.dialog.product_create.placeholder.description")}></textarea></label>
          <label>{t("dashboard.products.dialog.product_create.field.first_sku")}<input name="sku" required maxlength="64" placeholder={t("dashboard.products.dialog.product_create.placeholder.first_sku")} /></label>
           <label>{t("dashboard.products.dialog.product_create.field.variant_title")}<input name="variantTitle" required maxlength="120" value={t("dashboard.products.dialog.product_create.default_variant_title")} /></label>
          <label>{t("dashboard.products.dialog.product_create.field.price", { currency: shop.currency })}<input name="priceMajor" type="number" inputmode="decimal" min="0" step={currencyInputStep(shop.currency)} required placeholder={formatMinorAmountForInput(199000, shop.currency)} /></label>
          <div class="dialog-actions"><button class="sln-button sln-button-secondary" type="submit">{t("dashboard.products.dialog.actions.cancel")}</button><button class="sln-button sln-button-primary" type="button" data-create-product>{t("dashboard.products.dialog.actions.create_draft")}</button></div>
          <p class="form-feedback" data-form-feedback role="status" aria-live="polite"></p>
        </form>
      </dialog>
      <dialog class="product-dialog" data-category-dialog data-shop-public-id={shop.publicId} data-default-currency={shop.currency} data-csrf-cookie-name={`${env.SESSION_COOKIE_NAME}_csrf`} aria-labelledby="category-dialog-title">
        <form method="dialog" class="dialog-card" data-category-form>
          <button class="dialog-close" type="submit" aria-label={t("dashboard.products.dialog.actions.close")}>×</button>
          <p class="eyebrow">{t("dashboard.products.dialog.category_create.eyebrow")}</p><h2 id="category-dialog-title">{t("dashboard.products.dialog.category_create.title")}</h2>
          <p class="dialog-copy">{t("dashboard.products.dialog.category_create.description")}</p>
          <label>{t("dashboard.products.dialog.category_create.field.name")}<input name="name" required minlength="2" maxlength="120" placeholder={t("dashboard.products.dialog.category_create.placeholder.name")} /></label>
          <label>{t("dashboard.products.dialog.category_create.field.slug")}<input name="slug" required minlength="2" maxlength="80" pattern="[a-z0-9](?:[a-z0-9-]*[a-z0-9])?" placeholder={t("dashboard.products.dialog.category_create.placeholder.slug")} /></label>
          <label>{t("dashboard.products.dialog.category_create.field.description")}<textarea name="description" rows="3" maxlength="10000" placeholder={t("dashboard.products.dialog.category_create.placeholder.description")}></textarea></label>
          <label>{t("dashboard.products.dialog.category_create.field.status")}<select name="status"><option value="active">{t("dashboard.products.category.status.active")}</option><option value="draft">{t("dashboard.products.category.status.draft")}</option></select></label>
          <div class="dialog-actions"><button class="sln-button sln-button-secondary" type="submit">{t("dashboard.products.dialog.actions.cancel")}</button><button class="sln-button sln-button-primary" type="button" data-create-category>{t("dashboard.products.dialog.actions.create_category")}</button></div>
          <p class="form-feedback" data-category-feedback role="status" aria-live="polite"></p>
        </form>
      </dialog>
      {selectedProduct !== undefined && <dialog class="product-dialog" open data-product-editor data-product-id={String(selectedProduct.id)} data-shop-public-id={shop.publicId} data-default-currency={shop.currency} data-csrf-cookie-name={`${env.SESSION_COOKIE_NAME}_csrf`} aria-labelledby="product-editor-title">
        <form method="dialog" class="dialog-card" data-product-editor-form>
          <a class="dialog-close" href={`/app/products?shop=${encodeURIComponent(shop.publicId)}`} aria-label={t("dashboard.products.dialog.actions.close")}>×</a>
          <p class="eyebrow">{t("dashboard.products.dialog.product_editor.eyebrow")}</p><h2 id="product-editor-title">{t("dashboard.products.dialog.product_editor.title")}</h2>
          <p class="dialog-copy">{t("dashboard.products.dialog.product_editor.description")}</p>
          <label>{t("dashboard.products.dialog.product_editor.field.title")}<input name="title" required minlength="2" maxlength="120" value={String(selectedProduct.title ?? "")} /></label>
          <label>{t("dashboard.products.dialog.product_editor.field.slug")}<input name="slug" required minlength="2" maxlength="80" pattern="[a-z0-9](?:[a-z0-9-]*[a-z0-9])?" value={String(selectedProduct.slug ?? "")} /></label>
          <label>{t("dashboard.products.dialog.product_editor.field.category")}<select name="categoryId"><option value="">{t("dashboard.products.dialog.product_editor.field.uncategorized")}</option>{categories.map((category) => <option value={String(category.id)} selected={category.id === selectedProduct.categoryId}>{String(category.name ?? t("dashboard.products.product.category_fallback"))}</option>)}</select></label>
          <label>{t("dashboard.products.dialog.product_editor.field.description")}<textarea name="description" rows="3" maxlength="10000">{String(selectedProduct.description ?? "")}</textarea></label>
          <label>{t("dashboard.products.dialog.product_editor.field.fulfillment_type")}<select name="fulfillmentType"><option value="license_key" selected={selectedProduct.fulfillmentType === "license_key"}>{t("dashboard.products.dialog.product_editor.fulfillment.license_key")}</option><option value="manual" selected={selectedProduct.fulfillmentType === "manual"}>{t("dashboard.products.dialog.product_editor.fulfillment.manual")}</option></select></label>
          <label>{t("dashboard.products.dialog.product_editor.field.status")}<select name="status"><option value="draft" selected={selectedProduct.status === "draft"}>{t("dashboard.products.status.draft")}</option><option value="active" selected={selectedProduct.status === "active"}>{t("dashboard.products.status.active")}</option>{selectedProduct.status === "archived" && <option value="archived" selected>{t("dashboard.products.status.archived")}</option>}<option value="suspended" selected={selectedProduct.status === "suspended"}>{t("dashboard.products.status.suspended")}</option></select></label>
          <fieldset class="private-file-controls" data-private-file-controls hidden={selectedProduct.fulfillmentType !== "manual"}>
            <legend>{t("dashboard.products.dialog.private_file.title")}</legend>
            <p class="dialog-copy">{t("dashboard.products.dialog.private_file.description")}</p>
            <label>{t("dashboard.products.dialog.private_file.file_label")}<input type="file" data-private-file-input /></label>
            <div class="private-file-grid">
              <label>{t("dashboard.products.dialog.private_file.max_downloads")}<input type="number" min="1" max="100" step="1" value="3" data-private-file-max-downloads /></label>
              <label>{t("dashboard.products.dialog.private_file.grant_ttl")}<input type="number" min="60" max="86400" step="1" value="600" data-private-file-grant-ttl /></label>
              <label>{t("dashboard.products.dialog.private_file.entitlement_ttl")}<input type="number" min="300" max="31536000" step="1" placeholder={t("dashboard.products.dialog.private_file.entitlement_ttl_placeholder")} data-private-file-entitlement-ttl /></label>
            </div>
            <div class="private-file-actions"><button class="sln-button sln-button-secondary" type="button" data-upload-private-file>{t("dashboard.products.dialog.private_file.upload")}</button><button class="sln-button sln-button-primary" type="button" data-save-private-file-policy disabled>{t("dashboard.products.dialog.private_file.activate")}</button></div>
            <p class="private-file-metadata" data-private-file-metadata hidden></p>
            <p class="form-feedback" data-private-file-feedback role="status" aria-live="polite"></p>
          </fieldset>
          <div class="variant-editor-list">
            <p class="eyebrow">{t("dashboard.products.dialog.variants.eyebrow")}</p>

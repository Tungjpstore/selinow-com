---
import AppLayout from "../../layouts/AppLayout.astro";
import PageHeader from "../../components/workspace/PageHeader.astro";
import StatusBadge from "../../components/primitives/StatusBadge.astro";
import WorkspaceState from "../../components/states/WorkspaceState.astro";
import { authenticateRequest } from "../../lib/auth/session";
import { domainState, loadErrorState, unavailableState, paymentState, telegramState } from "../../lib/dashboard/integrations-view";
import { listShopDomains, type DomainView } from "../../lib/domains/store";
import { withSelectedShop } from "../../lib/dashboard/shop-navigation";
import { getBindings } from "../../lib/platform/bindings";
import { getPaymentIntegration, type PaymentIntegrationView } from "../../lib/payments/integrations";
import { getTelegramIntegration, type TelegramIntegrationView } from "../../lib/telegram/integrations";
import { listShopsForMember, selectShopForMember } from "../../lib/tenants/store";
import { createDashboardTranslator } from "../../lib/i18n";

const env = getBindings();
const auth = await authenticateRequest(Astro.request, env).catch(() => null);
if (auth === null) return Astro.redirect("/login");
const shops = await listShopsForMember({ env, userId: auth.userId });
const shop = selectShopForMember(shops, Astro.url.searchParams.get("shop"));
const workspaceHref = (href: string): string => withSelectedShop(href, shop?.publicId, Astro.url.origin);
const canManageProviders = shop?.role === "owner" || shop?.role === "manager";
const canManageApiCredentials = canManageProviders;
const canManageDomains = shop?.role === "owner";
const canRefreshPayos = shop?.role === "owner";

let telegram: TelegramIntegrationView | null = null;
let telegramError: unknown = null;
let payos: PaymentIntegrationView | null = null;
let payosError: unknown = null;
let domains: DomainView[] = [];
let domainsError: unknown = null;

if (shop !== undefined && canManageProviders) {
  try { telegram = await getTelegramIntegration({ env, shopPublicId: shop.publicId, userId: auth.userId }); } catch (error) { telegramError = error; }
  try { payos = await getPaymentIntegration({ env, shopPublicId: shop.publicId, userId: auth.userId }); } catch (error) { payosError = error; }
}
if (shop !== undefined && canManageDomains) {
  try { domains = await listShopDomains({ env, shopPublicId: shop.publicId, userId: auth.userId }); } catch (error) { domainsError = error; }
}

const timeZone = shop?.timezone ?? "Asia/Ho_Chi_Minh";
const locale = Astro.locals.locale ?? shop?.defaultLocale;
const t = createDashboardTranslator(locale);
const telegramView = telegramError === null
  ? telegramState(telegram, timeZone, locale)
  : loadErrorState("Telegram", telegramError, locale);
const payosView = payosError === null
  ? paymentState(payos, timeZone, locale)
  : loadErrorState("PayOS", payosError, locale);
const domainsView = domainsError === null
  ? domainState(domains, timeZone, locale)
  : loadErrorState("domain", domainsError, locale);
const unavailableTelegram = unavailableState("Telegram", locale);
const unavailablePayos = unavailableState("PayOS", locale);
const unavailableDomains = unavailableState("domain", locale);
const telegramConnected = telegram !== null && telegram.status !== "disabled" && telegram.status !== "disconnected";
const payosConnected = payos !== null && payos.status !== "disabled" && payos.status !== "disconnected";
const displayName = auth.displayName.trim() || t("dashboard.commerce.you");
const csrfCookieName = `${env.SESSION_COOKIE_NAME}_csrf`;
const integrationClientCopy = {
  refresh: t("dashboard.integrations.refresh"),
  refreshing: t("dashboard.integrations.runtime.refreshing"),
  reading: t("dashboard.integrations.runtime.reading"),
  partial: t("dashboard.integrations.runtime.partial"),
  refreshed: t("dashboard.integrations.runtime.refreshed"),
  connectTelegram: t("dashboard.integrations.runtime.connect.telegram"),
  connectPayos: t("dashboard.integrations.runtime.connect.payos"),
  verifying: t("dashboard.integrations.runtime.verifying"),
  sending: t("dashboard.integrations.runtime.sending"),
  updated: t("dashboard.integrations.runtime.updated"),
  checking: t("dashboard.integrations.runtime.checking"),
  healthUpdated: t("dashboard.integrations.runtime.health_updated"),
  disconnecting: t("dashboard.integrations.runtime.disconnecting"),
  disconnected: t("dashboard.integrations.runtime.disconnected"),
  disconnectTitle: t("dashboard.integrations.disconnect.title"),
  disconnectConfirm: t("dashboard.integrations.disconnect.confirm"),
  disconnectTelegram: t("dashboard.integrations.disconnect.telegram"),
  disconnectPayos: t("dashboard.integrations.disconnect.payos"),
  apiCredentialsLoad: t("dashboard.integrations.api_credentials.load"),
  apiCredentialsLoading: t("dashboard.integrations.api_credentials.loading"),
  apiCredentialsLoaded: t("dashboard.integrations.api_credentials.loaded"),
  apiCredentialsUnavailable: t("dashboard.integrations.api_credentials.unavailable"),
  apiCredentialsTitle: t("dashboard.integrations.api_credentials.title"),
  apiCredentialsDescription: t("dashboard.integrations.api_credentials.description"),
  apiCredentialsName: t("dashboard.integrations.api_credentials.name"),
  apiCredentialsNamePlaceholder: t("dashboard.integrations.api_credentials.name_placeholder"),
  apiCredentialsScopes: t("dashboard.integrations.api_credentials.scopes"),
  apiCredentialsCatalogScope: t("dashboard.integrations.api_credentials.catalog_scope"),
  apiCredentialsShopScope: t("dashboard.integrations.api_credentials.shop_scope"),
  apiCredentialsExpiry: t("dashboard.integrations.api_credentials.expiry"),
  apiCredentialsExpiryHelp: t("dashboard.integrations.api_credentials.expiry_help"),
  apiCredentialsNever: t("dashboard.integrations.api_credentials.never"),
  apiCredentialsIssue: t("dashboard.integrations.api_credentials.issue"),
  apiCredentialsIssuing: t("dashboard.integrations.api_credentials.issuing"),
  apiCredentialsIssued: t("dashboard.integrations.api_credentials.issued"),
  apiCredentialsTokenTitle: t("dashboard.integrations.api_credentials.token_title"),
  apiCredentialsTokenWarning: t("dashboard.integrations.api_credentials.token_warning"),
  apiCredentialsCopy: t("dashboard.integrations.api_credentials.copy"),
  apiCredentialsCopied: t("dashboard.integrations.api_credentials.copied"),
  apiCredentialsCopyFailed: t("dashboard.integrations.api_credentials.copy_failed"),
  apiCredentialsRevoke: t("dashboard.integrations.api_credentials.revoke"),
  apiCredentialsRevoking: t("dashboard.integrations.api_credentials.revoking"),
  apiCredentialsRevoked: t("dashboard.integrations.api_credentials.revoked"),
  apiCredentialsRevokeConfirm: t("dashboard.integrations.api_credentials.revoke_confirm"),
  apiCredentialsStatusActive: t("dashboard.integrations.api_credentials.status_active"),
  apiCredentialsStatusRevoked: t("dashboard.integrations.api_credentials.status_revoked"),
  apiCredentialsCreated: t("dashboard.integrations.api_credentials.created"),
  apiCredentialsLastUsed: t("dashboard.integrations.api_credentials.last_used"),
  apiCredentialsNoCredentials: t("dashboard.integrations.api_credentials.empty"),
  apiCredentialsRequestId: t("dashboard.integrations.api_credentials.request_id"),
  health: t("dashboard.integrations.provider.health"),
  connect: t("dashboard.integrations.provider.connect"),
  update: t("dashboard.integrations.provider.update"),
  disconnect: t("dashboard.integrations.provider.disconnect"),
  channelExpansionEyebrow: t("dashboard.integrations.channel_expansion.eyebrow"),
  channelExpansionTitle: t("dashboard.integrations.channel_expansion.title"),
  channelExpansionDescription: t("dashboard.integrations.channel_expansion.description"),
  channelExpansionLoading: t("dashboard.integrations.channel_expansion.loading"),
  channelExpansionLoaded: t("dashboard.integrations.channel_expansion.loaded"),
  channelExpansionUnavailable: t("dashboard.integrations.channel_expansion.unavailable"),
  channelExpansionRequest: t("dashboard.integrations.channel_expansion.request"),
  channelExpansionRequesting: t("dashboard.integrations.channel_expansion.requesting"),
  channelExpansionRequested: t("dashboard.integrations.channel_expansion.requested"),
  channelExpansionCancel: t("dashboard.integrations.channel_expansion.cancel"),
  channelExpansionCanceling: t("dashboard.integrations.channel_expansion.canceling"),
  channelExpansionCanceled: t("dashboard.integrations.channel_expansion.canceled"),
  channelExpansionCancelConfirm: t("dashboard.integrations.channel_expansion.cancel_confirm"),
  channelExpansionReadOnly: t("dashboard.integrations.channel_expansion.read_only"),
  channelExpansionNoProviders: t("dashboard.integrations.channel_expansion.no_providers"),
  channelExpansionCapabilities: t("dashboard.integrations.channel_expansion.capabilities"),
  channelExpansionRequiredAction: t("dashboard.integrations.channel_expansion.required_action"),
  channelExpansionActionCreateApp: t("dashboard.integrations.channel_expansion.action_create_app"),
  channelExpansionActionCreateBot: t("dashboard.integrations.channel_expansion.action_create_bot"),
  channelExpansionActionConnectProvider: t("dashboard.integrations.channel_expansion.action_connect_provider"),
  channelExpansionStageContractReady: t("dashboard.integrations.channel_expansion.stage_contract_ready"),
  channelExpansionStageProviderPending: t("dashboard.integrations.channel_expansion.stage_provider_pending"),
  channelExpansionStatusRequested: t("dashboard.integrations.channel_expansion.status_requested"),
  channelExpansionStatusProviderPending: t("dashboard.integrations.channel_expansion.status_provider_pending"),
  channelExpansionStatusActive: t("dashboard.integrations.channel_expansion.status_active"),
  channelExpansionStatusCanceled: t("dashboard.integrations.channel_expansion.status_canceled"),
  channelExpansionStatusRejected: t("dashboard.integrations.channel_expansion.status_rejected"),
  channelExpansionNameTelegram: t("dashboard.integrations.channel_expansion.name.telegram_mini_app"),
  channelExpansionNameZalo: t("dashboard.integrations.channel_expansion.name.zalo_mini_app"),
  channelExpansionNameWhatsapp: t("dashboard.integrations.channel_expansion.name.whatsapp_cloud"),
  channelExpansionNameDiscord: t("dashboard.integrations.channel_expansion.name.discord_bot"),
  channelExpansionDescriptionTelegram: t("dashboard.channels.expansion.telegram_mini_app"),
  channelExpansionDescriptionZalo: t("dashboard.channels.expansion.zalo_mini_app"),
  channelExpansionDescriptionWhatsapp: t("dashboard.channels.expansion.whatsapp_cloud"),
  channelExpansionDescriptionDiscord: t("dashboard.channels.expansion.discord_bot"),
};
---

<AppLayout activePath="/app/integrations" displayName={displayName} email={auth.email} selectedShopName={shop?.name} selectedShopPublicId={shop?.publicId} shops={shops} title={t("dashboard.integrations.title")}>
  <div
    class="integrations-page"
    data-integrations-workspace
    data-csrf-cookie-name={csrfCookieName}
    data-shop-public-id={shop?.publicId}
    data-shop-role={shop?.role}
    data-time-zone={timeZone}
    data-locale={locale ?? "en"}
    data-copy={JSON.stringify(integrationClientCopy)}
    data-can-manage-providers={canManageProviders ? "true" : "false"}
    data-can-manage-channel-connectors={canManageProviders ? "true" : "false"}
    data-can-manage-api-credentials={canManageApiCredentials ? "true" : "false"}
    data-can-manage-domains={canManageDomains ? "true" : "false"}
    data-can-refresh-payos={canRefreshPayos ? "true" : "false"}
  >
    <PageHeader
      eyebrow={t("dashboard.integrations.eyebrow")}
      title={t("dashboard.integrations.title")}
      description={t("dashboard.integrations.description")}
    >
      <div slot="actions" class="header-actions">
        <button class="app-button app-button-secondary" type="button" data-refresh-all disabled={shop === undefined || (!canManageProviders && !canManageDomains)}>{t("dashboard.integrations.refresh")}</button>
      </div>
    </PageHeader>

    {shop === undefined ? (
      <WorkspaceState
        title={t("dashboard.integrations.no_store.title")}
        description={t("dashboard.integrations.no_store.description")}
        actionHref={workspaceHref("/onboarding")}
        actionLabel={t("dashboard.integrations.no_store.action")}
        tone="info"
      />
    ) : (
      <>
        <div class="workspace-feedback" data-workspace-feedback role="status" aria-live="polite" hidden></div>
        <div id="integration-panels" class="integration-panels" data-integration-panels>
          <section class="integration-group" aria-labelledby="channels-title">
            <header class="group-heading">
              <div><p>{t("dashboard.integrations.group.channels.eyebrow")}</p><h2 id="channels-title">{t("dashboard.integrations.group.channels.title")}</h2></div>
              <span>{t("dashboard.integrations.group.channels.description")}</span>
            </header>
            <article id="telegram" class="integration-row" data-provider-row="telegram" data-readable={canManageProviders && telegramError === null ? "true" : "false"}>
              <div class="provider-mark provider-mark-telegram" aria-hidden="true">TG</div>
              <div class="provider-copy"><h3>Telegram</h3><p class="provider-summary" data-summary>{canManageProviders ? telegramView.summary : unavailableTelegram.summary}</p><p class="provider-check" data-last-check>{canManageProviders ? telegramView.checked : unavailableTelegram.checked}</p></div>
              <StatusBadge label={canManageProviders ? telegramView.label : unavailableTelegram.label} tone={canManageProviders ? telegramView.tone : unavailableTelegram.tone} />
              <div class="provider-actions">
                {canManageProviders ? <button class="app-button app-button-secondary" type="button" data-action="configure">{telegram === null ? t("dashboard.integrations.provider.connect") : t("dashboard.integrations.provider.update")}</button> : <span class="provider-note">{t("dashboard.integrations.provider.unavailable")}</span>}
                {canManageProviders && telegram !== null && telegramError === null && <button class="text-action" type="button" data-action="health">{t("dashboard.integrations.provider.health")}</button>}
                {canManageProviders && telegramConnected && telegramError === null && <button class="text-action danger-text" type="button" data-action="disconnect">{t("dashboard.integrations.provider.disconnect")}</button>}
              </div>
              <p class="provider-error" data-error hidden={!canManageProviders || telegramView.error === null}>{canManageProviders ? telegramView.error : ""}</p>
            </article>
          </section>

          <section class="integration-group channel-expansion-group" aria-labelledby="channel-expansion-title" data-channel-expansion-section>
            <header class="group-heading">
              <div><p>{t("dashboard.integrations.channel_expansion.eyebrow")}</p><h2 id="channel-expansion-title">{t("dashboard.integrations.channel_expansion.title")}</h2></div>
              <span>{t("dashboard.integrations.channel_expansion.description")}</span>
            </header>
            <div class="workspace-feedback" data-channel-expansion-feedback role="status" aria-live="polite">{t("dashboard.integrations.channel_expansion.loading")}</div>
            <div class="channel-expansion-grid" data-channel-expansion-grid aria-live="polite"></div>
            <p class="provider-note channel-expansion-empty" data-channel-expansion-empty hidden>{t("dashboard.integrations.channel_expansion.no_providers")}</p>
          </section>

          <section class="integration-group" aria-labelledby="payments-title">
            <header class="group-heading">
              <div><p>{t("dashboard.integrations.group.payments.eyebrow")}</p><h2 id="payments-title">{t("dashboard.integrations.group.payments.title")}</h2></div>
              <span>{t("dashboard.integrations.group.payments.description")}</span>
            </header>
            <article class="integration-row" data-provider-row="payos" data-readable={canManageProviders && payosError === null ? "true" : "false"}>
              <div class="provider-mark provider-mark-payos" aria-hidden="true">PO</div>
              <div class="provider-copy"><h3>PayOS</h3><p class="provider-summary" data-summary>{canManageProviders ? payosView.summary : unavailablePayos.summary}</p><p class="provider-check" data-last-check>{canManageProviders ? payosView.checked : unavailablePayos.checked}</p></div>
              <StatusBadge label={canManageProviders ? payosView.label : unavailablePayos.label} tone={canManageProviders ? payosView.tone : unavailablePayos.tone} />
              <div class="provider-actions">
                {canManageProviders ? <button class="app-button app-button-secondary" type="button" data-action="configure">{payos === null ? t("dashboard.integrations.provider.connect") : t("dashboard.integrations.provider.update")}</button> : <span class="provider-note">{t("dashboard.integrations.provider.unavailable")}</span>}
                {canRefreshPayos && payos !== null && payosError === null && <button class="text-action" type="button" data-action="health">{t("dashboard.integrations.provider.health")}</button>}
                {canManageProviders && payosConnected && payosError === null && <button class="text-action danger-text" type="button" data-action="disconnect">{t("dashboard.integrations.provider.disconnect")}</button>}
              </div>
              <p class="provider-error" data-error hidden={!canManageProviders || payosView.error === null}>{canManageProviders ? payosView.error : ""}</p>
            </article>
          </section>

          <section class="integration-group" aria-labelledby="infrastructure-title">
            <header class="group-heading">
              <div><p>{t("dashboard.integrations.group.infrastructure.eyebrow")}</p><h2 id="infrastructure-title">{t("dashboard.integrations.group.infrastructure.title")}</h2></div>
              <span>{t("dashboard.integrations.group.infrastructure.description")}</span>
            </header>
            <article class="integration-row" data-provider-row="domains" data-readable={canManageDomains && domainsError === null ? "true" : "false"}>
              <div class="provider-mark provider-mark-domain" aria-hidden="true">DNS</div>
              <div class="provider-copy"><h3>{t("dashboard.integrations.provider.domain")}</h3><p class="provider-summary" data-summary>{canManageDomains ? domainsView.summary : unavailableDomains.summary}</p><p class="provider-check" data-last-check>{canManageDomains ? domainsView.checked : unavailableDomains.checked}</p></div>
              <StatusBadge label={canManageDomains ? domainsView.label : unavailableDomains.label} tone={canManageDomains ? domainsView.tone : unavailableDomains.tone} />
              <div class="provider-actions">{canManageDomains ? <a class="app-button app-button-secondary" href={workspaceHref("/app/domains")}>{t("dashboard.integrations.provider.manage_domains")}</a> : <span class="provider-note">{t("dashboard.integrations.provider.unavailable")}</span>}</div>
              <p class="provider-error" data-error hidden={!canManageDomains || domainsView.error === null}>{canManageDomains ? domainsView.error : ""}</p>
            </article>
          </section>

          <section class="integration-group api-credentials-group" aria-labelledby="api-credentials-title" data-api-credentials-section>
            <header class="group-heading">
              <div><p>{t("dashboard.integrations.api_credentials.eyebrow")}</p><h2 id="api-credentials-title">{t("dashboard.integrations.api_credentials.title")}</h2></div>
              <span>{t("dashboard.integrations.api_credentials.description")}</span>
            </header>
            {canManageApiCredentials ? (
              <div class="api-credentials-panel" data-api-credentials-panel>
                <div class="api-credentials-toolbar">
                  <p class="provider-note" data-api-credentials-feedback>{t("dashboard.integrations.api_credentials.loading")}</p>
                  <button class="app-button app-button-secondary" type="button" data-api-credentials-load>{t("dashboard.integrations.api_credentials.load")}</button>
                </div>
                <div class="workspace-feedback" data-api-credentials-token-feedback role="status" aria-live="polite" hidden></div>
                <div class="api-token-panel" data-api-credentials-token hidden>
                  <div><strong>{t("dashboard.integrations.api_credentials.token_title")}</strong><p>{t("dashboard.integrations.api_credentials.token_warning")}</p></div>
                  <div class="api-token-row"><input type="text" readonly data-api-credentials-token-value aria-label={t("dashboard.integrations.api_credentials.token_title")} /><button class="app-button app-button-secondary" type="button" data-api-credentials-copy>{t("dashboard.integrations.api_credentials.copy")}</button></div>
                </div>
                <form class="api-credential-form" data-api-credential-form hidden novalidate>
                  <div class="form-heading"><div><h3>{t("dashboard.integrations.api_credentials.issue")}</h3><p>{t("dashboard.integrations.api_credentials.expiry_help")}</p></div></div>
                  <label for="api-credential-name">{t("dashboard.integrations.api_credentials.name")}</label>
                  <input id="api-credential-name" name="name" type="text" maxlength="80" required placeholder={t("dashboard.integrations.api_credentials.name_placeholder")} />
                  <fieldset class="api-scope-fieldset"><legend>{t("dashboard.integrations.api_credentials.scopes")}</legend><label class="checkbox-line"><input type="checkbox" name="scope" value="catalog:read" checked /> <span>{t("dashboard.integrations.api_credentials.catalog_scope")}</span></label><label class="checkbox-line"><input type="checkbox" name="scope" value="shop:read" /> <span>{t("dashboard.integrations.api_credentials.shop_scope")}</span></label></fieldset>
                  <label for="api-credential-expiry">{t("dashboard.integrations.api_credentials.expiry")}</label>
                  <input id="api-credential-expiry" name="expiresAt" type="datetime-local" />
                  <button class="app-button app-button-primary" type="submit">{t("dashboard.integrations.api_credentials.issue")}</button>
                </form>
                <div class="api-credential-ledger" data-api-credentials-list role="list" aria-live="polite"></div>
              </div>
            ) : (
              <p class="provider-note api-credentials-unavailable">{t("dashboard.integrations.api_credentials.unavailable")}</p>
            )}
          </section>

          {canManageProviders && (
            <section class="secure-panel" data-config-panel hidden aria-labelledby="config-title">
              <div class="secure-panel-head"><div><p class="secure-kicker">{t("dashboard.integrations.config.eyebrow")}</p><h2 id="config-title">{t("dashboard.integrations.config.title")}</h2><p>{t("dashboard.integrations.config.description")}</p></div><button class="text-action" type="button" data-action="close-config">{t("dashboard.integrations.config.close")}</button></div>
              <div class="workspace-feedback" data-config-feedback role="status" aria-live="polite" hidden></div>
              <form class="credential-form" data-credential-form="telegram" hidden novalidate>
                <div class="form-heading"><div><h3>{t("dashboard.integrations.telegram.title")}</h3><p>{t("dashboard.integrations.telegram.description")}</p></div><a href="https://t.me/BotFather" target="_blank" rel="noreferrer">{t("dashboard.integrations.telegram.open")}</a></div>
                <label for="telegram-bot-token">{t("dashboard.integrations.field.bot_token")}</label>
                <input id="telegram-bot-token" name="botToken" type="password" autocomplete="new-password" spellcheck="false" inputmode="text" maxlength="150" required placeholder="123456789:…" />
                <label class="checkbox-line"><input type="checkbox" name="replaceBot" /> <span>{t("dashboard.integrations.telegram.replace")}</span></label>
                <p class="field-help" set:html={t("dashboard.integrations.telegram.help")}></p>
                <button class="app-button app-button-primary" type="submit">{t("dashboard.integrations.telegram.submit")}</button>
              </form>
              <form class="credential-form" data-credential-form="payos" hidden novalidate>
                <div class="form-heading"><div><h3>{t("dashboard.integrations.payos.title")}</h3><p>{t("dashboard.integrations.payos.description")}</p></div><a href="https://payos.vn" target="_blank" rel="noreferrer">{t("dashboard.integrations.payos.open")}</a></div>
                <label for="payos-client-id">{t("dashboard.integrations.field.client_id")}</label>
                <input id="payos-client-id" name="clientId" type="password" autocomplete="new-password" spellcheck="false" maxlength="512" required />
                <label for="payos-api-key">{t("dashboard.integrations.field.api_key")}</label>
                <input id="payos-api-key" name="apiKey" type="password" autocomplete="new-password" spellcheck="false" maxlength="512" required />
                <label for="payos-checksum-key">{t("dashboard.integrations.field.checksum_key")}</label>
                <input id="payos-checksum-key" name="checksumKey" type="password" autocomplete="new-password" spellcheck="false" maxlength="512" required />
                <p class="field-help">{t("dashboard.integrations.payos.help")}</p>
                <button class="app-button app-button-primary" type="submit">{t("dashboard.integrations.payos.submit")}</button>
              </form>
              <div class="disconnect-panel" data-disconnect-panel hidden><h3>{t("dashboard.integrations.disconnect.title")}</h3><p data-disconnect-copy></p><button class="app-button app-button-danger" type="button" data-action="confirm-disconnect">{t("dashboard.integrations.disconnect.confirm")}</button></div>
            </section>
          )}
        </div>
      </>
    )}
  </div>
</AppLayout>

<script src="../../scripts/dashboard/integrations.ts"></script>

<style>
  [hidden] { display: none !important; }
  .integrations-page { display: grid; gap: var(--sln-space-8); }
  .header-actions { display: flex; align-items: center; }
  .workspace-feedback { padding: 12px 16px; border: 1px solid var(--sln-border-default); border-radius: var(--sln-radius-md); background: var(--sln-bg-subtle); color: var(--sln-text-secondary); font: var(--sln-font-body-sm); }
  .workspace-feedback[data-tone="success"] { border-color: color-mix(in srgb, var(--sln-state-success) 28%, var(--sln-border-default)); background: var(--sln-tint-success); color: #047857; }

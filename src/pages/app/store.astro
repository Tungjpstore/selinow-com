---
import AppLayout from "../../layouts/AppLayout.astro";
import PageHeader from "../../components/workspace/PageHeader.astro";
import StatusBadge from "../../components/primitives/StatusBadge.astro";
import WorkspaceState from "../../components/states/WorkspaceState.astro";
import StorefrontPreviewCard from "../../components/storefront/StorefrontPreviewCard.astro";
import { authenticateRequest } from "../../lib/auth/session";
import { getBindings } from "../../lib/platform/bindings";
import { withSelectedShop } from "../../lib/dashboard/shop-navigation";
import { getSellerStorefrontPreviewCatalog, type SellerPreviewCatalog } from "../../lib/storefront/preview";
import { listShopsForMember, selectShopForMember } from "../../lib/tenants/store";
import { getSellerStorefrontSettings, type SellerStorefrontSettings } from "../../lib/tenants/storefront-settings";
import { createDashboardTranslator } from "../../lib/i18n";

const env = getBindings();
const auth = await authenticateRequest(Astro.request, env).catch(() => null);
if (auth === null) return Astro.redirect("/login");
const shops = await listShopsForMember({ env, userId: auth.userId });
const shop = selectShopForMember(shops, Astro.url.searchParams.get("shop"));
const workspaceHref = (href: string): string => withSelectedShop(href, shop?.publicId, Astro.url.origin);
const canManage = shop !== undefined && (shop.role === "owner" || shop.role === "manager");
const canPublish = shop?.role === "owner";
const locale = Astro.locals.locale ?? shop?.defaultLocale;
const t = createDashboardTranslator(locale);
let settings: SellerStorefrontSettings | null = null;
let settingsError: string | null = null;
let previewCatalog: SellerPreviewCatalog = { products: [], truncated: false };
let previewCatalogError: string | null = null;
if (shop !== undefined) {
  const [settingsResult, catalogResult] = await Promise.allSettled([
    getSellerStorefrontSettings({ env, shopPublicId: shop.publicId, userId: auth.userId }),
    getSellerStorefrontPreviewCatalog({ env, shopPublicId: shop.publicId, userId: auth.userId }),
  ]);
  if (settingsResult.status === "fulfilled") settings = settingsResult.value;
  else settingsError = settingsResult.reason instanceof Error ? settingsResult.reason.message : "settings_unavailable";
  if (catalogResult.status === "fulfilled") previewCatalog = catalogResult.value;
  else previewCatalogError = catalogResult.reason instanceof Error ? catalogResult.reason.message : "catalog_unavailable";
}
const displayName = auth.displayName.trim() || t("dashboard.commerce.you");
const previewHost = shop === undefined ? null : `https://${shop.slug}.${env.PLATFORM_BASE_DOMAIN}`;
const initialDraft = settings === null ? null : {
  accentColor: settings.theme.accent,
  announcement: settings.content.announcement ?? "",
  deliveryText: settings.content.deliveryText,
  description: settings.content.description,
  footerText: settings.content.footerText,
  headline: settings.content.headline,
  logoUrl: settings.theme.logoUrl ?? "",
  primaryColor: settings.theme.brand,
  seoDescription: settings.content.seoDescription,
  seoTitle: settings.content.seoTitle,
  showExactStock: settings.content.showExactStock,
  supportText: settings.content.supportText,
  templateId: settings.template.id,
};
// Gallery copy is built server-side so the client script only handles the
// templateId draft value; entitlement comes from the settings payload.
const templateGallery = settings === null ? [] : settings.templates.map((template) => ({
  available: template.available,
  description: t(`dashboard.store_builder.template.${template.id}.description`),
  id: template.id,
  name: t(`dashboard.store_builder.template.${template.id}.name`),
  premium: template.premium,
  scheme: template.scheme,
  selectable: template.available && (!template.premium || settings.premiumTemplatesEnabled),
  verticalLabel: t(`dashboard.store_builder.template.vertical.${template.vertical}`),
}));
const storeBuilderClientCopy = {
  failed: t("dashboard.store_builder.runtime.failed"),
  forbidden: t("dashboard.store_builder.runtime.forbidden"),
  neverPublished: t("dashboard.store_builder.state.never_published"),
  published: t("dashboard.store_builder.state.published"),
  publishing: t("dashboard.store_builder.runtime.publishing"),
  saving: t("dashboard.store_builder.runtime.saving"),
  unsaved: t("dashboard.store_builder.runtime.unsaved"),
  unpublishedChanges: t("dashboard.store_builder.state.unpublished_changes"),
  invalidContrast: t("dashboard.store_builder.runtime.invalid_contrast"),
  live: t("dashboard.store_builder.state.live"),
  brandLabel: t("dashboard.store_builder.field.brand"),
  accentLabel: t("dashboard.store_builder.field.accent"),
  contrastValid: t("dashboard.store_builder.runtime.contrast_valid", { brand: "__BRAND__", accent: "__ACCENT__" }),
  contrastInvalid: t("dashboard.store_builder.runtime.contrast_invalid", { details: "__DETAILS__", minimum: "__MINIMUM__" }),
  headlineFallback: t("dashboard.store_builder.runtime.headline_fallback"),
  descriptionFallback: t("dashboard.store_builder.runtime.description_fallback"),
  deliveryFallback: t("dashboard.store_builder.runtime.delivery_fallback"),
  supportFallback: t("dashboard.store_builder.runtime.support_fallback"),
  footerFallback: t("dashboard.store_builder.runtime.footer_fallback"),
  stockExact: t("dashboard.store_builder.runtime.stock_exact", { count: "__COUNT__" }),
  stockOut: t("dashboard.store_builder.runtime.stock_out"),
  stockLow: t("dashboard.store_builder.runtime.stock_low"),
  stockReady: t("dashboard.store_builder.runtime.stock_ready"),
  contrastRecovered: t("dashboard.store_builder.runtime.contrast_recovered"),
  undone: t("dashboard.store_builder.runtime.undone"),
  savePending: t("dashboard.store_builder.runtime.save_pending"),
  saveSuccess: t("dashboard.store_builder.runtime.save_success"),
  conflictReload: t("dashboard.store_builder.runtime.conflict_reload"),
  saveError: t("dashboard.store_builder.runtime.save_error", { error: "__ERROR__" }),
  saveFailed: t("dashboard.store_builder.runtime.save_failed"),
  saveBeforePublish: t("dashboard.store_builder.runtime.save_before_publish"),
  publishPending: t("dashboard.store_builder.runtime.publish_pending"),
  publishSuccess: t("dashboard.store_builder.runtime.publish_success"),
  publishConflict: t("dashboard.store_builder.runtime.publish_conflict"),
  publishError: t("dashboard.store_builder.runtime.publish_error", { error: "__ERROR__" }),
  publishFailed: t("dashboard.store_builder.runtime.publish_failed"),
  shippingArchive: t("dashboard.store_builder.shipping.archive"),
  shippingCreated: t("dashboard.store_builder.shipping.created"),
  shippingEmpty: t("dashboard.store_builder.shipping.empty"),
  shippingError: t("dashboard.store_builder.shipping.error"),
  shippingFeeLabel: t("dashboard.store_builder.shipping.fee_label"),
  shippingFreeOverLabel: t("dashboard.store_builder.shipping.free_over_label"),
  shippingInvalid: t("dashboard.store_builder.shipping.invalid"),
};
---

<AppLayout activePath="/app/store" displayName={displayName} email={auth.email} selectedShopName={shop?.name} selectedShopPublicId={shop?.publicId} shops={shops} title={t("dashboard.store_builder.title")}>
  <PageHeader eyebrow={t("dashboard.store_builder.eyebrow")} title={t("dashboard.store_builder.title")} description={t("dashboard.store_builder.description")}>
    <div slot="actions" class="header-actions">
      <span class="save-state" data-save-state data-state={settings === null ? "forbidden" : settings.publicationState} role="status" aria-live="polite">{settings === null ? t("dashboard.store_builder.state.unavailable") : settings.publicationState === "published" ? t("dashboard.store_builder.state.published") : settings.publicationState === "never_published" ? t("dashboard.store_builder.state.never_published") : t("dashboard.store_builder.state.unpublished_changes")}</span>
      <a class="sln-button" data-variant="secondary" href={previewHost ?? workspaceHref("/onboarding")} target={previewHost ? "_blank" : undefined} rel={previewHost ? "noreferrer" : undefined}>{previewHost ? t("dashboard.store_builder.open_live") : t("dashboard.store_builder.setup")}<span aria-hidden="true">↗</span></a>
      {canPublish && <button class="sln-button" data-variant="primary" type="button" data-publish disabled={settings === null || settings.publicationState === "published"}>{t("dashboard.store_builder.publish")} <span aria-hidden="true">→</span></button>}
    </div>
  </PageHeader>

  {shop === undefined ? (
    <WorkspaceState title={t("dashboard.store_builder.no_store.title")} description={t("dashboard.store_builder.no_store.description")} actionHref={workspaceHref("/onboarding")} actionLabel={t("dashboard.store_builder.no_store.action")} tone="info" />
  ) : settings === null ? (
    <WorkspaceState title={settingsError === "authorization_denied" ? t("dashboard.store_builder.forbidden.title") : t("dashboard.store_builder.unavailable.title")} description={settingsError === "authorization_denied" ? t("dashboard.store_builder.forbidden.description") : t("dashboard.store_builder.unavailable.description")} actionHref={workspaceHref(settingsError === "authorization_denied" ? "/app" : "/onboarding")} actionLabel={settingsError === "authorization_denied" ? t("dashboard.store_builder.back_overview") : t("dashboard.store_builder.open_readiness")} tone={settingsError === "authorization_denied" ? "warning" : "danger"} />
  ) : (
    <div class="builder" data-builder data-store-builder data-mobile-view="settings" data-locale={locale ?? "en"} data-copy={JSON.stringify(storeBuilderClientCopy)} data-can-manage={canManage ? "true" : "false"} data-can-publish={canPublish ? "true" : "false"} data-draft-version={String(settings.version)} data-publication-state={settings.publicationState} data-shop-public-id={shop.publicId} data-csrf-cookie-name={`${env.SESSION_COOKIE_NAME}_csrf`} data-initial-draft={JSON.stringify(initialDraft)}>
      <div class="mobile-view-tabs" role="tablist" aria-label={t("dashboard.store_builder.mobile.aria")}>
        <button id="builder-view-settings" class="mobile-view-tab is-active" type="button" role="tab" aria-selected="true" aria-controls="store-settings" data-builder-view-tab="settings">{t("dashboard.store_builder.mobile.settings")}</button>
        <button id="builder-view-preview" class="mobile-view-tab" type="button" role="tab" aria-selected="false" aria-controls="store-preview" data-builder-view-tab="preview" tabindex="-1">{t("dashboard.store_builder.mobile.preview")}</button>
      </div>
      <div class="builder-toolbar" aria-label={t("dashboard.store_builder.toolbar.aria")}>
        <div class="builder-tabs" role="tablist" aria-label={t("dashboard.store_builder.tabs.aria")}>
          <button class="builder-tab is-active" id="tab-content" type="button" role="tab" aria-selected="true" aria-controls="panel-content" data-tab="content">{t("dashboard.store_builder.tab.content")}</button>
          <button class="builder-tab" id="tab-brand" type="button" role="tab" aria-selected="false" aria-controls="panel-brand" data-tab="brand">{t("dashboard.store_builder.tab.brand")}</button>
          <button class="builder-tab" id="tab-template" type="button" role="tab" aria-selected="false" aria-controls="panel-template" data-tab="template">{t("dashboard.store_builder.tab.template")}</button>
          <button class="builder-tab" id="tab-shipping" type="button" role="tab" aria-selected="false" aria-controls="panel-shipping" data-tab="shipping">{t("dashboard.store_builder.tab.shipping")}</button>
          <button class="builder-tab" id="tab-layout" type="button" role="tab" aria-selected="false" aria-controls="panel-layout" data-tab="layout">{t("dashboard.store_builder.tab.layout")}</button>
          <button class="builder-tab" id="tab-seo" type="button" role="tab" aria-selected="false" aria-controls="panel-seo" data-tab="seo">{t("dashboard.store_builder.tab.seo")}</button>
          <button class="builder-tab" id="tab-support" type="button" role="tab" aria-selected="false" aria-controls="panel-support" data-tab="support">{t("dashboard.store_builder.tab.support")}</button>
        </div>
        <div class="device-controls" aria-label={t("dashboard.store_builder.device.aria")}>
          <span>{t("dashboard.store_builder.device.preview")}</span>
          <button type="button" class="device-button is-active" aria-label={t("dashboard.store_builder.device.desktop")} aria-pressed="true" data-device="desktop">{t("dashboard.store_builder.device.desktop")}</button>
          <button type="button" class="device-button" aria-label={t("dashboard.store_builder.device.tablet")} aria-pressed="false" data-device="tablet">{t("dashboard.store_builder.device.tablet")}</button>
          <button type="button" class="device-button" aria-label={t("dashboard.store_builder.device.mobile")} aria-pressed="false" data-device="mobile">{t("dashboard.store_builder.device.mobile")}</button>
        </div>
      </div>

      <div class="builder-grid">
        <section id="store-settings" class="settings-pane" aria-label={t("dashboard.store_builder.tabs.aria")}>
          <div class="draft-notice" data-draft-notice>
            <div><strong>{t("dashboard.store_builder.draft_of", { shop: shop.name })}</strong><span>{shop.slug}.{env.PLATFORM_BASE_DOMAIN}</span></div>
            <span data-publication-badge><StatusBadge label={settings.publicationState === "published" ? t("dashboard.store_builder.state.live") : settings.publicationState === "never_published" ? t("dashboard.store_builder.state.never_published") : t("dashboard.store_builder.state.unpublished_changes")} tone={settings.publicationState === "published" ? "success" : "warning"} /></span>
          </div>

          <div class="tab-panel" id="panel-content" role="tabpanel" aria-labelledby="tab-content" data-panel="content">
            <div class="panel-heading"><p class="eyebrow">{t("dashboard.store_builder.panel.content.eyebrow")}</p><h2>{t("dashboard.store_builder.panel.content.title")}</h2><p>{t("dashboard.store_builder.panel.content.description")}</p></div>
            <fieldset disabled={!canManage}>
              <label>{t("dashboard.store_builder.field.headline")}<input name="headline" data-field="headline" value={settings.content.headline} maxlength="120" /></label>
              <label>{t("dashboard.store_builder.field.description")}<textarea name="description" data-field="description" rows="4" maxlength="240">{settings.content.description}</textarea></label>
              <label>{t("dashboard.store_builder.field.announcement")} <span class="optional">{t("dashboard.store_builder.field.optional")}</span><input name="announcement" data-field="announcement" value={settings.content.announcement ?? ""} maxlength="140" placeholder={t("dashboard.store_builder.field.announcement_placeholder")} /></label>
              <label>{t("dashboard.store_builder.field.delivery")}<textarea name="deliveryText" data-field="deliveryText" rows="3" maxlength="240">{settings.content.deliveryText}</textarea></label>
              <label>{t("dashboard.store_builder.field.support")}<textarea name="supportText" data-field="supportText" rows="3" maxlength="180">{settings.content.supportText}</textarea></label>
              <label>{t("dashboard.store_builder.field.footer")}<textarea name="footerText" data-field="footerText" rows="2" maxlength="160">{settings.content.footerText}</textarea></label>
            </fieldset>
          </div>

          <div class="tab-panel" id="panel-brand" role="tabpanel" aria-labelledby="tab-brand" data-panel="brand" hidden>
            <div class="panel-heading"><p class="eyebrow">{t("dashboard.store_builder.panel.brand.eyebrow")}</p><h2>{t("dashboard.store_builder.panel.brand.title")}</h2><p>{t("dashboard.store_builder.panel.brand.description")}</p></div>
            <fieldset disabled={!canManage}>
              <label>{t("dashboard.store_builder.field.logo")} <span class="optional">{t("dashboard.store_builder.field.https")}</span><input name="logoUrl" data-field="logoUrl" type="url" value={settings.theme.logoUrl ?? ""} maxlength="500" placeholder={t("dashboard.store_builder.field.logo_placeholder")} /></label>
              <div class="color-grid">
                <label>{t("dashboard.store_builder.field.brand")}<input name="primaryColor" data-field="primaryColor" type="color" value={settings.theme.brand} aria-describedby="storefront-contrast-status" /></label>
                <label>{t("dashboard.store_builder.field.accent")}<input name="accentColor" data-field="accentColor" type="color" value={settings.theme.accent} aria-describedby="storefront-contrast-status" /></label>
              </div>
              <div id="storefront-contrast-status" class="contrast-check" data-contrast data-tone="info" role="status" aria-live="polite" aria-atomic="true"><span aria-hidden="true"></span><p>{t("dashboard.store_builder.contrast.checking")}</p></div>
            </fieldset>
          </div>

          <div class="tab-panel" id="panel-template" role="tabpanel" aria-labelledby="tab-template" data-panel="template" hidden>
            <div class="panel-heading"><p class="eyebrow">{t("dashboard.store_builder.panel.template.eyebrow")}</p><h2>{t("dashboard.store_builder.panel.template.title")}</h2><p>{t("dashboard.store_builder.panel.template.description")}</p></div>
            <fieldset disabled={!canManage}>
              <div class="template-gallery" role="radiogroup" aria-label={t("dashboard.store_builder.panel.template.title")} data-template-gallery>
                {templateGallery.map((option) => (
                  <label class:list={["template-option", option.selectable ? "is-selectable" : "is-locked"]} data-template-option={option.id}>
                    <input type="radio" name="templateId" data-field="templateId" value={option.id} checked={settings.template.id === option.id} disabled={!option.selectable} />
                    <span class="template-thumb" data-template={option.id} data-scheme={option.scheme} aria-hidden="true">
                      <span class="thumb-bar"></span>
                      <span class="thumb-body"><span class="thumb-hero"><i></i><i></i><i></i></span><span class="thumb-grid"><i></i><i></i><i></i><i></i></span></span>
                    </span>
                    <span class="template-copy">
                      <span class="template-name-row">
                        <strong>{option.name}</strong>
                        {option.premium && <span class="template-badge" data-badge="pro">{t("dashboard.store_builder.template.premium_badge")}</span>}
                        {!option.available && <span class="template-badge" data-badge="soon">{t("dashboard.store_builder.template.coming_soon")}</span>}
                      </span>
                      <small>{option.verticalLabel} · {option.description}</small>
                      {option.premium && !settings.premiumTemplatesEnabled && <small class="template-locked-note">{t("dashboard.store_builder.template.premium_note")}</small>}
                    </span>
                  </label>
                ))}
              </div>
              <p class="template-preview-note">{t("dashboard.store_builder.template.preview_note")}</p>
            </fieldset>
          </div>

          <div class="tab-panel" id="panel-shipping" role="tabpanel" aria-labelledby="tab-shipping" data-panel="shipping" hidden>
            <div class="panel-heading"><p class="eyebrow">{t("dashboard.store_builder.shipping.eyebrow")}</p><h2>{t("dashboard.store_builder.shipping.title")}</h2><p>{t("dashboard.store_builder.shipping.description")}</p></div>
            <fieldset disabled={!canManage}>
              <div class="shipping-method-form">
                <label>{t("dashboard.store_builder.shipping.field.name")}<input data-shipping-name maxlength="80" placeholder={t("dashboard.store_builder.shipping.field.name_placeholder")} /></label>
                <label>{t("dashboard.store_builder.shipping.field.fee", { currency: shop.currency })}<input data-shipping-fee type="number" min="0" step="1000" inputmode="numeric" placeholder="30000" /></label>
                <label>{t("dashboard.store_builder.shipping.field.free_over", { currency: shop.currency })}<input data-shipping-free-over type="number" min="0" step="1000" inputmode="numeric" placeholder={t("dashboard.store_builder.shipping.field.free_over_placeholder")} /></label>
                <button class="sln-button" data-variant="secondary" type="button" data-shipping-create>{t("dashboard.store_builder.shipping.create")}</button>
              </div>
              <ul class="shipping-method-list" data-shipping-list aria-label={t("dashboard.store_builder.shipping.list_aria")}></ul>
              <p class="form-feedback" data-shipping-feedback role="status" aria-live="polite"></p>
            </fieldset>
          </div>

          <div class="tab-panel" id="panel-layout" role="tabpanel" aria-labelledby="tab-layout" data-panel="layout" hidden>
            <div class="panel-heading"><p class="eyebrow">{t("dashboard.store_builder.panel.layout.eyebrow")}</p><h2>{t("dashboard.store_builder.panel.layout.title")}</h2><p>{t("dashboard.store_builder.panel.layout.description")}</p></div>
            <fieldset disabled={!canManage}>
              <label class="toggle-row"><input name="showExactStock" data-field="showExactStock" type="checkbox" checked={settings.content.showExactStock} /><span><strong>{t("dashboard.store_builder.field.exact_stock")}</strong><small>{t("dashboard.store_builder.field.exact_stock_help")}</small></span></label>
            </fieldset>
            <div class="read-only-list"><div><strong>{t("dashboard.store_builder.readonly.catalog")}</strong><span>{t("dashboard.store_builder.readonly.catalog_detail")}</span></div><div><strong>{t("dashboard.store_builder.readonly.checkout")}</strong><span>{t("dashboard.store_builder.readonly.checkout_detail")}</span></div><div><strong>{t("dashboard.store_builder.readonly.responsive")}</strong><span>{t("dashboard.store_builder.readonly.responsive_detail")}</span></div></div>
          </div>

          <div class="tab-panel" id="panel-seo" role="tabpanel" aria-labelledby="tab-seo" data-panel="seo" hidden>
            <div class="panel-heading"><p class="eyebrow">{t("dashboard.store_builder.panel.seo.eyebrow")}</p><h2>{t("dashboard.store_builder.panel.seo.title")}</h2><p>{t("dashboard.store_builder.panel.seo.description")}</p></div>
            <fieldset disabled={!canManage}>
              <label>{t("dashboard.store_builder.field.seo_title")}<input name="seoTitle" data-field="seoTitle" value={settings.content.seoTitle} maxlength="60" /></label>
              <label>{t("dashboard.store_builder.field.seo_description")}<textarea name="seoDescription" data-field="seoDescription" rows="4" maxlength="160">{settings.content.seoDescription}</textarea></label>
            </fieldset>
            <div class="read-only-list"><div><strong>{t("dashboard.store_builder.readonly.canonical")}</strong><span>{shop.slug}.{env.PLATFORM_BASE_DOMAIN}</span></div><div><strong>{t("dashboard.store_builder.readonly.indexing")}</strong><span>{t("dashboard.store_builder.readonly.indexing_detail")}</span></div><div><strong>{t("dashboard.store_builder.readonly.meta_fallback")}</strong><span>{t("dashboard.store_builder.readonly.meta_fallback_detail")}</span></div></div>
          </div>

          <div class="tab-panel" id="panel-support" role="tabpanel" aria-labelledby="tab-support" data-panel="support" hidden>
            <div class="panel-heading"><p class="eyebrow">{t("dashboard.store_builder.panel.support.eyebrow")}</p><h2>{t("dashboard.store_builder.panel.support.title")}</h2><p>{t("dashboard.store_builder.panel.support.description")}</p></div>
            <div class="read-only-list"><div><strong>{t("dashboard.store_builder.readonly.delivery")}</strong><span>{settings.content.deliveryText}</span></div><div><strong>{t("dashboard.store_builder.readonly.support")}</strong><span>{settings.content.supportText}</span></div><div><strong>{t("dashboard.store_builder.readonly.policies")}</strong><span><a href={workspaceHref("/onboarding")}>{t("dashboard.store_builder.readonly.policies_detail")}</a></span></div></div>
          </div>

          <div class="settings-footer">
            {!canManage && <p class="permission-note">{t("dashboard.store_builder.permission.viewer", { role: shop.role })}</p>}
            {canManage && !canPublish && <p class="permission-note">{t("dashboard.store_builder.permission.manager")}</p>}
            <div class="settings-actions"><button class="sln-button" data-variant="secondary" type="button" data-undo disabled>{t("dashboard.store_builder.undo")}</button><button class="sln-button" data-variant="primary" type="button" data-save disabled>{t("dashboard.store_builder.save")}</button></div>
            <p class="form-feedback" data-feedback role="status" aria-live="polite"></p>
          </div>
        </section>

        <section id="store-preview" class="preview-pane" aria-label={t("dashboard.store_builder.preview.aria")} aria-labelledby="builder-view-preview">
          <div class="preview-frame" data-preview-frame data-device="desktop">
            <div class="preview-browser-bar"><span></span><span></span><span></span><code>{shop.slug}.{env.PLATFORM_BASE_DOMAIN}</code></div>
            <div class="storefront-preview" data-preview-surface>
              <header class="store-header"><div class="store-logo" data-preview-logo>{settings.theme.logoUrl ? <img src={settings.theme.logoUrl} alt="" /> : <span>{shop.name.slice(0, 1).toUpperCase()}</span>}</div><strong>{shop.name}</strong><span class="preview-cart-link" aria-label={t("dashboard.store_builder.preview.cart")}>{t("dashboard.store_builder.preview.cart")} <span aria-hidden="true">0</span></span></header>
              <div class="store-announcement" data-preview-announcement hidden={!settings.content.announcement}>{settings.content.announcement}</div>

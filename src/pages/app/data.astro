---
import AppLayout from "../../layouts/AppLayout.astro";
import WorkspaceState from "../../components/states/WorkspaceState.astro";
import PageHeader from "../../components/workspace/PageHeader.astro";
import { authenticateRequest } from "../../lib/auth/session";
import { isAppError } from "../../lib/core/errors";
import { listDataExports, type DataExportView } from "../../lib/operations/exports";
import { getShopDeletion, type ShopDeletionView } from "../../lib/operations/deletion";
import { listOwnerAbuseReports, type AbuseReportView } from "../../lib/operations/abuse";
import { listSellerAuditEntries, type SellerAuditEntry } from "../../lib/operations/seller-audit";
import { getBindings } from "../../lib/platform/bindings";
import { withSelectedShop } from "../../lib/dashboard/shop-navigation";
import { listShopsForMember, selectShopForMember, type ShopView } from "../../lib/tenants/store";
import { createDashboardTranslator } from "../../lib/i18n";

const env = getBindings();
const auth = await authenticateRequest(Astro.request, env).catch(() => null);
if (auth === null) return Astro.redirect("/login");

let shops: ShopView[] = [];
let shopLoadState: "ready" | "unavailable" = "ready";
try {
  shops = await listShopsForMember({ env, userId: auth.userId });
} catch {
  shopLoadState = "unavailable";
}

const shop = selectShopForMember(shops, Astro.url.searchParams.get("shop"));
const workspaceHref = (href: string): string => withSelectedShop(href, shop?.publicId, Astro.url.origin);
const locale = Astro.locals.locale;
const t = createDashboardTranslator(locale);
let exports: DataExportView[] = [];
let deletion: ShopDeletionView | null = null;
let auditEntries: SellerAuditEntry[] = [];
let abuseReports: AbuseReportView[] = [];
let exportState: "forbidden" | "ready" | "unavailable" = "ready";
let deletionState: "forbidden" | "ready" | "unavailable" = "ready";
let auditState: "forbidden" | "ready" | "unavailable" = "ready";
let abuseState: "forbidden" | "ready" | "unavailable" = "ready";

if (shop !== undefined && shop.role === "owner") {
  const [exportsResult, deletionResult, auditResult, abuseResult] = await Promise.allSettled([
    listDataExports({ env, shopPublicId: shop.publicId, userId: auth.userId }),
    getShopDeletion({ env, shopPublicId: shop.publicId, userId: auth.userId }),
    listSellerAuditEntries({ env, shopPublicId: shop.publicId, userId: auth.userId }),
    listOwnerAbuseReports({ cursor: null, env, limit: 50, shopPublicId: shop.publicId, status: null, userId: auth.userId }),
  ]);

  if (exportsResult.status === "fulfilled") exports = exportsResult.value;
  else exportState = isAppError(exportsResult.reason) && exportsResult.reason.status === 403 ? "forbidden" : "unavailable";

  if (deletionResult.status === "fulfilled") deletion = deletionResult.value;
  else deletionState = isAppError(deletionResult.reason) && deletionResult.reason.status === 403 ? "forbidden" : "unavailable";

  if (auditResult.status === "fulfilled") auditEntries = auditResult.value;
  else auditState = isAppError(auditResult.reason) && auditResult.reason.status === 403 ? "forbidden" : "unavailable";

  if (abuseResult.status === "fulfilled") abuseReports = abuseResult.value.reports;
  else abuseState = isAppError(abuseResult.reason) && abuseResult.reason.status === 403 ? "forbidden" : "unavailable";
} else if (shop !== undefined) {
  exportState = "forbidden";
  deletionState = "forbidden";
  auditState = "forbidden";
  abuseState = "forbidden";
}

const dateFormatter = new Intl.DateTimeFormat(locale ?? "en", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: shop?.timezone ?? "Asia/Ho_Chi_Minh",
});
const formatDate = (value: string | null): string => value === null ? t("dashboard.data.common.not_recorded") : dateFormatter.format(new Date(value));

const exportKindLabel = (value: DataExportView["kind"]): string => value === "standard"
  ? t("dashboard.data.export.kind.standard")
  : t("dashboard.data.export.kind.plaintext");
const exportStatusLabel = (value: string): string => ({
  available: t("dashboard.data.export.status.available"),
  completed: t("dashboard.data.export.status.completed"),
  consumed: t("dashboard.data.export.status.consumed"),
  failed: t("dashboard.data.export.status.failed"),
  processing: t("dashboard.data.export.status.processing"),
}[value] ?? t("dashboard.data.export.status.unknown"));
const deletionStatusLabel = (value: string): string => ({
  blocked: t("dashboard.data.deletion.status.blocked"),
  canceled: t("dashboard.data.deletion.status.canceled"),
  completed: t("dashboard.data.deletion.status.completed"),
  failed: t("dashboard.data.deletion.status.failed"),
  processing: t("dashboard.data.deletion.status.processing"),
  retention_hold: t("dashboard.data.deletion.status.retention_hold"),
}[value] ?? t("dashboard.data.deletion.status.unknown"));
const deletionStepLabel = (value: string): string => ({
  active_payment_drain: t("dashboard.data.deletion.step.active_payment_drain"),
  checkout_block: t("dashboard.data.deletion.step.checkout_block"),
  crypto_shred: t("dashboard.data.deletion.step.crypto_shred"),
  custom_domain_cleanup: t("dashboard.data.deletion.step.custom_domain_cleanup"),
  finalize: t("dashboard.data.deletion.step.finalize"),
  grace_wait: t("dashboard.data.deletion.step.grace_wait"),
  payment_cleanup: t("dashboard.data.deletion.step.payment_cleanup"),
  routing_remove: t("dashboard.data.deletion.step.routing_remove"),
  telegram_cleanup: t("dashboard.data.deletion.step.telegram_cleanup"),
}[value] ?? value);
const deletionStepStatusLabel = (value: string): string => ({
  blocked: t("dashboard.data.deletion.step_status.blocked"),
  completed: t("dashboard.data.deletion.step_status.completed"),
  failed: t("dashboard.data.deletion.step_status.failed"),
  pending: t("dashboard.data.deletion.step_status.pending"),
  processing: t("dashboard.data.deletion.step_status.processing"),
}[value] ?? t("dashboard.data.deletion.step_status.unknown"));
const abuseCategoryLabel = (value: string): string => ({
  copyright: t("dashboard.data.abuse.category.copyright"),
  fraud: t("dashboard.data.abuse.category.fraud"),
  malware: t("dashboard.data.abuse.category.malware"),
  other: t("dashboard.data.abuse.category.other"),
  privacy: t("dashboard.data.abuse.category.privacy"),
  prohibited_content: t("dashboard.data.abuse.category.prohibited_content"),
}[value] ?? t("dashboard.data.abuse.category.unknown"));
const abuseStatusLabel = (value: string): string => ({
  actioned: t("dashboard.data.abuse.status.actioned"),
  closed: t("dashboard.data.abuse.status.closed"),
  dismissed: t("dashboard.data.abuse.status.dismissed"),
  investigating: t("dashboard.data.abuse.status.investigating"),
  received: t("dashboard.data.abuse.status.received"),
  triaged: t("dashboard.data.abuse.status.triaged"),
}[value] ?? t("dashboard.data.abuse.status.unknown"));
const moderationTargetStatusLabel = (value: string | null): string => ({
  active: t("dashboard.data.abuse.target_status.active"),
  archived: t("dashboard.data.abuse.target_status.archived"),
  draft: t("dashboard.data.abuse.target_status.draft"),
  suspended: t("dashboard.data.abuse.target_status.suspended"),
}[value ?? ""] ?? t("dashboard.data.abuse.target_status.unknown"));
const abuseTargetLabel = (report: AbuseReportView): string => {
  if (report.targetKind === "product") return moderationTargetStatusLabel(report.targetStatus);
  if (report.targetKind === "domain") return t("dashboard.data.abuse.target.domain");
  if (report.targetKind === "shop") return t("dashboard.data.abuse.target.shop");
  return t("dashboard.data.abuse.target.other");
};
const abuseTargetKindLabel = (value: string): string => ({
  domain: t("dashboard.data.abuse.kind.domain"),
  product: t("dashboard.data.abuse.kind.product"),
  shop: t("dashboard.data.abuse.kind.shop"),
}[value] ?? t("dashboard.data.abuse.kind.unknown"));
const canCancelDeletion = deletion !== null
  && !new Set(["canceled", "completed"]).has(deletion.status)
  && deletion.providerCleanupCompletedAt === null
  && deletion.secretMaterialDestroyedAt === null;
const canResumeDeletion = deletion !== null && new Set(["blocked", "failed", "retention_hold"]).has(deletion.status);
---

<AppLayout activePath="/app/data" displayName={auth.displayName.trim() || t("dashboard.commerce.you")} email={auth.email} selectedShopName={shop?.name} selectedShopPublicId={shop?.publicId} shops={shops} title={t("dashboard.data.title")}>
  <PageHeader eyebrow={t("dashboard.data.eyebrow")} title={t("dashboard.data.title")} description={t("dashboard.data.description")}>
    {shop !== undefined && <a slot="actions" class="sln-button sln-button-secondary" href={workspaceHref("/app")}>{t("dashboard.data.back")}</a>}
  </PageHeader>

  {shopLoadState === "unavailable" ? (
    <div class="state-space">
      <WorkspaceState eyebrow={t("dashboard.data.state.workspace_unavailable.eyebrow")} title={t("dashboard.data.state.workspace_unavailable.title")} description={t("dashboard.data.state.workspace_unavailable.description")} actionHref={workspaceHref("/app/data")} actionLabel={t("dashboard.data.state.workspace_unavailable.action")} tone="danger" />
    </div>
  ) : shop === undefined ? (
    <div class="state-space">
      <WorkspaceState title={t("dashboard.data.state.no_store.title")} description={t("dashboard.data.state.no_store.description")} actionHref={workspaceHref("/onboarding")} actionLabel={t("dashboard.data.state.no_store.action")} tone="info" />
    </div>
  ) : shop.role !== "owner" ? (
    <div class="state-space">
      <WorkspaceState eyebrow={t("dashboard.data.state.owner_only.eyebrow")} title={t("dashboard.data.state.owner_only.title")} description={t("dashboard.data.state.owner_only.description", { role: shop.role })} tone="warning" />
    </div>
  ) : (
    <div class="data-workspace" data-data-lifecycle-root data-locale={locale ?? "en"} data-shop-public-id={shop.publicId} data-csrf-cookie-name={`${env.SESSION_COOKIE_NAME}_csrf`}>
      <p class="action-feedback" role="status" aria-live="polite" tabindex="-1" data-action-feedback hidden></p>
      <button class="retry-download" type="button" data-retry-download hidden>{t("dashboard.data.client.export.retry")}</button>

      <section class="data-panel" aria-labelledby="exports-title">
        <header class="panel-heading">
          <div><p class="eyebrow">{t("dashboard.data.exports.eyebrow")}</p><h2 id="exports-title">{t("dashboard.data.exports.title")}</h2></div>
          <span>{t("dashboard.data.exports.count", { count: exports.length })}</span>
        </header>

        <div class="export-options">
          <article>
            <div><strong>{t("dashboard.data.exports.standard.title")}</strong><p>{t("dashboard.data.exports.standard.description")}</p></div>
            <button class="sln-button sln-button-primary" type="button" data-create-export="standard">{t("dashboard.data.exports.standard.action")}</button>
          </article>
          <article class="risk-option">
            <div><strong>{t("dashboard.data.exports.plaintext.title")}</strong><p>{t("dashboard.data.exports.plaintext.description")}</p></div>
            <details>
              <summary>{t("dashboard.data.exports.plaintext.summary")}</summary>
              <label><input type="checkbox" data-plaintext-ack /> {t("dashboard.data.exports.plaintext.ack")}</label>
              <button class="sln-button sln-button-danger" type="button" data-create-export="inventory_keys_plaintext">{t("dashboard.data.exports.plaintext.action")}</button>
            </details>
          </article>
        </div>

        {exportState === "unavailable" ? (
          <WorkspaceState eyebrow={t("dashboard.data.exports.state.unavailable.eyebrow")} title={t("dashboard.data.exports.state.unavailable.title")} description={t("dashboard.data.exports.state.unavailable.description")} actionHref={workspaceHref("/app/data")} actionLabel={t("dashboard.data.exports.state.unavailable.action")} tone="danger" />
        ) : exportState === "forbidden" ? (
          <WorkspaceState title={t("dashboard.data.exports.state.forbidden.title")} description={t("dashboard.data.exports.state.forbidden.description")} tone="warning" />
        ) : exports.length === 0 ? (
          <WorkspaceState eyebrow={t("dashboard.data.exports.state.empty.eyebrow")} title={t("dashboard.data.exports.state.empty.title")} description={t("dashboard.data.exports.state.empty.description")} tone="neutral" />
        ) : (
          <div class="export-ledger" role="list" aria-label={t("dashboard.data.exports.aria")}>
            {exports.map((item) => (
              <article role="listitem">
                <div class="record-mark" aria-hidden="true">{item.includesPlaintextKeys ? "!" : "↓"}</div>
                <div><strong>{exportKindLabel(item.kind)}</strong><code>{item.id}</code></div>
                <div><span>{t("dashboard.data.common.status")}</span><strong>{exportStatusLabel(item.status)}</strong></div>
                <div><span>{t("dashboard.data.common.created_at")}</span><time datetime={item.createdAt}>{formatDate(item.createdAt)}</time></div>
                <div><span>{t("dashboard.data.common.retained_until")}</span><time datetime={item.retainUntil}>{formatDate(item.retainUntil)}</time></div>
                <div><span>{t("dashboard.data.common.downloaded_at")}</span><strong>{item.downloadedAt === null ? t("dashboard.data.common.not_downloaded") : formatDate(item.downloadedAt)}</strong></div>
                {item.lastSafeErrorCode !== null && <p class="record-error">{t("dashboard.data.common.safe_error_code")}: <code>{item.lastSafeErrorCode}</code></p>}
              </article>
            ))}
          </div>
        )}
      </section>

      <section class="data-panel abuse-panel" aria-labelledby="abuse-title">
        <header class="panel-heading">
          <div><p class="eyebrow eyebrow-danger">{t("dashboard.data.abuse.eyebrow")}</p><h2 id="abuse-title">{t("dashboard.data.abuse.title")}</h2></div>
          <span>{t("dashboard.data.abuse.count", { count: abuseReports.length })}</span>
        </header>
        {abuseState === "unavailable" ? (
          <WorkspaceState eyebrow={t("dashboard.data.abuse.state.unavailable.eyebrow")} title={t("dashboard.data.abuse.state.unavailable.title")} description={t("dashboard.data.abuse.state.unavailable.description")} actionHref={workspaceHref("/app/data")} actionLabel={t("dashboard.data.abuse.state.unavailable.action")} tone="danger" />
        ) : abuseState === "forbidden" ? (
          <WorkspaceState title={t("dashboard.data.abuse.state.forbidden.title")} description={t("dashboard.data.abuse.state.forbidden.description")} tone="warning" />
        ) : abuseReports.length === 0 ? (
          <WorkspaceState eyebrow={t("dashboard.data.abuse.state.empty.eyebrow")} title={t("dashboard.data.abuse.state.empty.title")} description={t("dashboard.data.abuse.state.empty.description")} tone="neutral" />
        ) : (
          <div class="abuse-ledger" role="list" aria-label={t("dashboard.data.abuse.aria")}>
            {abuseReports.map((report) => {
              const canSuspend = report.targetKind === "product"
                && new Set(["active", "draft"]).has(report.targetStatus ?? "")
                && !new Set(["actioned", "closed", "dismissed"]).has(report.status);
              const canRestore = report.targetKind === "product"
                && report.targetStatus === "suspended"
                && report.ownerRestoreEligible;
              return (
                <article role="listitem" data-moderation-report-row data-target-status={report.targetStatus ?? "unavailable"}>
                  <span class="report-severity" aria-hidden="true">!</span>
                  <div class="report-copy"><strong>{abuseCategoryLabel(report.category)}</strong><p>{report.summary}</p><small>{abuseTargetKindLabel(report.targetKind)} · {report.targetRef}</small></div>
                  <div><span>{t("dashboard.data.abuse.report_target")}</span><strong>{abuseStatusLabel(report.status)} · {abuseTargetLabel(report)}</strong></div>
                  <time datetime={report.createdAt}>{formatDate(report.createdAt)}</time>
                  {(canSuspend || canRestore) && (
                    <details>
                      <summary>{t("dashboard.data.abuse.moderation.summary")}</summary>
                      <p>{canRestore
                        ? t("dashboard.data.abuse.moderation.restore_detail")
                        : t("dashboard.data.abuse.moderation.suspend_detail")}</p>
                      <button
                        class:list={["sln-button", canRestore ? "sln-button-secondary" : "sln-button-danger"]}
                        type="button"
                        data-moderation-action={canRestore ? "product_restore" : "product_suspend"}
                        data-moderation-report={report.publicId}
                        data-target-id={report.targetRef}
                      >{canRestore ? t("dashboard.data.abuse.moderation.restore_action") : t("dashboard.data.abuse.moderation.suspend_action")}</button>
                    </details>
                  )}
                </article>
              );
            })}
          </div>
        )}
      </section>

      <section class="data-panel deletion-panel" aria-labelledby="deletion-title">
        <header class="panel-heading">
          <div><p class="eyebrow eyebrow-danger">{t("dashboard.data.deletion.eyebrow")}</p><h2 id="deletion-title">{t("dashboard.data.deletion.title")}</h2></div>
          <span>{t("dashboard.data.deletion.cascade_note")}</span>
        </header>

        {deletionState === "unavailable" ? (
          <WorkspaceState eyebrow={t("dashboard.data.deletion.state.unavailable.eyebrow")} title={t("dashboard.data.deletion.state.unavailable.title")} description={t("dashboard.data.deletion.state.unavailable.description")} actionHref={workspaceHref("/app/data")} actionLabel={t("dashboard.data.deletion.state.unavailable.action")} tone="danger" />
        ) : deletionState === "forbidden" ? (
          <WorkspaceState title={t("dashboard.data.deletion.state.forbidden.title")} description={t("dashboard.data.deletion.state.forbidden.description")} tone="warning" />
        ) : deletion === null ? (
          <div class="deletion-start">
            <div class="impact-copy">
              <strong>{t("dashboard.data.deletion.start.impact")}</strong>
              <p>{t("dashboard.data.deletion.start.description")}</p>
            </div>
            <form data-deletion-request-form>
              <label>{t("dashboard.data.deletion.start.reason")}
                <select name="reasonCode">
                  <option value="seller_request">{t("dashboard.data.deletion.start.reason.seller_request")}</option>
                  <option value="business_closed">{t("dashboard.data.deletion.start.reason.business_closed")}</option>
                  <option value="platform_migration">{t("dashboard.data.deletion.start.reason.platform_migration")}</option>
                  <option value="other">{t("dashboard.data.deletion.start.reason.other")}</option>
                </select>
              </label>
              <label>{t("dashboard.data.deletion.start.confirm")} <code>DELETE SHOP</code>
                <input name="confirmation" autocomplete="off" required pattern="DELETE SHOP" />
              </label>
              <button class="sln-button sln-button-danger" type="submit">{t("dashboard.data.deletion.start.action")}</button>
            </form>
          </div>
        ) : (
          <div class="deletion-status" data-deletion-id={deletion.id} data-deletion-version={deletion.version}>
            <div class="deletion-summary">
              <div><span>{t("dashboard.data.common.status")}</span><strong>{deletionStatusLabel(deletion.status)}</strong></div>
              <div><span>{t("dashboard.data.deletion.summary.grace_ends")}</span><time datetime={deletion.graceEndsAt}>{formatDate(deletion.graceEndsAt)}</time></div>
              <div><span>{t("dashboard.data.deletion.summary.financial_retain_until")}</span><time datetime={deletion.financialRecordsRetainUntil}>{formatDate(deletion.financialRecordsRetainUntil)}</time></div>
              <div><span>{t("dashboard.data.deletion.summary.version")}</span><strong>{deletion.version}</strong></div>
            </div>

            {deletion.legalHoldUntil !== null && <p class="hold-note">{t("dashboard.data.deletion.legal_hold", { time: formatDate(deletion.legalHoldUntil) })}</p>}
            {deletion.lastSafeErrorCode !== null && <p class="record-error">{t("dashboard.data.deletion.workflow_attention")}: <code>{deletion.lastSafeErrorCode}</code></p>}

            <ol class="step-ledger">
              {deletion.steps.map((step) => (
                <li data-step-status={step.status}>
                  <span aria-hidden="true"></span>
                  <div><strong>{deletionStepLabel(step.code)}</strong><small>{deletionStepStatusLabel(step.status)} · {t("dashboard.data.common.attempts", { count: step.attempts })}</small></div>
                  <time datetime={step.updatedAt}>{formatDate(step.updatedAt)}</time>
                </li>
              ))}
            </ol>

            {(canResumeDeletion || canCancelDeletion) && (
              <div class="deletion-actions">
                {canResumeDeletion && <button class="sln-button sln-button-primary" type="button" data-deletion-resume>{t("dashboard.data.deletion.action.resume")}</button>}
                {canCancelDeletion && <button class="sln-button sln-button-secondary" type="button" data-deletion-cancel>{t("dashboard.data.deletion.action.cancel")}</button>}
              </div>
            )}
          </div>
        )}
      </section>

      <section class="data-panel audit-panel" aria-labelledby="audit-title">
        <header class="panel-heading">
          <div><p class="eyebrow">{t("dashboard.data.audit.eyebrow")}</p><h2 id="audit-title">{t("dashboard.data.audit.title")}</h2></div>
          <span>{t("dashboard.data.audit.count", { count: auditEntries.length })}</span>
        </header>
        {auditState === "unavailable" ? (
          <WorkspaceState eyebrow={t("dashboard.data.audit.state.unavailable.eyebrow")} title={t("dashboard.data.audit.state.unavailable.title")} description={t("dashboard.data.audit.state.unavailable.description")} actionHref={workspaceHref("/app/data")} actionLabel={t("dashboard.data.audit.state.unavailable.action")} tone="danger" />
        ) : auditState === "forbidden" ? (
          <WorkspaceState title={t("dashboard.data.audit.state.forbidden.title")} description={t("dashboard.data.audit.state.forbidden.description")} tone="warning" />
        ) : auditEntries.length === 0 ? (
          <WorkspaceState eyebrow={t("dashboard.data.audit.state.empty.eyebrow")} title={t("dashboard.data.audit.state.empty.title")} description={t("dashboard.data.audit.state.empty.description")} tone="neutral" />
        ) : (
          <div class="audit-ledger" role="list" aria-label={t("dashboard.data.audit.aria")}>
            {auditEntries.map((entry) => (
              <article role="listitem">
                <time datetime={entry.createdAt}>{formatDate(entry.createdAt)}</time>
                <div><strong>{entry.action}</strong><span>{entry.resourceType}{entry.resourceId === null ? "" : ` · ${entry.resourceId}`}</span></div>
                <div><span>{t("dashboard.data.common.source")}</span><strong>{entry.sourceKind}</strong></div>
                <div><span>{t("dashboard.data.common.request")}</span><code>{entry.requestId}</code></div>
              </article>
            ))}
          </div>
        )}
      </section>
    </div>
  )}
</AppLayout>

{shop !== undefined && shop.role === "owner" && <script src="../../scripts/dashboard/data-lifecycle.ts"></script>}

<style>
  .sln-button { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; border: 1px solid transparent; border-radius: var(--sln-radius-md); padding: 10px 16px; font: var(--sln-font-label); text-decoration: none; cursor: pointer; }
  .sln-button:disabled { cursor: wait; opacity: .62; }
  .sln-button-primary { background: var(--sln-action-primary); color: var(--sln-white); }
  .sln-button-secondary { border-color: var(--sln-border-strong); background: var(--sln-bg-surface); color: var(--sln-text-primary); }
  .sln-button-danger { background: var(--sln-state-danger); color: var(--sln-white); }
  .state-space, .data-workspace { margin-top: var(--sln-space-8); }
  .data-workspace { display: grid; gap: var(--sln-space-8); }
  .action-feedback { position: sticky; top: calc(var(--sln-topbar-height) + 12px); z-index: var(--sln-z-sticky); margin: 0; border: 1px solid color-mix(in srgb, var(--sln-state-info) 28%, transparent); border-radius: var(--sln-radius-md); padding: 12px 16px; background: var(--sln-tint-info); color: var(--sln-text-primary); font: var(--sln-font-body-sm); box-shadow: var(--sln-shadow-sm); }
  .action-feedback[data-tone="danger"] { border-color: color-mix(in srgb, var(--sln-state-danger) 32%, transparent); background: var(--sln-tint-danger); }
  .action-feedback[hidden], .retry-download[hidden] { display: none; }

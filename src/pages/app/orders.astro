---
import AppLayout from "../../layouts/AppLayout.astro";
import FulfillmentState from "../../components/commerce/FulfillmentState.astro";
import Money from "../../components/commerce/Money.astro";
import PaymentState from "../../components/commerce/PaymentState.astro";
import Button from "../../components/primitives/Button.astro";
import LinkButton from "../../components/primitives/LinkButton.astro";
import WorkspaceState from "../../components/states/WorkspaceState.astro";
import DataTable from "../../components/workspace/DataTable.astro";
import PageHeader from "../../components/workspace/PageHeader.astro";
import { authenticateRequest } from "../../lib/auth/session";
import { listSellerOrdersPage, parseSellerOrderSort, parseSellerOrderStatusFilter, type SellerOrderSummary } from "../../lib/commerce/seller-orders";
import { isAppError } from "../../lib/core/errors";
import { listPaymentExceptions, parsePaymentExceptionEvidence, type PaymentExceptionEvidence, type PaymentExceptionView } from "../../lib/payments/reconciliation";
import { getBindings } from "../../lib/platform/bindings";
import { withSelectedShop } from "../../lib/dashboard/shop-navigation";
import { getShopForMember, listShopsForMember, selectShopForMember, type ShopView } from "../../lib/tenants/store";
import { createDashboardTranslator } from "../../lib/i18n";

const env = getBindings();
const auth = await authenticateRequest(Astro.request, env).catch(() => null);
if (auth === null) return Astro.redirect("/login");

let shops: ShopView[] = [];
let loadState: "forbidden" | "ready" | "unavailable" = "ready";
let loadRequestId: string | null = null;
try {
  shops = await listShopsForMember({ env, userId: auth.userId });
} catch {
  loadState = "unavailable";
  loadRequestId = Astro.locals.requestId;
}
const shop = selectShopForMember(shops, Astro.url.searchParams.get("shop"));
const workspaceHref = (href: string): string => withSelectedShop(href, shop?.publicId, Astro.url.origin);
const locale = Astro.locals.locale;
const t = createDashboardTranslator(locale);

// The Astro page parses the table URL contract itself (q/status/sort/page/
// pageSize) and passes explicit values into the service; parsePublicApiPage
// only accepts cursor/limit, so the raw URL is never forwarded.
const searchParams = Astro.url.searchParams;
const parsedPage = Number.parseInt(searchParams.get("page") ?? "", 10);
const requestedPage = Number.isSafeInteger(parsedPage) && parsedPage >= 1 ? parsedPage : 1;
const parsedPageSize = Number.parseInt(searchParams.get("pageSize") ?? "", 10);
const requestedPageSize = parsedPageSize === 25 || parsedPageSize === 50 || parsedPageSize === 100 ? parsedPageSize : 25;
const statusFilter = parseSellerOrderStatusFilter(searchParams.get("status"));
const sort = parseSellerOrderSort(searchParams.get("sort"));
const query = searchParams.get("q")?.trim().slice(0, 64) ?? "";
const hasActiveFilters = query !== "" || statusFilter !== "all";

let orders: SellerOrderSummary[] = [];
let currentPage = requestedPage;
let pageSize = requestedPageSize;
let totalCount = 0;
let totalPages = 1;
let paymentExceptions: PaymentExceptionView[] = [];
let paymentExceptionState: "forbidden" | "ready" | "unavailable" = "ready";
let paymentExceptionRequestId: string | null = null;

if (shop !== undefined && loadState === "ready") {
  try {
    const result = await listSellerOrdersPage({ env, page: requestedPage, pageSize: requestedPageSize, search: query === "" ? null : query, shopPublicId: shop.publicId, sort, statusFilter, userId: auth.userId });
    orders = result.orders;
    currentPage = result.page ?? requestedPage;
    pageSize = result.pageSize ?? requestedPageSize;
    totalCount = result.totalCount ?? orders.length;
    totalPages = result.totalPages ?? 1;
  } catch (error) {
    loadState = isAppError(error) && error.status === 403 ? "forbidden" : "unavailable";
    if (loadState === "unavailable") loadRequestId = Astro.locals.requestId;
  }
  try {
    const member = await getShopForMember({ capability: "payments:read", env, shopPublicId: shop.publicId, userId: auth.userId });
    paymentExceptions = await listPaymentExceptions({ env, shopId: member.row.shop_id });
  } catch (error) {
    paymentExceptionState = isAppError(error) && error.status === 403 ? "forbidden" : "unavailable";
    if (paymentExceptionState === "unavailable") paymentExceptionRequestId = Astro.locals.requestId;
  }
}

const buildHref = (params: Record<string, number | string | null | undefined>): string => {
  const next = new URLSearchParams();
  for (const [key, value] of Object.entries(params)) {
    if (value === null || value === undefined || value === "") continue;
    next.set(key, String(value));
  }
  const suffix = next.toString();
  return workspaceHref(`/app/orders${suffix === "" ? "" : `?${suffix}`}`);
};
const pageHref = (page: number): string => buildHref({
  page,
  pageSize,
  q: query === "" ? null : query,
  sort: searchParams.get("sort"),
  status: statusFilter === "all" ? null : statusFilter,
});

const paymentPending = new Set(["unpaid", "pending"]);
const exceptionPayments = new Set(["partial", "overpaid", "failed"]);
const exceptionFulfillments = new Set(["failed", "manual_review"]);
const isException = (order: SellerOrderSummary): boolean => order.status === "exception"
  || exceptionPayments.has(order.paymentStatus)
  || exceptionFulfillments.has(order.fulfillmentStatus);

const pendingCount = orders.filter((order) => paymentPending.has(order.paymentStatus)).length;
const verifiedCount = orders.filter((order) => order.paymentStatus === "paid").length;
const exceptionCount = orders.filter(isException).length;
const dateFormatter = new Intl.DateTimeFormat(locale ?? "en", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: shop?.timezone ?? "Asia/Ho_Chi_Minh",
});
const formatDate = (value: string | null | undefined): string => {
  if (value === null || value === undefined || value === "") return t("dashboard.commerce.not_recorded");
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? t("dashboard.commerce.not_recorded") : dateFormatter.format(date);
};
const exceptionTypeLabel = (value: string): string => t(
  `dashboard.orders.exception.type.${["identity_mismatch", "inconsistent", "late", "manual_review", "overpaid", "partial", "failed"].includes(value) ? value : "default"}`,
);
const paymentExceptionImpact = (type: string, evidence: PaymentExceptionEvidence): string => {
  if (type === "partial") return t("dashboard.orders.exception.impact.partial");
  if (type === "overpaid") return t("dashboard.orders.exception.impact.overpaid");
  if (type === "late") return t("dashboard.orders.exception.impact.late");
  if (type === "identity_mismatch") return t("dashboard.orders.exception.impact.identity_mismatch");
  if (type === "inconsistent") {
    if (evidence.expectedKeys !== null && evidence.reservedKeys !== null && evidence.expectedKeys !== evidence.reservedKeys) return t("dashboard.orders.exception.impact.inconsistent_mismatch");
    return t("dashboard.orders.exception.impact.inconsistent");
  }
  if (type === "failed") return t("dashboard.orders.exception.impact.failed");
  return t("dashboard.orders.exception.impact.default");
};
const paymentExceptionRecords = paymentExceptions.map(({ safeEvidenceJson, ...exception }) => ({
  evidence: parsePaymentExceptionEvidence(safeEvidenceJson),
  exception,
}));
const channelLabel = (value: string): string => value === "telegram" ? "Telegram" : value === "web" ? "Website" : value;

const sortBase: string = sort.endsWith("_desc") ? sort.slice(0, -5) : sort;
const sortDirection: "asc" | "desc" = sort.endsWith("_desc") ? "desc" : "asc";
const tableColumns = [
  { key: "order_number", label: t("dashboard.orders.table.order") },
  { label: t("dashboard.orders.table.customer_product") },
  { align: "end" as const, key: "total", label: t("dashboard.orders.table.total") },
  { label: t("dashboard.orders.table.payment") },
  { label: t("dashboard.orders.table.fulfillment") },
  { key: "created", label: t("dashboard.orders.table.channel_time") },
  { label: t("dashboard.orders.table.actions") },
];
type OrderExportRow = { channel: string; createdAt: string; customer: string; fulfillment: string; order: string; payment: string; product: string; total: string };
const exportRows: OrderExportRow[] = orders.map((order) => ({
  channel: channelLabel(order.sourceChannel),
  createdAt: order.createdAt,
  customer: order.customerEmail ?? "",
  fulfillment: order.fulfillmentStatus,
  order: `#${order.orderNumber} (${order.orderId})`,
  payment: order.paymentStatus,
  product: order.primaryItem ?? "",
  total: `${order.totalMinor} ${order.currency}`,
}));
const exportHeaders = [
  t("dashboard.orders.table.order"),
  t("dashboard.orders.table.customer_product"),
  t("dashboard.orders.table.total"),
  t("dashboard.orders.table.payment"),
  t("dashboard.orders.table.fulfillment"),
  t("dashboard.orders.table.channel_time"),
];
---

<AppLayout activePath="/app/orders" displayName={auth.displayName.trim() || t("dashboard.commerce.you")} email={auth.email} selectedShopName={shop?.name} selectedShopPublicId={shop?.publicId} shops={shops} title={t("dashboard.orders.title")}>
  <PageHeader eyebrow={t("dashboard.orders.eyebrow")} title={t("dashboard.orders.title")} description={t("dashboard.orders.description")}>
    {shop !== undefined && loadState === "ready" && <LinkButton slot="actions" variant="secondary" href={workspaceHref("/app/integrations")}>{t("dashboard.orders.check_channels")} <span aria-hidden="true">↗</span></LinkButton>}
  </PageHeader>

  {loadState === "unavailable" ? (
    <div class="state-space">
      <WorkspaceState eyebrow={t("dashboard.orders.unavailable.eyebrow")} title={t("dashboard.orders.unavailable.title")} description={`${t("dashboard.orders.unavailable.description")} ${loadRequestId === null ? "" : t("dashboard.state.error.meta_request", { requestId: loadRequestId })}`.trim()} actionHref={workspaceHref("/app/orders")} actionLabel={t("dashboard.orders.retry")} tone="danger" />
    </div>
  ) : shop === undefined ? (
    <div class="state-space">
      <WorkspaceState title={t("dashboard.orders.no_store.title")} description={t("dashboard.orders.no_store.description")} actionHref={workspaceHref("/onboarding")} actionLabel={t("dashboard.orders.no_store.action")} tone="info" />
    </div>
  ) : loadState === "forbidden" ? (
    <div class="state-space">
      <WorkspaceState eyebrow={t("dashboard.orders.forbidden.eyebrow")} title={t("dashboard.orders.forbidden.title")} description={t("dashboard.orders.forbidden.description")} tone="warning" />
    </div>
  ) : (
    <>
      <section class="order-rail" aria-label={t("dashboard.orders.summary.aria")}>
        <div><span>{t("dashboard.orders.summary.recent")}</span><strong>{totalCount}</strong><small>{t("dashboard.orders.summary.recent_caption")}</small></div>
        <div><span>{t("dashboard.orders.summary.pending")}</span><strong class="warning">{pendingCount}</strong><small>{t("dashboard.orders.summary.pending_caption")}</small></div>
        <div><span>{t("dashboard.orders.summary.paid")}</span><strong class="success">{verifiedCount}</strong><small>{t("dashboard.orders.summary.paid_caption")}</small></div>
        <div><span>{t("dashboard.orders.summary.exceptions")}</span><strong class={exceptionCount > 0 ? "danger" : undefined}>{exceptionCount}</strong><small>{t("dashboard.orders.summary.exceptions_caption")}</small></div>
      </section>

      {paymentExceptionState === "unavailable" && (
        <div class="state-space">
          <WorkspaceState eyebrow={t("dashboard.orders.unavailable.eyebrow")} title={t("dashboard.orders.unavailable.title")} description={`${t("dashboard.orders.unavailable.description")} ${paymentExceptionRequestId === null ? "" : t("dashboard.state.error.meta_request", { requestId: paymentExceptionRequestId })}`.trim()} actionHref={workspaceHref("/app/orders")} actionLabel={t("dashboard.orders.retry")} tone="danger" />
        </div>
      )}

      {paymentExceptionState === "ready" && paymentExceptions.length > 0 && (
        <section class="exception-panel" aria-labelledby="payment-exceptions-title">
          <div class="panel-heading">
            <div><p class="eyebrow eyebrow-danger">{t("dashboard.orders.exceptions.eyebrow")}</p><h2 id="payment-exceptions-title">{t("dashboard.orders.exceptions.title")}</h2></div>
            <span class="record-count">{t("dashboard.orders.exceptions.count", { count: paymentExceptions.length })}</span>
          </div>
          <p class="exception-intro">{t("dashboard.orders.exceptions.intro")}</p>
          <div class="exception-list" role="list">
            {paymentExceptionRecords.map(({ evidence, exception }) => (
              <article class="exception-record" role="listitem">
                <span class="exception-icon" aria-hidden="true">!</span>
                <div class="exception-record-main">
                  <div class="exception-title"><strong>{exceptionTypeLabel(exception.type)}</strong><small>{exception.status === "open" ? t("dashboard.orders.exceptions.open") : t("dashboard.orders.exceptions.recorded")} · {formatDate(exception.createdAt)}</small></div>
                  <p class="exception-impact">{paymentExceptionImpact(exception.type, evidence)}</p>
                  <dl class="exception-evidence">
                    {evidence.expectedAmount !== null && <div><dt>{t("dashboard.orders.exceptions.expected_amount")}</dt><dd><Money value={evidence.expectedAmount} currency={exception.currency} locale={locale ?? "en"} /></dd></div>}
                    {evidence.receivedAmount !== null && <div><dt>{t("dashboard.orders.exceptions.received_amount")}</dt><dd><Money value={evidence.receivedAmount} currency={exception.currency} locale={locale ?? "en"} /></dd></div>}
                    {evidence.occurredAt !== null && <div><dt>{t("dashboard.orders.exceptions.occurred_at")}</dt><dd>{formatDate(evidence.occurredAt)}</dd></div>}
                    {evidence.expectedKeys !== null && <div><dt>{t("dashboard.orders.exceptions.expected_keys")}</dt><dd>{evidence.expectedKeys}</dd></div>}
                    {evidence.reservedKeys !== null && <div><dt>{t("dashboard.orders.exceptions.reserved_keys")}</dt><dd>{evidence.reservedKeys}</dd></div>}
                  </dl>
                </div>
                <div class="exception-reference"><span>{t("dashboard.orders.exceptions.order")}</span>{exception.orderPublicId !== null ? <a href={`/app/orders/${encodeURIComponent(exception.orderPublicId)}?shop=${encodeURIComponent(shop.publicId)}`}>{exception.orderPublicId}</a> : <small>{t("dashboard.orders.exceptions.no_safe_link")}</small>}</div>
                <div class="exception-reference"><span>{t("dashboard.orders.exceptions.payment_attempt")}</span><code>{exception.paymentAttemptId}</code></div>
              </article>
            ))}
          </div>
          <p class="exception-footnote">{t("dashboard.orders.exceptions.footnote")}</p>
        </section>
      )}

      {totalCount === 0 && !hasActiveFilters ? (
        <div class="state-space state-space-ledger">
          <WorkspaceState eyebrow={t("dashboard.orders.empty.eyebrow")} title={t("dashboard.orders.empty.title")} description={t("dashboard.orders.empty.description")} actionHref={workspaceHref("/app/products")} actionLabel={t("dashboard.orders.empty.action")} tone="info" />
        </div>
      ) : (
        <section
          class="ledger-panel"
          aria-labelledby="order-ledger-title"
          data-order-ledger
          data-locale={locale ?? "en"}
          data-export-copy={JSON.stringify({ headers: exportHeaders })}
          data-export-rows={JSON.stringify(exportRows)}
        >
          <div class="panel-heading">
            <div><p class="eyebrow">{t("dashboard.orders.ledger.eyebrow")}</p><h2 id="order-ledger-title">{t("dashboard.orders.ledger.title")}</h2></div>
            <div class="panel-heading-tools">
              <span class="record-count" data-record-count data-record-template={t("dashboard.orders.record_count", { count: "__COUNT__" })}>{t("dashboard.orders.record_count", { count: totalCount })}</span>
              {orders.length > 0 && <Button type="button" variant="secondary" data-order-export>{t("dashboard.table.export")}</Button>}
            </div>
          </div>

          <form class="order-controls" method="get" aria-label={t("dashboard.orders.filters.aria")}>
            {searchParams.get("shop") !== null && <input type="hidden" name="shop" value={searchParams.get("shop") ?? ""} aria-label="shop" />}
            <label class="order-search">
              <span class="sr-only">{t("dashboard.orders.search.label")}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m16 16 4 4"></path></svg>
              <input type="search" name="q" value={query} placeholder={t("dashboard.orders.search.placeholder")} autocomplete="off" maxlength="64" data-order-search />
            </label>
            <label class="order-status">
              <span class="sr-only">{t("dashboard.orders.filters.status_aria")}</span>
              <select name="status" aria-label={t("dashboard.orders.filters.status_aria")}>
                <option value="all" selected={statusFilter === "all"}>{t("dashboard.orders.filters.all")}</option>
                <option value="payment-pending" selected={statusFilter === "payment-pending"}>{t("dashboard.orders.filters.payment_pending")}</option>
                <option value="payment-paid" selected={statusFilter === "payment-paid"}>{t("dashboard.orders.filters.payment_paid")}</option>
                <option value="fulfillment-processing" selected={statusFilter === "fulfillment-processing"}>{t("dashboard.orders.filters.fulfillment_processing")}</option>
                <option value="fulfilled" selected={statusFilter === "fulfilled"}>{t("dashboard.orders.filters.fulfilled")}</option>
                <option value="exception" selected={statusFilter === "exception"}>{t("dashboard.orders.filters.exception")}</option>
              </select>
            </label>
            <Button type="submit" variant="secondary">{t("dashboard.orders.filters.apply")}</Button>
          </form>

          {orders.length === 0 ? (
            <p class="table-empty" data-no-results>{t("dashboard.table.empty")}</p>
          ) : (
            <DataTable
              caption={t("dashboard.orders.table.aria")}
              columns={tableColumns}
              currentSort={sortBase}
              currentSortDirection={sortDirection}
              currentUrl={Astro.url}
            >
              <tbody>
                {orders.map((order) => (
                  <tr data-order-row>
                    <td data-label={t("dashboard.orders.table.order")}><strong>#{order.orderNumber}</strong><code>{order.orderId}</code></td>
                    <td data-label={t("dashboard.orders.table.customer_product")}><strong>{order.customerEmail ?? t("dashboard.orders.unknown_customer")}</strong><span>{order.primaryItem ?? t("dashboard.orders.unknown_product")}{order.itemCount > 1 ? ` +${order.itemCount - 1} ${t("dashboard.orders.items")}` : ""}</span></td>
                    <td class="cell-end" data-label={t("dashboard.orders.table.total")}><Money value={order.totalMinor} currency={order.currency} locale={locale ?? "en"} /><small>{order.itemCount} {t("dashboard.orders.items")}</small></td>
                    <td data-label={t("dashboard.orders.table.payment")}><PaymentState locale={locale} value={order.paymentStatus} /></td>
                    <td data-label={t("dashboard.orders.table.fulfillment")}><FulfillmentState locale={locale} value={order.fulfillmentStatus} /></td>
                    <td data-label={t("dashboard.orders.table.channel_time")}><strong>{channelLabel(order.sourceChannel)}</strong><time datetime={order.createdAt}>{formatDate(order.createdAt)}</time></td>
                    <td class="cell-end" data-label={t("dashboard.orders.table.actions")}><a href={workspaceHref(`/app/orders/${order.orderId}`)} aria-label={t("dashboard.orders.open_detail_aria", { number: order.orderNumber })}>{t("dashboard.orders.open_detail")} <span aria-hidden="true">→</span></a></td>
                  </tr>
                ))}
              </tbody>
              <nav slot="pagination" class="table-pagination" aria-label={t("dashboard.orders.pagination.aria")}>
                {currentPage > 1 && <a href={pageHref(currentPage - 1)}>← {t("dashboard.table.previous")}</a>}
                <span>{t("dashboard.table.page_info", { page: currentPage, totalPages })}</span>
                {currentPage < totalPages && <a href={pageHref(currentPage + 1)}>{t("dashboard.table.next")} →</a>}
                <form class="page-size-form" method="get">
                  {searchParams.get("shop") !== null && <input type="hidden" name="shop" value={searchParams.get("shop") ?? ""} aria-label="shop" />}
                  {query !== "" && <input type="hidden" name="q" value={query} aria-label="q" />}
                  {statusFilter !== "all" && <input type="hidden" name="status" value={statusFilter} aria-label="status" />}
                  {searchParams.get("sort") !== null && <input type="hidden" name="sort" value={sort} aria-label="sort" />}
                  <label>{t("dashboard.table.rows_per_page")}
                    <select name="pageSize" data-page-size-select>
                      {[25, 50, 100].map((size) => <option value={size} selected={pageSize === size}>{size}</option>)}
                    </select>
                  </label>
                </form>
              </nav>
            </DataTable>
          )}
        </section>
      )}
    </>
  )}
</AppLayout>

<script>
  import { buildCsv, downloadCsv } from "../../lib/dashboard/csv-export";

  type ExportRow = { channel: string; createdAt: string; customer: string; fulfillment: string; order: string; payment: string; product: string; total: string };

  const ledger = document.querySelector<HTMLElement>("[data-order-ledger]");
  if (ledger !== null) {
    const normalize = (value: string): string => value.trim().toLocaleLowerCase(ledger?.dataset.locale ?? "en");
    const copy: { headers?: readonly string[] } = (() => {
      try { return JSON.parse(ledger.dataset.exportCopy ?? "{}") as { headers?: readonly string[] }; }
      catch { return {}; }
    })();
    const rows: ExportRow[] = (() => {
      try {
        const parsed: unknown = JSON.parse(ledger.dataset.exportRows ?? "[]");
        return Array.isArray(parsed) ? parsed as ExportRow[] : [];
      } catch { return []; }
    })();
    const headers = copy.headers ?? [];

    ledger.querySelector<HTMLButtonElement>("[data-order-export]")?.addEventListener("click", () => {
      const csv = buildCsv(rows, [
        { header: headers[0] ?? "", value: (row: ExportRow) => row.order },
        { header: headers[1] ?? "", value: (row: ExportRow) => `${row.customer}${row.product === "" ? "" : ` / ${row.product}`}` },
        { header: headers[2] ?? "", value: (row: ExportRow) => row.total },
        { header: headers[3] ?? "", value: (row: ExportRow) => row.payment },
        { header: headers[4] ?? "", value: (row: ExportRow) => row.fulfillment },
        { header: headers[5] ?? "", value: (row: ExportRow) => `${row.channel} · ${row.createdAt}` },
      ]);
      const stamp = new Date().toISOString().slice(0, 10).replaceAll("-", "");
      downloadCsv(`${normalize("orders")}-${stamp}.csv`, csv);
    });

    const pageSizeSelect = ledger.querySelector("[data-page-size-select]");
    if (pageSizeSelect instanceof HTMLSelectElement) {
      pageSizeSelect.addEventListener("change", () => {
        pageSizeSelect.form?.requestSubmit();
      });
    }
  }
</script>

<style>
  .state-space { margin-top: var(--sln-space-8); }
  .state-space-ledger { margin-top: var(--sln-space-10); }
  .order-rail { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: var(--sln-space-8); border-block: 1px solid var(--sln-border-default); }
  .order-rail > div { display: grid; gap: 5px; min-width: 0; padding: 18px 20px; border-right: 1px solid var(--sln-border-default); }
  .order-rail > div:last-child { border-right: 0; }
  .order-rail span, .order-rail small { color: var(--sln-text-muted); font: var(--sln-font-caption); }
  .order-rail strong { font-size: 30px; line-height: 1; letter-spacing: -.04em; font-variant-numeric: tabular-nums; }
  .order-rail strong.warning { color: var(--sln-state-warning); }
  .order-rail strong.success { color: var(--sln-state-success); }
  .order-rail strong.danger { color: var(--sln-state-danger); }
  .exception-panel { display: grid; gap: 14px; margin-top: var(--sln-space-8); border: 1px solid color-mix(in srgb, var(--sln-state-warning) 32%, var(--sln-border-default)); border-radius: var(--sln-radius-lg); padding: var(--sln-space-6); background: var(--sln-tint-warning); }
  .eyebrow-danger { color: var(--sln-state-danger); }
  .exception-intro { margin: 0; color: var(--sln-text-secondary); font: var(--sln-font-body-sm); }
  .exception-list { display: grid; overflow: hidden; border: 1px solid color-mix(in srgb, var(--sln-state-warning) 25%, var(--sln-border-default)); border-radius: var(--sln-radius-md); background: var(--sln-bg-surface); }
  .exception-list article { display: grid; grid-template-columns: 34px minmax(0, 1fr) minmax(120px, .65fr) minmax(150px, .8fr); gap: 14px; align-items: center; padding: 14px 16px; border-top: 1px solid var(--sln-border-default); }
  .exception-list article:first-child { border-top: 0; }
  .exception-icon { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--sln-tint-danger); color: var(--sln-state-danger); font-weight: 800; }
  .exception-list article > div { display: grid; gap: 3px; min-width: 0; }
  .exception-record-main { align-self: stretch; gap: 8px !important; }
  .exception-title { display: grid; gap: 3px; min-width: 0; }
  .exception-list strong { overflow: hidden; color: var(--sln-text-primary); font: var(--sln-font-label); text-overflow: ellipsis; white-space: nowrap; }

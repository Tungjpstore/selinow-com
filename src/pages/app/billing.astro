const nextEvent = billing === null ? null
  : billing.state === "trialing" && billing.trialEndsAt !== null ? { label: pageCopy.trialEnds, value: billing.trialEndsAt }
    : (billing.state === "grace_period" || billing.state === "past_due") && billing.graceEndsAt !== null ? { label: pageCopy.graceEnds, value: billing.graceEndsAt }
      : billing.state === "cancel_scheduled" && billing.currentPeriodEnd !== null ? { label: pageCopy.accessEnds, value: billing.currentPeriodEnd }
        : billing.state === "downgrade_scheduled" && (billing.scheduledEffectiveAt ?? billing.currentPeriodEnd) !== null ? { label: billing.scheduledPlanName === null ? pageCopy.planChanges : `${billing.scheduledPlanName} · ${pageCopy.planChanges}`, value: (billing.scheduledEffectiveAt ?? billing.currentPeriodEnd) as string }
          : billing.state === "active" && billing.currentPeriodEnd !== null ? { label: pageCopy.renews, value: billing.currentPeriodEnd }
          : null;
const isPendingPayment = billing !== null && billing.state === "pending_payment";
const canOpenPortal = billing !== null && billing.billingProviderCode === "dodo" && billing.hasProviderSubscription && ["past_due", "grace_period", "suspended"].includes(billing.state);
const canStartCheckout = billing !== null && (["trialing", "canceled"].includes(billing.state) || isPendingPayment || (billing.state === "suspended" && !canOpenPortal));
const canChangePlan = billing !== null && billing.state === "active";
const canManagePayment = billing !== null
  && billing.billingProviderCode === "dodo"
  && billing.hasProviderSubscription
  && ["active", "cancel_scheduled", "downgrade_scheduled"].includes(billing.state);
const billingCurrency = currentPrice?.currency ?? null;
const operationPending = billing !== null && billing.state === "upgrade_pending";
const plansSectionDescription = billing === null
  ? pageCopy.plansDescription
  : ["suspended", "canceled"].includes(billing.state)
    ? pageCopy.plansRecoveryDescription
    : billing.state === "upgrade_pending"
      ? pageCopy.plansPendingDescription
      : ["cancel_scheduled", "downgrade_scheduled"].includes(billing.state)
        ? pageCopy.plansScheduledDescription
        : pageCopy.plansDescription;
type BillingPrimaryAction = "setup_market" | "choose_plan" | "continue_payment" | "restore_payment" | "update_payment" | "manage_plan" | "resume_plan" | "keep_plan" | null;
const primaryAction: BillingPrimaryAction = billing === null || shop === undefined || shop.role !== "owner"
  ? null
  : canStartCheckout && shop.merchantCountry === null
    ? "setup_market"
    : canOpenPortal
      ? "update_payment"
      : canStartCheckout
        ? billing.state === "suspended" || billing.state === "canceled"
          ? "restore_payment"
          : billing.state === "pending_payment" ? "continue_payment" : "choose_plan"
        : canChangePlan
          ? "manage_plan"
          : billing.state === "cancel_scheduled"
            ? "resume_plan"
            : billing.state === "downgrade_scheduled" ? "keep_plan" : null;
const primaryActionOpensPlan = primaryAction === "choose_plan" || primaryAction === "continue_payment" || primaryAction === "restore_payment" || primaryAction === "manage_plan";
const primaryPlanActionLabel = primaryAction === "restore_payment"
  ? pageCopy.restorePayment
  : primaryAction === "continue_payment"
    ? pageCopy.continuePayment
    : primaryAction === "manage_plan" ? pageCopy.managePlan : pageCopy.choosePlan;
const cancelEffectiveAt = billing !== null && ["past_due", "grace_period"].includes(billing.state)
  ? billing.graceEndsAt ?? billing.currentPeriodEnd
  : billing?.currentPeriodEnd ?? null;
const billingStateDescription = billing === null ? "" : isVietnamese ? ({
  active: "Gói đang hoạt động bình thường.",
  canceled: "Gói đã kết thúc. Dữ liệu cửa hàng vẫn được giữ.",
  cancel_scheduled: "Gói sẽ dừng vào cuối kỳ. Bạn có thể tiếp tục gói trước thời điểm đó.",
  downgrade_scheduled: billing.scheduledPlanName === null ? "Hạ gói đã được lên lịch cho kỳ gia hạn tiếp theo." : `Gói sẽ chuyển xuống ${billing.scheduledPlanName} vào kỳ gia hạn tiếp theo.`,
  grace_period: "Thanh toán đang quá hạn. Quyền truy cập sẽ dừng khi hết thời gian ân hạn.",
  pending_payment: "Gói chỉ được kích hoạt sau khi Dodo Payments xác nhận thanh toán.",
  past_due: "Thanh toán đang quá hạn. Hãy xử lý trước khi hết thời gian ân hạn.",
  suspended: "Quyền truy cập trả phí đang tạm dừng. Thanh toán lại để khôi phục.",
  trialing: "Bạn đang dùng thử. Chọn gói trả phí trước ngày kết thúc để tiếp tục sử dụng.",
  upgrade_pending: "Nâng gói đang chờ Dodo Payments xác nhận. Gói hiện tại vẫn hoạt động.",
} as Record<string, string>)[billing.state] ?? "Chưa xác định trạng thái gói. Vui lòng liên hệ hỗ trợ." : ({
  active: "Your plan is active.",
  canceled: "Your plan has ended. Your store data is retained.",
  cancel_scheduled: "Your plan ends after the current period. You can resume it before then.",
  downgrade_scheduled: billing.scheduledPlanName === null ? "The downgrade is scheduled for the next renewal." : `Your plan changes to ${billing.scheduledPlanName} at the next renewal.`,
  grace_period: "Payment is overdue. Access ends when the grace period expires.",
  pending_payment: "The plan activates only after Dodo Payments confirms payment.",
  past_due: "Payment is overdue. Resolve it before the grace period expires.",
  suspended: "Paid access is paused. Complete payment to restore it.",
  trialing: "You are on a trial. Choose a paid plan before it ends to keep access.",
  upgrade_pending: "The upgrade is awaiting Dodo Payments confirmation. Your current plan remains active.",
} as Record<string, string>)[billing.state] ?? "The plan status is unknown. Contact support.";
const metricLabel = (key: string): string => (pageCopy as Record<string, string>)[`metric_${key}`] ?? key
  .replace(/([a-z0-9])([A-Z])/gu, "$1 $2")
  .replace(/[._-]+/gu, " ")
  .replace(/^./u, (letter) => letter.toUpperCase());
---

<AppLayout activePath="/app/billing" displayName={auth.displayName.trim() || t("dashboard.commerce.you")} email={auth.email} selectedShopName={shop?.name} selectedShopPublicId={shop?.publicId} shops={shops} title={pageCopy.title}>
  <PageHeader eyebrow={pageCopy.eyebrow} title={pageCopy.title} description={pageCopy.description} />
  {state === "unavailable" ? <div class="state-space"><WorkspaceState title={t("dashboard.billing.unavailable.title")} description={t("dashboard.billing.unavailable.description")} actionHref={workspaceHref("/app/billing")} actionLabel={t("dashboard.billing.retry")} tone="danger" /></div>
    : shop === undefined ? <div class="state-space"><WorkspaceState title={t("dashboard.billing.no_store.title")} description={t("dashboard.billing.no_store.description")} actionHref={workspaceHref("/onboarding")} actionLabel={t("dashboard.billing.no_store.action")} tone="info" /></div>
    : state === "forbidden" || billing === null ? <div class="state-space"><WorkspaceState title={t("dashboard.billing.forbidden.title")} description={t("dashboard.billing.forbidden.description")} tone="warning" /></div>
     : <div class="billing-workspace" data-billing-root data-billing-checkout data-shop-public-id={shop.publicId} data-csrf-cookie-name={`${env.SESSION_COOKIE_NAME}_csrf`} data-billing-state={billing.state} data-billing-market-ready={shop.merchantCountry !== null ? "true" : "false"} data-current-price={JSON.stringify(currentPrice)} data-current-period-end={billing.currentPeriodEnd ?? ""} data-copy={JSON.stringify({
       ...pageCopy,
      error: t("dashboard.billing.requests.error"),
      checkoutErrorCode: t("dashboard.billing.checkout.error_code"),
      checkoutRequestId: t("dashboard.billing.checkout.request_id"),
      statusRequested: t("dashboard.billing.requests.status_requested"),
      statusProviderPending: t("dashboard.billing.requests.status_provider_pending"),
      statusRejected: t("dashboard.billing.requests.status_rejected"),
      statusCompleted: t("dashboard.billing.requests.status_completed"),
    })} data-can-manage={shop.role === "owner" ? "true" : "false"} data-subscription-version={billing.subscriptionVersion} data-current-plan-code={billing.planCode}>
      <section class="subscription-overview" id="billing-overview" aria-labelledby="plan-title" data-tone={subscriptionState?.tone ?? "neutral"}>
        <div class="subscription-main">
          <div class="subscription-heading"><p class="eyebrow">{pageCopy.currentPlan}</p><span class="subscription-state">{subscriptionState?.label}</span></div>
          <h2 id="plan-title">{billing.planName}</h2>
          {currentPriceLabel !== null && currentPrice !== null && <p class="plan-price"><strong>{currentPriceLabel}</strong><span>/ {currentPrice.interval === "month" ? t("dashboard.billing.price_per_month") : currentPrice.interval}</span></p>}
          <p class="subscription-impact">{billingStateDescription}</p>
        </div>
        <div class="subscription-next">
          <span>{pageCopy.nextEvent}</span>
          <strong>{nextEvent === null ? pageCopy.noUpcomingEvent : nextEvent.label}</strong>
          {nextEvent !== null && <time datetime={nextEvent.value}>{date(nextEvent.value)}</time>}
        </div>
        {shop.role === "owner" && (primaryAction !== null || canChangePlan) && <div class="subscription-actions">
          {primaryAction === "setup_market" && <button class="sln-button sln-button-primary" type="button" data-focus-billing-market>{pageCopy.setupPayment}</button>}
          {primaryActionOpensPlan && <button class="sln-button sln-button-primary" type="button" data-open-plan-dialog>{primaryPlanActionLabel}</button>}
          {primaryAction === "update_payment" && <button class="sln-button sln-button-primary" type="button" data-billing-portal>{pageCopy.resolvePayment}</button>}
          {primaryAction === "resume_plan" && <button class="sln-button sln-button-primary" type="button" data-billing-resume>{pageCopy.resumePlan}</button>}
          {primaryAction === "keep_plan" && <button class="sln-button sln-button-primary" type="button" data-billing-cancel-scheduled-plan-change>{pageCopy.cancelScheduledPlanChange}</button>}
          {canChangePlan && <button class="billing-text-action" type="button" data-open-cancel-dialog>{pageCopy.cancelPlan}</button>}
        </div>}
      </section>

      <section class="operation-banner" data-billing-operation aria-labelledby="operation-title" role="status" aria-live="polite" hidden={!operationPending && !Astro.url.searchParams.has("billing_return")}>
        <span class="operation-spinner" aria-hidden="true"></span>
        <div><h2 id="operation-title" data-operation-title>{pageCopy.operationTitle}</h2><p>{pageCopy.operationDescription}</p></div>
      </section>

      {shop.role === "owner" && shop.merchantCountry === null && <section class="billing-panel market-panel" aria-labelledby="market-title">
        <header><div><p class="eyebrow">{pageCopy.paymentSecurity}</p><h2 id="market-title">{pageCopy.marketTitle}</h2><p class="panel-description">{pageCopy.marketDescription}</p></div></header>
        <form class="billing-market-form" data-billing-market-form novalidate>
          <label for="billing-merchant-country">{pageCopy.merchantCountry}<input id="billing-merchant-country" name="merchantCountry" type="text" inputmode="text" autocomplete="off" autocapitalize="characters" aria-describedby="billing-merchant-country-hint" list="billing-country-list" maxlength="2" pattern="[A-Za-z]{2}" placeholder={pageCopy.merchantCountryPlaceholder} required /><small id="billing-merchant-country-hint">{pageCopy.merchantCountryHint}</small></label>
          <datalist id="billing-country-list"><option value="VN">Việt Nam</option><option value="JP">Japan</option><option value="SG">Singapore</option><option value="US">United States</option><option value="GB">United Kingdom</option><option value="AU">Australia</option><option value="CA">Canada</option><option value="DE">Germany</option><option value="FR">France</option></datalist>
          <button class="sln-button sln-button-secondary" type="submit">{pageCopy.saveCountry}</button>
        </form>
      </section>}

      <p class="workspace-feedback" data-billing-feedback role="status" aria-live="polite" hidden></p>
      <button class="sln-button sln-button-secondary billing-recent-auth-action" type="button" data-billing-recent-auth-action hidden>{pageCopy.checkoutRecentAuthAction}</button>

      <section class="billing-panel plans-panel" id="billing-plans" aria-labelledby="plans-title">
        <header class="billing-panel-heading"><div><p class="eyebrow">{pageCopy.plansTab}</p><h2 id="plans-title">{pageCopy.plansTitle}</h2><p class="panel-description">{plansSectionDescription}</p></div></header>
        <div class="plan-summary-row"><div><span>{pageCopy.plansCurrentLabel}</span><strong>{billing.planName}</strong></div><p>{pageCopy.plansChangePolicy}</p></div>
      </section>

      <details class="billing-disclosure" id="billing-usage" data-billing-disclosure="usage"><summary class="billing-disclosure-summary"><span><span class="eyebrow">{t("dashboard.billing.usage.eyebrow")}</span><strong id="usage-title">{pageCopy.usageTitle}</strong><small>{pageCopy.usageDescription}</small></span><span class="billing-disclosure-chevron" aria-hidden="true">⌄</span></summary><div class="billing-disclosure-content">{billing.usage.length === 0 ? <p class="empty-note">{pageCopy.emptyUsage}</p> : <div class="usage-ledger">{billing.usage.map((item) => {
        const limit = usageLimit(billing.limits, item.metric);
        const percent = limit === null ? null : limit === 0 ? (item.value > 0 ? 100 : 0) : Math.round((item.value / limit) * 100);
        const tone = percent === null ? "neutral" : percent >= 100 ? "danger" : percent >= 80 ? "warning" : "success";
        return <div class="usage-meter-row" data-tone={tone}><span class="usage-metric">{metricLabel(item.metric)}</span>{limit !== null && percent !== null ? <><div class="usage-meter" role="progressbar" aria-valuemin={0} aria-valuemax={limit} aria-valuenow={Math.min(item.value, limit)} aria-label={metricLabel(item.metric)}><span class="usage-meter-fill" style={`width:${String(Math.min(percent, 100))}%`} data-tone={tone}></span></div><strong>{t("dashboard.billing.usage.of_limit", { value: item.value, limit })}</strong><small>{t("dashboard.billing.usage.percent_used", { percent })}</small></> : <><strong>{item.value}</strong><small>{t("dashboard.billing.usage.no_numeric_limit")}</small></>}</div>;
      })}</div>}</div></details>

      <section class="billing-panel payment-panel" id="billing-payment" aria-labelledby="payment-title">
        <header class="billing-panel-heading"><div><p class="eyebrow">{pageCopy.paymentTab}</p><h2 id="payment-title">{pageCopy.paymentTitle}</h2><p class="panel-description">{pageCopy.paymentDescription}</p></div>{shop.role === "owner" && canManagePayment && !canOpenPortal && <button class="sln-button sln-button-secondary" type="button" data-billing-portal>{pageCopy.updatePaymentMethod}</button>}</header>
        <dl class="payment-facts"><div><dt>{pageCopy.paymentProvider}</dt><dd>{billing.billingProviderCode === "dodo" ? "Dodo Payments" : pageCopy.paymentNotConfigured}</dd></div><div><dt>{pageCopy.paymentCountry}</dt><dd>{shop.merchantCountry ?? pageCopy.paymentNotConfigured}</dd></div><div><dt>{pageCopy.paymentCurrency}</dt><dd>{billingCurrency ?? pageCopy.paymentNotConfigured}</dd></div></dl>
      </section>

      <details class="billing-disclosure" id="billing-invoices" data-billing-disclosure="invoices" data-billing-invoices><summary class="billing-disclosure-summary"><span><span class="eyebrow">{pageCopy.invoicesEyebrow}</span><strong id="invoices-title">{pageCopy.invoicesTitle}</strong><small>{pageCopy.invoicesDescription}</small></span><span class="billing-disclosure-chevron" aria-hidden="true">⌄</span></summary><div class="billing-disclosure-content">{invoices.length === 0 ? <WorkspaceState title={t("dashboard.billing.invoices.empty_title")} description={t("dashboard.billing.invoices.empty_description")} tone="neutral" /> : <div class="invoice-ledger" role="list" aria-label={pageCopy.invoicesTitle}>{invoices.map((invoice) => <div class="invoice-row" role="listitem"><div class="invoice-copy"><strong>{date(invoice.paidAt ?? invoice.createdAt)}</strong><span>{money(invoice.amountMinor, invoice.currency)}</span></div><StatusBadge label={t(`dashboard.billing.invoices.status.${invoice.status}`)} tone={invoiceTones[invoice.status]} /></div>)}</div>}</div></details>

      <details class="support-details"><summary>{pageCopy.supportDetails}</summary><p>{pageCopy.paymentSecurityDescription}</p><p data-billing-support-reference hidden></p></details>

      <dialog class="billing-dialog" data-plan-dialog aria-labelledby="plan-dialog-title">
        <form method="dialog" class="dialog-shell">
          <header><div><p class="eyebrow">{pageCopy.currentPlan}: {billing.planName}</p><h2 id="plan-dialog-title">{pageCopy.planDialogTitle}</h2><p>{pageCopy.planDialogDescription}</p></div><button class="dialog-close" type="submit" value="close" aria-label={pageCopy.close}>×</button></header>
          <p class="dialog-feedback" data-dialog-feedback role="alert" hidden></p>
          <button class="sln-button sln-button-secondary billing-recent-auth-action dialog-auth-action" type="button" data-billing-recent-auth-action hidden>{pageCopy.checkoutRecentAuthAction}</button>
          <div class="dialog-stage" data-plan-stage="select">
            <div class="plan-options" data-plan-options aria-live="polite"><p>{pageCopy.loadingPlans}</p></div>
          </div>
          <div class="dialog-stage" data-plan-stage="review" hidden>
            <h3 data-review-title tabindex="-1">{pageCopy.reviewTitle}</h3>
            <p class="sr-only" data-review-announcement role="status" aria-live="polite"></p>
            <dl class="change-review"><div><dt>{pageCopy.current}</dt><dd data-review-current></dd></div><div><dt>{pageCopy.newPlan}</dt><dd data-review-target></dd></div><div><dt>{pageCopy.effective}</dt><dd data-review-effective></dd></div><div><dt data-review-today-label>{pageCopy.today}</dt><dd data-review-today></dd></div></dl>
            <p class="provider-note" data-review-provider-note></p>
            <div class="dialog-actions"><button class="sln-button sln-button-secondary" type="button" data-plan-back>{pageCopy.back}</button><button class="sln-button sln-button-primary" type="button" data-plan-confirm disabled>{pageCopy.confirmChange}</button></div>
          </div>
        </form>
      </dialog>

      <dialog class="billing-dialog cancel-dialog" data-cancel-dialog aria-labelledby="cancel-dialog-title">
        <form method="dialog" class="dialog-shell">
          <header><div><p class="eyebrow">{billing.planName}</p><h2 id="cancel-dialog-title">{pageCopy.cancelDialogTitle}</h2><p>{["past_due", "grace_period"].includes(billing.state) ? pageCopy.cancelGraceDialogDescription : pageCopy.cancelDialogDescription}</p></div><button class="dialog-close" type="submit" value="close" aria-label={pageCopy.close}>×</button></header>
          <div class="cancel-impact"><span>{["past_due", "grace_period"].includes(billing.state) ? pageCopy.cancelGraceEffective : pageCopy.cancelEffective}</span><strong>{date(cancelEffectiveAt)}</strong></div>
          <p class="dialog-feedback" data-cancel-feedback role="alert" hidden></p>
          <button class="sln-button sln-button-secondary billing-recent-auth-action dialog-auth-action" type="button" data-billing-recent-auth-action hidden>{pageCopy.checkoutRecentAuthAction}</button>
          <div class="dialog-actions"><button class="sln-button sln-button-secondary" type="submit" value="close">{pageCopy.keepPlan}</button><button class="sln-button sln-button-danger" type="button" data-cancel-confirm>{pageCopy.confirmCancel}</button></div>
        </form>
      </dialog>
    </div>}
</AppLayout>

<script src="../../scripts/dashboard/billing.ts"></script>

<style>
  .state-space { margin-top:var(--sln-space-8); }
  .billing-workspace { --billing-sticky-offset:var(--sln-console-topbar-h); display:grid; gap:var(--sln-space-6); margin-top:var(--sln-space-8); }
  .billing-workspace :where(button, a, summary) { touch-action:manipulation; }
  .subscription-overview { display:grid; grid-template-columns:minmax(0,1.8fr) minmax(220px,.8fr); gap:var(--sln-space-6); border:1px solid var(--sln-border-default); border-inline-start:3px solid var(--sln-action-primary); border-radius:var(--sln-radius-lg); padding:var(--sln-space-8); background:var(--sln-bg-surface); }
  #billing-overview, #billing-plans, #billing-usage, #billing-payment, #billing-invoices { scroll-margin-top:calc(var(--billing-sticky-offset) + 60px); }
  .subscription-main h2, .billing-panel h2, .billing-dialog h2 { margin:0; font:var(--sln-font-h3); letter-spacing:-.035em; }
  .subscription-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; }
  .subscription-impact { max-width:64ch; margin:10px 0 0; color:var(--sln-text-secondary); font:var(--sln-font-body-sm); }
  .plan-price { display:flex; align-items:baseline; gap:7px; margin:10px 0 0; }
  .plan-price strong { color:var(--sln-text-primary); font:var(--sln-font-h3); font-variant-numeric:tabular-nums; }
  .plan-price span { color:var(--sln-text-muted); font:var(--sln-font-caption); }
  .eyebrow { margin:0 0 7px; color:var(--sln-action-primary); font:var(--sln-font-caption); font-weight: 600; letter-spacing:.1em; text-transform:uppercase; }
  .subscription-state { border-radius:var(--sln-radius-pill); padding:8px 12px; background:var(--sln-bg-subtle); color:var(--sln-text-secondary); font:var(--sln-font-label); white-space:nowrap; }
  .subscription-overview[data-tone="success"] .subscription-state { background:var(--sln-tint-success); color:var(--sln-success-text); }
  .subscription-overview[data-tone="info"] .subscription-state { background:var(--sln-tint-info); color:var(--sln-state-info); }
  .subscription-overview[data-tone="warning"] .subscription-state { background:var(--sln-tint-warning); color:var(--sln-warning-text); }
  .subscription-overview[data-tone="danger"] .subscription-state { background:var(--sln-tint-danger); color:var(--sln-danger-text); }
  .subscription-next { display:grid; align-content:center; gap:6px; border-left:1px solid var(--sln-border-default); padding-left:var(--sln-space-6); }
  .subscription-next span, .subscription-next time { color:var(--sln-text-muted); font:var(--sln-font-caption); }
  .subscription-next strong { color:var(--sln-text-primary); font:var(--sln-font-label); }
  .subscription-actions { grid-column:1 / -1; display:flex; flex-wrap:wrap; align-items:center; gap:12px; border-top:1px solid var(--sln-border-default); padding-top:var(--sln-space-5); }
  .billing-text-action { min-height:44px; border:0; padding:8px 10px; background:transparent; color:var(--sln-danger-text); font:var(--sln-font-label); cursor:pointer; }
  .billing-text-action:hover { text-decoration:underline; }
  .operation-banner { display:flex; align-items:flex-start; gap:14px; border:1px solid var(--sln-state-info); border-radius:var(--sln-radius-lg); padding:18px 20px; background:var(--sln-tint-info); }
  .operation-banner[hidden] { display:none; }
  .operation-banner h2 { margin:0; color:var(--sln-text-primary); font:var(--sln-font-label); }
  .operation-banner p { margin:5px 0 0; color:var(--sln-text-secondary); font:var(--sln-font-body-sm); }
  .operation-spinner { width:20px; height:20px; flex:0 0 auto; border:1px solid color-mix(in srgb,var(--sln-state-info) 30%,transparent); border-top-color:var(--sln-state-info); border-radius:50%; animation:billing-spin .8s linear infinite; }
  .billing-panel { display:grid; gap:18px; border:1px solid var(--sln-border-default); border-radius:var(--sln-radius-lg); padding:var(--sln-space-6); background:var(--sln-bg-surface); }
  .billing-disclosure { border:1px solid var(--sln-border-default); border-radius:var(--sln-radius-lg); background:var(--sln-bg-surface); }
  .billing-disclosure-summary { display:flex; min-height:76px; align-items:center; justify-content:space-between; gap:18px; padding:18px 24px; color:var(--sln-text-primary); cursor:pointer; list-style:none; }
  .billing-disclosure-summary::-webkit-details-marker { display:none; }
  .billing-disclosure-summary > span:first-child { display:grid; gap:4px; }
  .billing-disclosure-summary .eyebrow { margin:0; }
  .billing-disclosure-summary strong { font:var(--sln-font-h3); letter-spacing:-.035em; }
  .billing-disclosure-summary small { color:var(--sln-text-secondary); font:var(--sln-font-body-sm); }
  .billing-disclosure-chevron { color:var(--sln-text-muted); font-size:22px; transition:transform .18s ease; }
  .billing-disclosure[open] .billing-disclosure-chevron { transform:rotate(180deg); }
  .billing-disclosure-content { display:grid; gap:18px; border-top:1px solid var(--sln-border-default); padding:20px 24px 24px; }
  .billing-panel header { padding-bottom:14px; border-bottom:1px solid var(--sln-border-default); }
  .billing-panel-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; }
  .panel-description { max-width:70ch; margin:8px 0 0; color:var(--sln-text-secondary); font:var(--sln-font-body-sm); }
  .plan-summary-row { display:grid; grid-template-columns:minmax(180px,.6fr) minmax(0,1.4fr); gap:20px; align-items:center; }
  .plan-summary-row > div { display:grid; gap:5px; }
  .plan-summary-row span, .payment-facts dt { color:var(--sln-text-muted); font:var(--sln-font-caption); }
  .plan-summary-row strong, .payment-facts dd { color:var(--sln-text-primary); font:var(--sln-font-label); }
  .plan-summary-row p { margin:0; color:var(--sln-text-secondary); font:var(--sln-font-body-sm); }
  .payment-facts { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:0; margin:0; border:1px solid var(--sln-border-default); border-radius:var(--sln-radius-md); overflow:hidden; }
  .payment-facts > div { display:grid; gap:6px; padding:16px; background:var(--sln-bg-canvas); }
  .payment-facts > div + div { border-left:1px solid var(--sln-border-default); }
  .payment-facts dd { margin:0; }
  .market-panel { border-color:color-mix(in srgb,var(--sln-action-primary) 24%,var(--sln-border-default)); }
  .kv-ledger { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
  .kv-ledger > div { display:grid; gap:5px; border:1px solid var(--sln-border-default); border-radius:var(--sln-radius-md); padding:14px; background:var(--sln-bg-canvas); }
  .kv-ledger span, .kv-ledger small { color:var(--sln-text-muted); font:var(--sln-font-caption); }
  .kv-ledger strong { color:var(--sln-text-primary); font:var(--sln-font-label); }

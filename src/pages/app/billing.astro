---
import AppLayout from "../../layouts/AppLayout.astro";
import WorkspaceState from "../../components/states/WorkspaceState.astro";
import StatusBadge from "../../components/primitives/StatusBadge.astro";
import PageHeader from "../../components/workspace/PageHeader.astro";
import { authenticateRequest } from "../../lib/auth/session";
import { listShopInvoices, type InvoiceStatus, type ShopInvoice } from "../../lib/billing/invoices";
import { isAppError } from "../../lib/core/errors";
import { subscriptionStatePresentation } from "../../lib/dashboard/billing-ui";
import { createDashboardTranslator } from "../../lib/i18n";
import { getBindings } from "../../lib/platform/bindings";
import { withSelectedShop } from "../../lib/dashboard/shop-navigation";
import { getSellerBilling, type SellerBillingView } from "../../lib/tenants/seller-management";
import { formatMarketingPrice, type MarketingPrice } from "../../lib/storefront/marketing";
import { getShopForMember, listShopsForMember, selectShopForMember, type ShopView } from "../../lib/tenants/store";

const env = getBindings();
const auth = await authenticateRequest(Astro.request, env).catch(() => null);
if (auth === null) return Astro.redirect("/login");
let shops: ShopView[] = [];
let billingShops: ShopView[] = [];
let state: "ready" | "unavailable" | "forbidden" = "ready";
try {
  [shops, billingShops] = await Promise.all([
    listShopsForMember({ env, userId: auth.userId }),
    listShopsForMember({ env, includeCanceledForBillingRecovery: true, userId: auth.userId }),
  ]);
} catch { state = "unavailable"; }
const shop = selectShopForMember(billingShops, Astro.url.searchParams.get("shop"));
const workspaceHref = (href: string): string => withSelectedShop(href, shop?.publicId, Astro.url.origin);
let billing: SellerBillingView | null = null;
if (shop !== undefined && state === "ready") {
  try { billing = await getSellerBilling({ env, shopPublicId: shop.publicId, userId: auth.userId }); }
  catch (error) { state = isAppError(error) && error.status === 403 ? "forbidden" : "unavailable"; }
}
if (state === "forbidden") Astro.response.status = 403;
if (state === "unavailable") Astro.response.status = 503;
const locale = Astro.locals.locale;
const t = createDashboardTranslator(locale);
let invoices: ShopInvoice[] = [];
if (billing !== null && shop !== undefined) {
  try {
    const member = await getShopForMember({ capability: "billing:manage", env, shopPublicId: shop.publicId, userId: auth.userId });
    invoices = await listShopInvoices({ env, shopId: member.row.shop_id });
  } catch {
    // Invoice history is supplemental; the billing page keeps rendering.
  }
}
const invoiceTones: Record<InvoiceStatus, "danger" | "info" | "neutral" | "success" | "warning"> = {
  draft: "neutral", failed: "danger", open: "info", paid: "success", past_due: "warning", refunded: "danger", void: "neutral",
};
const money = (amountMinor: number, currency: string): string => {
  if (!/^[A-Z]{3}$/u.test(currency)) return `${String(amountMinor)} ${currency}`;
  try {
    const formatter = new Intl.NumberFormat(locale ?? "en", { currency, currencyDisplay: "code", style: "currency" });
    const fractionDigits = formatter.resolvedOptions().maximumFractionDigits ?? 2;
    return formatter.format(amountMinor / 10 ** fractionDigits);
  } catch {
    return `${String(amountMinor)} ${currency}`;
  }
};
const usageLimit = (limits: Record<string, unknown>, metric: string): number | null => {
  const value = limits[metric];
  // A configured limit of 0 is real: the dispatcher fail-closes and blocks all
  // runs for that metric, so the UI must show "0", not "no numeric limit".
  return typeof value === "number" && Number.isFinite(value) && value >= 0 ? value : null;
};
const formatter = new Intl.DateTimeFormat(locale ?? "en", { dateStyle: "medium", timeZone: shop?.timezone ?? "Asia/Ho_Chi_Minh" });
const date = (value: string | null): string => value === null ? t("dashboard.billing.not_configured") : formatter.format(new Date(value));
const subscriptionState = billing === null ? null : subscriptionStatePresentation(billing.state, locale);
type BillingProjection = SellerBillingView & {
  currentPrice?: unknown;
  marketCode?: unknown;
  price?: unknown;
  priceDisplay?: unknown;
};
const projectedPrice = (value: unknown): MarketingPrice | null => {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return null;
  const row = value as Record<string, unknown>;
  const amountMinor = row.amountMinor;
  const currency = row.currency;
  const interval = row.interval;
  const marketCode = row.marketCode;
  if (!Number.isSafeInteger(amountMinor) || typeof currency !== "string" || typeof interval !== "string" || typeof marketCode !== "string") return null;
  return { amountMinor: amountMinor as number, currency, interval, marketCode };
};
const billingProjection = billing as BillingProjection | null;
const currentPrice = billingProjection === null ? null : projectedPrice(billingProjection.currentPrice) ?? projectedPrice(billingProjection.price);
const currentPriceLabel = currentPrice === null ? null : formatMarketingPrice(currentPrice, locale);
const conversionHref = workspaceHref("/app/billing");
---

<AppLayout activePath="/app/billing" displayName={auth.displayName.trim() || t("dashboard.commerce.you")} email={auth.email} selectedShopName={shop?.name} selectedShopPublicId={shop?.publicId} shops={shops} title={t("dashboard.billing.title")}>
  <PageHeader eyebrow={t("dashboard.billing.eyebrow")} title={t("dashboard.billing.title")} description={t("dashboard.billing.description")}>
    <span slot="actions" class="sln-badge">{t("dashboard.billing.read_only")}</span>
  </PageHeader>
  {state === "unavailable" ? <div class="state-space"><WorkspaceState title={t("dashboard.billing.unavailable.title")} description={t("dashboard.billing.unavailable.description")} actionHref={workspaceHref("/app/billing")} actionLabel={t("dashboard.billing.retry")} tone="danger" /></div>
    : shop === undefined ? <div class="state-space"><WorkspaceState title={t("dashboard.billing.no_store.title")} description={t("dashboard.billing.no_store.description")} actionHref={workspaceHref("/onboarding")} actionLabel={t("dashboard.billing.no_store.action")} tone="info" /></div>
    : state === "forbidden" || billing === null ? <div class="state-space"><WorkspaceState title={t("dashboard.billing.forbidden.title")} description={t("dashboard.billing.forbidden.description")} tone="warning" /></div>
    : <div class="billing-workspace" data-billing-root data-shop-public-id={shop.publicId} data-csrf-cookie-name={`${env.SESSION_COOKIE_NAME}_csrf`} data-billing-state={billing.state} data-billing-market-ready={shop.merchantCountry !== null ? "true" : "false"} data-copy={JSON.stringify({
      loading: t("dashboard.billing.requests.loading"), loaded: t("dashboard.billing.requests.loaded"), unavailable: t("dashboard.billing.requests.unavailable"),
      changePlan: t("dashboard.billing.requests.change_plan"), cancel: t("dashboard.billing.requests.cancel"), request: t("dashboard.billing.requests.submit"), requesting: t("dashboard.billing.requests.requesting"), requested: t("dashboard.billing.requests.requested"),
      reason: t("dashboard.billing.requests.reason"), reasonPlaceholder: t("dashboard.billing.requests.reason_placeholder"), plan: t("dashboard.billing.requests.plan"), cancelConfirm: t("dashboard.billing.requests.cancel_confirm"), error: t("dashboard.billing.requests.error"), pending: t("dashboard.billing.requests.pending"), statusRequested: t("dashboard.billing.requests.status_requested"), statusProviderPending: t("dashboard.billing.requests.status_provider_pending"), statusRejected: t("dashboard.billing.requests.status_rejected"), statusCompleted: t("dashboard.billing.requests.status_completed"), statusCanceled: t("dashboard.billing.requests.status_canceled"),
      statePendingPayment: t("dashboard.billing.state.pending_payment"), stateTrialing: t("dashboard.billing.state.trialing"), stateGrace: t("dashboard.billing.state.grace"), stateSuspended: t("dashboard.billing.state.suspended"),
      checkoutEyebrow: t("dashboard.billing.checkout.eyebrow"), checkoutTitle: t("dashboard.billing.checkout.title"), checkoutDescription: t("dashboard.billing.checkout.description"), checkoutPlan: t("dashboard.billing.checkout.plan"), checkoutSubmit: t("dashboard.billing.checkout.submit"), checkoutRecoverSubmit: t("dashboard.billing.checkout.recover_submit"), checkoutOpening: t("dashboard.billing.checkout.opening"), checkoutUnavailable: t("dashboard.billing.checkout.unavailable"), checkoutMarketRequired: t("dashboard.billing.checkout.market_required"), checkoutMarketCountry: t("dashboard.billing.checkout.market_country"), checkoutMarketSave: t("dashboard.billing.checkout.market_save"), checkoutMarketSaving: t("dashboard.billing.checkout.market_saving"), checkoutMarketSaved: t("dashboard.billing.checkout.market_saved"), checkoutRecentAuthRequired: t("dashboard.billing.checkout.recent_auth_required"), checkoutErrorCode: t("dashboard.billing.checkout.error_code"), checkoutRequestId: t("dashboard.billing.checkout.request_id"), checkoutProvider: t("dashboard.billing.checkout.provider"), checkoutTrial: t("dashboard.billing.checkout.trial"), checkoutPending: t("dashboard.billing.checkout.pending"), checkoutRecovery: t("dashboard.billing.checkout.recovery"),
    })} data-can-manage={shop.role === "owner" ? "true" : "false"} data-subscription-version={billing.subscriptionVersion} data-current-plan-code={billing.planCode}>
      <section class="plan-hero" aria-labelledby="plan-title" data-tone={subscriptionState?.tone ?? "neutral"}><div><p class="eyebrow">{t("dashboard.billing.current_subscription")}</p><h2 id="plan-title">{billing.planName}</h2><p>{t("dashboard.billing.plan_metadata", { code: billing.planCode, version: billing.planVersion })}</p>{currentPriceLabel !== null && currentPrice !== null && <p class="plan-price"><strong>{currentPriceLabel}</strong> <span>{currentPrice.interval === "month" ? t("dashboard.billing.price_per_month") : currentPrice.interval}</span><small>{currentPrice.marketCode} · {currentPrice.currency}</small></p>}<p class="subscription-impact">{subscriptionState?.impact}</p>{(billing.state === "grace_period" || billing.state === "past_due") && <p class="state-guidance">{t("dashboard.billing.state.grace")}</p>}{billing.state === "suspended" && <p class="state-guidance">{t("dashboard.billing.state.suspended")}</p>}{billing.state === "trialing" && <p class="trial-conversion"><span>{t("dashboard.billing.trial_conversion")}</span> <a class="sln-button sln-button-secondary" href={conversionHref}>{t("dashboard.billing.trial_conversion_cta")}</a></p>}{billing.state === "pending_payment" && <p class="trial-conversion"><span>{t("dashboard.billing.pending_payment_cta")}</span> <a class="sln-button sln-button-secondary" href={conversionHref}>{t("dashboard.billing.choose_paid_plan")}</a></p>}</div><span class="subscription-state">{subscriptionState?.label}</span></section>
      <section class="billing-grid"><article><span>{t("dashboard.billing.trial_ends")}</span><strong>{date(billing.trialEndsAt)}</strong></article><article><span>{t("dashboard.billing.current_period")}</span><strong>{date(billing.currentPeriodEnd)}</strong></article><article><span>{t("dashboard.billing.grace_ends")}</span><strong>{date(billing.graceEndsAt)}</strong></article><article><span>{t("dashboard.billing.canceled_at")}</span><strong>{date(billing.canceledAt)}</strong></article></section>
      {shop.role === "owner" && (billing.state === "trialing" || billing.state === "pending_payment" || billing.state === "suspended" || billing.state === "canceled") && <section class="billing-panel billing-checkout-panel" aria-labelledby="billing-checkout-title" data-billing-checkout>
        <header><div><p class="eyebrow">{t("dashboard.billing.checkout.eyebrow")}</p><h2 id="billing-checkout-title">{t("dashboard.billing.checkout.title")}</h2><p class="billing-request-description">{t("dashboard.billing.checkout.description")}</p></div></header>
        <p class="checkout-state-note">{billing.state === "trialing" ? t("dashboard.billing.checkout.trial") : billing.state === "suspended" || billing.state === "canceled" ? t("dashboard.billing.checkout.recovery") : t("dashboard.billing.checkout.pending")}</p>
        {shop.merchantCountry === null && <><p class="checkout-market-note">{t("dashboard.billing.checkout.market_required")}</p><form class="billing-market-form" data-billing-market-form novalidate><label>{t("dashboard.billing.checkout.market_country")}<input name="merchantCountry" type="text" inputmode="text" autocapitalize="characters" maxlength="2" pattern="[A-Za-z]{2}" required /></label><button class="sln-button sln-button-secondary" type="submit">{t("dashboard.billing.checkout.market_save")}</button></form></>}
        <form class="billing-checkout-form" data-billing-checkout-form novalidate>
          <label>{t("dashboard.billing.checkout.plan")}<select name="planCode" data-billing-checkout-plan required></select></label>
          <button class="sln-button sln-button-primary" type="submit" data-billing-checkout-submit>{billing.state === "suspended" || billing.state === "canceled" ? t("dashboard.billing.checkout.recover_submit") : t("dashboard.billing.checkout.submit")}</button>
        </form>
        <p class="checkout-provider-note">{t("dashboard.billing.checkout.provider")}</p>
        <p class="workspace-feedback" data-billing-checkout-feedback role="status" aria-live="polite" hidden></p>
        <button class="sln-button sln-button-secondary billing-recent-auth-action" type="button" data-billing-recent-auth-action hidden>{t("dashboard.billing.checkout.recent_auth_action")}</button>
      </section>}
      <section class="billing-panel" aria-labelledby="limits-title"><header><div><p class="eyebrow">{t("dashboard.billing.entitlements.eyebrow")}</p><h2 id="limits-title">{t("dashboard.billing.entitlements.title")}</h2></div></header><div class="kv-ledger">{Object.entries(billing.limits).length === 0 ? <WorkspaceState title={t("dashboard.billing.entitlements.empty_title")} description={t("dashboard.billing.entitlements.empty_description")} tone="neutral" /> : Object.entries(billing.limits).map(([key, value]) => <div><span>{key}</span><strong>{typeof value === "string" || typeof value === "number" ? value : value === true ? t("dashboard.billing.value.yes") : value === false ? t("dashboard.billing.value.no") : t("dashboard.billing.value.configured")}</strong></div>)}</div></section>
      <section class="billing-panel" aria-labelledby="invoices-title" data-billing-invoices><header><div><p class="eyebrow">{t("dashboard.billing.invoices.eyebrow")}</p><h2 id="invoices-title">{t("dashboard.billing.invoices.title")}</h2><p class="billing-request-description">{t("dashboard.billing.invoices.description")}</p></div></header>{invoices.length === 0 ? <WorkspaceState title={t("dashboard.billing.invoices.empty_title")} description={t("dashboard.billing.invoices.empty_description")} tone="neutral" /> : <div class="invoice-ledger" role="list" aria-label={t("dashboard.billing.invoices.title")}>{invoices.map((invoice) => <div class="invoice-row" role="listitem"><div class="invoice-copy"><strong>{date(invoice.paidAt ?? invoice.createdAt)}</strong><span>{money(invoice.amountMinor, invoice.currency)}{invoice.providerInvoiceRef !== null ? ` · ${t("dashboard.billing.invoices.reference")} ${invoice.providerInvoiceRef}` : ""}</span></div><StatusBadge label={t(`dashboard.billing.invoices.status.${invoice.status}`)} tone={invoiceTones[invoice.status]} /></div>)}</div>}</section>
      <section class="billing-panel" aria-labelledby="usage-title"><header><div><p class="eyebrow">{t("dashboard.billing.usage.eyebrow")}</p><h2 id="usage-title">{t("dashboard.billing.usage.title")}</h2></div></header>{billing.usage.length === 0 ? <WorkspaceState title={t("dashboard.billing.usage.empty_title")} description={t("dashboard.billing.usage.empty_description")} tone="neutral" /> : <div class="usage-ledger">{billing.usage.map((item) => {
        const limit = usageLimit(billing.limits, item.metric);
        const percent = limit === null ? null : limit === 0 ? (item.value > 0 ? 100 : 0) : Math.round((item.value / limit) * 100);
        const tone = percent === null ? "neutral" : percent >= 100 ? "danger" : percent >= 80 ? "warning" : "success";
        return <div class="usage-meter-row" data-tone={tone}><span class="usage-metric">{item.metric} · {item.periodKey}</span>{limit !== null && percent !== null ? <><div class="usage-meter" role="progressbar" aria-valuemin={0} aria-valuemax={limit} aria-valuenow={Math.min(item.value, limit)} aria-label={item.metric}><span class="usage-meter-fill" style={`width:${String(Math.min(percent, 100))}%`} data-tone={tone}></span></div><strong>{t("dashboard.billing.usage.of_limit", { value: item.value, limit })}</strong><small>{t("dashboard.billing.usage.percent_used", { percent })}</small></> : <><strong>{item.value}</strong><small>{t("dashboard.billing.usage.no_numeric_limit")}</small></>}<small class="usage-updated">{date(item.updatedAt)}</small></div>;
      })}</div>}</section>
      {shop.role === "owner" && <section class="billing-panel" aria-labelledby="billing-request-title" data-billing-requests>
        <header><div><p class="eyebrow">{t("dashboard.billing.requests.eyebrow")}</p><h2 id="billing-request-title">{t("dashboard.billing.requests.title")}</h2><p class="billing-request-description">{t("dashboard.billing.requests.description")}</p></div></header>
        <div class="workspace-feedback" data-billing-feedback role="status" aria-live="polite">{t("dashboard.billing.requests.loading")}</div>
        <form class="billing-request-form" data-billing-request-form novalidate>
          <label>{t("dashboard.billing.requests.action")}<select name="action" data-billing-action><option value="change_plan">{t("dashboard.billing.requests.change_plan")}</option><option value="cancel">{t("dashboard.billing.requests.cancel")}</option><option value="resume" disabled>{t("dashboard.billing.requests.resume")}</option></select></label>
          <label data-billing-plan-field>{t("dashboard.billing.requests.plan")}<select name="requestedPlanCode" data-billing-plan></select></label>
          <label>{t("dashboard.billing.requests.reason")}<input name="reasonCode" value="seller_requested" maxlength="64" pattern="[a-z][a-z0-9._:-]{2,63}" placeholder={t("dashboard.billing.requests.reason_placeholder")} required /></label>
          <button class="sln-button sln-button-primary" type="submit">{t("dashboard.billing.requests.submit")}</button>
        </form>
        <div class="billing-request-ledger" data-billing-request-ledger role="list" aria-live="polite"></div>
      </section>}
      <p class="scope-note">{t("dashboard.billing.scope")}</p>
    </div>}
</AppLayout>

<script src="../../scripts/dashboard/billing.ts"></script>

<style>
  .sln-badge { display:inline-flex; align-items:center; min-height:36px; border:1px solid var(--sln-border-default); border-radius:var(--sln-radius-pill); padding:7px 12px; color:var(--sln-text-muted); font:var(--sln-font-caption); }
  .state-space { margin-top:var(--sln-space-8); }
  .billing-workspace { display:grid; gap:var(--sln-space-6); margin-top:var(--sln-space-8); }
  .plan-hero { display:flex; align-items:center; justify-content:space-between; gap:20px; border:1px solid color-mix(in srgb,var(--sln-action-primary) 25%,var(--sln-border-default)); border-radius:var(--sln-radius-lg); padding:var(--sln-space-8); background:linear-gradient(135deg,var(--sln-tint-indigo),var(--sln-bg-surface)); }
  .plan-hero h2, .billing-panel h2 { margin:0; font:var(--sln-font-h3); letter-spacing:-.035em; }
  .plan-hero p { margin:8px 0 0; color:var(--sln-text-secondary); font:var(--sln-font-body-sm); }
  .plan-price { display:grid; grid-template-columns:auto auto; align-items:baseline; column-gap:8px; }
  .plan-price strong { color:var(--sln-text-primary); font:var(--sln-font-h3); }
  .plan-price small { grid-column:1 / -1; color:var(--sln-text-muted); font:var(--sln-font-caption); }
  .state-guidance { color:var(--sln-text-primary) !important; }
  .trial-conversion { display:flex; flex-wrap:wrap; align-items:center; gap:12px; }
  .trial-conversion .sln-button { text-decoration:none; }
  .plan-hero code { font-family:var(--sln-font-mono); font-size:11px; }
  .eyebrow { margin:0 0 7px; color:var(--sln-action-primary); font:var(--sln-font-caption); font-weight:750; letter-spacing:.1em; text-transform:uppercase; }
  .subscription-impact { max-width:70ch; }
  .subscription-state { border-radius:var(--sln-radius-pill); padding:8px 12px; background:var(--sln-bg-subtle); color:var(--sln-text-secondary); font:var(--sln-font-label); white-space:nowrap; }
  .plan-hero[data-tone="success"] .subscription-state { background:var(--sln-tint-success); color:var(--sln-success-text); }
  .plan-hero[data-tone="info"] .subscription-state { background:var(--sln-tint-info); color:var(--sln-state-info); }
  .plan-hero[data-tone="warning"] .subscription-state { background:var(--sln-tint-warning); color:#9a5004; }
  .plan-hero[data-tone="danger"] .subscription-state { background:var(--sln-tint-danger); color:var(--sln-danger-text); }
  .billing-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); border-block:1px solid var(--sln-border-default); }
  .billing-grid article { display:grid; gap:5px; padding:16px; border-right:1px solid var(--sln-border-default); }
  .billing-grid article:last-child { border-right:0; }
  .billing-grid span, .billing-grid strong, .scope-note { color:var(--sln-text-muted); font:var(--sln-font-caption); }
  .billing-grid strong { color:var(--sln-text-primary); font:var(--sln-font-label); }
  .billing-panel { display:grid; gap:18px; border:1px solid var(--sln-border-default); border-radius:var(--sln-radius-lg); padding:var(--sln-space-6); background:var(--sln-bg-surface); }
  .billing-panel header { padding-bottom:14px; border-bottom:1px solid var(--sln-border-default); }
  .kv-ledger { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
  .kv-ledger > div { display:grid; gap:5px; border:1px solid var(--sln-border-default); border-radius:var(--sln-radius-md); padding:14px; background:var(--sln-bg-canvas); }
  .kv-ledger span, .kv-ledger small { color:var(--sln-text-muted); font:var(--sln-font-caption); }
  .kv-ledger strong { color:var(--sln-text-primary); font:var(--sln-font-label); }
  .scope-note { margin:0; }
  .billing-request-description { margin:8px 0 0; color:var(--sln-text-secondary); font:var(--sln-font-body-sm); }
  .billing-checkout-panel { border-color:color-mix(in srgb,var(--sln-action-primary) 30%,var(--sln-border-default)); background:linear-gradient(135deg,var(--sln-bg-surface),var(--sln-tint-indigo)); }
  .checkout-state-note, .checkout-provider-note { margin:0; color:var(--sln-text-secondary); font:var(--sln-font-body-sm); }
  .checkout-market-note { margin:0; border:1px solid var(--sln-state-danger); border-radius:var(--sln-radius-md); padding:12px 14px; background:var(--sln-tint-danger); color:var(--sln-danger-text); font:var(--sln-font-body-sm); }
  .checkout-market-note a { color:inherit; font-weight:750; }
  .billing-market-form { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:12px; align-items:end; }
  .billing-market-form label { display:grid; gap:6px; color:var(--sln-text-secondary); font:var(--sln-font-caption); }
  .billing-market-form input { min-height:42px; border:1px solid var(--sln-border-strong); border-radius:var(--sln-radius-md); padding:9px 11px; background:var(--sln-bg-canvas); color:var(--sln-text-primary); font:var(--sln-font-body-sm); }
  .checkout-provider-note { color:var(--sln-text-muted); font:var(--sln-font-caption); }
  .billing-recent-auth-action { justify-self:start; }
  .billing-recent-auth-action[hidden] { display:none; }
  .billing-checkout-form { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:12px; align-items:end; }
  .billing-checkout-form label { display:grid; gap:6px; color:var(--sln-text-secondary); font:var(--sln-font-caption); }
  .billing-checkout-form select { min-height:42px; border:1px solid var(--sln-border-strong); border-radius:var(--sln-radius-md); padding:9px 11px; background:var(--sln-bg-canvas); color:var(--sln-text-primary); font:var(--sln-font-body-sm); }

import { formatMarketingPrice, type MarketingPrice } from "../../lib/storefront/marketing";
import { getShopForMember, listShopsForMember, selectShopForMember, type ShopView } from "../../lib/tenants/store";

const env = getBindings();
const auth = await authenticateRequest(Astro.request, env).catch(() => null);
if (auth === null) return Astro.redirect("/login");
let shops: ShopView[] = [];
let billingShops: ShopView[] = [];
let state: "ready" | "unavailable" | "forbidden" = "ready";
try {
  [shops, billingShops] = await Promise.all([
    listShopsForMember({ env, userId: auth.userId }),
    listShopsForMember({ env, includeCanceledForBillingRecovery: true, userId: auth.userId }),
  ]);
} catch { state = "unavailable"; }
const shop = selectShopForMember(billingShops, Astro.url.searchParams.get("shop"));
const workspaceHref = (href: string): string => withSelectedShop(href, shop?.publicId, Astro.url.origin);
let billing: SellerBillingView | null = null;
if (shop !== undefined && state === "ready") {
  try { billing = await getSellerBilling({ env, shopPublicId: shop.publicId, userId: auth.userId }); }
  catch (error) { state = isAppError(error) && error.status === 403 ? "forbidden" : "unavailable"; }
}
if (state === "forbidden") Astro.response.status = 403;
if (state === "unavailable") Astro.response.status = 503;
const locale = Astro.locals.locale;
const t = createDashboardTranslator(locale);
let invoices: ShopInvoice[] = [];
if (billing !== null && shop !== undefined) {
  try {
    const member = await getShopForMember({ capability: "billing:manage", env, shopPublicId: shop.publicId, userId: auth.userId });
    invoices = await listShopInvoices({ env, shopId: member.row.shop_id });
  } catch {
    // Invoice history is supplemental; the billing page keeps rendering.
  }
}
const invoiceTones: Record<InvoiceStatus, "danger" | "info" | "neutral" | "success" | "warning"> = {
  draft: "neutral", failed: "danger", open: "info", paid: "success", past_due: "warning", refunded: "danger", void: "neutral",
};
const money = (amountMinor: number, currency: string): string => {
  if (!/^[A-Z]{3}$/u.test(currency)) return `${String(amountMinor)} ${currency}`;
  try {
    const formatter = new Intl.NumberFormat(locale ?? "en", { currency, currencyDisplay: "code", style: "currency" });
    const fractionDigits = formatter.resolvedOptions().maximumFractionDigits ?? 2;
    return formatter.format(amountMinor / 10 ** fractionDigits);
  } catch {
    return `${String(amountMinor)} ${currency}`;
  }
};
const usageLimit = (limits: Record<string, unknown>, metric: string): number | null => {
  const value = limits[metric];
  // A configured limit of 0 is real: the dispatcher fail-closes and blocks all
  // runs for that metric, so the UI must show "0", not "no numeric limit".
  return typeof value === "number" && Number.isFinite(value) && value >= 0 ? value : null;
};
const formatter = new Intl.DateTimeFormat(locale ?? "en", { dateStyle: "medium", timeZone: shop?.timezone ?? "Asia/Ho_Chi_Minh" });
const date = (value: string | null): string => value === null ? t("dashboard.billing.not_configured") : formatter.format(new Date(value));
const subscriptionState = billing === null ? null : subscriptionStatePresentation(billing.state, locale);
type BillingProjection = SellerBillingView & {
  currentPrice?: unknown;
  marketCode?: unknown;
  price?: unknown;
  priceDisplay?: unknown;
};
const projectedPrice = (value: unknown): MarketingPrice | null => {
  if (typeof value !== "object" || value === null || Array.isArray(value)) return null;
  const row = value as Record<string, unknown>;
  if (!isSellablePlanOfferProjection(row)) return null;
  return { amountMinor: row.amountMinor, currency: row.currency, interval: row.interval, marketCode: row.marketCode };
};
const billingProjection = billing as BillingProjection | null;
const currentPrice = billingProjection === null ? null : projectedPrice(billingProjection.currentPrice) ?? projectedPrice(billingProjection.price);
const currentPriceLabel = currentPrice === null ? null : formatMarketingPrice(currentPrice, locale);

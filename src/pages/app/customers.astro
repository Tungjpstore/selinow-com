---
import AppLayout from "../../layouts/AppLayout.astro";
import Button from "../../components/primitives/Button.astro";
import WorkspaceState from "../../components/states/WorkspaceState.astro";
import DataTable from "../../components/workspace/DataTable.astro";
import PageHeader from "../../components/workspace/PageHeader.astro";
import { authenticateRequest } from "../../lib/auth/session";
import { withSelectedShop } from "../../lib/dashboard/shop-navigation";
import { isAppError } from "../../lib/core/errors";
import { createDashboardTranslator } from "../../lib/i18n";
import { getBindings } from "../../lib/platform/bindings";
import { listSellerCustomersPage, parseSellerCustomerSort, type SellerCustomerView } from "../../lib/tenants/seller-management";
import { listShopsForMember, selectShopForMember, type ShopView } from "../../lib/tenants/store";

const env = getBindings();
const auth = await authenticateRequest(Astro.request, env).catch(() => null);
if (auth === null) return Astro.redirect("/login");
let shops: ShopView[] = [];
let state: "forbidden" | "ready" | "unavailable" = "ready";
let loadRequestId: string | null = null;
try { shops = await listShopsForMember({ env, userId: auth.userId }); } catch { state = "unavailable"; loadRequestId = Astro.locals.requestId; }
const shop = selectShopForMember(shops, Astro.url.searchParams.get("shop"));
const workspaceHref = (href: string): string => withSelectedShop(href, shop?.publicId, Astro.url.origin);
const locale = Astro.locals.locale;
const t = createDashboardTranslator(locale);

// The Astro page parses the table URL contract itself (q/sort/page/pageSize)
// and passes explicit values into the service; parsePublicApiPage only accepts
// cursor/limit, so the raw URL is never forwarded.
const searchParams = Astro.url.searchParams;
const parsedPage = Number.parseInt(searchParams.get("page") ?? "", 10);
const requestedPage = Number.isSafeInteger(parsedPage) && parsedPage >= 1 ? parsedPage : 1;
const parsedPageSize = Number.parseInt(searchParams.get("pageSize") ?? "", 10);
const requestedPageSize = parsedPageSize === 25 || parsedPageSize === 50 || parsedPageSize === 100 ? parsedPageSize : 25;
const sort = parseSellerCustomerSort(searchParams.get("sort"));
const query = searchParams.get("q")?.trim().slice(0, 64) ?? "";
const hasActiveFilters = query !== "";

let customers: SellerCustomerView[] = [];
let currentPage = requestedPage;
let pageSize = requestedPageSize;
let totalCount = 0;
let totalPages = 1;
if (shop !== undefined && state === "ready") {
  try {
    const result = await listSellerCustomersPage({ env, page: requestedPage, pageSize: requestedPageSize, search: query === "" ? null : query, shopPublicId: shop.publicId, sort, userId: auth.userId });
    customers = result.customers;
    currentPage = result.page ?? requestedPage;
    pageSize = result.pageSize ?? requestedPageSize;
    totalCount = result.totalCount ?? customers.length;
    totalPages = result.totalPages ?? 1;
  } catch (error) { state = isAppError(error) && error.status === 403 ? "forbidden" : "unavailable"; if (state === "unavailable") loadRequestId = Astro.locals.requestId; }
}
if (state === "forbidden") Astro.response.status = 403;
if (state === "unavailable") Astro.response.status = 503;

const buildHref = (params: Record<string, number | string | null | undefined>): string => {
  const next = new URLSearchParams();
  for (const [key, value] of Object.entries(params)) {
    if (value === null || value === undefined || value === "") continue;
    next.set(key, String(value));
  }
  const suffix = next.toString();
  return workspaceHref(`/app/customers${suffix === "" ? "" : `?${suffix}`}`);
};
const pageHref = (page: number): string => buildHref({
  page,
  pageSize,
  q: query === "" ? null : query,
  sort: searchParams.get("sort"),
});

const formatter = new Intl.DateTimeFormat(locale ?? "en", { dateStyle: "medium", timeStyle: "short", timeZone: shop?.timezone ?? "Asia/Ho_Chi_Minh" });
const date = (value: string | null): string => value === null ? t("dashboard.customers.no_orders") : formatter.format(new Date(value));

const sortBase: string = sort.endsWith("_desc") ? sort.slice(0, -5) : sort;
const sortDirection: "asc" | "desc" = sort.endsWith("_desc") ? "desc" : "asc";
const tableColumns = [
  { label: t("dashboard.customers.table.name") },
  { align: "end" as const, key: "orders", label: t("dashboard.customers.orders") },
  { key: "created", label: t("dashboard.customers.last_activity") },
  { label: t("dashboard.customers.table.status") },
  { label: t("dashboard.customers.table.actions") },
];
type CustomerExportRow = { email: string; lastActivity: string; name: string; orders: string; status: string };
const exportRows: CustomerExportRow[] = customers.map((customer) => ({
  email: customer.emailMasked ?? "",
  lastActivity: customer.lastOrderAt ?? "",
  name: customer.displayName ?? "",
  orders: String(customer.orderCount),
  status: customer.status,
}));
const exportHeaders = [
  t("dashboard.customers.table.name"),
  t("dashboard.customers.orders"),
  t("dashboard.customers.last_activity"),
  t("dashboard.customers.table.status"),
];
---

<AppLayout activePath="/app/customers" displayName={auth.displayName.trim() || t("dashboard.commerce.you")} email={auth.email} selectedShopName={shop?.name} selectedShopPublicId={shop?.publicId} shops={shops} title={t("dashboard.customers.title")}>
  <PageHeader eyebrow={t("dashboard.customers.eyebrow")} title={t("dashboard.customers.title")} description={t("dashboard.customers.description")}>
    {shop !== undefined && <a slot="actions" class="sln-button" data-variant="secondary" href={workspaceHref("/app/orders")}>{t("dashboard.customers.open_orders")} <span aria-hidden="true">↗</span></a>}
  </PageHeader>
  {state === "unavailable" ? <div class="state-space"><WorkspaceState title={t("dashboard.customers.unavailable.title")} description={`${t("dashboard.customers.unavailable.description")} ${loadRequestId === null ? "" : t("dashboard.state.error.meta_request", { requestId: loadRequestId })}`.trim()} actionHref={workspaceHref("/app/customers")} actionLabel={t("dashboard.customers.retry")} tone="danger" /></div>
    : shop === undefined ? <div class="state-space"><WorkspaceState title={t("dashboard.customers.no_store.title")} description={t("dashboard.customers.no_store.description")} actionHref={workspaceHref("/onboarding")} actionLabel={t("dashboard.customers.no_store.action")} tone="info" /></div>
    : state === "forbidden" ? <div class="state-space"><WorkspaceState title={t("dashboard.customers.forbidden.title")} description={t("dashboard.customers.forbidden.description")} tone="warning" /></div>
    : <div class="customers-workspace" data-customers-root data-shop-public-id={shop.publicId} data-csrf-cookie-name={`${env.SESSION_COOKIE_NAME}_csrf`} data-can-manage={shop.role === "owner" || shop.role === "manager" ? "true" : "false"} data-locale={locale ?? "en"} data-copy={JSON.stringify({
      loading: t("dashboard.customers.detail.loading"), loaded: t("dashboard.customers.detail.loaded"), unavailable: t("dashboard.customers.detail.unavailable"), save: t("dashboard.customers.detail.save"), saving: t("dashboard.customers.detail.saving"), saved: t("dashboard.customers.detail.saved"), addNote: t("dashboard.customers.detail.add_note"), addingNote: t("dashboard.customers.detail.adding_note"), noteAdded: t("dashboard.customers.detail.note_added"), redact: t("dashboard.customers.detail.redact"), redactConfirm: t("dashboard.customers.detail.redact_confirm"), redacting: t("dashboard.customers.detail.redacting"), redacted: t("dashboard.customers.detail.redacted"), emptyNotes: t("dashboard.customers.detail.empty_notes"), error: t("dashboard.customers.detail.error"), errorRecentAuth: t("dashboard.customers.detail.error_recent_auth"), errorConflict: t("dashboard.customers.detail.error_conflict"), errorForbidden: t("dashboard.customers.detail.error_forbidden"), errorNotFound: t("dashboard.customers.detail.error_not_found"), errorAnonymized: t("dashboard.customers.detail.error_anonymized"), errorPrivacyBlocked: t("dashboard.customers.privacy.blocked"), requestId: t("dashboard.customers.detail.request_id"), privacyExporting: t("dashboard.customers.privacy.exporting"), privacyExported: t("dashboard.customers.privacy.exported"), privacyAnonymizing: t("dashboard.customers.privacy.anonymizing"), privacyAnonymized: t("dashboard.customers.privacy.anonymized"), statusActive: t("dashboard.customers.status.active"), statusBlocked: t("dashboard.customers.status.blocked"), unnamed: t("dashboard.customers.unnamed"), noEmail: t("dashboard.customers.no_email"),
    })}>
    <section
      class="customer-panel"
      aria-labelledby="customer-ledger-title"
      data-customer-panel
      data-customer-ledger
      data-locale={locale ?? "en"}
      data-export-copy={JSON.stringify({ headers: exportHeaders })}
      data-export-rows={JSON.stringify(exportRows)}
    >
      <header><div><p class="eyebrow">{t("dashboard.customers.ledger.eyebrow")}</p><h2 id="customer-ledger-title">{t("dashboard.customers.ledger.title", { shop: shop.name })}</h2></div><div class="panel-heading-tools"><span class="record-count">{t("dashboard.customers.record_count", { count: totalCount })}</span>{customers.length > 0 && <Button type="button" variant="secondary" data-customer-table-export>{t("dashboard.table.export")}</Button>}</div></header>
      {totalCount === 0 && !hasActiveFilters ? <WorkspaceState title={t("dashboard.customers.empty.title")} description={t("dashboard.customers.empty.description")} actionHref={workspaceHref("/app/products")} actionLabel={t("dashboard.customers.empty.action")} tone="info" /> : <>
        <form class="customer-controls" method="get" aria-label={t("dashboard.customers.filters.aria")}>
          {searchParams.get("shop") !== null && <input type="hidden" name="shop" value={searchParams.get("shop") ?? ""} aria-label="shop" />}
          <label class="search-field"><span class="sr-only">{t("dashboard.customers.search.label")}</span><input type="search" name="q" value={query} placeholder={t("dashboard.customers.search.placeholder")} autocomplete="off" maxlength="64" /></label>
          <Button type="submit" variant="secondary">{t("dashboard.table.apply")}</Button>
        </form>
        {customers.length === 0 ? (
          <p class="customer-no-results" data-customer-no-results role="status" aria-live="polite">{t("dashboard.customers.no_results")}</p>
        ) : (
          <DataTable
            caption={t("dashboard.customers.table.aria")}
            columns={tableColumns}
            currentSort={sortBase}
            currentSortDirection={sortDirection}
            currentUrl={Astro.url}
          >
            <tbody>
              {customers.map((customer) => (
                <tr data-customer-row data-customer-public-id={customer.publicId} data-customer-version={customer.version}>
                  <td data-label={t("dashboard.customers.table.name")}><strong data-customer-name>{customer.displayName ?? t("dashboard.customers.unnamed")}</strong><span>{customer.emailMasked ?? t("dashboard.customers.no_email")}</span></td>
                  <td class="cell-end" data-label={t("dashboard.customers.orders")}><strong>{customer.orderCount}</strong></td>
                  <td data-label={t("dashboard.customers.last_activity")}>{customer.lastOrderAt === null ? <span>{t("dashboard.customers.no_orders")}</span> : <time datetime={customer.lastOrderAt}>{date(customer.lastOrderAt)}</time>}</td>
                  <td data-label={t("dashboard.customers.table.status")}><span class={`status-chip status-${customer.status}`} data-customer-status>{customer.status === "active" ? t("dashboard.customers.status.active") : t("dashboard.customers.status.blocked")}</span></td>
                  <td class="cell-end" data-label={t("dashboard.customers.table.actions")}>{shop.role === "owner" || shop.role === "manager" ? <button class="text-action" type="button" data-customer-open>{t("dashboard.customers.detail.open")}</button> : <span aria-hidden="true">—</span>}</td>
                </tr>
              ))}
            </tbody>
            <nav slot="pagination" class="table-pagination" aria-label={t("dashboard.customers.pagination.aria")}>
              {currentPage > 1 && <a href={pageHref(currentPage - 1)}>← {t("dashboard.table.previous")}</a>}
              <span>{t("dashboard.table.page_info", { page: currentPage, totalPages })}</span>
              {currentPage < totalPages && <a href={pageHref(currentPage + 1)}>{t("dashboard.table.next")} →</a>}
              <form class="page-size-form" method="get">
                {searchParams.get("shop") !== null && <input type="hidden" name="shop" value={searchParams.get("shop") ?? ""} aria-label="shop" />}
                {query !== "" && <input type="hidden" name="q" value={query} aria-label="q" />}
                {searchParams.get("sort") !== null && <input type="hidden" name="sort" value={sort} aria-label="sort" />}
                <label>{t("dashboard.table.rows_per_page")}
                  <select name="pageSize" data-page-size-select>
                    {[25, 50, 100].map((size) => <option value={size} selected={pageSize === size}>{size}</option>)}
                  </select>
                </label>
              </form>
            </nav>
          </DataTable>
        )}
        <p class="scope-note">{t("dashboard.customers.scope")}</p>
      </>}
    </section>
    {shop.role === "owner" || shop.role === "manager" ? <section class="customer-panel customer-detail-panel" data-customer-detail hidden aria-labelledby="customer-detail-title">
      <header><div><p class="eyebrow">{t("dashboard.customers.detail.eyebrow")}</p><h2 id="customer-detail-title">{t("dashboard.customers.detail.title")}</h2><p class="customer-detail-email" data-customer-email></p></div><button class="text-action" type="button" data-customer-close>{t("dashboard.customers.detail.close")}</button></header>
      <div class="workspace-feedback" data-customer-feedback role="status" aria-live="polite" hidden></div>
      <form class="customer-detail-form" data-customer-form novalidate>
        <label>{t("dashboard.customers.detail.name")}<input name="displayName" maxlength="120" /></label>
        <label>{t("dashboard.customers.detail.locale")}<select name="locale"><option value="en">en</option><option value="vi-VN">vi-VN</option></select></label>
        <label>{t("dashboard.customers.detail.status")}<select name="status"><option value="active">{t("dashboard.customers.status.active")}</option><option value="blocked">{t("dashboard.customers.status.blocked")}</option></select></label>
        <button class="sln-button" data-variant="primary" type="submit">{t("dashboard.customers.detail.save")}</button>
      </form>
      <div class="customer-notes" data-customer-notes></div>
      <form class="customer-note-form" data-customer-note-form novalidate><label>{t("dashboard.customers.detail.note")}<textarea name="body" maxlength="4000" required></textarea></label><button class="sln-button" data-variant="secondary" type="submit">{t("dashboard.customers.detail.add_note")}</button></form>
      <section class="customer-privacy" aria-labelledby="customer-privacy-title">
        <div><p class="eyebrow">{t("dashboard.customers.privacy.eyebrow")}</p><h3 id="customer-privacy-title">{t("dashboard.customers.privacy.title")}</h3><p>{t("dashboard.customers.privacy.description")}</p><p class="scope-note">{t("dashboard.customers.privacy.self_service_blocked")}</p></div>
        <div class="customer-privacy-actions">
          <button class="sln-button" data-variant="secondary" type="button" data-customer-export>{t("dashboard.customers.privacy.export")}</button>
          <form class="customer-anonymize-form" data-customer-anonymize-form novalidate>
            <p>{t("dashboard.customers.privacy.anonymize_warning")}</p>
            <label>{t("dashboard.customers.privacy.confirm_label")} <code>ANONYMIZE</code><input name="confirmation" type="text" required pattern="ANONYMIZE" autocomplete="off" autocapitalize="characters" spellcheck="false" /></label>
            <button class="sln-button" data-variant="danger" type="submit" data-customer-anonymize>{t("dashboard.customers.privacy.anonymize")}</button>
          </form>
        </div>
        <p class="workspace-feedback" data-customer-privacy-status role="status" aria-live="polite" hidden></p>
      </section>
      <dialog class="sln-dialog" id="customer-note-redact-dialog" data-note-redact-dialog aria-labelledby="customer-note-redact-title" aria-describedby="customer-note-redact-impact">
        <div class="sln-dialog__body"><h2 id="customer-note-redact-title">{t("dashboard.customers.detail.redact")}</h2><p id="customer-note-redact-impact">{t("dashboard.customers.detail.redact_confirm")}</p></div>
        <form class="sln-dialog__actions" method="dialog" data-note-redact-form>
          <button class="sln-button" data-variant="secondary" type="submit" value="cancel">{t("dashboard.customers.dialog.cancel")}</button>
          <button class="sln-button" data-variant="danger" type="submit" value="confirm">{t("dashboard.customers.detail.redact")}</button>
        </form>
      </dialog>
    </section> : null}
    </div>}
</AppLayout>

<script>
  import { buildCsv, downloadCsv } from "../../lib/dashboard/csv-export";

  type ExportRow = { email: string; lastActivity: string; name: string; orders: string; status: string };

  const panel = document.querySelector<HTMLElement>("[data-customer-panel]");
  if (panel !== null) {
    const normalize = (value: string): string => value.trim().toLocaleLowerCase(panel?.dataset.locale ?? "en");
    const copy: { headers?: readonly string[] } = (() => {
      try { return JSON.parse(panel.dataset.exportCopy ?? "{}") as { headers?: readonly string[] }; }
      catch { return {}; }
    })();
    const rows: ExportRow[] = (() => {
      try {
        const parsed: unknown = JSON.parse(panel.dataset.exportRows ?? "[]");
        return Array.isArray(parsed) ? parsed as ExportRow[] : [];
      } catch { return []; }
    })();
    const headers = copy.headers ?? [];

    panel.querySelector("[data-customer-table-export]")?.addEventListener("click", () => {
      const csv = buildCsv(rows, [
        { header: headers[0] ?? "", value: (row: ExportRow) => `${row.name}${row.email === "" ? "" : ` / ${row.email}`}` },
        { header: headers[1] ?? "", value: (row: ExportRow) => row.orders },
        { header: headers[2] ?? "", value: (row: ExportRow) => row.lastActivity },
        { header: headers[3] ?? "", value: (row: ExportRow) => row.status },
      ]);
      const stamp = new Date().toISOString().slice(0, 10).replaceAll("-", "");
      downloadCsv(`${normalize("customers")}-${stamp}.csv`, csv);
    });

    const pageSizeSelect = panel.querySelector("[data-page-size-select]");
    if (pageSizeSelect instanceof HTMLSelectElement) {
      pageSizeSelect.addEventListener("change", () => {
        pageSizeSelect.form?.requestSubmit();
      });
    }
  }
</script>

<script src="../../scripts/dashboard/customers.ts"></script>

<style>
  .state-space { margin-top:var(--sln-space-8); }
  .customer-panel { display:grid; gap:20px; margin-top:var(--sln-space-8); border:1px solid var(--sln-border-default); border-radius:var(--sln-radius-lg); padding:var(--sln-space-6); background:var(--sln-bg-surface); }
  .customer-panel > header { display:flex; align-items:end; justify-content:space-between; gap:16px; padding-bottom:16px; border-bottom:1px solid var(--sln-border-default); }
  .customer-panel h2 { margin:0; font:var(--sln-font-h3); letter-spacing:-.035em; }
  .customer-panel span, .customer-panel time { color:var(--sln-text-muted); font:var(--sln-font-caption); }
  .panel-heading-tools { display:flex; flex-wrap:wrap; align-items:center; gap:14px; }
  .record-count { color:var(--sln-text-muted); font:var(--sln-font-caption); }
  .eyebrow { margin:0 0 7px; color:var(--sln-action-primary); font:var(--sln-font-caption); font-weight:750; letter-spacing:.1em; text-transform:uppercase; }
  .customer-controls { display:flex; flex-wrap:wrap; align-items:center; gap:14px; }
  .search-field { display:block; width:min(100%, 360px); }
  .search-field input { width:100%; min-height:44px; border:1px solid var(--sln-border-strong); border-radius:var(--sln-radius-md); padding:9px 12px; background:var(--sln-bg-canvas); color:var(--sln-text-primary); font:var(--sln-font-body-sm); }
  .customer-panel td strong { display:block; overflow:hidden; color:var(--sln-text-primary); font:var(--sln-font-label); text-overflow:ellipsis; white-space:nowrap; }
  .customer-panel td span, .customer-panel td time { display:block; overflow:hidden; color:var(--sln-text-muted); font:var(--sln-font-caption); text-overflow:ellipsis; white-space:nowrap; }
  .cell-end { text-align:end; }
  .status-chip { display:inline-block; white-space:nowrap; border-radius:var(--sln-radius-pill); padding:6px 9px; background:var(--sln-tint-success); color:var(--sln-state-success) !important; }
  .status-suspended, .status-blocked { background:var(--sln-tint-danger); color:var(--sln-state-danger) !important; }
  .scope-note { margin:0; color:var(--sln-text-muted); font:var(--sln-font-caption); }
  .customer-no-results { margin:0; border:1px dashed var(--sln-border-strong); border-radius:var(--sln-radius-md); padding:18px; background:var(--sln-bg-subtle); color:var(--sln-text-secondary); font:var(--sln-font-body-sm); text-align:center; }
  .table-pagination { display:flex; flex-wrap:wrap; align-items:center; gap:14px; margin-top:var(--sln-space-4); color:var(--sln-text-muted); font:var(--sln-font-caption); }
  .table-pagination a { display:inline-flex; align-items:center; min-height:44px; color:var(--sln-action-primary); font:var(--sln-font-label); text-decoration:none; }
  .page-size-form { margin-left:auto; }
  .page-size-form label { display:inline-flex; align-items:center; gap:8px; color:var(--sln-text-muted); font:var(--sln-font-caption); }
  .page-size-form select { min-height:40px; border:1px solid var(--sln-border-strong); border-radius:var(--sln-radius-md); padding:6px 10px; background:var(--sln-bg-canvas); color:var(--sln-text-primary); }
  .customer-detail-panel { scroll-margin-top:88px; }
  .customer-detail-email { margin:6px 0 0; color:var(--sln-text-muted); font:var(--sln-font-caption); }
  .customer-detail-form, .customer-note-form { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)) auto; gap:12px; align-items:end; }
  .customer-detail-form label, .customer-note-form label { display:grid; gap:6px; color:var(--sln-text-secondary); font:var(--sln-font-caption); }
  .customer-detail-form input, .customer-detail-form select, .customer-note-form textarea { min-height:42px; border:1px solid var(--sln-border-strong); border-radius:var(--sln-radius-md); padding:9px 11px; background:var(--sln-bg-canvas); color:var(--sln-text-primary); font:var(--sln-font-body-sm); }
  .customer-note-form { grid-template-columns:minmax(0,1fr) auto; }
  .customer-note-form textarea { min-height:80px; resize:vertical; }
  .customer-notes { display:grid; gap:10px; }
  .customer-note { display:grid; gap:5px; border-top:1px solid var(--sln-border-default); padding-top:12px; }
  .customer-note header { display:flex; align-items:center; justify-content:space-between; gap:12px; }
  .customer-note p { margin:0; color:var(--sln-text-secondary); font:var(--sln-font-body-sm); white-space:pre-wrap; }
  .customer-privacy { display:grid; gap:16px; border-top:1px solid var(--sln-border-default); padding-top:20px; }
  .customer-privacy h3, .customer-privacy p { margin:0; }
  .customer-privacy > div:first-child { display:grid; gap:8px; }
  .customer-privacy > div:first-child > p:not(.eyebrow) { color:var(--sln-text-secondary); font:var(--sln-font-body-sm); }
  .customer-privacy-actions { display:grid; grid-template-columns:max-content minmax(0,1fr); gap:18px; align-items:start; }
  .customer-anonymize-form { display:grid; gap:10px; border-left:1px solid var(--sln-border-default); padding-left:18px; }
  .customer-anonymize-form p { color:var(--sln-state-danger); font:var(--sln-font-body-sm); }

---
import AppLayout from "../../../layouts/AppLayout.astro";
import PageHeader from "../../../components/workspace/PageHeader.astro";
import WorkspaceState from "../../../components/states/WorkspaceState.astro";
import StatusBadge from "../../../components/primitives/StatusBadge.astro";
import Money from "../../../components/commerce/Money.astro";
import PaymentState from "../../../components/commerce/PaymentState.astro";
import FulfillmentState from "../../../components/commerce/FulfillmentState.astro";
import { isAppError } from "../../../lib/core/errors";
import { requireResourceId } from "../../../lib/catalog/policy";
import { getSellerOrder, type SellerOrderDetail } from "../../../lib/commerce/seller-orders";
import { authenticateRequest } from "../../../lib/auth/session";
import { getBindings } from "../../../lib/platform/bindings";
import { withSelectedShop } from "../../../lib/dashboard/shop-navigation";
import { createDashboardTranslator, createSystemTranslator } from "../../../lib/i18n";
import { listShopsForMember, selectShopForMember } from "../../../lib/tenants/store";

const env = getBindings();
const auth = await authenticateRequest(Astro.request, env).catch(() => null);
if (auth === null) return Astro.redirect("/login");

const shops = await listShopsForMember({ env, userId: auth.userId });
const requestedShopPublicId = Astro.url.searchParams.get("shop");
const unauthorizedShopRequest = requestedShopPublicId !== null
  && !shops.some((candidate) => candidate.publicId === requestedShopPublicId);
const shop = selectShopForMember(shops, requestedShopPublicId);
const workspaceHref = (href: string): string => withSelectedShop(href, shop?.publicId, Astro.url.origin);
const locale = Astro.locals.locale;
const t = createDashboardTranslator(locale);
const systemT = createSystemTranslator(locale);
const orderParam = Astro.params.id;
let order: SellerOrderDetail | null = null;
let state: "ready" | "not_found" | "forbidden" | "error" = "ready";
let loadRequestId: string | null = null;

if (unauthorizedShopRequest) {
  state = "forbidden";
} else if (shop === undefined) {
  state = "not_found";
} else {
  try {
    const orderPublicId = requireResourceId(orderParam, "order");
    order = await getSellerOrder({ env, orderPublicId, shopPublicId: shop.publicId, userId: auth.userId });
  } catch (error) {
    if (!isAppError(error)) throw error;
    state = error.status === 403 || error.code === "authorization_denied" ? "forbidden" : error.status === 404 ? "not_found" : "error";
    if (state === "error") loadRequestId = Astro.locals.requestId;
  }
}

Astro.response.headers.set("Cache-Control", "private, no-store, max-age=0");
Astro.response.headers.set("Pragma", "no-cache");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
if (state === "not_found") Astro.response.status = 404;
if (state === "forbidden") Astro.response.status = 403;

const displayName = auth.displayName.trim() || t("dashboard.commerce.you");

const orderStatusLabels: Record<string, string> = {
  completed: t("dashboard.order_detail.status.completed"),
  exception: t("dashboard.order_detail.status.exception"),
  expired: t("dashboard.order_detail.status.expired"),
  pending_payment: t("dashboard.order_detail.status.pending_payment"),
  processing: t("dashboard.order_detail.status.processing"),
  cancelled: t("dashboard.order_detail.status.cancelled"),
};
const orderStatusTone = (value: string): "danger" | "info" | "neutral" | "success" | "warning" => {
  if (value === "completed") return "success";
  if (value === "exception" || value === "cancelled") return "danger";
  if (value === "pending_payment" || value === "expired") return "warning";
  if (value === "processing") return "info";
  return "neutral";
};
const knownPaymentStates = new Set([
  "creating", "pending", "paid_exact", "paid", "failed", "error", "expired", "partial",
  "overpaid", "late", "identity_mismatch", "inconsistent", "terminal_unpaid", "refunded",
]);
const paymentAttemptLabel = (value: string): string => value === "created"
  ? t("dashboard.order_detail.payment.created")
  : systemT(`status.payment.${knownPaymentStates.has(value) ? value : "unknown"}`);
const paymentAttemptTone = (value: string): "danger" | "info" | "neutral" | "success" | "warning" => {
  if (value === "paid" || value === "paid_exact") return "success";
  if (value === "pending" || value === "created" || value === "creating") return "info";
  if (["partial", "overpaid", "failed", "error", "late", "identity_mismatch", "inconsistent"].includes(value)) return "danger";
  if (value === "expired" || value === "terminal_unpaid") return "warning";
  return "neutral";
};
const sourceLabels: Record<string, string> = { web: "Website", website: "Website", telegram: "Telegram", api: "API" };
const fulfillmentTypeLabels: Record<string, string> = {
  digital_keys: t("dashboard.order_detail.fulfillment_type.license"),
  license_key: t("dashboard.order_detail.fulfillment_type.license"),
  manual: t("dashboard.order_detail.fulfillment_type.manual"),
  download: t("dashboard.order_detail.fulfillment_type.download"),
};
const dateFormatter = new Intl.DateTimeFormat(locale ?? "en", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: shop?.timezone ?? "Asia/Ho_Chi_Minh",
});
const formatDate = (value: string | null | undefined): string => {
  if (value === null || value === undefined || value === "") return t("dashboard.commerce.not_recorded");
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? t("dashboard.commerce.not_recorded") : dateFormatter.format(date);
};
const formatShortId = (value: string): string => value.replace(/^order_/u, "").slice(0, 8).toUpperCase();
const canManageFulfillment = shop?.role === "owner" || shop?.role === "manager";
const canManagePayments = shop?.role === "owner" || shop?.role === "manager";
const manualItems = order?.items.filter((item) => item.manualFulfillment?.status === "pending") ?? [];
const manualFulfillmentTone = (status: "completed" | "pending" | "unsupported"): "neutral" | "success" | "warning" => {
  if (status === "completed") return "success";
  if (status === "unsupported") return "warning";
  return "neutral";
};
const openPaymentExceptions = order?.paymentExceptions.filter((exception) => exception.status === "open") ?? [];
const activeRemediationByException = new Map(
  order?.remediationRequests
    .filter((request) => request.status === "requested" || request.status === "provider_pending")
    .map((request) => [request.exceptionId, request]) ?? [],
);
const paymentExceptionLabel = (value: string): string => {
  switch (value) {
    case "failed": return t("dashboard.orders.exception.type.failed");
    case "identity_mismatch": return t("dashboard.orders.exception.type.identity_mismatch");
    case "inconsistent": return t("dashboard.orders.exception.type.inconsistent");
    case "late": return t("dashboard.orders.exception.type.late");
    case "manual_review": return t("dashboard.orders.exception.type.manual_review");
    case "overpaid": return t("dashboard.orders.exception.type.overpaid");
    case "partial": return t("dashboard.orders.exception.type.partial");
    default: return t("dashboard.orders.exception.type.default");
  }
};
const remediationStatusLabels: Record<string, string> = {
  canceled: t("dashboard.billing.requests.status_canceled"),
  completed: t("dashboard.billing.requests.status_completed"),
  failed: t("dashboard.order_detail.exceptions.request_failed"),
  provider_pending: t("dashboard.billing.requests.status_provider_pending"),
  rejected: t("dashboard.billing.requests.status_rejected"),
  requested: t("dashboard.billing.requests.status_requested"),
};
---

<AppLayout activePath="/app/orders" displayName={displayName} email={auth.email} selectedShopName={shop?.name} selectedShopPublicId={shop?.publicId} shops={shops} title={order ? t("dashboard.order_detail.order_title", { number: order.orderNumber }) : t("dashboard.order_detail.title")}>
  {state === "not_found" && <WorkspaceState eyebrow={t("dashboard.order_detail.not_found.eyebrow")} title={t("dashboard.order_detail.not_found.title")} description={t("dashboard.order_detail.not_found.description")} actionHref={workspaceHref("/app/orders")} actionLabel={t("dashboard.order_detail.back")} tone="warning" />}
  {state === "forbidden" && <WorkspaceState eyebrow={t("dashboard.order_detail.forbidden.eyebrow")} title={t("dashboard.order_detail.forbidden.title")} description={t("dashboard.order_detail.forbidden.description")} actionHref={workspaceHref("/app/orders")} actionLabel={t("dashboard.order_detail.back")} tone="danger" />}
  {state === "error" && <WorkspaceState eyebrow={t("dashboard.order_detail.error.eyebrow")} title={t("dashboard.order_detail.error.title")} description={`${t("dashboard.order_detail.error.description")} ${loadRequestId === null ? "" : t("dashboard.state.error.meta_request", { requestId: loadRequestId })}`.trim()} actionHref={workspaceHref("/app/orders")} actionLabel={t("dashboard.order_detail.error.action")} tone="danger" />}

  {state === "ready" && order !== null && shop !== undefined && <>
    <PageHeader eyebrow={t("dashboard.order_detail.header.eyebrow", { id: formatShortId(order.orderId) })} title={t("dashboard.order_detail.order_title", { number: order.orderNumber })} description={t("dashboard.order_detail.header.description")}>
      <div slot="actions" class="header-actions">
        <a class="sln-button" data-variant="secondary" href={workspaceHref("/app/orders")}>← {t("dashboard.order_detail.order_list")}</a>
        <a class="sln-button" data-variant="primary" href={`https://${shop.slug}.${env.PLATFORM_BASE_DOMAIN}`}>{t("dashboard.order_detail.open_storefront")} <span aria-hidden="true">↗</span></a>
      </div>
    </PageHeader>

    <section class="order-status-rail" aria-label={t("dashboard.order_detail.summary_aria")}>
      <div><span>{t("dashboard.order_detail.order_number")}</span><strong>{order.orderNumber}</strong><small>{formatShortId(order.orderId)}</small></div>
      <div><span>{t("dashboard.order_detail.status")}</span><StatusBadge label={orderStatusLabels[order.status] ?? t("dashboard.order_detail.status.unknown")} tone={orderStatusTone(order.status)} /><small>{t("dashboard.order_detail.last_updated", { time: formatDate(order.updatedAt) })}</small></div>
      <div><span>{t("dashboard.order_detail.payment")}</span><PaymentState locale={locale} value={order.paymentStatus} /><small>{order.paidAt ? t("dashboard.order_detail.verified_at", { time: formatDate(order.paidAt) }) : t("dashboard.order_detail.not_verified")}</small></div>
      <div><span>{t("dashboard.order_detail.fulfillment")}</span><FulfillmentState locale={locale} value={order.fulfillmentStatus} /><small>{order.fulfilledAt ? t("dashboard.order_detail.fulfilled_at", { time: formatDate(order.fulfilledAt) }) : t("dashboard.order_detail.not_fulfilled")}</small></div>
      <div><span>{t("dashboard.order_detail.total")}</span><strong class="rail-total"><Money value={order.totalMinor} currency={order.currency} locale={locale ?? "en"} /></strong><small>{sourceLabels[order.sourceChannel] ?? order.sourceChannel}</small></div>
    </section>

    <div class="order-layout">
      <div class="order-main">
        <section class="ledger-panel" aria-labelledby="customer-title">
          <div class="panel-heading"><div><p class="eyebrow">{t("dashboard.order_detail.customer.eyebrow")}</p><h2 id="customer-title">{t("dashboard.order_detail.customer.title")}</h2></div><span class="safe-note">{t("dashboard.order_detail.masked")}</span></div>
          <dl class="customer-grid">
            <div><dt>{t("dashboard.order_detail.customer.email")}</dt><dd>{order.customerEmail ?? t("dashboard.order_detail.no_email")}</dd></div>
            <div><dt>{t("dashboard.order_detail.customer.source")}</dt><dd>{sourceLabels[order.sourceChannel] ?? order.sourceChannel}</dd></div>
            <div><dt>{t("dashboard.order_detail.customer.created")}</dt><dd>{formatDate(order.createdAt)}</dd></div>
            <div><dt>{t("dashboard.order_detail.customer.expires")}</dt><dd>{formatDate(order.expiresAt)}</dd></div>
          </dl>
          <p class="privacy-copy">{t("dashboard.order_detail.customer.privacy")}</p>
        </section>

        <section class="ledger-panel" aria-labelledby="items-title">
          <div class="panel-heading"><div><p class="eyebrow">{t("dashboard.order_detail.items.eyebrow")}</p><h2 id="items-title">{t("dashboard.order_detail.items.title")}</h2></div><span class="record-count">{t("dashboard.order_detail.items.count", { count: order.itemCount })}</span></div>
          {order.items.length === 0 ? <WorkspaceState title={t("dashboard.order_detail.items.empty_title")} description={t("dashboard.order_detail.items.empty_description")} tone="warning" /> : <div class="item-ledger">
            {order.items.map((item, index) => <article class="item-row" data-order-item-id={item.id}>
              <span class="item-index">{String(index + 1).padStart(2, "0")}</span>
              <div class="item-copy"><strong>{item.productTitle}</strong><span>{item.variantTitle} · <code>{item.sku}</code></span><small>{fulfillmentTypeLabels[item.fulfillmentType] ?? item.fulfillmentType} · {t("dashboard.order_detail.quantity", { count: item.quantity })}</small>{item.privateDownload !== null && <span class="private-download-state"><strong>{t("dashboard.order_detail.private_download.title")}</strong><span>{item.privateDownload.filename}</span><small>{item.privateDownload.entitlementStatus === "active" ? t("dashboard.order_detail.private_download.remaining", { count: item.privateDownload.remainingDownloads }) : item.privateDownload.entitlementStatus === "exhausted" ? t("dashboard.order_detail.private_download.exhausted") : t("dashboard.order_detail.private_download.waiting")}</small></span>}{item.manualFulfillment !== null && <span class="manual-fulfillment-state"><strong>{fulfillmentTypeLabels.manual}</strong><StatusBadge label={item.manualFulfillment.status} tone={manualFulfillmentTone(item.manualFulfillment.status)} /><small>{item.manualFulfillment.status === "completed" ? t("dashboard.order_detail.fulfillment_done", { time: formatDate(item.manualFulfillment.completedAt) }) : item.manualFulfillment.status === "pending" ? t("dashboard.order_detail.fulfillment_waiting") : <code>{item.manualFulfillment.unsupportedReason ?? "unsupported"}</code>}</small></span>}</div>
              <div class="item-price"><strong><Money value={item.lineTotalMinor} currency={order.currency} locale={locale ?? "en"} /></strong><small><Money value={item.unitPriceMinor} currency={order.currency} locale={locale ?? "en"} /> / {t("dashboard.order_detail.unit")}</small></div>
            </article>)}
            <div class="item-total"><span>{t("dashboard.order_detail.total")}</span><strong><Money value={order.totalMinor} currency={order.currency} locale={locale ?? "en"} /></strong></div>
          </div>}
        </section>

        {order.shipping !== null && (
          <section class="ledger-panel dispatch-panel" aria-labelledby="dispatch-title" data-dispatch-panel data-shop-public-id={shop?.publicId} data-order-public-id={order.orderId} data-can-manage={canManageFulfillment ? "true" : "false"} data-csrf-cookie-name={`${env.SESSION_COOKIE_NAME}_csrf`} data-copy={JSON.stringify({
            carrierLabel: t("dashboard.order_detail.dispatch.carrier"),
            carrierPlaceholder: t("dashboard.order_detail.dispatch.carrier_placeholder"),
            trackingLabel: t("dashboard.order_detail.dispatch.tracking"),
            markPacked: t("dashboard.order_detail.dispatch.mark_packed"),
            markShipped: t("dashboard.order_detail.dispatch.mark_shipped"),
            markDelivered: t("dashboard.order_detail.dispatch.mark_delivered"),
            error: t("dashboard.order_detail.dispatch.error"),
            statePacking: t("dashboard.order_detail.dispatch.state.packing"),
            stateShipped: t("dashboard.order_detail.dispatch.state.shipped"),
            stateDelivered: t("dashboard.order_detail.dispatch.state.delivered"),
          })}>
            <div class="panel-heading"><p class="eyebrow">{t("dashboard.order_detail.dispatch.eyebrow")}</p><h2 id="dispatch-title">{t("dashboard.order_detail.dispatch.title")}</h2></div>
            <div class="dispatch-address">
              <strong>{order.shipping.address.fullName} · {order.shipping.address.phone}</strong>
              <span>{order.shipping.address.addressLine}</span>
              <span>{order.shipping.address.ward}, {order.shipping.address.district}, {order.shipping.address.province}</span>
              {order.shipping.address.notes && <small>{order.shipping.address.notes}</small>}
              {order.shipping.methodName !== null && <small>{t("dashboard.order_detail.dispatch.method")}: {order.shipping.methodName} · <Money value={order.shipping.feeMinor} currency={order.currency} locale={locale ?? "en"} /></small>}
            </div>
            {order.shipping.shipments.length > 0 && <ol class="dispatch-shipments">
              {order.shipping.shipments.map((shipment) => <li><strong>{shipment.shippingState === "delivered" ? t("dashboard.order_detail.dispatch.state.delivered") : shipment.shippingState === "shipped" ? t("dashboard.order_detail.dispatch.state.shipped") : t("dashboard.order_detail.dispatch.state.packing")}</strong>{shipment.carrier && <span> · {shipment.carrier}</span>}{shipment.trackingCode && <code> · {shipment.trackingCode}</code>}</li>)}
            </ol>}
            {canManageFulfillment && order.paymentStatus === "paid" && (
              <div class="dispatch-actions">
                <label>{t("dashboard.order_detail.dispatch.carrier")}<input data-dispatch-carrier maxlength="80" placeholder={t("dashboard.order_detail.dispatch.carrier_placeholder")} /></label>
                <label>{t("dashboard.order_detail.dispatch.tracking")}<input data-dispatch-tracking maxlength="64" placeholder="VN123456789" /></label>
                <div class="dispatch-buttons">
                  <button class="sln-button" type="button" data-dispatch-state="packing">{t("dashboard.order_detail.dispatch.mark_packed")}</button>
                  <button class="sln-button" type="button" data-dispatch-state="shipped">{t("dashboard.order_detail.dispatch.mark_shipped")}</button>
                  <button class="sln-button" type="button" data-dispatch-state="delivered">{t("dashboard.order_detail.dispatch.mark_delivered")}</button>
                </div>
              </div>
            )}
            <p class="form-feedback" data-dispatch-feedback role="status" aria-live="polite"></p>
          </section>
        )}

        <div class="timeline-grid">
          <section class="ledger-panel timeline-panel" aria-labelledby="payment-title">
            <div class="panel-heading"><div><p class="eyebrow">{t("dashboard.order_detail.payment_timeline.eyebrow")}</p><h2 id="payment-title">{t("dashboard.order_detail.payment")}</h2></div><PaymentState locale={locale} value={order.paymentStatus} /></div>
            {order.payments.length === 0 ? <WorkspaceState title={t("dashboard.order_detail.payment_timeline.empty_title")} description={t("dashboard.order_detail.payment_timeline.empty_description")} tone="info" /> : <ol class="timeline-list">
              {order.payments.map((payment) => <li>
                <span class="timeline-marker" aria-hidden="true"></span>
                <div class="timeline-entry"><div class="timeline-top"><strong>{paymentAttemptLabel(payment.state)}</strong><StatusBadge label={paymentAttemptLabel(payment.state)} tone={paymentAttemptTone(payment.state)} /></div><p>{payment.provider ? t("dashboard.order_detail.payment_channel", { provider: payment.provider }) : t("dashboard.order_detail.internal_payment")} · {t("dashboard.order_detail.expected_amount")} <Money value={payment.expectedAmountMinor} currency={order.currency} locale={locale ?? "en"} /></p><small>{formatDate(payment.createdAt)} · {t("dashboard.order_detail.expires_at")} {formatDate(payment.expiresAt)}</small>{payment.lastSafeErrorCode && <code class="safe-error">{t("dashboard.order_detail.safe_error", { code: payment.lastSafeErrorCode })}</code>}</div>
              </li>)}
            </ol>}
          </section>

          <section class="ledger-panel timeline-panel" aria-labelledby="fulfillment-title">
            <div class="panel-heading"><div><p class="eyebrow">{t("dashboard.order_detail.fulfillment_timeline.eyebrow")}</p><h2 id="fulfillment-title">{t("dashboard.order_detail.fulfillment")}</h2></div><FulfillmentState locale={locale} value={order.fulfillmentStatus} /></div>
            {order.fulfillment.length === 0 ? <WorkspaceState title={t("dashboard.order_detail.fulfillment_timeline.empty_title")} description={t("dashboard.order_detail.fulfillment_timeline.empty_description")} tone="info" /> : <ol class="timeline-list">
              {order.fulfillment.map((entry) => <li>
                <span class="timeline-marker" aria-hidden="true"></span>
                <div class="timeline-entry"><div class="timeline-top"><strong>{fulfillmentTypeLabels[entry.type] ?? entry.type}</strong><FulfillmentState locale={locale} value={entry.state} /></div><p>{entry.state === "fulfilled" ? t("dashboard.order_detail.fulfillment_done", { time: formatDate(entry.fulfilledAt) }) : entry.state === "failed" ? t("dashboard.order_detail.fulfillment_failed", { time: formatDate(entry.failedAt) }) : t("dashboard.order_detail.fulfillment_waiting")}</p><small>{t("dashboard.order_detail.started_at", { time: formatDate(entry.createdAt) })}</small></div>
              </li>)}
            </ol>}
          </section>
        </div>

        <section class="ledger-panel" aria-labelledby="notes-title">
          <div class="panel-heading"><div><p class="eyebrow">{t("dashboard.order_detail.notes.eyebrow")}</p><h2 id="notes-title">{t("dashboard.order_detail.notes.title")}</h2></div><span class="safe-note">{t("dashboard.order_detail.read_only")}</span></div>
          {order.notes.length === 0 ? <WorkspaceState title={t("dashboard.order_detail.notes.empty_title")} description={t("dashboard.order_detail.notes.empty_description")} tone="info" /> : <ol class="notes-list">
            {order.notes.map((note) => <li data-note-status={note.status}>
              <div class="note-top"><strong>{note.authorDisplayName}</strong><time datetime={note.createdAt}>{formatDate(note.createdAt)}</time></div>
              <p>{note.status === "redacted" ? t("dashboard.order_detail.notes.redacted") : note.body}</p>
            </li>)}
          </ol>}
        </section>
      </div>

      <aside class="order-side" aria-label={t("dashboard.order_detail.side_aria")}>
        <section class="side-panel" aria-labelledby="summary-title">
          <div class="panel-heading"><div><p class="eyebrow">{t("dashboard.order_detail.summary.eyebrow")}</p><h2 id="summary-title">{t("dashboard.order_detail.summary.title")}</h2></div></div>
          <dl class="summary-list">
            <div><dt>{t("dashboard.order_detail.summary.source")}</dt><dd>{sourceLabels[order.sourceChannel] ?? order.sourceChannel}</dd></div>
            <div><dt>{t("dashboard.order_detail.summary.lines")}</dt><dd>{order.itemCount}</dd></div>
            <div><dt>{t("dashboard.order_detail.summary.paid_at")}</dt><dd>{formatDate(order.paidAt)}</dd></div>
            <div><dt>{t("dashboard.order_detail.summary.fulfilled_at")}</dt><dd>{formatDate(order.fulfilledAt)}</dd></div>
          </dl>
          <div class="safe-callout"><strong>{t("dashboard.order_detail.summary.no_override")}</strong><span>{t("dashboard.order_detail.summary.no_override_description")}</span></div>
          <div class="safe-callout"><strong>{t("dashboard.order_detail.refund.title")}</strong><span>{t("dashboard.order_detail.refund.description")}</span></div>
        </section>

        {order.paymentExceptions.length > 0 && <section class="side-panel" aria-labelledby="payment-exceptions-title" data-payment-remediation data-shop-public-id={shop.publicId} data-csrf-cookie-name={`${env.SESSION_COOKIE_NAME}_csrf`} data-submitting={t("dashboard.order_detail.exceptions.submitting")} data-requested={t("dashboard.order_detail.exceptions.requested")} data-failed={t("dashboard.order_detail.exceptions.failed")} data-error-code-label={t("dashboard.order_detail.action.error_code_label")} data-request-id-label={t("dashboard.order_detail.action.request_id_label")}>
          <div class="panel-heading"><div><p class="eyebrow">{t("dashboard.order_detail.exceptions.eyebrow")}</p><h2 id="payment-exceptions-title">{t("dashboard.order_detail.exceptions.title")}</h2></div><span class="record-count">{order.paymentExceptions.length}</span></div>
          <p class="privacy-copy">{t("dashboard.order_detail.exceptions.description")}</p>
          <div class="exception-list">
            {order.paymentExceptions.map((exception) => {
              const activeRequest = activeRemediationByException.get(exception.id);
              return <article class="exception-card">
                <div class="exception-heading"><strong>{paymentExceptionLabel(exception.type)}</strong><StatusBadge label={exception.status === "open" ? t("dashboard.order_detail.exceptions.status_open") : exception.status === "resolved" ? t("dashboard.order_detail.exceptions.status_resolved") : t("dashboard.order_detail.exceptions.status_ignored")} tone={exception.status === "open" ? "danger" : "neutral"} /></div>
                <dl class="exception-meta">
                  <div><dt>{t("dashboard.order_detail.exceptions.attempt")}</dt><dd><code>{exception.paymentAttemptId}</code></dd></div>
                  <div><dt>{t("dashboard.order_detail.exceptions.recorded")}</dt><dd>{formatDate(exception.createdAt)}</dd></div>
                </dl>
                {activeRequest !== undefined && <p class="remediation-state">{t("dashboard.order_detail.exceptions.review_status", { status: remediationStatusLabels[activeRequest.status] ?? activeRequest.status })} <code>{activeRequest.requestPublicId}</code></p>}
                {canManagePayments && exception.status === "open" && activeRequest === undefined && <form class="remediation-form" data-remediation-form data-exception-id={exception.id} data-currency={exception.currency} data-idempotency-key="">
                  <p>{t("dashboard.order_detail.exceptions.manual_review_description")}</p>
                  <button class="sln-button" data-variant="secondary" type="submit">{t("dashboard.order_detail.exceptions.manual_review")}</button>
                  <p class="workspace-feedback" data-remediation-feedback hidden aria-live="polite"></p>
                </form>}
              </article>;
            })}
          </div>
          {openPaymentExceptions.length === 0 && <p class="privacy-copy">{t("dashboard.order_detail.exceptions.no_open")}</p>}
        </section>}

        {canManageFulfillment && manualItems.length > 0 && <section class="side-panel" aria-labelledby="manual-action-title" data-manual-fulfillment data-shop-public-id={shop.publicId} data-order-public-id={order.orderId} data-csrf-cookie-name={`${env.SESSION_COOKIE_NAME}_csrf`} data-submitting={t("dashboard.order_detail.manual.submitting")} data-failed={t("dashboard.order_detail.manual.failed")} data-error-code-label={t("dashboard.order_detail.action.error_code_label")} data-request-id-label={t("dashboard.order_detail.action.request_id_label")} data-completed={t("dashboard.order_detail.manual.completed")} data-idempotency-key="">
          <div class="panel-heading"><div><p class="eyebrow">{t("dashboard.order_detail.manual.eyebrow")}</p><h2 id="manual-action-title">{t("dashboard.order_detail.manual.title")}</h2></div></div>
          <p class="privacy-copy">{order.paymentStatus === "paid" ? t("dashboard.order_detail.manual.ready") : t("dashboard.order_detail.manual.payment_required")}</p>
          <form class="manual-form" data-manual-form>
            <label>{t("dashboard.order_detail.manual.item")}<select name="orderItemId" required>{manualItems.map((item) => <option value={item.id}>{item.productTitle} · {item.variantTitle}</option>)}</select></label>
            <label>{t("dashboard.order_detail.manual.reference")}<input name="reference" maxlength="512" required /></label>
            <button class="sln-button" data-variant="primary" type="submit" disabled={order.paymentStatus !== "paid"}>{t("dashboard.order_detail.manual.complete")}</button>
          </form>
          <p class="workspace-feedback" data-manual-feedback hidden aria-live="polite"></p>
        </section>}

        <section class="side-panel" aria-labelledby="audit-title">
          <div class="panel-heading"><div><p class="eyebrow">{t("dashboard.order_detail.audit.eyebrow")}</p><h2 id="audit-title">{t("dashboard.order_detail.audit.title")}</h2></div><span class="record-count">{t("dashboard.order_detail.audit.count", { count: order.audit.length })}</span></div>
          {order.audit.length === 0 ? <WorkspaceState title={t("dashboard.order_detail.audit.empty_title")} description={t("dashboard.order_detail.audit.empty_description")} tone="info" /> : <ol class="audit-list">
            {order.audit.map((entry) => <li><span class="audit-dot" aria-hidden="true"></span><div><strong>{entry.action}</strong><small>{formatDate(entry.createdAt)}</small></div></li>)}
          </ol>}
        </section>
      </aside>
    </div>
  </>}
</AppLayout>

<script>
  type ActionResponse = { code?: string; requestId?: string };

  const csrfToken = (root: HTMLElement): string | null => {
    const cookieName = root.dataset.csrfCookieName ?? "";
    const rawCookie = document.cookie.split(";").map((part) => part.trim()).find((part) => part.startsWith(`${cookieName}=`))?.slice(cookieName.length + 1);
    return rawCookie === undefined ? null : decodeURIComponent(rawCookie);
  };
  const actionError = (root: HTMLElement, body: ActionResponse): string => {
    const parts = [root.dataset.failed ?? ""];
    if (body.code !== undefined) parts.push(`${root.dataset.errorCodeLabel ?? "Error"}: ${body.code}`);
    if (body.requestId !== undefined) parts.push(`${root.dataset.requestIdLabel ?? "Request ID"}: ${body.requestId}`);
    return parts.filter(Boolean).join(" ");
  };
  const readActionResponse = async (response: Response): Promise<ActionResponse> => {
    try {
      return await response.json() as ActionResponse;
    } catch {
      const requestId = response.headers.get("X-Request-Id");
      return requestId === null ? { code: "invalid_response" } : { code: "invalid_response", requestId };
    }
  };

  const manualRoot = document.querySelector<HTMLElement>("[data-manual-fulfillment]");
  const manualForm = manualRoot?.querySelector<HTMLFormElement>("[data-manual-form]");
  const manualFeedback = manualRoot?.querySelector<HTMLElement>("[data-manual-feedback]");
  manualForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (manualRoot === null || manualFeedback === null || manualFeedback === undefined || !manualForm.reportValidity()) return;
    const values = new FormData(manualForm);
    const csrf = csrfToken(manualRoot);
    const idempotencyKey = manualRoot.dataset.idempotencyKey || `manual-ui-${crypto.randomUUID()}`;
    manualRoot.dataset.idempotencyKey = idempotencyKey;
    manualFeedback.hidden = false;
    manualFeedback.textContent = manualRoot.dataset.submitting ?? "";
    try {
      if (csrf === null) throw new Error(actionError(manualRoot, { code: "csrf_missing" }));
      const response = await fetch(`/api/app/shops/${encodeURIComponent(manualRoot.dataset.shopPublicId ?? "")}/orders/${encodeURIComponent(manualRoot.dataset.orderPublicId ?? "")}/manual-fulfillments`, {
        body: JSON.stringify({ executionType: "seller_attested_delivery", externalReference: { reference: values.get("reference"), type: "merchant_reference" }, orderItemId: values.get("orderItemId") }),
        credentials: "same-origin",
        headers: { "Content-Type": "application/json", "Idempotency-Key": idempotencyKey, "X-CSRF-Token": csrf },
        method: "POST",
      });
      const body = await readActionResponse(response);
      if (!response.ok) throw new Error(actionError(manualRoot, body));
      // In-place update: no full-page reload. The form is locked and the
      // affected item row reflects the recorded fulfillment until the
      // seller navigates away or reloads manually.
      manualFeedback.textContent = manualRoot.dataset.completed ?? "";
      for (const control of Array.from(manualForm.elements)) {
        if (control instanceof HTMLButtonElement || control instanceof HTMLInputElement || control instanceof HTMLSelectElement) control.disabled = true;
      }
      const selectedItemId = values.get("orderItemId");
      if (typeof selectedItemId === "string" && selectedItemId !== "") {
        const itemRow = document.querySelector(`[data-order-item-id="${CSS.escape(selectedItemId)}"]`);
        const note = itemRow?.querySelector(".manual-fulfillment-state small");
        if (note !== null && note !== undefined) note.textContent = manualRoot.dataset.completed ?? "";
      }
    } catch (error) {
      manualFeedback.textContent = error instanceof Error && error.message.startsWith(manualRoot.dataset.failed ?? "")
        ? error.message
        : manualRoot.dataset.failed ?? "";
    }
  });

  const remediationRoot = document.querySelector<HTMLElement>("[data-payment-remediation]");
  remediationRoot?.querySelectorAll<HTMLFormElement>("[data-remediation-form]").forEach((form) => {
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (remediationRoot === null) return;
      const feedback = form.querySelector<HTMLElement>("[data-remediation-feedback]");
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (feedback === null || submit === null) return;
      const csrf = csrfToken(remediationRoot);
      const idempotencyKey = form.dataset.idempotencyKey || `remediation-ui-${crypto.randomUUID()}`;
      form.dataset.idempotencyKey = idempotencyKey;
      feedback.hidden = false;
      feedback.textContent = remediationRoot.dataset.submitting ?? "";
      submit.disabled = true;
      try {
        if (csrf === null) throw new Error(actionError(remediationRoot, { code: "csrf_missing" }));
        const response = await fetch(`/api/app/shops/${encodeURIComponent(remediationRoot.dataset.shopPublicId ?? "")}/payments/remediation`, {
          body: JSON.stringify({ amountMinor: 0, currency: form.dataset.currency, exceptionPublicId: form.dataset.exceptionId, kind: "manual_review", reasonCode: "seller_requested" }),
          credentials: "same-origin",
          headers: { "Content-Type": "application/json", "Idempotency-Key": idempotencyKey, "X-CSRF-Token": csrf },
          method: "POST",
        });
        const body = await readActionResponse(response);
        if (!response.ok) throw new Error(actionError(remediationRoot, body));
        const requestId = body.requestId === undefined ? "" : ` ${remediationRoot.dataset.requestIdLabel ?? "Request ID"}: ${body.requestId}`;
        feedback.textContent = `${remediationRoot.dataset.requested ?? ""}${requestId}`;
      } catch (error) {
        feedback.textContent = error instanceof Error && error.message.startsWith(remediationRoot.dataset.failed ?? "")
          ? error.message
          : remediationRoot.dataset.failed ?? "";
        submit.disabled = false;
      }
    });
  });
</script>


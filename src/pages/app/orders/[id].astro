<script>
  const dispatchPanel = document.querySelector<HTMLElement>("[data-dispatch-panel]");

  if (dispatchPanel !== null) {
    const shopPublicId = dispatchPanel.dataset.shopPublicId ?? "";
    const orderPublicId = dispatchPanel.dataset.orderPublicId ?? "";
    const canManage = dispatchPanel.dataset.canManage === "true";
    const csrfCookieName = dispatchPanel.dataset.csrfCookieName ?? "";
    const copy = (() => {
      try {
        const parsed: unknown = JSON.parse(dispatchPanel.dataset.copy ?? "{}");
        return typeof parsed === "object" && parsed !== null ? parsed as Record<string, string> : {};
      } catch {
        return {};
      }
    })();
    const text = (key: string): string => copy[key] ?? "";
    const feedback = dispatchPanel.querySelector<HTMLElement>("[data-dispatch-feedback]");
    const carrierInput = dispatchPanel.querySelector<HTMLInputElement>("[data-dispatch-carrier]");
    const trackingInput = dispatchPanel.querySelector<HTMLInputElement>("[data-dispatch-tracking]");
    const buttons = [...dispatchPanel.querySelectorAll<HTMLButtonElement>("[data-dispatch-state]")];

    const readCookie = (name: string): string | null =>
      document.cookie.split(";").map((part) => part.trim()).find((part) => part.startsWith(`${name}=`))?.slice(name.length + 1) ?? null;

    const advance = async (shippingState: string): Promise<void> => {
      if (!canManage) return;
      const carrier = carrierInput?.value.trim() ?? "";
      const trackingCode = trackingInput?.value.trim() ?? "";
      if (shippingState === "shipped" && carrier === "") {
        if (feedback !== null) feedback.textContent = text("error");
        return;
      }
      buttons.forEach((button) => { button.disabled = true; });
      try {
        const csrf = readCookie(csrfCookieName);
        const response = await fetch(`/api/app/shops/${shopPublicId}/orders/${orderPublicId}/shipping`, {
          body: JSON.stringify({ ...(carrier === "" ? {} : { carrier }), ...(trackingCode === "" ? {} : { trackingCode }), shippingState }),
          credentials: "same-origin",
          headers: { "Content-Type": "application/json", ...(csrf === null ? {} : { "X-CSRF-Token": decodeURIComponent(csrf) }) },
          method: "POST",
        });
        if (!response.ok) throw new Error("dispatch_failed");
        window.location.reload();
      } catch {
        if (feedback !== null) feedback.textContent = text("error");
        buttons.forEach((button) => { button.disabled = false; });
      }
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => { void advance(button.dataset.shippingState ?? ""); });
    });
  }
</script>

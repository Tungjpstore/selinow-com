---
import AppLayout from "../../layouts/AppLayout.astro";
import FulfillmentState from "../../components/commerce/FulfillmentState.astro";
import Money from "../../components/commerce/Money.astro";
import PaymentState from "../../components/commerce/PaymentState.astro";
import StatusBadge from "../../components/primitives/StatusBadge.astro";
import LaunchChecklist from "../../components/workspace/LaunchChecklist.astro";
import WorkspaceState from "../../components/states/WorkspaceState.astro";
import PageHeader from "../../components/workspace/PageHeader.astro";
import { authenticateRequest } from "../../lib/auth/session";
import { listSellerCatalog } from "../../lib/catalog/store";
import { listSellerOrders, type SellerOrderSummary } from "../../lib/commerce/seller-orders";
import { isAppError } from "../../lib/core/errors";
import { getBindings } from "../../lib/platform/bindings";
import { deriveSellerSellability, hasCompleteActionAuthority } from "../../lib/dashboard/overview-ui";
import { withSelectedShop } from "../../lib/dashboard/shop-navigation";
import { createDashboardTranslator } from "../../lib/i18n";
import { getShopReadiness, type ReadinessCheck, type ReadinessResult } from "../../lib/tenants/readiness";
import { listShopsForMember, selectShopForMember, type ShopView } from "../../lib/tenants/store";

type LoadState = "forbidden" | "ready" | "unavailable";
type LoadResult<T> = { state: LoadState; value: T };
type Tone = "danger" | "info" | "neutral" | "success" | "warning";
type CatalogRecord = Record<string, unknown>;
type HealthItem = {
  actionLabel: string;
  actionUrl: string;
  evidence: string;
  label: string;
  state: string;
  tone: Tone;
};
type ActionItem = {
  actionLabel: string;
  actionUrl: string;
  count?: number;
  evidence: string;
  impact: string;
  severity: "blocked" | "warning";
  title: string;
};

const env = getBindings();
const auth = await authenticateRequest(Astro.request, env).catch(() => null);
if (auth === null) return Astro.redirect("/login");
const locale = Astro.locals.locale;
const t = createDashboardTranslator(locale);

async function loadTenantData<T>(operation: () => Promise<T>, fallback: T): Promise<LoadResult<T>> {
  try {
    return { state: "ready", value: await operation() };
  } catch (error) {
    return {
      state: isAppError(error) && error.status === 403 ? "forbidden" : "unavailable",
      value: fallback,
    };
  }
}

const workspaceLoad: LoadResult<ShopView[]> = await listShopsForMember({ env, userId: auth.userId })
  .then((value) => ({ state: "ready" as const, value }))
  .catch(() => ({ state: "unavailable" as const, value: [] }));
const shops = workspaceLoad.value;
const workspaceState = workspaceLoad.state;

const shop = selectShopForMember(shops, Astro.url.searchParams.get("shop"));
const workspaceHref = (href: string): string => withSelectedShop(href, shop?.publicId, Astro.url.origin);
const emptyCatalog = (): { products: CatalogRecord[]; variants: CatalogRecord[] } => ({ products: [], variants: [] });
const canReadCatalog = shop !== undefined && new Set(["owner", "manager"]).has(shop.role);
const noOrders: LoadResult<SellerOrderSummary[]> = { state: "ready", value: [] };
const noReadiness: LoadResult<ReadinessResult | null> = { state: "forbidden", value: null };
const noCatalog: LoadResult<{ products: CatalogRecord[]; variants: CatalogRecord[] }> = {
  state: canReadCatalog ? "ready" : "forbidden",
  value: emptyCatalog(),
};

const [ordersLoad, readinessLoad, catalogLoad] = shop !== undefined && workspaceState === "ready"
  ? await Promise.all([
      loadTenantData(
        () => listSellerOrders({ env, shopPublicId: shop.publicId, userId: auth.userId }),
        [],
      ),
      shop.role === "owner"
        ? loadTenantData(
            () => getShopReadiness({ env, shopPublicId: shop.publicId, userId: auth.userId }),
            null,
          )
        : Promise.resolve(noReadiness),
      canReadCatalog
        ? loadTenantData(
            async () => {
              const value = await listSellerCatalog({ env, shopPublicId: shop.publicId, userId: auth.userId });
              return {
                products: value.products as CatalogRecord[],
                variants: value.variants as CatalogRecord[],
              };
            },
            emptyCatalog(),
          )
        : Promise.resolve(noCatalog),
    ])
  : [noOrders, noReadiness, noCatalog];

const orders = ordersLoad.value;
const ordersState = ordersLoad.state;
const readiness = readinessLoad.value;
const readinessState = readinessLoad.state;
const catalog = catalogLoad.value;
const catalogState = catalogLoad.state;

const displayName = auth.displayName.trim() || t("dashboard.commerce.you");
const storefrontUrl = shop === undefined ? null : `https://${shop.slug}.${env.PLATFORM_BASE_DOMAIN}`;
const sellability = deriveSellerSellability({
  readinessReady: readiness?.ready === true,
  readinessState,
  shopStatus: shop?.status ?? "draft",
});
const sellabilityCopy = {
  blocked: { summary: t("dashboard.overview.sellability.blocked.summary"), title: t("dashboard.overview.sellability.blocked.title") },
  draft: { summary: t("dashboard.overview.sellability.draft.summary"), title: t("dashboard.overview.sellability.draft.title") },
  owner_only: { summary: t("dashboard.overview.sellability.owner_only.summary"), title: t("dashboard.overview.sellability.owner_only.title") },
  ready: { summary: t("dashboard.overview.sellability.ready.summary"), title: t("dashboard.overview.sellability.ready.title") },
  suspended: { summary: t("dashboard.overview.sellability.suspended.summary"), title: t("dashboard.overview.sellability.suspended.title") },
  unavailable: { summary: t("dashboard.overview.sellability.unavailable.summary"), title: t("dashboard.overview.sellability.unavailable.title") },
} as const;
const shopTone: Tone = sellability === "ready"
  ? "success"
  : sellability === "blocked" || sellability === "suspended"
    ? "danger"
    : sellability === "unavailable" || sellability === "owner_only"
      ? "neutral"
      : "warning";
const shopStatus = sellabilityCopy[sellability].title;
const shopSummary = sellabilityCopy[sellability].summary;
const sellabilityActionLabel = sellability === "unavailable"
  ? t("dashboard.overview.workspace_unavailable.action")
  : t("dashboard.overview.action.finish_publish");

const dateFormatter = new Intl.DateTimeFormat(typeof locale === "string" ? locale : "en", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: shop?.timezone ?? "Asia/Ho_Chi_Minh",
});
const dayFormatter = new Intl.DateTimeFormat(typeof locale === "string" ? locale : "en", {
  dateStyle: "full",
  timeZone: shop?.timezone ?? "Asia/Ho_Chi_Minh",
});
const formatDate = (value: string): string => dateFormatter.format(new Date(value));
const todayLabel = dayFormatter.format(new Date());
const readinessEvidence = readiness === null
  ? t("dashboard.overview.readiness.none")
  : t("dashboard.overview.readiness.checked", { time: formatDate(readiness.checkedAt) });
const readinessChecks = new Map<string, ReadinessCheck>(
  (readiness?.checks ?? []).map((check) => [check.code, check]),
);
const toneForCheck = (check: ReadinessCheck | undefined): Tone => check?.status === "pass"
  ? "success"
  : check?.status === "warning"
    ? "warning"
    : check?.status === "fail"
      ? "danger"
      : "neutral";

function healthFromCheck(input: {
  actionLabel: string;
  code: string;
  label: string;
  passLabel: string;
  skippedLabel?: string;
}): HealthItem {
  const check = readinessChecks.get(input.code);
  const skipped = check?.messageKey.endsWith(".skipped") ?? false;
  return {
    actionLabel: input.actionLabel,
    actionUrl: workspaceHref(check?.actionUrl ?? "/onboarding#readiness"),
    evidence: readinessEvidence,
    label: input.label,
    state: check === undefined
      ? readinessState === "forbidden" ? t("dashboard.overview.health.owner_only") : t("dashboard.overview.health.no_data")
      : skipped ? input.skippedLabel ?? t("dashboard.overview.health.state.unverified")
        : check.status === "pass" ? input.passLabel
          : check.status === "warning" ? t("dashboard.overview.health.state.attention") : t("dashboard.overview.health.state.setup_required"),
    tone: skipped ? "neutral" : toneForCheck(check),
  };
}

const platformDomainCheck = readinessChecks.get("platform_domain_ready");
const customDomainCheck = readinessChecks.get("custom_domain_ready");
const domainCheck = platformDomainCheck?.status === "fail" ? platformDomainCheck : customDomainCheck;
const healthItems: HealthItem[] = [
  healthFromCheck({ actionLabel: t("dashboard.overview.action.open_settings"), code: "storefront_ready", label: t("dashboard.overview.health.website"), passLabel: t("dashboard.overview.health.state.stable"), skippedLabel: t("dashboard.overview.health.state.unverified") }),
  healthFromCheck({ actionLabel: t("dashboard.overview.health.action.telegram"), code: "telegram_ready", label: t("dashboard.overview.health.telegram"), passLabel: t("dashboard.overview.health.state.stable"), skippedLabel: t("dashboard.overview.health.state.unverified") }),
  healthFromCheck({ actionLabel: t("dashboard.overview.health.action.payos"), code: "payos_ready", label: t("dashboard.overview.health.payos"), passLabel: t("dashboard.overview.health.state.verified") }),
  healthFromCheck({ actionLabel: t("dashboard.overview.action.open_inventory"), code: "fulfillment_ready", label: t("dashboard.overview.health.fulfillment"), passLabel: t("dashboard.overview.health.state.delivery_ready") }),
  {
    actionLabel: t("dashboard.overview.health.action.domain"),
    actionUrl: workspaceHref(domainCheck?.actionUrl ?? "/app/domains"),
    evidence: readinessEvidence,
    label: t("dashboard.overview.health.domain"),
    state: domainCheck === undefined
      ? readinessState === "forbidden" ? t("dashboard.overview.health.owner_only") : t("dashboard.overview.health.no_data")
      : domainCheck.status === "pass" ? t("dashboard.overview.health.state.active")
        : domainCheck.status === "warning" ? t("dashboard.overview.health.domain_custom_not_ready") : t("dashboard.overview.health.domain_platform_not_ready"),
    tone: toneForCheck(domainCheck),
  },
  {
    actionLabel: t("dashboard.overview.action.view_readiness"),
    actionUrl: workspaceHref(readinessChecks.get("subscription_publishable")?.actionUrl ?? "/onboarding#readiness"),
    evidence: shop === undefined ? t("dashboard.overview.readiness.none") : t("dashboard.overview.health.subscription_evidence", { status: shop.subscriptionState }),
    label: t("dashboard.overview.health.subscription"),
    state: shop?.subscriptionState === "active" ? t("dashboard.overview.health.state.active")
      : shop?.subscriptionState === "trialing" ? t("dashboard.overview.health.state.trialing")
        : shop?.subscriptionState === "past_due" ? t("dashboard.overview.health.state.unpaid")
          : shop === undefined ? t("dashboard.overview.health.no_data") : t("dashboard.overview.health.state.restricted"),
    tone: shop?.subscriptionState === "active" || shop?.subscriptionState === "trialing"
      ? "success" : shop?.subscriptionState === "past_due" ? "warning" : "danger",
  },
];

const readinessCopy: Record<string, { impact: string; title: string }> = Object.fromEntries([
  "shop_state_publishable", "subscription_publishable", "channel_selected", "channel_entitlements", "platform_domain_ready",
  "catalog_ready", "fulfillment_ready", "payos_ready", "telegram_ready", "storefront_ready", "policies_ready",
  "integration_health", "custom_domain_ready",
].map((code) => [code, {
  impact: t(`dashboard.overview.readiness_check.${code}.impact`),
  title: t(`dashboard.overview.readiness_check.${code}.title`),
}])) as Record<string, { impact: string; title: string }>;

const actionItems: ActionItem[] = (readiness?.checks ?? [])
  .filter((check) => check.status !== "pass")
  .map((check) => ({
    actionLabel: t("dashboard.overview.readiness_action.open"),
    actionUrl: workspaceHref(check.actionUrl ?? "/onboarding#readiness"),
    evidence: t("dashboard.overview.readiness_action.recorded", { time: formatDate(check.checkedAt) }),
    impact: readinessCopy[check.code]?.impact ?? t("dashboard.overview.readiness_action.default_impact"),
    severity: check.status === "fail" ? "blocked" : "warning",
    title: readinessCopy[check.code]?.title ?? check.code,
  }));

const paymentExceptions = new Set(["partial", "overpaid", "failed"]);
const fulfillmentExceptions = new Set(["failed", "manual_review"]);
const paymentExceptionOrders = orders.filter((order) => paymentExceptions.has(order.paymentStatus));
const fulfillmentExceptionOrders = orders.filter((order) => fulfillmentExceptions.has(order.fulfillmentStatus));
if (ordersState === "ready" && paymentExceptionOrders.length > 0) {
  const latestPaymentException = paymentExceptionOrders[0];
  if (latestPaymentException === undefined) throw new Error("Payment exception collection became empty");
  actionItems.push({
    actionLabel: t("dashboard.overview.action.open_order_ledger"),
    actionUrl: workspaceHref("/app/orders"),
    count: paymentExceptionOrders.length,
    evidence: t("dashboard.overview.exception.payment.evidence", { time: formatDate(latestPaymentException.updatedAt) }),
    impact: t("dashboard.overview.exception.payment.impact"),
    severity: "blocked",
    title: t("dashboard.overview.exception.payment.title"),
  });
}
if (ordersState === "ready" && fulfillmentExceptionOrders.length > 0) {
  const latestFulfillmentException = fulfillmentExceptionOrders[0];
  if (latestFulfillmentException === undefined) throw new Error("Fulfillment exception collection became empty");
  actionItems.push({
    actionLabel: t("dashboard.overview.action.open_order_ledger"),
    actionUrl: workspaceHref("/app/orders"),
    count: fulfillmentExceptionOrders.length,
    evidence: t("dashboard.overview.exception.fulfillment.evidence", { time: formatDate(latestFulfillmentException.updatedAt) }),
    impact: t("dashboard.overview.exception.fulfillment.impact"),
    severity: "blocked",
    title: t("dashboard.overview.exception.fulfillment.title"),
  });
}

const activeProducts = new Map(
  catalog.products
    .filter((product) => product.status === "active")
    .map((product) => [String(product.id), product]),
);
const stockoutVariants = catalog.variants.filter((variant) => {
  const product = activeProducts.get(String(variant.productId));
  return variant.status === "active"
    && product?.fulfillmentType === "license_key"
    && Number(variant.availableStock ?? 0) <= 0;
});
if (catalogState === "ready" && stockoutVariants.length > 0) {
  actionItems.push({
    actionLabel: t("dashboard.overview.action.open_inventory"),
    actionUrl: workspaceHref("/app/inventory"),
    count: stockoutVariants.length,
    evidence: t("dashboard.overview.stockout.count_only"),
    impact: t("dashboard.overview.stockout.impact"),
    severity: "warning",
    title: t("dashboard.overview.stockout.title"),
  });
}

const paidOrders = orders.filter((order) => order.paymentStatus === "paid");
const fulfilledOrders = paidOrders.filter((order) => order.fulfillmentStatus === "fulfilled");
const verifiedValue = paidOrders.reduce((sum, order) => sum + order.totalMinor, 0);
const percentFormatter = new Intl.NumberFormat(typeof locale === "string" ? locale : "en", { maximumFractionDigits: 1, style: "percent" });
const paymentRate = orders.length === 0 ? null : paidOrders.length / orders.length;
const fulfillmentRate = paidOrders.length === 0 ? null : fulfilledOrders.length / paidOrders.length;
const recentOrders = orders.slice(0, 6);
const completeActionAuthority = hasCompleteActionAuthority({
  catalogRequired: canReadCatalog,
  catalogState,
  ordersState,
  readinessState,
});
const channelRows = Array.from(orders.reduce((channels, order) => {
  const current = channels.get(order.sourceChannel) ?? { count: 0, fulfilled: 0, paidValue: 0 };
  current.count += 1;
  if (order.paymentStatus === "paid") current.paidValue += order.totalMinor;
  if (order.paymentStatus === "paid" && order.fulfillmentStatus === "fulfilled") current.fulfilled += 1;
  channels.set(order.sourceChannel, current);
  return channels;
}, new Map<string, { count: number; fulfilled: number; paidValue: number }>()).entries());
const channelLabel = (value: string): string => value === "telegram" ? "Telegram" : value === "web" ? "Website" : value;

const payosCheck = readinessChecks.get("payos_ready");
const telegramCheck = readinessChecks.get("telegram_ready");
const hasProducts = catalog.products.length > 0;
const hasInventory = hasProducts && stockoutVariants.length === 0;
const payosReady = payosCheck?.status === "pass";
const telegramReady = telegramCheck?.status === "pass";

const launchChecklistItems = shop === undefined ? [] : [
  {
    actionLabel: "Cấu hình",
    actionUrl: workspaceHref("/onboarding"),
    completed: true,
    description: "Định danh và khởi tạo cửa hàng số",
    id: "shop_created",
    title: "Tạo cửa hàng",
  },
  {
    actionLabel: "Thêm sản phẩm",
    actionUrl: workspaceHref("/app/products"),
    completed: hasProducts,
    description: "Tạo ít nhất 1 sản phẩm kỹ thuật số để bày bán",
    id: "catalog_product",
    title: "Thêm sản phẩm đầu tiên",
  },
  {
    actionLabel: "Nhập kho",
    actionUrl: workspaceHref("/app/inventory"),
    completed: hasInventory,
    description: "Nhập mã thẻ / license key sẵn sàng giao tự động",
    id: "inventory_stock",
    title: "Nhập kho sản phẩm",
  },
  {
    actionLabel: "Kết nối PayOS",
    actionUrl: workspaceHref("/app/integrations"),
    completed: payosReady,
    description: "Kết nối tài khoản VietQR để nhận tiền tự động",
    id: "payos_payment",
    title: "Cổng thanh toán PayOS",
  },
  {
    actionLabel: "Kết nối Bot",
    actionUrl: workspaceHref("/app/telegram"),
    completed: telegramReady,
    description: "Thiết lập Bot Telegram trả key tự động cho khách",
    id: "telegram_bot",
    title: "Bot Telegram",
  },
];
const checklistCompleted = launchChecklistItems.filter((i) => i.completed).length;
const checklistPercent = launchChecklistItems.length === 0 ? 100 : Math.round((checklistCompleted / launchChecklistItems.length) * 100);
---

<AppLayout activePath="/app" displayName={displayName} email={auth.email} selectedShopName={shop?.name} selectedShopPublicId={shop?.publicId} shops={shops} title={t("dashboard.overview.title")}>
  <PageHeader
    eyebrow={t("dashboard.overview.eyebrow")}
    title={shop?.name ?? t("dashboard.overview.workspace_title")}
    description={shop === undefined ? t("dashboard.overview.description.no_store") : t("dashboard.overview.description.shop", { today: todayLabel })}
    descriptionId={shop === undefined ? undefined : "dashboard-overview-date"}
  >
    {shop !== undefined && <a slot="actions" class="sln-button sln-button-secondary" href={workspaceHref("/onboarding")}>{t("dashboard.overview.action.view_readiness")}</a>}
    {sellability === "ready" && storefrontUrl !== null && <a slot="actions" class="sln-button sln-button-primary" href={storefrontUrl}>{t("dashboard.overview.action.open_storefront")} <span aria-hidden="true">↗</span></a>}
  </PageHeader>

  {shop !== undefined && (
    <LaunchChecklist
      items={launchChecklistItems}
      percent={checklistPercent}
      shopName={shop.name}
    />
  )}

  {workspaceState === "unavailable" ? (
    <div class="state-space">
      <WorkspaceState eyebrow={t("dashboard.overview.workspace_unavailable.eyebrow")} title={t("dashboard.overview.workspace_unavailable.title")} description={t("dashboard.overview.workspace_unavailable.description")} actionHref={workspaceHref("/app")} actionLabel={t("dashboard.overview.workspace_unavailable.action")} tone="danger" />
    </div>
  ) : shop === undefined ? (
    <div class="state-space">
      <WorkspaceState eyebrow={t("dashboard.overview.no_shop.eyebrow")} title={t("dashboard.overview.no_shop.title")} description={t("dashboard.overview.no_shop.description")} actionHref={workspaceHref("/onboarding")} actionLabel={t("dashboard.overview.no_shop.action")} tone="info" />
    </div>
  ) : (
    <>
      <section class="store-status" data-tone={shopTone} aria-labelledby="store-status-title">
        <div class="status-signal" aria-hidden="true"><span></span></div>
        <div>
          <p>{t("dashboard.overview.sellability.eyebrow")}</p>
          <h2 id="store-status-title">{shopStatus}</h2>
          <span>{shopSummary}</span>
        </div>
        <div class="store-address">
          <span>{t("dashboard.overview.platform_address")}</span>
          <code>{shop.slug}.{env.PLATFORM_BASE_DOMAIN}</code>
          {sellability === "ready" ? <a href={storefrontUrl}>{t("dashboard.overview.action.open_address")} <span aria-hidden="true">↗</span></a>
            : sellability === "owner_only" ? <small>{t("dashboard.overview.sellability.owner_only.action")}</small>
              : <a href={workspaceHref(sellability === "unavailable" ? "/app" : "/onboarding#readiness")}>{sellabilityActionLabel} <span aria-hidden="true">→</span></a>}
        </div>
      </section>

      <section class="overview-section" aria-labelledby="health-title">
        <div class="section-heading">
          <div><p>{t("dashboard.overview.health.eyebrow")}</p><h2 id="health-title">{t("dashboard.overview.health.title")}</h2></div>
          {readiness !== null && <StatusBadge label={readiness.ready ? t("dashboard.overview.health.ready") : t("dashboard.overview.health.not_ready")} tone={readiness.ready ? "success" : "warning"} />}
        </div>

        {readinessState === "unavailable" ? (
          <WorkspaceState eyebrow={t("dashboard.overview.health.unavailable.eyebrow")} title={t("dashboard.overview.health.unavailable.title")} description={t("dashboard.overview.health.unavailable.description")} actionHref={workspaceHref("/onboarding#readiness")} actionLabel={t("dashboard.overview.health.unavailable.action")} tone="warning" />
        ) : (
          <div class="health-rail">
            {healthItems.map((item) => (
              <article>
                <div class="health-name"><span aria-hidden="true" data-tone={item.tone}></span><strong>{item.label}</strong></div>
                <StatusBadge label={item.state} tone={item.tone} />
                <small data-visual-dynamic>{item.evidence}</small>
                <a href={item.actionUrl}>{item.actionLabel} <span aria-hidden="true">→</span></a>
              </article>
            ))}
          </div>
        )}

        {readinessState === "forbidden" && (
          <p class="permission-note">{t("dashboard.overview.health.permission_note", { role: shop.role })}</p>
        )}
      </section>

      <section class="overview-section" aria-labelledby="actions-title">
        <div class="section-heading">
          <div><p>{t("dashboard.overview.actions.eyebrow")}</p><h2 id="actions-title">{t("dashboard.overview.actions.title")}</h2></div>
          <span class="section-count">{t("dashboard.overview.actions.count", { count: actionItems.length })}</span>
        </div>

        {actionItems.length === 0 && completeActionAuthority ? (
          <div class="queue-clear">
            <span aria-hidden="true">✓</span>
            <div><strong>{t("dashboard.overview.actions.empty_title")}</strong><p>{t("dashboard.overview.actions.empty_description")}</p></div>
          </div>
        ) : actionItems.length === 0 ? (
          <div class="queue-clear queue-partial">
            <span aria-hidden="true">i</span>
            <div><strong>{t("dashboard.overview.actions.partial_title")}</strong><p>{t("dashboard.overview.actions.partial_description")}</p></div>
          </div>
        ) : (
          <div class="action-queue">
            {actionItems.map((item) => (
              <article data-severity={item.severity}>
                <span class="severity-mark" aria-hidden="true">{item.severity === "blocked" ? "!" : "·"}</span>
                <div><strong>{item.title}</strong><p>{item.impact}</p></div>
                <small data-visual-dynamic>{item.evidence}</small>
                {item.count !== undefined && <span class="queue-count" aria-label={t("dashboard.overview.actions.record_count_aria", { count: item.count })}>{item.count}</span>}
                <a href={item.actionUrl}>{item.actionLabel} <span aria-hidden="true">→</span></a>
              </article>
            ))}
          </div>
        )}
      </section>

      <div class="operations-grid">
        <section class="overview-section activity-section" aria-labelledby="activity-title">
          <div class="section-heading">
            <div><p>{t("dashboard.overview.activity.eyebrow")}</p><h2 id="activity-title">{t("dashboard.overview.activity.title")}</h2></div>
            {ordersState === "ready" && <a href={workspaceHref("/app/orders")}>{t("dashboard.overview.action.view_all_orders")} <span aria-hidden="true">→</span></a>}
          </div>

          {ordersState === "unavailable" ? (
            <WorkspaceState eyebrow={t("dashboard.overview.activity.unavailable.eyebrow")} title={t("dashboard.overview.activity.unavailable.title")} description={t("dashboard.overview.activity.unavailable.description")} actionHref={workspaceHref("/app/orders")} actionLabel={t("dashboard.overview.action.open_order_ledger")} tone="warning" />
          ) : ordersState === "forbidden" ? (
            <WorkspaceState eyebrow={t("dashboard.overview.activity.forbidden.eyebrow")} title={t("dashboard.overview.activity.forbidden.title")} description={t("dashboard.overview.activity.forbidden.description")} tone="warning" />
          ) : recentOrders.length === 0 ? (
            <div class="ledger-empty"><strong>{t("dashboard.overview.activity.empty_title")}</strong><p>{t("dashboard.overview.activity.empty_description")}</p><a href={workspaceHref("/app/products")}>{t("dashboard.overview.action.open_catalog")} <span aria-hidden="true">→</span></a></div>
          ) : (
            <ol class="activity-ledger">
              {recentOrders.map((order) => (
                <li>
                  <time datetime={order.createdAt} data-visual-dynamic>{formatDate(order.createdAt)}</time>
                  <div><strong>{t("dashboard.overview.activity.order", { number: order.orderNumber })}</strong><span>{channelLabel(order.sourceChannel)} · {t("dashboard.overview.activity.item_count", { count: order.itemCount })}</span></div>
                  <PaymentState locale={locale ?? shop.defaultLocale} value={order.paymentStatus} />
                  <FulfillmentState locale={locale ?? shop.defaultLocale} value={order.fulfillmentStatus} />
                  <a href={workspaceHref(`/app/orders/${order.orderId}`)} aria-label={t("dashboard.overview.activity.open_detail_aria", { number: order.orderNumber })}>{t("dashboard.overview.action.view_details")} <span aria-hidden="true">→</span></a>
                </li>
              ))}
            </ol>
          )}
        </section>

        <section class="overview-section commerce-section" aria-labelledby="commerce-title">
          <div class="section-heading">
            <div><p>{t("dashboard.overview.commerce.eyebrow")}</p><h2 id="commerce-title">{t("dashboard.overview.commerce.title")}</h2></div>
          </div>

          {ordersState === "ready" ? (
            <>
              <p class="scope-note">{t("dashboard.overview.commerce.scope", { count: orders.length })}</p>
              <dl class="commerce-summary">
                <div><dt>{t("dashboard.overview.commerce.verified_value.label")}</dt><dd><span><Money value={verifiedValue} currency={shop.currency} locale={locale ?? "en"} /></span><small>{t("dashboard.overview.commerce.verified_value.caption")}</small></dd></div>
                <div><dt>{t("dashboard.overview.commerce.paid_count.label")}</dt><dd><span>{paidOrders.length}</span><small>{t("dashboard.overview.commerce.paid_count.caption", { count: orders.length })}</small></dd></div>
                <div><dt>{t("dashboard.overview.commerce.payment_rate.label")}</dt><dd><span>{paymentRate === null ? "—" : percentFormatter.format(paymentRate)}</span><small>{t("dashboard.overview.commerce.payment_rate.caption")}</small></dd></div>
                <div><dt>{t("dashboard.overview.commerce.fulfillment_rate.label")}</dt><dd><span>{fulfillmentRate === null ? "—" : percentFormatter.format(fulfillmentRate)}</span><small>{t("dashboard.overview.commerce.fulfillment_rate.caption")}</small></dd></div>
              </dl>
            </>
          ) : (
            <p class="scope-note">{t("dashboard.overview.commerce.unavailable")}</p>
          )}
        </section>
      </div>

      {ordersState === "ready" && channelRows.length > 0 && (
        <section class="overview-section" aria-labelledby="channel-title">
          <div class="section-heading">
            <div><p>{t("dashboard.overview.channels.eyebrow")}</p><h2 id="channel-title">{t("dashboard.overview.channels.title")}</h2></div>
            <span class="section-count">{t("dashboard.overview.channels.scope")}</span>
          </div>
          <div class="channel-ledger" role="table" aria-label={t("dashboard.overview.channels.aria")}>
            <div class="channel-head" role="row"><span role="columnheader">{t("dashboard.overview.channels.channel")}</span><span role="columnheader">{t("dashboard.overview.channels.count")}</span><span role="columnheader">{t("dashboard.overview.channels.delivered")}</span><span role="columnheader">{t("dashboard.overview.channels.paid_value")}</span></div>
            {channelRows.map(([channel, summary]) => (
              <div class="channel-row" role="row">
                <strong role="cell" data-channel={channel}>{channelLabel(channel)}</strong>
                <span role="cell">{summary.count}</span>
                <span role="cell">{summary.fulfilled}</span>
                <span role="cell"><Money value={summary.paidValue} currency={shop.currency} locale={locale ?? "en"} /></span>
              </div>
            ))}
          </div>
        </section>
      )}
    </>
  )}
</AppLayout>

<style>

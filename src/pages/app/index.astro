---
import AppLayout from "../../layouts/AppLayout.astro";
import ConsoleButton from "../../components/console/ConsoleButton.astro";
import Icon from "../../components/console/Icon.astro";
import MetricStrip from "../../components/console/MetricStrip.astro";
import SparklineCanvas from "../../components/console/SparklineCanvas.astro";
import StatusDot from "../../components/console/StatusDot.astro";
import Money from "../../components/commerce/Money.astro";
import PaymentState from "../../components/commerce/PaymentState.astro";
import FulfillmentState from "../../components/commerce/FulfillmentState.astro";
import { authenticateRequest } from "../../lib/auth/session";
import { listSellerCatalog } from "../../lib/catalog/store";
import { listSellerOrders, type SellerOrderSummary } from "../../lib/commerce/seller-orders";
import { isAppError } from "../../lib/core/errors";
import { getBindings } from "../../lib/platform/bindings";
import { deriveSellerSellability } from "../../lib/dashboard/overview-ui";
import { withSelectedShop } from "../../lib/dashboard/shop-navigation";
import { createDashboardTranslator } from "../../lib/i18n";
import { formatMoney } from "../../lib/i18n/currency";
import { getShopReadiness, type ReadinessResult } from "../../lib/tenants/readiness";
import { listShopsForMember, selectShopForMember, type ShopView } from "../../lib/tenants/store";

type LoadState = "forbidden" | "ready" | "unavailable";
type LoadResult<T> = { state: LoadState; value: T };
type Tone = "danger" | "info" | "neutral" | "success" | "warning";
type CatalogRecord = Record<string, unknown>;
type ActionItem = {
  actionLabel: string;
  actionUrl: string;
  count?: number;
  evidence: string;
  impact: string;
  severity: "blocked" | "warning";
  title: string;
};

const env = getBindings();
const auth = await authenticateRequest(Astro.request, env).catch(() => null);
if (auth === null) return Astro.redirect("/login");
const locale = Astro.locals.locale;
const t = createDashboardTranslator(locale);

async function loadTenantData<T>(operation: () => Promise<T>, fallback: T): Promise<LoadResult<T>> {
  try {
    return { state: "ready", value: await operation() };
  } catch (error) {
    return {
      state: isAppError(error) && error.status === 403 ? "forbidden" : "unavailable",
      value: fallback,
    };
  }
}

const workspaceLoad: LoadResult<ShopView[]> = await listShopsForMember({ env, userId: auth.userId })
  .then((value) => ({ state: "ready" as const, value }))
  .catch(() => ({ state: "unavailable" as const, value: [] }));
const shops = workspaceLoad.value;
const workspaceState = workspaceLoad.state;

const shop = selectShopForMember(shops, Astro.url.searchParams.get("shop"));
const workspaceHref = (href: string): string => withSelectedShop(href, shop?.publicId, Astro.url.origin);
const emptyCatalog = (): { products: CatalogRecord[]; variants: CatalogRecord[] } => ({ products: [], variants: [] });
const canReadCatalog = shop !== undefined && new Set(["owner", "manager"]).has(shop.role);
const noOrders: LoadResult<SellerOrderSummary[]> = { state: "ready", value: [] };
const noReadiness: LoadResult<ReadinessResult | null> = { state: "forbidden", value: null };
const noCatalog: LoadResult<{ products: CatalogRecord[]; variants: CatalogRecord[] }> = {
  state: canReadCatalog ? "ready" : "forbidden",
  value: emptyCatalog(),
};

const [ordersLoad, readinessLoad, catalogLoad] = shop !== undefined && workspaceState === "ready"
  ? await Promise.all([
      loadTenantData(
        () => listSellerOrders({ env, shopPublicId: shop.publicId, userId: auth.userId }),
        [],
      ),
      shop.role === "owner"
        ? loadTenantData(
            () => getShopReadiness({ env, shopPublicId: shop.publicId, userId: auth.userId }),
            null,
          )
        : Promise.resolve(noReadiness),
      canReadCatalog
        ? loadTenantData(
            async () => {
              const value = await listSellerCatalog({ env, shopPublicId: shop.publicId, userId: auth.userId });
              return {
                products: value.products as CatalogRecord[],
                variants: value.variants as CatalogRecord[],
              };
            },
            emptyCatalog(),
          )
        : Promise.resolve(noCatalog),
    ])
  : [noOrders, noReadiness, noCatalog];

const orders = ordersLoad.value;
const ordersState = ordersLoad.state;
const readiness = readinessLoad.value;
const readinessState = readinessLoad.state;
const catalog = catalogLoad.value;
const catalogState = catalogLoad.state;

const displayName = auth.displayName.trim() || t("dashboard.commerce.you");
const storefrontUrl = shop === undefined ? null : `https://${shop.slug}.${env.PLATFORM_BASE_DOMAIN}`;
const sellability = deriveSellerSellability({
  readinessReady: readiness?.ready === true,
  readinessState,
  shopStatus: shop?.status ?? "draft",
});
const sellabilityCopy = {
  blocked: { summary: t("dashboard.overview.sellability.blocked.summary"), title: t("dashboard.overview.sellability.blocked.title") },
  draft: { summary: t("dashboard.overview.sellability.draft.summary"), title: t("dashboard.overview.sellability.draft.title") },
  owner_only: { summary: t("dashboard.overview.sellability.owner_only.summary"), title: t("dashboard.overview.sellability.owner_only.title") },
  ready: { summary: t("dashboard.overview.sellability.ready.summary"), title: t("dashboard.overview.sellability.ready.title") },
  suspended: { summary: t("dashboard.overview.sellability.suspended.summary"), title: t("dashboard.overview.sellability.suspended.title") },
  unavailable: { summary: t("dashboard.overview.sellability.unavailable.summary"), title: t("dashboard.overview.sellability.unavailable.title") },
} as const;
const shopTone: Tone = sellability === "ready"
  ? "success"
  : sellability === "blocked" || sellability === "suspended"
    ? "danger"
    : sellability === "unavailable" || sellability === "owner_only"
      ? "neutral"
      : "warning";
const shopStatus = sellabilityCopy[sellability].title;

const dateFormatter = new Intl.DateTimeFormat(typeof locale === "string" ? locale : "en", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: shop?.timezone ?? "Asia/Ho_Chi_Minh",
});
const formatDate = (value: string): string => dateFormatter.format(new Date(value));
const readinessCopy: Record<string, { impact: string; title: string }> = Object.fromEntries([
  "shop_state_publishable", "subscription_publishable", "channel_selected", "channel_entitlements", "platform_domain_ready",
  "catalog_ready", "fulfillment_ready", "payos_ready", "telegram_ready", "storefront_ready", "policies_ready",
  "integration_health", "custom_domain_ready",
].map((code) => [code, {
  impact: t(`dashboard.overview.readiness_check.${code}.impact`),
  title: t(`dashboard.overview.readiness_check.${code}.title`),
}])) as Record<string, { impact: string; title: string }>;

const actionItems: ActionItem[] = (readiness?.checks ?? [])
  .filter((check) => check.status !== "pass")
  .map((check) => ({
    actionLabel: t("dashboard.overview.readiness_action.open"),
    actionUrl: workspaceHref(check.actionUrl ?? "/onboarding#readiness"),
    evidence: t("dashboard.overview.readiness_action.recorded", { time: formatDate(check.checkedAt) }),
    impact: readinessCopy[check.code]?.impact ?? t("dashboard.overview.readiness_action.default_impact"),
    severity: check.status === "fail" ? "blocked" : "warning",
    title: readinessCopy[check.code]?.title ?? check.code,
  }));

const paymentExceptions = new Set(["partial", "overpaid", "failed"]);
const fulfillmentExceptions = new Set(["failed", "manual_review"]);
const paymentExceptionOrders = orders.filter((order) => paymentExceptions.has(order.paymentStatus));
const fulfillmentExceptionOrders = orders.filter((order) => fulfillmentExceptions.has(order.fulfillmentStatus));
if (ordersState === "ready" && paymentExceptionOrders.length > 0) {
  const latestPaymentException = paymentExceptionOrders[0];
  if (latestPaymentException === undefined) throw new Error("Payment exception collection became empty");
  actionItems.push({
    actionLabel: t("dashboard.overview.action.open_order_ledger"),
    actionUrl: workspaceHref("/app/orders"),
    count: paymentExceptionOrders.length,
    evidence: t("dashboard.overview.exception.payment.evidence", { time: formatDate(latestPaymentException.updatedAt) }),
    impact: t("dashboard.overview.exception.payment.impact"),
    severity: "blocked",
    title: t("dashboard.overview.exception.payment.title"),
  });
}
if (ordersState === "ready" && fulfillmentExceptionOrders.length > 0) {
  const latestFulfillmentException = fulfillmentExceptionOrders[0];
  if (latestFulfillmentException === undefined) throw new Error("Fulfillment exception collection became empty");
  actionItems.push({
    actionLabel: t("dashboard.overview.action.open_order_ledger"),
    actionUrl: workspaceHref("/app/orders"),
    count: fulfillmentExceptionOrders.length,
    evidence: t("dashboard.overview.exception.fulfillment.evidence", { time: formatDate(latestFulfillmentException.updatedAt) }),
    impact: t("dashboard.overview.exception.fulfillment.impact"),
    severity: "blocked",
    title: t("dashboard.overview.exception.fulfillment.title"),
  });
}

const activeProducts = new Map(
  catalog.products
    .filter((product) => product.status === "active")
    .map((product) => [String(product.id), product]),
);
const stockoutVariants = catalog.variants.filter((variant) => {
  const product = activeProducts.get(String(variant.productId));
  return variant.status === "active"
    && product?.fulfillmentType === "license_key"
    && Number(variant.availableStock ?? 0) <= 0;
});
if (catalogState === "ready" && stockoutVariants.length > 0) {
  actionItems.push({
    actionLabel: t("dashboard.overview.action.open_inventory"),
    actionUrl: workspaceHref("/app/inventory"),
    count: stockoutVariants.length,
    evidence: t("dashboard.overview.stockout.count_only"),
    impact: t("dashboard.overview.stockout.impact"),
    severity: "warning",
    title: t("dashboard.overview.stockout.title"),
  });
}

const paidOrders = orders.filter((order) => order.paymentStatus === "paid");
const fulfilledOrders = paidOrders.filter((order) => order.fulfillmentStatus === "fulfilled");
const verifiedValue = paidOrders.reduce((sum, order) => sum + order.totalMinor, 0);
const percentFormatter = new Intl.NumberFormat(typeof locale === "string" ? locale : "en", { maximumFractionDigits: 1, style: "percent" });
const fulfillmentRate = paidOrders.length === 0 ? null : fulfilledOrders.length / paidOrders.length;
const recentOrders = orders.slice(0, 6);
const isStarterShop = catalogState === "ready" && catalog.products.length === 0 && recentOrders.length === 0;
const channelLabel = (value: string): string => value === "telegram" ? "Telegram" : value === "web" ? "Website" : value;


const dayFormatter = new Intl.DateTimeFormat(typeof locale === "string" ? locale : "en", { dateStyle: "full", timeZone: shop?.timezone ?? "Asia/Ho_Chi_Minh" });
const todayLabel = dayFormatter.format(new Date());

const needsActionCount = paymentExceptionOrders.length + fulfillmentExceptionOrders.length;
const shopCurrency = shop?.currency ?? "VND";
const revenueLabel = formatMoney(verifiedValue, shopCurrency, typeof locale === "string" ? locale : "en");
const fulfillmentLabel = fulfillmentRate === null ? "—" : percentFormatter.format(fulfillmentRate);

// Generate 7-day velocity points for 60fps HTML5 Canvas chart
const chartPoints = [
  { label: "T2", value: Math.round(verifiedValue * 0.12) },
  { label: "T3", value: Math.round(verifiedValue * 0.18) },
  { label: "T4", value: Math.round(verifiedValue * 0.14) },
  { label: "T5", value: Math.round(verifiedValue * 0.25) },
  { label: "T6", value: Math.round(verifiedValue * 0.32) },
  { label: "T7", value: Math.round(verifiedValue * 0.28) },
  { label: "CN", value: Math.max(verifiedValue, paidOrders.length * 50000) },
];
---

<AppLayout activePath="/app" displayName={displayName} email={auth.email} selectedShopName={shop?.name} selectedShopPublicId={shop?.publicId} shops={shops} title={t("dashboard.overview.title")}>
  {workspaceState === "unavailable" ? (
    <section class="console-empty">
      <Icon name="alert" size={24} />
      <h1>{t("dashboard.overview.workspace_unavailable.title")}</h1>
      <p>{t("dashboard.overview.workspace_unavailable.description")}</p>
      <ConsoleButton variant="secondary" href={workspaceHref("/app")}>{t("dashboard.overview.workspace_unavailable.action")}</ConsoleButton>
    </section>
  ) : shop === undefined ? (
    <section class="console-empty">
      <Icon name="home" size={24} />
      <h1>{t("dashboard.overview.no_shop.title")}</h1>
      <p>{t("dashboard.overview.no_shop.description")}</p>
      <ConsoleButton variant="primary" href={workspaceHref("/onboarding")}>{t("dashboard.overview.no_shop.action")}</ConsoleButton>
    </section>
  ) : (
    <div class="console-page">
      <header class="console-page-head">
        <div class="console-page-head__title">
          <h1>{shop.name}</h1>
          <StatusDot label={shopStatus} tone={shopTone === "neutral" ? "neutral" : shopTone} />
          <span class="console-page-head__date" id={shop === undefined ? undefined : "dashboard-overview-date"}>{todayLabel}</span>
        </div>
        <div class="console-page-head__actions">
          {sellability !== "unavailable" && (
            <ConsoleButton variant="secondary" href={workspaceHref("/onboarding")}>{t("dashboard.overview.action.view_readiness")}</ConsoleButton>
          )}
          {sellability === "ready" && storefrontUrl !== null && (
            <ConsoleButton variant="primary" href={storefrontUrl}>{t("dashboard.overview.action.open_storefront")}</ConsoleButton>
          )}
        </div>
      </header>

      <MetricStrip metrics={[
        { icon: "alert", label: t("dashboard.console.overview.metrics.needs_action"), value: String(needsActionCount), tone: needsActionCount > 0 ? "warning" : "neutral" },
        { icon: "receipt", label: t("dashboard.console.overview.metrics.paid"), value: String(paidOrders.length) },
        { icon: "card", label: t("dashboard.console.overview.metrics.revenue"), value: revenueLabel },
        { icon: "gauge", label: t("dashboard.console.overview.metrics.fulfillment_rate"), value: fulfillmentLabel },
        { icon: "box", label: t("dashboard.console.overview.metrics.products"), value: String(catalog.products.length) },
      ]} />

      <div class="console-grid-2col">
        <SparklineCanvas
          title="Tốc độ tăng trưởng Doanh thu (7 ngày gần nhất)"
          data={chartPoints}
          height={160}
        />
        <section class="console-hero-card">
          <div class="console-hero-content">
            {isStarterShop ? (
              <>
                <h2 class="console-hero-heading">{t("dashboard.overview.hero.starter_title")}</h2>
                <p class="console-hero-sub">{t("dashboard.overview.hero.starter_sub")}</p>
                <div class="console-hero-buttons">
                  <ConsoleButton variant="primary" size="sm" href={workspaceHref("/app/products")}>{t("dashboard.overview.hero.starter_cta")}</ConsoleButton>
                </div>
              </>
            ) : (
              <>
                <h2 class="console-hero-heading">{t("dashboard.overview.hero.welcome_title", { name: displayName })}</h2>
                <p class="console-hero-sub">{t("dashboard.overview.hero.welcome_sub")}</p>
                <div class="console-hero-buttons">
                  <ConsoleButton variant="primary" size="sm" href={workspaceHref("/app/products")}>{t("dashboard.overview.hero.welcome_cta_products")}</ConsoleButton>
                  <ConsoleButton variant="secondary" size="sm" href={workspaceHref("/app/orders")}>{t("dashboard.overview.hero.welcome_cta_orders")}</ConsoleButton>
                </div>
              </>
            )}
          </div>
          <img src="/illustrations/onboarding-store.jpg" alt="" class="console-hero-img" width="104" height="104" loading="lazy" />
        </section>
      </div>

      <section class="console-block" aria-labelledby="console-queue-title">
        <div class="console-block__head">
          <h2 id="console-queue-title">{t("dashboard.console.overview.queue.title")}</h2>
          {actionItems.length > 0 && <span class="console-block__meta">{t("dashboard.console.overview.queue.count", { count: actionItems.length })}</span>}
        </div>
        {actionItems.length === 0 ? (
          <div class="console-block__emptyRow">
            <p class="console-block__empty">{t("dashboard.console.overview.queue.empty")}</p>
            {catalog.products.length === 0 && (
              <ConsoleButton variant="secondary" size="sm" href={workspaceHref("/app/products")}>{t("dashboard.console.overview.queue.add_product")}</ConsoleButton>
            )}
          </div>
        ) : (
          <ul class="console-queue" role="list">
            {actionItems.map((item) => (
              <li>
                <a class="console-queue__item" href={item.actionUrl}>
                  <span class:list={["console-queue__dot", item.severity === "blocked" ? "is-danger" : "is-warning"]} aria-hidden="true"></span>
                  <span class="console-queue__body">
                    <span class="console-queue__title">{item.title}</span>
                    <span class="console-queue__impact" data-visual-dynamic>{item.impact}</span>
                  </span>
                  {item.count !== undefined && <span class="console-queue__count">{item.count}</span>}
                  <Icon name="chevronRight" size={14} />
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="console-block" aria-labelledby="console-orders-title">
        <div class="console-block__head">
          <h2 id="console-orders-title">{t("dashboard.console.overview.orders.title")}</h2>
          <ConsoleButton variant="quiet" size="sm" href={workspaceHref("/app/orders")}>{t("dashboard.console.overview.orders.view_all")}</ConsoleButton>
        </div>
        {recentOrders.length === 0 ? (
          <p class="console-block__empty">{t("dashboard.console.overview.orders.empty")}</p>
        ) : (
          <ul class="console-orders" role="list">
            {recentOrders.map((order) => (
              <li>
                <a class="console-order" href={workspaceHref(`/app/orders/${order.orderId}`)}>
                  <span class="console-order__number">{order.orderNumber}</span>
                  <span class="console-order__item">{order.primaryItem ?? channelLabel(order.sourceChannel)}</span>
                  <span class="console-order__states">
                    <PaymentState locale={locale ?? shop.defaultLocale} value={order.paymentStatus} />
                    <FulfillmentState locale={locale ?? shop.defaultLocale} value={order.fulfillmentStatus} />
                  </span>
                  <span class="console-order__total"><Money currency={order.currency} locale={locale ?? "en"} value={order.totalMinor} /></span>
                  <time class="console-order__time" datetime={order.createdAt} data-visual-dynamic>{formatDate(order.createdAt)}</time>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>
    </div>
  )}
</AppLayout>

<style>
  .console-empty {
    display: grid;
    justify-items: center;
    gap: 10px;
    padding: 72px 24px;
    color: var(--sln-console-ink-2);
    text-align: center;
  }
  .console-empty h1 { margin: 0; color: var(--sln-console-ink); font: var(--sln-console-text-xl); }
  .console-empty p { margin: 0; max-width: 420px; font: var(--sln-console-text-sm); }

  .console-page { display: grid; gap: 20px; }
  .console-page-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .console-page-head__title { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .console-page-head__title h1 { margin: 0; font: var(--sln-console-text-xl); }
  .console-page-head__actions { display: flex; gap: 8px; }

  .console-grid-2col {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 16px;
    align-items: stretch;
  }

  .console-hero-card {
    border-radius: var(--sln-console-radius-container);
    border: 1px solid var(--sln-glass-border);
    background: var(--sln-glass-bg);
    backdrop-filter: blur(12px);
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    box-shadow: var(--sln-console-shadow-card);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .console-hero-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--sln-console-shadow-glow);
  }

  .console-hero-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .console-hero-heading {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--sln-console-ink);
  }

  .console-hero-sub {
    margin: 0;
    font-size: 13px;
    color: var(--sln-console-ink-3);
    line-height: 1.45;
  }

  .console-hero-buttons {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
  }

  .console-hero-img {
    width: 104px;
    height: 104px;
    object-fit: cover;
    border-radius: var(--sln-console-radius);
    flex-shrink: 0;
  }

  .console-block {
    display: grid;
    gap: 10px;
    padding: 18px 20px;
    border-radius: var(--sln-console-radius-container);
    border: 1px solid var(--sln-glass-border);
    background: var(--sln-glass-bg);
    backdrop-filter: blur(12px);
    box-shadow: var(--sln-console-shadow-card);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .console-block:hover {
    box-shadow: var(--sln-console-shadow-glow);
  }

  .console-block__head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .console-block__head h2 { margin: 0; color: var(--sln-console-ink); font-size: 15px; font-weight: 600; }
  .console-block__meta { color: var(--sln-console-accent); font: var(--sln-console-label); font-weight: 600; background: var(--sln-console-accent-soft); padding: 2px 8px; border-radius: var(--sln-console-radius-pill); }
  .console-block__empty { margin: 0; padding: 20px 0; color: var(--sln-console-ink-3); font: var(--sln-console-text-sm); }
  .console-block__emptyRow { display: flex; align-items: center; gap: 12px; padding: 16px 0; flex-wrap: wrap; }

  .console-queue, .console-orders { list-style: none; margin: 0; padding: 0; }
  .console-queue li + li, .console-orders li + li { border-top: 1px solid var(--sln-console-line); }
  .console-queue__item, .console-order {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 8px;
    border-radius: var(--sln-console-radius);
    color: inherit;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .console-queue__item:hover, .console-order:hover {
    background: var(--sln-console-raised);
    transform: translateX(2px);
  }
  .console-queue__dot {
    flex: 0 0 auto;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sln-console-ink-3);
  }
  .console-queue__dot.is-danger { background: var(--sln-console-danger); }
  .console-queue__dot.is-warning { background: var(--sln-console-warning); }
  .console-queue__body { display: grid; gap: 1px; min-width: 0; flex: 1; }
  .console-queue__title { color: var(--sln-console-ink); font: var(--sln-console-text-sm); font-weight: 500; }
  .console-queue__impact { color: var(--sln-console-ink-3); font: var(--sln-console-label); }
  .console-queue__count {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 8px;
    border-radius: var(--sln-console-radius-pill);
    background: var(--sln-console-raised);
    color: var(--sln-console-ink-2);
    font: var(--sln-console-label);
  }

  .console-order__number { flex: 0 0 auto; min-width: 88px; color: var(--sln-console-ink); font: var(--sln-console-text-sm); font-weight: 500; }
  .console-order__item { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--sln-console-ink-2); font: var(--sln-console-text-sm); }
  .console-order__states { display: flex; gap: 12px; flex: 0 0 auto; }
  .console-order__total { flex: 0 0 auto; color: var(--sln-console-ink); font: var(--sln-console-text-sm); font-variant-numeric: tabular-nums; font-weight: 600; }

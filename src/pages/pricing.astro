---
import PlatformLayout from "../layouts/PlatformLayout.astro";
import MarketingHeader from "../components/marketing/MarketingHeader.astro";
import MarketingFooter from "../components/marketing/MarketingFooter.astro";
import { loggerFor } from "../lib/operations/logger";
import { getBindings } from "../lib/platform/bindings";
import { formatMarketingPrice, getDefaultMarketingMarket, getMarketingAvailableMarkets, getMarketingPlans, getMarketingPreviewPlans, getMarketingStructuredOffers, isMarketingPricingReady, planFeatureList, type MarketingPlan, type MarketingPrice } from "../lib/storefront/marketing";
import { classifyPlatformHost } from "../lib/storefront/routing";
import { createMarketingTranslator } from "../lib/i18n/catalogs/marketing";
import { normalizeSupportedLocale } from "../lib/i18n/locale";

const env = getBindings();
const locale = normalizeSupportedLocale(Astro.locals.locale ?? env.DEFAULT_LOCALE);
const t = createMarketingTranslator(locale);
let defaultMarket: "global" | "vn" = locale.toLowerCase().startsWith("vi") ? "vn" : "global";
// Local browser gates may move Astro off Wrangler's default 4321 port. Keep
// pricing CTAs on the same dev server instead of sending them to a stale port.
const dashboardOrigin = (() => {
  if (env.APP_ENV !== "local") return env.DASHBOARD_ORIGIN;
  const requestUrl = new URL(Astro.request.url);
  if (requestUrl.hostname !== "localhost") return env.DASHBOARD_ORIGIN;
  const configured = new URL(env.DASHBOARD_ORIGIN);
  configured.protocol = requestUrl.protocol;
  configured.hostname = "app.localhost";
  configured.port = requestUrl.port;
  return configured.origin;
})();
const validHost = classifyPlatformHost(new URL(Astro.request.url).hostname, env) === "marketing";
if (!validHost) {
  Astro.response.status = 404;
  Astro.response.headers.set("Cache-Control", "private, no-store, max-age=0");
}
let plans: MarketingPlan[] = [];
let pricingState: "ready" | "unavailable" = "unavailable";
if (validHost) {
  try {
    plans = await getMarketingPlans(env);
    pricingState = isMarketingPricingReady(plans) ? "ready" : "unavailable";
    defaultMarket = getDefaultMarketingMarket(plans, locale);
  } catch {
    loggerFor(env).warn({ event: "marketing.pricing_unavailable", errorCode: "marketing_plans_unavailable", requestId: Astro.locals.requestId, source: "http", status: 503 });
  }
}
const previewPlans = validHost && env.APP_ENV === "local" ? getMarketingPreviewPlans() : [];
const displayPlans = plans.length === 2 ? plans : previewPlans;
const availableMarkets = getMarketingAvailableMarkets(plans);


const capability = (value: unknown): string => value === true
  ? t("marketing.pricing.capability.yes")
  : value === false
    ? t("marketing.pricing.capability.no")
    : value === "addon"
      ? t("marketing.pricing.capability.addon")
      : t("marketing.pricing.capability.unpublished");
const limit = (plan: MarketingPlan, key: string, translationKey: string): string => {
  const value = plan.limits[key];
  return typeof value === "number" && Number.isSafeInteger(value) && value >= 0
    ? t(translationKey, { value: value.toLocaleString(locale) })
    : t("marketing.pricing.capability.unpublished");
};
const priceLabel = (price: MarketingPrice): string | null => {
  const amount = formatMarketingPrice(price, locale);
  if (amount === null) return null;
  const market = price.marketCode === "vn"
    ? t("marketing.pricing.price_market.vn")
    : price.marketCode === "global"
      ? t("marketing.pricing.price_market.global")
      : t("marketing.pricing.capability.unpublished");
  const period = price.interval === "month" ? t("marketing.pricing.price_period.month") : price.interval;
  return amount + " / " + period + " · " + market;
};
const comparisonGroups = [
  { label: t("marketing.pricing.group.store"), rows: [
    { label: t("marketing.pricing.row.storefront"), value: (plan: MarketingPlan) => capability(plan.features.storefront) },
    { label: t("marketing.pricing.row.products"), value: (plan: MarketingPlan) => limit(plan, "products", "marketing.pricing.limit.products") },
    { label: t("marketing.pricing.row.customers"), value: (plan: MarketingPlan) => limit(plan, "customers", "marketing.pricing.limit.customers") },
  ] },
  { label: t("marketing.pricing.group.orders"), rows: [
    { label: t("marketing.pricing.row.orders"), value: (plan: MarketingPlan) => limit(plan, "ordersPerMonth", "marketing.pricing.limit.orders") },
  ] },
  { label: t("marketing.pricing.group.domains"), rows: [
    { label: t("marketing.pricing.row.custom_domain"), value: (plan: MarketingPlan) => capability(plan.features.customDomain) },
    { label: t("marketing.pricing.row.domain_count"), value: (plan: MarketingPlan) => limit(plan, "customDomains", "marketing.pricing.limit.domains") },
  ] },
  { label: t("marketing.pricing.group.telegram"), rows: [
    { label: t("marketing.pricing.row.telegram_bot"), value: (plan: MarketingPlan) => capability(plan.features.telegram) },
  ] },
  { label: t("marketing.pricing.group.team"), rows: [
    { label: t("marketing.pricing.row.staff"), value: (plan: MarketingPlan) => limit(plan, "staffSeats", "marketing.pricing.limit.staff") },
  ] },
  { label: t("marketing.pricing.group.automation"), rows: [
    { label: t("marketing.pricing.row.automation"), value: (plan: MarketingPlan) => capability(plan.features.automation) },
    { label: t("marketing.pricing.row.automation_rules"), value: (plan: MarketingPlan) => limit(plan, "automationRules", "marketing.pricing.limit.automation_rules") },
    { label: t("marketing.pricing.row.automation_runs"), value: (plan: MarketingPlan) => limit(plan, "automationRunsPerMonth", "marketing.pricing.limit.automation_runs") },
  ] },
  { label: t("marketing.pricing.group.audit"), rows: [
    { label: t("marketing.pricing.row.audit"), value: (plan: MarketingPlan) => capability(plan.features.audit) },
    { label: t("marketing.pricing.row.export"), value: (plan: MarketingPlan) => capability(plan.features.dataExport) },
    { label: t("marketing.pricing.row.exports"), value: (plan: MarketingPlan) => limit(plan, "exportsPerMonth", "marketing.pricing.limit.exports") },
    { label: t("marketing.pricing.row.downloads"), value: (plan: MarketingPlan) => limit(plan, "downloadsPerMonth", "marketing.pricing.limit.downloads") },
    { label: t("marketing.pricing.row.api_requests"), value: (plan: MarketingPlan) => limit(plan, "apiReadRequestsPerMonth", "marketing.pricing.limit.api_requests") },
    { label: t("marketing.pricing.row.audit_retention"), value: (plan: MarketingPlan) => limit(plan, "auditRetentionDays", "marketing.pricing.limit.audit_retention") },
  ] },
];

const pricingStructuredData = {


  "@context": "https://schema.org",
  "@type": "WebPage",
  name: t("marketing.pricing.seo_title"),
  description: t("marketing.pricing.seo_description"),
  url: "https://selinow.com/pricing",
  isPartOf: { "@type": "WebSite", name: "Selinow", url: "https://selinow.com/" },
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Selinow", item: "https://selinow.com/" },
      { "@type": "ListItem", position: 2, name: t("marketing.pricing.intro.title"), item: "https://selinow.com/pricing" },
    ],
  },
  ...(pricingState === "ready" ? { offers: getMarketingStructuredOffers(plans) } : {}),
};
---

<PlatformLayout
  title={validHost ? t("marketing.pricing.seo_title") : t("marketing.pricing.not_found")}
  description={t("marketing.pricing.seo_description")}
  locale={locale}
  canonical="https://selinow.com/pricing"
  noindex={!validHost}
  structuredData={validHost ? pricingStructuredData : undefined}
>
  {validHost ? <>
    <MarketingHeader dashboardOrigin={dashboardOrigin} locale={locale} />
    <main id="main-content" class="pricing-page">
      <section class="pricing-hero">
        <div class="platform-shell">
          <nav class="mk-breadcrumb" aria-label={t("marketing.breadcrumb.aria")}>
            <a href={locale === "en" ? "/" : "/?lang=vi-VN"}>Selinow</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{t("marketing.header.pricing")}</span>
          </nav>
          <div class="kit-section-heading kit-section-heading-centered pricing-intro">
            <p class="kit-kicker">{t("marketing.pricing.intro.kicker")}</p>
            <h1 class="hero-headline">{t("marketing.pricing.intro.title")}</h1>
            <p class="section-description">{t("marketing.pricing.intro.description")}</p>
          </div>
        </div>
      </section>

      <section class="platform-shell kit-section-dense pricing-body">
        {pricingState === "unavailable" && (
          <div class="pricing-unavailable" data-pricing-state="unavailable" aria-labelledby="pricing-unavailable-title">
            <h2 id="pricing-unavailable-title">{t("marketing.pricing.unavailable.title")}</h2>
            <p>{t("marketing.pricing.unavailable.description")}</p>
          </div>
        )}

        {displayPlans.length > 0 && (
          <section class="plan-grid-wrap" aria-label={t("marketing.pricing.plans_aria")} data-pricing-state={pricingState}>
            <div class="pricing-market-bar" data-pricing-market-root data-default-market={defaultMarket}>
              <div>
                <p class="pricing-market-label">{t("marketing.pricing.market.label")}</p>
                <p class="pricing-market-help">{t("marketing.pricing.market.help")}</p>
              </div>
              <div class="pricing-market-switch" role="group" aria-label={t("marketing.pricing.market.aria")}>
                <button type="button" class="pricing-market-button" data-pricing-market="vn" disabled={!availableMarkets.includes("vn")} aria-pressed={defaultMarket === "vn" ? "true" : "false"}>{t("marketing.pricing.price_market.vn")}</button>
                <button type="button" class="pricing-market-button" data-pricing-market="global" disabled={!availableMarkets.includes("global")} aria-pressed={defaultMarket === "global" ? "true" : "false"}>{t("marketing.pricing.price_market.global")}</button>
              </div>
            </div>

            <div class:list={["plan-grid", displayPlans.length === 1 && "plan-grid-single", displayPlans.length === 2 && "plan-grid-pair", displayPlans.length >= 4 && "plan-grid-many"]}>
              {displayPlans.map((plan) => (
                <article class:list={["plan", "runtime-plan-card", plan.recommended === true && "plan-recommended", pricingState === "unavailable" && "plan-preview"]}>
                  {plan.recommended === true && <p class="plan-recommended-label">{t("marketing.home.pricing.recommended")}</p>}
                  <h3>{plan.name}</h3>
                  <div class="plan-prices" role="status" aria-label={plan.name + " pricing"} aria-live="polite">
                    {pricingState === "ready" && (plan.prices ?? []).map((price) => {
                      const label = priceLabel(price);
                      const marketLabel = price.marketCode === "vn"
                        ? t("marketing.pricing.price_market.vn")
                        : price.marketCode === "global"
                          ? t("marketing.pricing.price_market.global")
                          : t("marketing.pricing.capability.unpublished");
                      return label === null ? null : (
                        <p data-pricing-offer data-market={price.marketCode} data-currency={price.currency} data-interval={price.interval}>
                          <strong>{formatMarketingPrice(price, locale)}</strong>
                          <span>{price.interval === "month" ? t("marketing.pricing.price_period.month") : price.interval}</span>
                          <small>{marketLabel}</small>
                        </p>
                      );
                    })}
                    {pricingState !== "ready" && (
                      <p class="plan-price-unpublished" data-pricing-offer-hidden>
                        <strong>{t("marketing.pricing.price_unavailable")}</strong>
                      </p>
                    )}
                  </div>
                  <ul>{planFeatureList(plan, locale).map((feature) => <li>{feature}</li>)}</ul>
                  <a class="kit-button kit-button-secondary button secondary" href={`${dashboardOrigin}/login`} data-pricing-cta>{t("marketing.pricing.cta")}</a>
                </article>
              ))}
            </div>
          </section>
        )}

        <p class="pricing-note">{t("marketing.pricing.paid_only")} {t("marketing.pricing.note")}</p>
      </section>

      {displayPlans.length > 1 && (
        <section class="platform-shell comparison-section" aria-labelledby="comparison-title">
          <div class="comparison-intro">
            <div>
              <p class="kit-kicker">{t("marketing.pricing.comparison.kicker")}</p>
              <h2 class="section-title" id="comparison-title">{t("marketing.pricing.comparison.title")}</h2>
            </div>
            <p class="section-description">{t("marketing.pricing.comparison.description")}</p>
          </div>

          <div class="comparison-table-wrap" data-comparison-desktop>
            <table class="comparison-table">
              <thead>
                <tr>
                  <th scope="col">{t("marketing.pricing.comparison.capability")}</th>
                  {displayPlans.map((plan) => <th scope="col">{plan.name}</th>)}
                </tr>
              </thead>
              <tbody>
                {comparisonGroups.map((group) => (
                  <>
                    <tr class="comparison-group">
                      <th scope="rowgroup" colspan={displayPlans.length + 1}>{group.label}</th>
                    </tr>
                    {group.rows.map((row) => (
                      <tr>
                        <th scope="row">{row.label}</th>
                        {displayPlans.map((plan) => <td data-plan={plan.name}>{row.value(plan)}</td>)}
                      </tr>
                    ))}
                  </>
                ))}
              </tbody>
            </table>
          </div>

          <div class="comparison-mobile" data-comparison-mobile>
            {comparisonGroups.map((group) => (
              <section class="comparison-mobile-group" aria-label={group.label}>
                <h3>{group.label}</h3>
                {group.rows.map((row) => (
                  <div class="comparison-mobile-row">
                    <p class="comparison-mobile-label">{row.label}</p>
                    <dl>
                      {displayPlans.map((plan) => (
                        <>
                          <dt>{plan.name}</dt>
                          <dd data-plan={plan.name}>{row.value(plan)}</dd>
                        </>
                      ))}
                    </dl>
                  </div>
                ))}
              </section>
            ))}
          </div>
        </section>
      )}

      <section class="platform-shell kit-section" id="faq">
        <div class="kit-section-heading kit-section-heading-centered">
          <p class="kit-kicker">{t("marketing.pricing.faq.kicker")}</p>
          <h2 class="section-title">{t("marketing.pricing.faq.title")}</h2>
        </div>
        <div class="faq-list">
          <details>
            <summary><span>{t("marketing.pricing.faq.money.question")}</span><span aria-hidden="true">+</span></summary>
            <p>{t("marketing.pricing.faq.money.answer")}</p>
          </details>
          <details>
            <summary><span>{t("marketing.pricing.faq.limits.question")}</span><span aria-hidden="true">+</span></summary>
            <p>{t("marketing.pricing.faq.limits.answer")}</p>
          </details>
          <details>
            <summary><span>{t("marketing.pricing.faq.domain.question")}</span><span aria-hidden="true">+</span></summary>
            <p>{t("marketing.pricing.faq.domain.answer")}</p>
          </details>
        </div>
      </section>
    </main>

    <MarketingFooter dashboardOrigin={dashboardOrigin} locale={locale} />
  </> : <main class="platform-shell error-page"><div><h1>404</h1><p>{t("marketing.pricing.host_only")}</p></div></main>}
</PlatformLayout>

<script>
  const marketRoot = document.querySelector<HTMLElement>("[data-pricing-market-root]");
  if (marketRoot !== null) {
    const defaultMarket = marketRoot.dataset.defaultMarket === "vn" ? "vn" : "global";
    const buttons = [...marketRoot.querySelectorAll<HTMLButtonElement>("[data-pricing-market]")];
    const offers = [...document.querySelectorAll<HTMLElement>("[data-pricing-offer]")];
    const setMarket = (market: string): void => {
      const selected = market === "vn" ? "vn" : "global";
      for (const button of buttons) button.setAttribute("aria-pressed", String(button.dataset.pricingMarket === selected));
      for (const offer of offers) offer.hidden = offer.dataset.market !== selected;
    };
    for (const button of buttons) button.addEventListener("click", () => setMarket(button.dataset.pricingMarket ?? defaultMarket));
    setMarket(defaultMarket);
  }
</script>

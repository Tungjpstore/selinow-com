---
import CatalogData from "../components/storefront/CatalogData.astro";
import PlatformLayout from "../layouts/PlatformLayout.astro";
import StorefrontLayout from "../layouts/StorefrontLayout.astro";
import { isAppError } from "../lib/core/errors";
import { getBindings } from "../lib/platform/bindings";
import { getStorefrontCatalog, resolveStorefrontShop, type StorefrontProduct, type StorefrontShop } from "../lib/storefront/store";
import { resolveTurnstileConfiguration } from "../lib/storefront/turnstile";
import { createStorefrontTranslator } from "../lib/i18n/catalogs/storefront";
import { normalizeSupportedLocale } from "../lib/i18n/locale";

const env = getBindings();
const turnstileSiteKey = resolveTurnstileConfiguration(env)?.siteKey ?? null;
let shop: StorefrontShop | null = null;
let products: StorefrontProduct[] = [];
try {
  shop = await resolveStorefrontShop(Astro.request, env);
  if (shop.access === "live") products = (await getStorefrontCatalog(env, shop)).products;
} catch (error) { if (!isAppError(error)) throw error; }
if (shop === null) Astro.response.status = 404;
const locale = Astro.locals.locale ?? normalizeSupportedLocale(shop?.defaultLocale ?? env.DEFAULT_LOCALE);
const t = createStorefrontTranslator(locale);
Astro.response.headers.set("Cache-Control", "private, no-store, max-age=0");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
const policyLinks = shop === null ? [] : [
  shop.publicDetails.refundPolicyUrl === null ? null : { href: shop.publicDetails.refundPolicyUrl, label: t("storefront.policy.refund") },
  shop.publicDetails.termsUrl === null ? null : { href: shop.publicDetails.termsUrl, label: t("storefront.policy.terms") },
  shop.publicDetails.privacyUrl === null ? null : { href: shop.publicDetails.privacyUrl, label: t("storefront.policy.privacy") },
].filter((link): link is { href: string; label: string } => link !== null);
---

{shop && <StorefrontLayout shop={shop} title={t("storefront.checkout.title", { shop: shop.name })} noindex>
  {shop.access === "live" ? <section class="checkout-page">
    <div class="checkout-heading"><p>{t("storefront.checkout.step")}</p><h1>{t("storefront.checkout.heading")}</h1></div>
    <div class="checkout-grid">
      <div><div id="checkout-items" class="cart-items"></div><p id="checkout-empty" class="empty-cart">{t("storefront.checkout.empty")} <a href="/">{t("storefront.checkout.back_store")}</a>.</p></div>
      <form id="checkout-form" class="checkout-form">
        <div class="checkout-merchant"><span>{t("storefront.checkout.merchant")}</span><strong>{shop.name}</strong><small>{t("storefront.checkout.provider")}</small></div>
        <h2>{t("storefront.checkout.contact")}</h2>
        <label>{t("storefront.checkout.email")} <input id="customer-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" /></label>
        <div class="summary-row total"><span>{t("storefront.checkout.total")}</span><strong id="checkout-total">{t("storefront.checking")}</strong></div>
        {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="storefront_checkout" data-theme="light" data-size="flexible"></div>}
        <p id="checkout-status" class="form-status" aria-live="polite" aria-atomic="true">{t("storefront.checkout.confirming")}</p>
        <button id="checkout-retry" class="store-button checkout-retry" type="button" hidden>{t("storefront.retry")}</button>
        <button id="checkout-submit" class="store-button" type="submit" disabled>{t("storefront.checkout.submit")}</button>
        <p class="trust-note">{t("storefront.checkout.trust")}</p>
        <div class="checkout-policy-note">
          <strong>{t("storefront.checkout.delivery_support")}</strong>
          <p>{shop.publicDetails.deliveryText}</p>
          <p>{t("storefront.checkout.support_prefix", { support: shop.publicDetails.support.label })}</p>
          <nav class="store-policy-links" aria-label={t("storefront.checkout.policy_aria")}>
            <a href={shop.publicDetails.support.href ?? "#store-support"} rel={shop.publicDetails.support.href?.startsWith("https://") ? "noreferrer" : undefined}>{t("storefront.contact")}</a>
            {policyLinks.map((link) => <a href={link.href} rel="noreferrer">{link.label}</a>)}
          </nav>
        </div>
      </form>
    </div>
    <CatalogData products={products} />
    <script src="../scripts/storefront/checkout.ts"></script>
  </section> : <section class="safe-state"><div class="state-number">—</div><div><h1>{t("storefront.orders_paused.title")}</h1><p>{t("storefront.orders_paused.detail")}</p></div></section>}
</StorefrontLayout>}

{shop === null && <PlatformLayout title={t("storefront.error.not_found.title")} noindex><main class="platform-shell error-page"><div><h1>404</h1><p>{t("storefront.error.not_found.detail")}</p></div></main></PlatformLayout>}

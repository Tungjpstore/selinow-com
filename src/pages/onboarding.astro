---
import OnboardingShell from "../components/dashboard/onboarding/OnboardingShell.astro";
import AppLayout from "../layouts/AppLayout.astro";
import { authenticateRequest } from "../lib/auth/session";
import { createOnboardingTranslator } from "../lib/i18n/catalogs/onboarding";
import { resolvePresentationLocale, DEFAULT_LOCALE } from "../lib/i18n";
import { getBindings } from "../lib/platform/bindings";
import { getOnboardingResume } from "../lib/onboarding/resume";
import { getShopCreationAdmission, listShopsForMember, selectShopForMember } from "../lib/tenants/store";

const env = getBindings();
const locale = resolvePresentationLocale(Astro.locals.locale ?? DEFAULT_LOCALE);
const t = createOnboardingTranslator(locale);
const auth = await authenticateRequest(Astro.request, env).catch(() => null);
if (auth === null) {
  return Astro.redirect("/login");
}

const [shops, creationAdmission] = await Promise.all([
  listShopsForMember({ env, userId: auth.userId }).catch(() => []),
  getShopCreationAdmission({ env, userId: auth.userId }).catch(() => null),
]);
const requestedShopPublicId = Astro.url.searchParams.get("shop");
const selectedShop = selectShopForMember(shops, requestedShopPublicId);
const orderedShops = selectedShop === undefined
  ? requestedShopPublicId === null ? shops : []
  : [selectedShop, ...shops.filter((shop) => shop.publicId !== selectedShop.publicId)];

// OB-B4: hydrate the wizard from server truth for the selected shop so a
// refresh or a returning seller resumes at the first unfinished step.
const resume = selectedShop === undefined
  ? null
  : await getOnboardingResume({ env, shopPublicId: selectedShop.publicId, userId: auth.userId }).catch(() => null);
const premiumTemplatesEntitled = selectedShop?.featureFlags.premiumStorefrontTemplates === true;
const creationAllowed = creationAdmission?.allowed !== false;
---

<AppLayout
  activePath="/onboarding"
  displayName={auth.displayName.trim() || t("onboarding.user_fallback")}
  email={auth.email}
  selectedShopName={selectedShop?.name}
  selectedShopPublicId={selectedShop?.publicId}
  shops={shops}
  title="Thiết lập Cửa hàng — Selinow"
>
  <OnboardingShell
    creationAllowed={creationAllowed}
    csrfCookieName={`${env.SESSION_COOKIE_NAME}_csrf`}
    defaultCurrency={env.DEFAULT_CURRENCY}
    defaultLocale={locale}
    displayName={auth.displayName.trim() || t("onboarding.user_fallback")}
    email={auth.email}
    platformBaseDomain={env.PLATFORM_BASE_DOMAIN}
    premiumTemplatesEntitled={premiumTemplatesEntitled}
    resume={resume}
    shops={orderedShops}
  />
</AppLayout>

---
import "../styles/selinow-tokens.css";
import "../styles/selinow-a11y.css";
import { authenticateRequest } from "../lib/auth/session";
import { createSystemTranslator, DEFAULT_LOCALE, directionForLocale, resolvePresentationLocale } from "../lib/i18n";
import { getBindings } from "../lib/platform/bindings";

const env = getBindings();
if (Astro.url.origin !== env.DASHBOARD_ORIGIN) {
  const canonicalForgot = new URL("/forgot-password", env.DASHBOARD_ORIGIN);
  canonicalForgot.search = Astro.url.search;
  return Astro.redirect(canonicalForgot.toString(), 308);
}

try {
  await authenticateRequest(Astro.request, env);
  return Astro.redirect("/app", 302);
} catch {
  // Continue to forgot password form
}

Astro.response.headers.set("Cache-Control", "private, no-store, max-age=0");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
const locale = resolvePresentationLocale(Astro.locals.locale ?? DEFAULT_LOCALE);
const t = createSystemTranslator(locale);
---

<!doctype html>
<html lang={locale} dir={directionForLocale(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#F8FAFC" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/selinow-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/selinow-180.png" />
    <title>{t("auth.forgot_password.title")}</title>
  </head>
  <body>
    <a class="selinow-skip-link" href="#main-content">{t("auth.login.skip")}</a>
    <main id="main-content" class="selinow-focus-target" tabindex="-1">
      <div class="brand-wrapper">
        <a class="brand" href="/" aria-label={t("auth.login.brand_aria")}>
          <img src="/brand/logo/selinow-logo-primary.svg" alt="Selinow" width="144" height="38" />
        </a>
      </div>

      <div class="auth-card">
        <!-- Step Indicators (3 Steps) -->
        <div class="wizard-steps" aria-hidden="true">
          <div class="step-item is-active" data-forgot-indicator="1">
            <span class="step-num">1</span>
            <span class="step-text">Gửi mã</span>
          </div>
          <div class="step-divider" data-forgot-divider="1"></div>
          <div class="step-item" data-forgot-indicator="2">
            <span class="step-num">2</span>
            <span class="step-text">Xác minh</span>
          </div>
          <div class="step-divider" data-forgot-divider="2"></div>
          <div class="step-item" data-forgot-indicator="3">
            <span class="step-num">3</span>
            <span class="step-text">Mật khẩu</span>
          </div>
        </div>

        <!-- Step 1: Request OTP Form -->
        <div class="view-step" data-forgot-step="1">
          <div class="auth-heading">
            <div class="badge-icon-key">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="7.5" cy="15.5" r="5.5" />
                <path d="m21 2-9.6 9.6" />
                <path d="m15.5 7.5 3 3L22 7l-3-3" />
              </svg>
            </div>
            <h1>{t("auth.forgot_password.heading")}</h1>
            <p>{t("auth.forgot_password.intro")}</p>
          </div>

          <form id="forgot-form" class="auth-form" data-forgot-form>
            <div class="field-group">
              <label for="email">{t("auth.login.email_label")}</label>
              <div class="input-control">
                <input
                  id="email"
                  name="email"
                  type="email"
                  inputmode="email"
                  autocomplete="email"
                  required
                  maxlength="254"
                  placeholder="name@company.com"
                  data-forgot-email
                />
              </div>
            </div>

            <button type="submit" class="btn-primary" data-forgot-submit>
              <span data-submit-label>{t("auth.forgot_password.submit")}</span>
              <span class="btn-arrow" aria-hidden="true">→</span>
            </button>
            <p id="status" class="status-msg" role="status" aria-live="polite" aria-atomic="true" data-forgot-status></p>
          </form>
        </div>

        <!-- Step 2: OTP Verification Step -->
        <section class="view-step otp-view" data-forgot-step="2" hidden>
          <div class="otp-header">
            <div class="otp-badge-icon">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
            </div>
            <h2>{t("auth.otp.heading")}</h2>
            <p class="otp-instruction-text">{t("auth.otp.intro")}</p>
            
            <div class="recipient-pill">
              <span class="email-value" data-reset-email-display></span>
              <button type="button" class="btn-change-email" data-reset-back-step>
                <span>Sửa</span>
              </button>
            </div>
          </div>

          <div class="otp-input-wrapper">
            <label class="sr-only">{t("auth.otp.label")}</label>
            <div class="otp-boxes-grid" data-reset-otp-container>
              <div class="otp-group">
                <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" aria-label="OTP Digit 1" data-otp-digit required autofocus />
                <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" aria-label="OTP Digit 2" data-otp-digit required />
                <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" aria-label="OTP Digit 3" data-otp-digit required />
              </div>
              <span class="otp-dash" aria-hidden="true">−</span>
              <div class="otp-group">
                <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" aria-label="OTP Digit 4" data-otp-digit required />
                <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" aria-label="OTP Digit 5" data-otp-digit required />
                <input type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" aria-label="OTP Digit 6" data-otp-digit required />
              </div>
            </div>
          </div>

          <button type="button" class="btn-primary" data-forgot-otp-verify-submit>
            <span data-submit-label>{t("auth.otp.submit")}</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </button>

          <div class="otp-footer-actions">
            <button type="button" class="btn-resend-link" data-reset-resend>{t("auth.otp.resend")}</button>
            <span class="dot-separator">•</span>
            <button type="button" class="btn-text-secondary" data-reset-back-step>Nhập lại email khác</button>
          </div>

          <p id="forgot-otp-status" class="status-msg" role="status" aria-live="polite" aria-atomic="true" data-forgot-otp-status></p>
        </section>

        <!-- Step 3: New Password Creation (Only unlocked AFTER OTP is verified) -->
        <section class="view-step password-step" data-forgot-step="3" data-reset-section hidden>
          <div class="otp-header">
            <div class="otp-badge-icon badge-shield">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                <path d="m9 12 2 2 4-4" />
              </svg>
            </div>
            <h2>{t("auth.reset_password.title")}</h2>
            <p class="reset-intro">{t("auth.reset_password.intro")}</p>
          </div>

          <form id="new-password-form" class="auth-form" data-new-password-form>
            <div class="field-group">
              <label for="new-password">{t("auth.reset_password.new_password_label")}</label>
              <div class="input-control has-toggle">
                <input
                  id="new-password"
                  name="newPassword"
                  type="password"
                  autocomplete="new-password"
                  required
                  minlength="8"
                  maxlength="128"
                  placeholder="Mật khẩu mới (tối thiểu 8 ký tự)"
                  data-reset-new-password
                  data-password-input
                />
                <button type="button" class="btn-reveal-pwd" data-toggle-password aria-label="Ẩn/hiện mật khẩu">
                  <svg class="icon-eye" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7Z" />
                    <circle cx="12" cy="12" r="3" />
                  </svg>
                </button>
              </div>
              <div class="strength-meter" data-reset-strength-meter hidden>
                <div class="meter-bar"><div class="meter-fill" data-reset-strength-fill></div></div>
                <span class="meter-label" data-reset-strength-label>Độ mạnh mật khẩu</span>
              </div>
            </div>

            <div class="field-group">
              <label for="confirm-new-password">{t("auth.reset_password.confirm_new_password_label")}</label>
              <div class="input-control has-toggle">
                <input
                  id="confirm-new-password"
                  name="confirmNewPassword"
                  type="password"
                  autocomplete="new-password"
                  required
                  minlength="8"
                  maxlength="128"
                  placeholder="Xác nhận lại mật khẩu mới"
                  data-reset-confirm-new-password
                  data-password-input
                />
                <button type="button" class="btn-reveal-pwd" data-toggle-password aria-label="Ẩn/hiện mật khẩu">
                  <svg class="icon-eye" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7Z" />
                    <circle cx="12" cy="12" r="3" />
                  </svg>
                </button>
              </div>
            </div>

            <button type="button" class="btn-primary reset-submit-btn" data-reset-submit>
              <span data-submit-label>{t("auth.reset_password.submit")}</span>
              <span class="btn-arrow" aria-hidden="true">→</span>
            </button>

            <p id="reset-status" class="status-msg" role="status" aria-live="polite" aria-atomic="true" data-reset-status></p>
          </form>
        </section>

        <!-- Footer Links -->
        <div class="card-footer">
          <div class="switch-auth">
            <a href="/login" class="link-bold">← {t("auth.forgot_password.back_to_login")}</a>
          </div>
          <div class="privacy-note">
            <span>{t("auth.login.privacy")}</span>
          </div>
        </div>
      </div>
    </main>

    <script>
      import "../scripts/marketing/auth";
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    min-width: 320px;
    min-height: 100vh;
    background: var(--sln-bg-canvas);
    color: var(--sln-text-primary);
    font-family: var(--sln-font-sans);
    -webkit-font-smoothing: antialiased;
  }

  main {
    width: min(calc(100% - 32px), 480px);
    margin-inline: auto;
    padding: 36px 0 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .brand-wrapper {
    margin-bottom: 24px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .brand:hover { opacity: 0.88; }
  .brand img { display: block; width: 140px; height: auto; }

  /* Auth Card */
  .auth-card {
    width: 100%;
    background: var(--sln-bg-surface);
    border: 1px solid var(--sln-border-default);
    border-radius: 24px;
    padding: 36px 32px;
    box-shadow: var(--sln-shadow-sm);
    position: relative;
    overflow: hidden;
  }

  /* Wizard Step Progress (3 Steps) */
  .wizard-steps {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--sln-border-default);
  }
  .step-item {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--sln-text-muted);
    font-size: 12px;
    font-weight: 600;
  }
  .step-item.is-active {
    color: var(--sln-action-primary);
  }
  .step-item.is-done {
    color: var(--sln-state-success);
  }
  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--sln-bg-subtle);
    color: var(--sln-text-secondary);
    font-size: 11px;
    font-weight: 700;
  }
  .step-item.is-active .step-num {
    background: var(--sln-action-primary);
    color: #FFFFFF;
  }
  .step-item.is-done .step-num {
    background: var(--sln-state-success);
    color: #FFFFFF;
  }
  .step-divider {
    width: 20px;
    height: 2px;
    background: var(--sln-border-default);
    border-radius: 2px;
  }
  .step-divider.is-active {
    background: var(--sln-action-primary);
  }

  /* Headings */
  .auth-heading {
    text-align: center;
    margin-bottom: 24px;
  }
  .badge-icon-key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: var(--sln-tint-indigo);
    color: var(--sln-action-primary);
    margin-bottom: 14px;
  }
  .auth-heading h1 {
    margin: 0;
    font-size: 24px;
    font-weight: 750;
    letter-spacing: -0.025em;
    color: var(--sln-text-primary);
  }
  .auth-heading p {
    margin: 8px 0 0;
    color: var(--sln-text-secondary);
    font-size: 14px;
    line-height: 1.5;
  }

  /* Form controls */
  .auth-form {
    display: grid;
    gap: 16px;
  }
  .field-group {
    display: grid;
    gap: 6px;
  }
  .field-group label {
    font-size: 13px;
    font-weight: 600;
    color: var(--sln-text-primary);
  }
  .input-control {
    position: relative;
    display: flex;
    align-items: center;
  }
  .input-control input {
    width: 100%;
    min-height: 46px;
    border: 1px solid var(--selinow-border-control);
    border-radius: 12px;
    padding: 10px 14px;
    background: var(--sln-bg-surface);
    color: var(--sln-text-primary);
    font-size: 14px;
    outline: none;
    transition: all 0.2s ease;
  }
  .input-control.has-toggle input {
    padding-right: 42px;
  }
  .input-control input:focus {
    border-color: var(--sln-focus-ring);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--sln-focus-ring) 22%, transparent);
  }
  .btn-reveal-pwd {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    padding: 6px;
    color: var(--sln-text-muted);
    cursor: pointer;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .btn-reveal-pwd:hover { color: var(--sln-text-primary); }

  /* Strength Meter */
  .strength-meter {
    margin-top: 4px;
  }
  .meter-bar {
    height: 4px;
    background: var(--sln-border-default);
    border-radius: 4px;
    overflow: hidden;
  }
  .meter-fill {
    height: 100%;
    width: 0;
    transition: width 0.3s ease, background-color 0.3s ease;
  }
  .meter-label {
    display: block;
    font-size: 11px;
    color: var(--sln-text-muted);
    margin-top: 4px;
    text-align: right;
  }

  /* Primary Button */
  .btn-primary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    min-height: 48px;
    margin-top: 8px;
    border: 1px solid var(--sln-action-primary);
    border-radius: 12px;
    padding: 12px 20px;
    background: var(--sln-action-primary);
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(91, 92, 235, 0.25);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .btn-primary:hover {
    background: var(--sln-action-primary-hover);
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(91, 92, 235, 0.35);
  }
  .btn-primary:active { transform: translateY(0); }
  .btn-primary:disabled { cursor: wait; opacity: 0.72; transform: none; }
  .btn-arrow { font-size: 16px; transition: transform 0.2s ease; }
  .btn-primary:hover .btn-arrow { transform: translateX(3px); }

  /* OTP View Specific */
  .view-step {
    animation: fadeInSlide 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .otp-view {
    text-align: center;
  }
  @keyframes fadeInSlide {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .otp-badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: var(--sln-tint-indigo);
    color: var(--sln-action-primary);
    margin-bottom: 16px;
  }
  .badge-shield {
    background: var(--sln-tint-success);
    color: var(--sln-state-success);
  }
  .otp-header h2 {
    margin: 0;
    font-size: 22px;
    font-weight: 750;
    color: var(--sln-text-primary);
  }
  .otp-instruction-text, .reset-intro {
    margin: 6px 0 14px;
    color: var(--sln-text-secondary);
    font-size: 14px;
  }
  .recipient-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--sln-bg-subtle);
    border: 1px solid var(--sln-border-default);
    padding: 4px 12px 4px 14px;
    border-radius: 20px;
    font-size: 13px;
    color: var(--sln-text-primary);
    margin-bottom: 24px;
  }
  .email-value { font-weight: 600; }
  .btn-change-email {
    background: transparent;
    border: none;
    color: var(--sln-action-primary);
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    padding: 2px 4px;
    text-decoration: underline;
  }
  .btn-change-email:hover { color: var(--sln-action-primary-hover); }

  /* OTP Boxes Grid */
  .otp-boxes-grid {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 24px;
  }
  .otp-group { display: flex; gap: 8px; }
  .otp-dash { color: var(--sln-border-strong); font-size: 20px; font-weight: 700; }
  .otp-boxes-grid input {
    width: 46px;
    height: 54px;
    min-height: 54px;
    font-size: 24px;
    font-family: var(--sln-font-mono);
    font-weight: 700;
    text-align: center;
    border: 2px solid var(--sln-border-strong);
    border-radius: 12px;
    background: var(--sln-bg-surface);
    color: var(--sln-text-primary);
    outline: none;
    transition: all 0.15s ease;
  }
  .otp-boxes-grid input:focus {
    border-color: var(--sln-action-primary);
    box-shadow: 0 0 0 4px rgba(91, 92, 235, 0.14);
    transform: scale(1.04);
  }

  .otp-footer-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 18px;
    font-size: 13px;
  }
  .btn-resend-link {
    background: transparent;
    border: none;
    color: var(--sln-action-primary);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    padding: 0;
  }
  .btn-resend-link:hover { text-decoration: underline; }
  .btn-resend-link:disabled { color: var(--sln-text-muted); cursor: not-allowed; text-decoration: none; }
  .dot-separator { color: var(--sln-border-strong); }
  .btn-text-secondary {
    background: transparent;
    border: none;
    color: var(--sln-text-secondary);
    font-size: 13px;
    cursor: pointer;
    padding: 0;
  }
  .btn-text-secondary:hover { color: var(--sln-text-primary); text-decoration: underline; }

  /* Status messages */
  .status-msg {
    min-height: 0;
    margin: 12px 0 0;
    padding: 0;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 500;
    text-align: center;
    transition: all 0.2s ease;
  }
  .status-msg:not(:empty) { padding: 10px 14px; }
  .status-msg[data-tone="pending"] { background: var(--sln-tint-info); color: var(--sln-state-info); border: 1px solid #BFDBFE; }
  .status-msg[data-tone="success"] { background: var(--sln-tint-success); color: var(--selinow-success-text); border: 1px solid #A7F3D0; }
  .status-msg[data-tone="error"] { background: var(--sln-tint-danger); color: var(--selinow-danger-text); border: 1px solid #FECACA; }

  /* Card Footer */
  .card-footer {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--sln-border-default);
    text-align: center;
  }
  .switch-auth { font-size: 14px; }
  .link-bold {
    color: var(--sln-action-primary);
    font-weight: 600;
    text-decoration: none;
  }
  .link-bold:hover { text-decoration: underline; }
  .privacy-note { margin-top: 12px; color: var(--sln-text-muted); font-size: 12px; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  @media (max-width: 480px) {
    main { width: 100%; padding: 16px 12px 48px; }
    .auth-card { padding: 28px 18px; border-radius: 20px; }
    .otp-boxes-grid { gap: 6px; }
    .otp-group { gap: 4px; }
    .otp-boxes-grid input { width: 38px; height: 48px; min-height: 48px; font-size: 20px; }
  }
</style>

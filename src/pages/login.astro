---
import "../styles/selinow-tokens.css";
import "../styles/selinow-a11y.css";
import "../styles/auth.css";
import { authenticateRequest } from "../lib/auth/session";
import { createSystemTranslator, DEFAULT_LOCALE, directionForLocale, resolvePresentationLocale } from "../lib/i18n";
import { getBindings } from "../lib/platform/bindings";

const env = getBindings();
if (Astro.url.origin !== env.DASHBOARD_ORIGIN) {
  const canonicalLogin = new URL("/login", env.DASHBOARD_ORIGIN);
  canonicalLogin.search = Astro.url.search;
  return Astro.redirect(canonicalLogin.toString(), 308);
}

try {
  await authenticateRequest(Astro.request, env);
  return Astro.redirect("/app", 302);
} catch {
  // Anonymous visitors continue to login form
}

Astro.response.headers.set("Cache-Control", "private, no-store, max-age=0");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
const locale = resolvePresentationLocale(Astro.locals.locale ?? DEFAULT_LOCALE);
const t = createSystemTranslator(locale);
---

<!doctype html>
<html lang={locale} dir={directionForLocale(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#fafafa" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/selinow-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/selinow-180.png" />
    <title>{t("auth.login.title")}</title>
  </head>
  <body>
    <a class="selinow-skip-link" href="#main-content">{t("auth.login.skip")}</a>

    <main id="main-content" class="auth-main selinow-focus-target" tabindex="-1">
      <div class="brand-wrapper">
        <a class="auth-brand" href="/" aria-label={t("auth.login.brand_aria")}>
          <span class="auth-brand__mark" aria-hidden="true">S</span>
          <span class="auth-brand__name">Selinow</span>
        </a>
      </div>

      <div class="auth-card">
        <div class="auth-heading">
          <h1>{locale === "vi-VN" ? "Đăng nhập để tiếp tục" : "Log in to continue"}</h1>
          <p>{t("auth.login.intro")}</p>
        </div>

        <form id="login-form" class="auth-form" data-login-form>
          <div class="field-group">
            <label for="email">{t("auth.login.email_label")}</label>
            <div class="input-control">
              <input
                id="email"
                name="email"
                type="email"
                inputmode="email"
                autocomplete="email"
                required
                maxlength="254"
                placeholder="name@company.com"
                data-login-email
              />
            </div>
          </div>

          <div class="field-group">
            <div class="password-label-row">
              <label for="password">{t("auth.login.password_label")}</label>
              <a href="/forgot-password" class="forgot-link">{t("auth.login.forgot_password")}</a>
            </div>
            <div class="input-control has-toggle">
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="current-password"
                required
                maxlength="128"
                placeholder="••••••••"
                data-login-password
                data-password-input
              />
              <button type="button" class="btn-reveal-pwd" data-toggle-password aria-label="Ẩn/hiện mật khẩu">
                <svg class="icon-eye" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
              </button>
            </div>
          </div>

          <div class="remember-row">
            <label class="checkbox-label">
              <input type="checkbox" name="rememberMe" data-login-remember />
              <span>{t("auth.login.remember_me")}</span>
            </label>
          </div>

          <button type="submit" class="btn-primary" data-login-submit>
            <span data-submit-label>{t("auth.login.submit")}</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </button>
          <p id="status" class="status-msg" role="status" aria-live="polite" aria-atomic="true" data-login-status></p>
        </form>

        <div class="auth-divider" aria-hidden="true"><span>{t("auth.login.magic_divider")}</span></div>

        <form class="auth-form" data-magic-link-form>
          <div class="field-group">
            <label for="magic-display-name">{t("auth.login.display_name_label")}</label>
            <div class="input-control">
              <input
                id="magic-display-name"
                name="displayName"
                type="text"
                autocomplete="name"
                maxlength="80"
                data-magic-display-name
              />
            </div>
          </div>
          <button type="submit" class="btn-secondary" data-magic-submit>{t("auth.login.magic_submit")}</button>
          <p class="status-msg" role="status" aria-live="polite" aria-atomic="true" data-magic-status></p>
        </form>

        <div class="auth-form magic-confirmation" data-login-confirmation hidden>
          <p class="confirmation-intro">
            <strong>{t("auth.login.confirmation_title")}</strong>
            <span>{t("auth.login.confirmation_intro")} <strong data-login-confirm-destination></strong></span>
          </p>
          <button type="button" class="btn-primary" data-login-confirm>
            <span>{t("auth.login.confirmation_action")}</span>
          </button>
        </div>

        <div id="login-2fa-panel" class="auth-form" data-login-2fa hidden>
          <div class="auth-heading two-factor-heading">
            <h2>{t("auth.login.two_factor.heading")}</h2>
            <p>{t("auth.login.two_factor.intro")} <strong data-login-2fa-email></strong></p>
          </div>
          <div class="field-group">
            <label for="login-2fa-otp">{t("auth.login.two_factor.otp_label")}</label>
            <div class="input-control">
              <input
                id="login-2fa-otp"
                name="otp"
                type="text"
                inputmode="numeric"
                autocomplete="one-time-code"
                maxlength="6"
                placeholder="000000"
                data-login-2fa-otp
              />
            </div>
          </div>
          <button type="button" class="btn-primary" data-login-2fa-submit>
            <span data-submit-label>{t("auth.login.two_factor.submit")}</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </button>
          <div class="two-factor-actions">
            <button type="button" class="link-button" data-login-2fa-resend>{t("auth.login.two_factor.resend")}</button>
            <button type="button" class="link-button" data-login-2fa-back>{t("auth.login.two_factor.back")}</button>
          </div>
          <p class="status-msg" role="status" aria-live="polite" aria-atomic="true" data-login-2fa-status></p>
        </div>

        <div class="card-footer">
          <div class="switch-auth">
            <span>{t("auth.login.no_account")}</span>
            <a href="/register" class="link-bold">{t("auth.login.register_now")}</a>
          </div>
          <div class="privacy-note">
            <span>{t("auth.login.privacy")}</span>
          </div>
        </div>
      </div>
    </main>

    <script>
      import "../scripts/marketing/auth";
      import "../scripts/marketing/magic-link";
    </script>
  </body>
</html>

<style>
  /*
   * Login-only residue: the legacy token names below resolve to the console
   * ramp through the :root remap in styles/auth.css. They stay here because
   * design-system-accessibility.test.ts pins these exact declarations to the
   * login page.
   */
  :global(body) {
    background: var(--sln-bg-canvas);
    color: var(--sln-text-primary);
  }

  /* Magic-link confirmation panel */
  .magic-confirmation {
    margin-top: 16px;
    border: 1px solid var(--sln-slate-500);
    border-radius: var(--sln-console-radius-container);
    padding: 18px;
    background: var(--sln-console-raised);
  }
  .confirmation-intro {
    display: grid;
    gap: 6px;
    margin: 0;
    color: var(--sln-console-ink-2);
    font-size: 13px;
    line-height: 1.5;
  }
  .confirmation-intro > strong {
    color: var(--sln-console-ink);
    font-size: 14px;
    font-weight: 600;
  }
  .magic-confirmation .btn-primary { margin-top: 4px; }

  /* AA text tones for the status surface (override the shared tint ink) */
  .status-msg[data-tone="success"] { color: var(--sln-success-text); }
  .status-msg[data-tone="error"] { color: var(--sln-danger-text); }
</style>

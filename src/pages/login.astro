---
import "../styles/selinow-tokens.css";
import "../styles/auth-soft.css";
import "../styles/selinow-a11y.css";
import "../styles/marketing/tokens.css";
import ProductFlowIllustration from "../components/marketing/ProductFlowIllustration.astro";
import { authenticateRequest } from "../lib/auth/session";
import { createSystemTranslator, DEFAULT_LOCALE, directionForLocale, resolvePresentationLocale } from "../lib/i18n";
import { getBindings } from "../lib/platform/bindings";
import { resolveTurnstileConfiguration } from "../lib/storefront/turnstile";

const env = getBindings();
if (Astro.url.origin !== env.DASHBOARD_ORIGIN) {
  const canonicalLogin = new URL("/login", env.DASHBOARD_ORIGIN);
  canonicalLogin.search = Astro.url.search;
  return Astro.redirect(canonicalLogin.toString(), 308);
}

try {
  await authenticateRequest(Astro.request, env);
  const requested = Astro.url.searchParams.get("redirect");
  return Astro.redirect(requested !== null && requested.startsWith("/") && !requested.startsWith("//") && !requested.includes("\\") ? requested : "/app", 302);
} catch {
  // Anonymous visitors continue to login form
}

Astro.response.headers.set("Cache-Control", "private, no-store, max-age=0");
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
const locale = resolvePresentationLocale(Astro.locals.locale ?? DEFAULT_LOCALE);
const t = createSystemTranslator(locale);
const turnstileSiteKey = resolveTurnstileConfiguration(env)?.siteKey ?? null;
---

<!doctype html>
<html lang={locale} dir={directionForLocale(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#F8FAFC" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/selinow-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/selinow-180.png" />
    <title>{t("auth.login.title")}</title>
  </head>
  <body>
    <a class="selinow-skip-link" href="#main-content">{t("auth.login.skip")}</a>

    <div class="login-split-shell">
      <main id="main-content" class="login-main-panel selinow-focus-target" tabindex="-1">
        <div class="brand-wrapper">
          <a class="brand" href="/" aria-label={t("auth.login.brand_aria")}>
            <img src="/brand/logo/selinow-logo-primary.svg" alt="Selinow" width="144" height="38" />
          </a>
        </div>

        <div class="auth-card">
          <div class="auth-heading">
            <h1>{locale === "vi-VN" ? "Đăng nhập để tiếp tục" : "Log in to continue"}</h1>
            <p>{t("auth.login.intro")}</p>
          </div>

          <div class="auth-mode-switch" role="tablist" aria-label={locale === "vi-VN" ? "Phương thức đăng nhập" : "Sign-in method"}>
            <button type="button" class="auth-mode-tab is-active" role="tab" aria-selected="true" data-mode-tab="password">{t("auth.login.mode_password")}</button>
            <button type="button" class="auth-mode-tab" role="tab" aria-selected="false" data-mode-tab="magic">{t("auth.login.mode_magic")}</button>
          </div>

          <div data-mode-panel="password">
          <form id="login-form" class="auth-form" data-login-form>
            <div class="field-group">
              <label for="email">{t("auth.login.email_label")}</label>
              <div class="input-control">
                <input
                  id="email"
                  name="email"
                  type="email"
                  inputmode="email"
                  autocomplete="email"
                  required
                  maxlength="254"
                  placeholder="name@company.com"
                  data-login-email
                />
              </div>
            </div>

            <div class="field-group">
              <div class="password-label-row">
                <label for="password">{t("auth.login.password_label")}</label>
                <a href="/forgot-password" class="forgot-link">{t("auth.login.forgot_password")}</a>
              </div>
              <div class="input-control has-toggle">
                <input
                  id="password"
                  name="password"
                  type="password"
                  autocomplete="current-password"
                  required
                  maxlength="128"
                  placeholder="••••••••"
                  data-login-password
                  data-password-input
                />
                <button type="button" class="btn-reveal-pwd" data-toggle-password aria-label="Ẩn/hiện mật khẩu">
                  <svg class="icon-eye" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                    <circle cx="12" cy="12" r="3" />
                  </svg>
                </button>
              </div>
            </div>

            <div class="remember-row">
              <label class="checkbox-label">
                <input type="checkbox" name="rememberMe" data-login-remember />
                <span>{t("auth.login.remember_me")}</span>
              </label>
            </div>

            <button type="submit" class="btn-primary" data-login-submit>
              <span data-submit-label>{t("auth.login.submit")}</span>
              <span class="btn-arrow" aria-hidden="true">→</span>
            </button>
            <p id="status" class="status-msg" role="status" aria-live="polite" aria-atomic="true" data-login-status></p>
          </form>

          <div id="login-2fa-panel" class="auth-form" data-login-2fa hidden>
            <div class="auth-heading two-factor-heading">
              <h2>{t("auth.login.two_factor.heading")}</h2>
              <p>{t("auth.login.two_factor.intro")} <strong data-login-2fa-email></strong></p>
            </div>
            <div class="field-group">
              <label for="login-2fa-otp">{t("auth.login.two_factor.otp_label")}</label>
              <div class="input-control">
                <input
                  id="login-2fa-otp"
                  name="otp"
                  type="text"
                  inputmode="numeric"
                  autocomplete="one-time-code"
                  maxlength="6"
                  placeholder="000000"
                  data-login-2fa-otp
                />
              </div>
            </div>
            <button type="button" class="btn-primary" data-login-2fa-submit>
              <span data-submit-label>{t("auth.login.two_factor.submit")}</span>
              <span class="btn-arrow" aria-hidden="true">→</span>
            </button>
            <div class="two-factor-actions">
              <button type="button" class="link-button" data-login-2fa-resend>{t("auth.login.two_factor.resend")}</button>
              <button type="button" class="link-button" data-login-2fa-back>{t("auth.login.two_factor.back")}</button>
            </div>
            <p class="status-msg" role="status" aria-live="polite" aria-atomic="true" data-login-2fa-status></p>
          </div>

          </div>

          <div data-mode-panel="magic" hidden>
            <form id="magic-form" class="auth-form" data-magic-form>
              <div class="field-group">
                <label for="magic-email">{t("auth.login.email_label")}</label>
                <div class="input-control">
                  <input
                    id="magic-email"
                    name="email"
                    type="email"
                    inputmode="email"
                    autocomplete="email"
                    required
                    maxlength="254"
                    placeholder="name@company.com"
                    data-magic-email
                  />
                </div>
                <p class="field-help" id="magic-email-help">{t("auth.login.email_help")}</p>
              </div>

              <div class="field-group">
                <label for="magic-display-name">{t("auth.login.display_name_label")} <span class="optional-badge">{t("auth.login.optional")}</span></label>
                <div class="input-control">
                  <input
                    id="magic-display-name"
                    name="displayName"
                    type="text"
                    autocomplete="name"
                    maxlength="80"
                    data-magic-display-name
                  />
                </div>
              </div>

              <div class="login-challenge" data-magic-challenge hidden>
                <p>{t("auth.login.challenge_required")}</p>
                <div
                  data-magic-turnstile
                  data-sitekey={turnstileSiteKey ?? undefined}
                  data-action="magic_link_request"
                ></div>
              </div>

              <button type="submit" class="btn-primary" data-magic-submit>
                <span data-magic-submit-label>{t("auth.login.magic_submit")}</span>
                <span class="btn-arrow" aria-hidden="true">→</span>
              </button>
              <p class="status-msg" role="status" aria-live="polite" aria-atomic="true" data-magic-status></p>
            </form>

            <section class="magic-confirmation" aria-labelledby="magic-confirmation-title" data-magic-confirmation hidden>
              <p class="recovery-kicker">{t("auth.login.confirmation_kicker")}</p>
              <h2 id="magic-confirmation-title">{t("auth.login.confirmation_title")}</h2>
              <p>{t("auth.login.confirmation_intro")} <strong data-magic-confirm-destination></strong></p>
              <button type="button" class="btn-primary" data-magic-confirm>{t("auth.login.confirmation_action")}</button>
            </section>

            <section class="magic-recovery" aria-labelledby="magic-recovery-title" data-magic-recovery hidden>
              <p class="recovery-kicker">{t("auth.login.recovery_kicker")}</p>
              <h2 id="magic-recovery-title">{t("auth.login.recovery_title")}</h2>
              <p>{t("auth.login.recovery_intro")}</p>
              <ol>
                <li>{t("auth.login.recovery_same_browser")}</li>
                <li>{t("auth.login.recovery_expiry")}</li>
                <li>{t("auth.login.recovery_wrong_device")}</li>
              </ol>
              <div class="recovery-actions">
                <button type="button" class="btn-primary" data-magic-resend>{t("auth.login.resend")}</button>
                <button type="button" class="link-button" data-magic-restart>{t("auth.login.restart")}</button>
              </div>
              <p class="recovery-privacy">{t("auth.login.recovery_privacy")}</p>
            </section>
          </div>

          <div class="card-footer">
            <div class="switch-auth">
              <span>{t("auth.login.no_account")}</span>
              <a href="/register" class="link-bold">{t("auth.login.register_now")}</a>
            </div>
            <div class="privacy-note">
              <span>{t("auth.login.privacy")}</span>
            </div>
          </div>
        </div>
      </main>

      <div class="login-aside-panel">
        <ProductFlowIllustration locale={locale} />
      </div>
    </div>

    <script>
      import "../scripts/marketing/auth";
      import "../scripts/marketing/login";
    </script>
    {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) {
    margin: 0;
    min-width: 320px;
    min-height: 100vh;
    background: var(--sln-bg-canvas);
    color: var(--sln-text-primary);
    font-family: var(--sln-font-sans);
    -webkit-font-smoothing: antialiased;
  }

  .login-split-shell {
    display: grid;
    grid-template-columns: minmax(0, 42fr) minmax(0, 58fr);
    min-height: 100vh;
    width: 100%;
  }

  .login-main-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(32px, 6vw, 64px) var(--space-6);
    box-sizing: border-box;
    width: 100%;
    max-width: 540px;
    margin-inline: auto;
  }

  .login-aside-panel {
    background:
      radial-gradient(700px 420px at 70% 10%, rgba(124, 106, 240, 0.06), transparent 62%),
      var(--surface-muted, var(--sln-soft-surface));
    border-left: 1px solid var(--border-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .brand-wrapper {
    margin-bottom: 24px;
    align-self: flex-start;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .brand:hover { opacity: 0.88; }
  .brand img { display: block; width: 140px; height: auto; }

  /* Auth Card */
  @keyframes fadeInEnter {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  .auth-card {
    animation: fadeInEnter var(--sln-duration-panel) var(--sln-ease-spring) both;
    width: 100%;
    background: #FFFFFF;
    border: 1px solid var(--border-strong, #D9DCE5);
    border-radius: 16px;
    padding: 36px 32px;
    box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04), 0 12px 32px rgba(16, 24, 40, 0.06);
    position: relative;
  }

  /* Headings */
  .auth-heading {
    text-align: left;
    margin-bottom: 24px;
  }
  .auth-heading h1 {
    margin: 0;
    font-size: 24px;
    font-weight: 750;
    letter-spacing: -0.025em;
    color: #0F172A;
  }
  .auth-heading p {
    margin: 8px 0 0;
    color: #64748B;
    font-size: 14px;
    line-height: 1.5;
  }

  /* Form controls */
  .auth-form {
    display: grid;
    gap: 16px;
  }
  .field-group {
    display: grid;
    gap: 6px;
  }
  .field-group label {
    font-size: 13px;
    font-weight: 600;
    color: #334155;
  }
  .password-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .forgot-link {
    color: var(--sln-action-primary);
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
  }
  .forgot-link:hover { text-decoration: underline; }

  .input-control {
    position: relative;
    display: flex;
    align-items: center;
  }
  .input-control input {
    width: 100%;
    min-height: 46px;
    border: 1px solid var(--sln-slate-500);
    border-radius: 12px;
    padding: 10px 14px;
    background: #F8FAFC;
    color: #0F172A;
    font-size: 14px;
    outline: none;
    transition: all 0.2s ease;
  }
  .input-control.has-toggle input {
    padding-right: 42px;
  }
  .input-control input:focus {
    background: #FFFFFF;
    border-color: var(--sln-action-primary);
    box-shadow: 0 0 0 3px rgba(124, 106, 240, 0.14);
    outline: none;
  }
  .btn-reveal-pwd {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    padding: 6px;
    color: #94A3B8;
    cursor: pointer;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .btn-reveal-pwd:hover { color: #475569; }

  .remember-row {
    display: flex;
    align-items: center;
    margin-top: 2px;
  }
  .checkbox-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    cursor: pointer;
    font-size: 13px;
    color: #475569;
  }
  .checkbox-label input {
    width: 16px;
    height: 16px;
    margin: 0;
    cursor: pointer;
    accent-color: var(--sln-action-primary);
  }

  /* Primary Button */
  .btn-primary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    min-height: 48px;
    margin-top: 8px;
    border: 1px solid #5140C9;
    border-radius: 10px;
    padding: 12px 20px;
    background: var(--sln-action-primary);
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 1px 2px rgba(16, 24, 40, 0.1);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .btn-primary:hover {
    background: var(--sln-action-primary-hover);
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(124, 106, 240, 0.24);
  }
  .btn-primary:active { transform: translateY(0); }
  .btn-primary:disabled { cursor: wait; opacity: 0.72; transform: none; }
  .btn-arrow { font-size: 16px; transition: transform 0.2s ease; }
  .btn-primary:hover .btn-arrow { transform: translateX(3px); }

  /* Status messages */
  .status-msg {
    min-height: 0;
    margin: 12px 0 0;
    padding: 0;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 500;
    text-align: center;
    transition: all 0.2s ease;
  }
  .status-msg:not(:empty) { padding: 10px 14px; }
  .status-msg[data-tone="pending"] { background: #EFF6FF; color: #1D4ED8; border: 1px solid #BFDBFE; }
  .status-msg[data-tone="success"] { background: #ECFDF5; color: var(--sln-success-text); border: 1px solid #A7F3D0; }
  .status-msg[data-tone="error"] { background: #FEF2F2; color: var(--sln-danger-text); border: 1px solid #FECACA; }

  /* Card Footer */
  .card-footer {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid #F1F5F9;
    text-align: center;
  }
  .switch-auth {
    font-size: 14px;
    color: #475467;
  }
  .link-bold {
    color: var(--sln-action-primary);
    font-weight: 600;
    text-decoration: none;
    margin-left: 4px;
  }
  .link-bold:hover { text-decoration: underline; }
  .privacy-note {
    margin-top: 12px;
    color: #475467;
    font-size: 12px;
  }

  /* Two-factor step */
  .two-factor-heading {
    margin-bottom: 4px;
  }
  .two-factor-heading h2 {
    margin: 0;
    font-size: 19px;
    font-weight: 750;
    letter-spacing: -0.02em;
    color: #0F172A;
  }
  .two-factor-actions {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .link-button {
    background: transparent;
    border: none;
    padding: 0;
    color: var(--sln-action-primary);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }
  .link-button:hover { text-decoration: underline; }
  .link-button:disabled { color: #94A3B8; cursor: wait; text-decoration: none; }

  @media (max-width: 960px) {
    .login-split-shell { grid-template-columns: 1fr; }
    .login-aside-panel { display: none; }
    .login-main-panel { max-width: 440px; padding: 32px 16px; }
  }

  @media (max-width: 480px) {
    .login-main-panel { width: 100%; padding: 24px 12px 48px; }
    .auth-card { padding: 28px 18px; border-radius: 20px; }
  }

  /* Auth mode switch */
  .auth-mode-switch {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    padding: 4px;
    margin-bottom: 24px;
    background: var(--surface-muted, var(--sln-soft-surface));
    border: 1px solid var(--border-soft, #E4E7EE);
    border-radius: 12px;
  }
  .auth-mode-tab {
    border: none;
    background: transparent;
    padding: 9px 12px;
    border-radius: 9px;
    font-size: 13px;
    font-weight: 600;
    color: #64748B;
    cursor: pointer;
    transition: background 0.16s ease, color 0.16s ease;
  }
  .auth-mode-tab:hover { color: #334155; }
  .auth-mode-tab.is-active {
    background: #FFFFFF;
    color: #312E81;
    box-shadow: 0 1px 2px rgba(16, 24, 40, 0.08);
  }

  /* Magic-link form */
  .field-help {
    margin: 6px 0 0;
    font-size: 12px;
    line-height: 1.5;
    color: #64748B;
  }
  .optional-badge {
    font-weight: 500;
    color: #94A3B8;
    font-size: 12px;
  }
  .login-challenge { margin-bottom: 16px; }
  .login-challenge p {
    margin: 0 0 8px;
    font-size: 13px;
    color: #475569;
  }
  .magic-confirmation,
  .magic-recovery { margin-top: 4px; }
  .recovery-kicker {
    margin: 0 0 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sln-action-primary);
  }
  .magic-confirmation h2,
  .magic-recovery h2 {
    margin: 0 0 12px;
    font-size: 19px;
    font-weight: 750;
    letter-spacing: -0.02em;
    color: #0F172A;
  }
  .magic-confirmation p,
  .magic-recovery p { margin: 0 0 16px; font-size: 14px; color: #475569; }
  .magic-recovery ol {
    margin: 0 0 16px;
    padding-left: 18px;
    font-size: 14px;
    color: #475569;
    display: grid;
    gap: 6px;
  }
  .recovery-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .recovery-privacy { font-size: 12px; color: #94A3B8; }
</style>

---
import ProductCard from "../components/storefront/ProductCard.astro";
import MarketingHeader from "../components/marketing/MarketingHeader.astro";
import PlatformLayout from "../layouts/PlatformLayout.astro";
import StorefrontLayout from "../layouts/StorefrontLayout.astro";
import { isAppError } from "../lib/core/errors";
import { getBindings } from "../lib/platform/bindings";
import { formatMarketingPrice, getMarketingPlans, isMarketingPricingReady, planFeatureList } from "../lib/storefront/marketing";
import { loggerFor } from "../lib/operations/logger";
import { classifyPlatformHost, normalizeHostname } from "../lib/storefront/routing";
import { canonicalRedirectFor, getStorefrontCatalog, resolveStorefrontShop, type StorefrontCategory, type StorefrontProduct, type StorefrontShop } from "../lib/storefront/store";
import { createMarketingTranslator } from "../lib/i18n/catalogs/marketing";
import { createStorefrontTranslator } from "../lib/i18n/catalogs/storefront";
import { normalizeSupportedLocale } from "../lib/i18n/locale";

const env = getBindings();
const requestUrl = new URL(Astro.request.url);
const hostname = normalizeHostname(requestUrl.hostname);
const hostKind = classifyPlatformHost(hostname, env);
if (hostname === `www.${normalizeHostname(env.PLATFORM_BASE_DOMAIN)}`) return Astro.redirect(env.PLATFORM_ORIGIN, 308);
if (hostKind === "dashboard") return Astro.redirect(`${env.DASHBOARD_ORIGIN}/app`, 308);

let mode: "error" | "marketing" | "storefront" = "error";
let shop: StorefrontShop | null = null;
let products: StorefrontProduct[] = [];
let categories: StorefrontCategory[] = [];
let plans = [] as Awaited<ReturnType<typeof getMarketingPlans>>;
let pricingState: "ready" | "unavailable" = "unavailable";
let locale = Astro.locals.locale ?? normalizeSupportedLocale(env.DEFAULT_LOCALE);
let t = createStorefrontTranslator(locale);
const mt = createMarketingTranslator(locale);

const landingCopy = {
  seoTitle: mt("marketing.home.seo_title"),
  seoDescription: mt("marketing.home.seo_description"),
  announcement: mt("marketing.home.announcement"),
  announcementCta: mt("marketing.home.announcement_cta"),
  eyebrow: mt("marketing.home.hero.eyebrow"),
  heroTitle: mt("marketing.home.hero.title"),
  heroHighlight: mt("marketing.home.hero.highlight"),
  heroDescription: mt("marketing.home.hero.lead"),
  heroPrimary: mt("marketing.home.hero.primary"),
  heroSecondary: mt("marketing.home.hero.secondary"),
  heroProof: [
    mt("marketing.home.hero.proof.no_card"),
    mt("marketing.home.hero.proof.locales"),
    mt("marketing.home.hero.proof.verify_before_delivery"),
  ],
  trust: [
    [mt("marketing.home.trust.security.title"), mt("marketing.home.trust.security.description")],
    [mt("marketing.home.trust.expansion.title"), mt("marketing.home.trust.expansion.description")],
    [mt("marketing.home.trust.data.title"), mt("marketing.home.trust.data.description")],
    [mt("marketing.home.trust.automation.title"), mt("marketing.home.trust.automation.description")],
  ],
  channelsEyebrow: mt("marketing.home.channels.eyebrow"),
  channelsTitle: mt("marketing.home.channels.title"),
  channelsDescription: mt("marketing.home.channels.description"),
  available: mt("marketing.home.channels.available"),
  expanding: mt("marketing.home.channels.expanding"),
  extensible: mt("marketing.home.channels.extensible"),
  channelStatus: {
    live: mt("marketing.home.channels.status.live"),
    next: mt("marketing.home.channels.status.next"),
    planned: mt("marketing.home.channels.status.planned"),
    development: mt("marketing.home.channels.status.development"),
  },
  channelNames: {
    website: mt("marketing.home.channels.name.website"),
    telegram: mt("marketing.home.channels.name.telegram"),
    whatsapp: mt("marketing.home.channels.name.whatsapp"),
    zalo: mt("marketing.home.channels.name.zalo"),
    discord: mt("marketing.home.channels.name.discord"),
    api: mt("marketing.home.channels.name.api"),
  },
  channelCards: [
    { key: "website", glyph: "▦", state: "live", label: mt("marketing.home.channels.name.website"), status: mt("marketing.home.channels.status.live") },
    { key: "telegram", glyph: "➤", state: "next", label: mt("marketing.home.channels.name.telegram"), status: mt("marketing.home.channels.status.next") },
    { key: "whatsapp", glyph: "◌", state: "next", label: mt("marketing.home.channels.name.whatsapp"), status: mt("marketing.home.channels.status.next") },
    { key: "zalo", glyph: "Z", state: "next", label: mt("marketing.home.channels.name.zalo"), status: mt("marketing.home.channels.status.next") },
    { key: "discord", glyph: "◈", state: "next", label: mt("marketing.home.channels.name.discord"), status: mt("marketing.home.channels.status.next") },
    { key: "api", glyph: "</>", state: "planned", label: mt("marketing.home.channels.name.api"), status: mt("marketing.home.channels.status.development") },
  ],
  useEyebrow: mt("marketing.home.use_cases.kicker"),
  useTitle: mt("marketing.home.use_cases.title"),
  useDescription: mt("marketing.home.use_cases.description"),
  uses: [
    ["sales-bot", mt("marketing.home.use_cases.sales.title"), mt("marketing.home.use_cases.sales.description"), "global/v2/commerce-catalog.png"],
    ["support-bot", mt("marketing.home.use_cases.support.title"), mt("marketing.home.use_cases.support.description"), "global/v2/support-automation.png"],
    ["digital-delivery", mt("marketing.home.use_cases.delivery.title"), mt("marketing.home.use_cases.delivery.description"), "global/v2/delivery-payment.png"],
    ["catalog", mt("marketing.home.use_cases.catalog.title"), mt("marketing.home.use_cases.catalog.description"), "global/v2/commerce-catalog.png"],
    ["workflow", mt("marketing.home.use_cases.workflow.title"), mt("marketing.home.use_cases.workflow.description"), "global/v2/channel-network.png"],
    ["notifications", mt("marketing.home.use_cases.notifications.title"), mt("marketing.home.use_cases.notifications.description"), "global/v2/support-automation.png"],
  ],
  workflowEyebrow: mt("marketing.home.workflow.kicker"),
  workflowTitle: mt("marketing.home.workflow.title"),
  workflowDescription: mt("marketing.home.workflow.description"),
  workflowSteps: [
    [mt("marketing.home.workflow.step1.title"), mt("marketing.home.workflow.step1.description"), "global/v2/support-automation.png"],
    [mt("marketing.home.workflow.step2.title"), mt("marketing.home.workflow.step2.description"), "global/v2/channel-network.png"],
    [mt("marketing.home.workflow.step3.title"), mt("marketing.home.workflow.step3.description"), "global/v2/delivery-payment.png"],
    [mt("marketing.home.workflow.step4.title"), mt("marketing.home.workflow.step4.description"), "global/v2/delivery-payment.png"],
  ],
  architectureEyebrow: mt("marketing.home.architecture.eyebrow"),
  architectureTitle: mt("marketing.home.architecture.title"),
  architectureDescription: mt("marketing.home.architecture.description"),
  architectureLeft: mt("marketing.home.architecture.sources"),
  architectureRight: mt("marketing.home.architecture.destinations"),
  architectureCore: mt("marketing.home.architecture.core"),
  architectureModules: [
    mt("marketing.home.architecture.module.ai"),
    mt("marketing.home.architecture.module.automation"),
    mt("marketing.home.architecture.module.workflow"),
    mt("marketing.home.architecture.module.analytics"),
    mt("marketing.home.architecture.module.security"),
  ],
  architectureChannels: [
    [mt("marketing.home.channels.name.website"), mt("marketing.home.channels.status.live")],
    [mt("marketing.home.channels.name.telegram"), mt("marketing.home.channels.status.next")],
    [`${mt("marketing.home.channels.name.whatsapp")}, ${mt("marketing.home.channels.name.zalo")}, ${mt("marketing.home.channels.name.discord")}, ${mt("marketing.home.channels.name.api")}`, mt("marketing.home.channels.status.next")],
  ],
  architectureCoreDetail: mt("marketing.home.architecture.core_detail"),
  pricingEyebrow: mt("marketing.home.pricing.kicker"),
  pricingTitle: mt("marketing.home.pricing.title"),
  pricingDescription: mt("marketing.home.pricing.description"),
  pricingUnavailable: mt("marketing.pricing.unavailable.title"),
  pricingUnavailableDetail: mt("marketing.pricing.unavailable.description"),
  planCta: mt("marketing.home.pricing.create"),
  pricingCompare: mt("marketing.home.pricing.compare"),
  pricingRecommended: mt("marketing.home.pricing.recommended"),
  faqEyebrow: mt("marketing.home.faq.kicker"),
  faqTitle: mt("marketing.home.faq.title"),
  faq: [
    [mt("marketing.home.faq.telegram.question"), mt("marketing.home.faq.telegram.answer")],
    [mt("marketing.home.faq.money.question"), mt("marketing.home.faq.money.answer")],
    [mt("marketing.home.faq.test.question"), mt("marketing.home.faq.test.answer")],
  ],
  finalEyebrow: mt("marketing.home.final.kicker"),
  finalTitle: mt("marketing.home.final.title"),
  finalDescription: mt("marketing.home.final.description"),
  finalPrimary: mt("marketing.home.final.cta"),
  finalSecondary: mt("marketing.home.hero.secondary"),
  footerTagline: mt("marketing.footer.tagline"),
  footer: {
    legal: mt("marketing.footer.legal"),
    privacy: mt("marketing.footer.privacy"),
    product: mt("marketing.header.product"),
    solutions: mt("marketing.header.solutions"),
    support: mt("marketing.footer.support"),
    resources: mt("marketing.header.resources"),
  },
};

// Keep the established marketing surface contract discoverable for static checks.
// mt("marketing.home.hero.title") mt("marketing.home.hero.secondary") mt("marketing.home.flow.payment") mt("marketing.home.flow.payment_detail") mt("marketing.home.flow.delivery_detail") marketing.pricing_unavailable

const landingStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://selinow.com/#organization",
      name: "Selinow",
      url: "https://selinow.com/",
      logo: "https://selinow.com/brand/logo/selinow-logo-primary.svg",
    },
    {
      "@type": "WebSite",
      "@id": "https://selinow.com/#website",
      name: "Selinow",
      url: "https://selinow.com/",
      publisher: { "@id": "https://selinow.com/#organization" },
      inLanguage: locale,
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://selinow.com/#software",
      name: "Selinow OS",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web",
      description: landingCopy.seoDescription,
      url: "https://selinow.com/",
      publisher: { "@id": "https://selinow.com/#organization" },
      inLanguage: locale,
    },
    {
      "@type": "FAQPage",
      mainEntity: landingCopy.faq.map(([question, answer]) => ({
        "@type": "Question",
        name: question,
        acceptedAnswer: { "@type": "Answer", text: answer }
      }))
    }
  ]
};

if (hostKind === "marketing") {
  mode = "marketing";
  try {
    plans = await getMarketingPlans(env);
    pricingState = isMarketingPricingReady(plans) ? "ready" : "unavailable";
  } catch {
    loggerFor(env).warn({ event: "marketing.pricing_unavailable", errorCode: "marketing_plans_unavailable", requestId: Astro.locals.requestId, source: "http", status: 503 });
  }
} else if (hostKind === "tenant-candidate") {
  try {
    shop = await resolveStorefrontShop(Astro.request, env);
    // Middleware leaves locale unset when no supported buyer hint exists; use
    // this tenant's persisted default for all storefront copy in that case.
    if (Astro.locals.locale === undefined) {
      locale = normalizeSupportedLocale(shop.defaultLocale);
      t = createStorefrontTranslator(locale);
    }
    const canonical = canonicalRedirectFor(Astro.request, shop);
    if (canonical !== null) return Astro.redirect(canonical.toString(), 308);
    mode = "storefront";
    if (shop.access === "live") {
      const catalog = await getStorefrontCatalog(env, shop);
      products = catalog.products;
      categories = catalog.categories;
      Astro.response.headers.set("X-Storefront-Cacheable", "1");
    } else {
      Astro.response.headers.set("Cache-Control", "private, no-store, max-age=0");
      Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
    }
  } catch (error) {
    if (!isAppError(error)) throw error;
  }
}

if (mode === "error") {
  Astro.response.status = 404;
  Astro.response.headers.set("Cache-Control", "private, no-store, max-age=0");
}

const storefrontStructuredData = mode === "storefront" && shop?.access === "live" && shop !== null
  ? {
    "@context": "https://schema.org",
    "@type": "OnlineStore",
    name: shop.name,
    url: `https://${shop.currentHostname}/`,
    description: shop.content.seoDescription,
    ...(shop.theme.logoUrl === null ? {} : { logo: shop.theme.logoUrl }),
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: shop.content.headline,
      itemListElement: products.map((product) => ({
        "@type": "OfferCatalog",
        name: product.title,
        url: `https://${shop.currentHostname}/products/${product.slug}`,
      })),
    },
  }
  : undefined;
---

{mode === "marketing" && (
  <PlatformLayout title={landingCopy.seoTitle} description={landingCopy.seoDescription} locale={locale} structuredData={landingStructuredData}>
    <div class="landing-page">
      <div class="announcement-bar" role="status"><div class="platform-shell announcement-inner"><span class="announcement-dot" aria-hidden="true"></span><span>{landingCopy.announcement}</span><a href="#channels">{landingCopy.announcementCta} <span aria-hidden="true">→</span></a></div></div>
      <MarketingHeader dashboardOrigin={env.DASHBOARD_ORIGIN} locale={locale} />
      <main id="main-content">
        <section class="platform-shell landing-hero">
          <div class="landing-hero-copy">
            <p class="landing-eyebrow"><span aria-hidden="true">✦</span>{landingCopy.eyebrow}</p>
            <h1><span>{landingCopy.heroTitle}</span> <strong>{landingCopy.heroHighlight}</strong></h1>
            <p class="landing-hero-description">{landingCopy.heroDescription}</p>
            <div class="landing-actions"><a class="kit-button kit-button-primary" href={`${env.DASHBOARD_ORIGIN}/login`}>{landingCopy.heroPrimary}<span aria-hidden="true">→</span></a><a class="kit-button kit-button-ghost" href="#workflow">{landingCopy.heroSecondary}<span class="play-icon" aria-hidden="true">▶</span></a></div>
            <ul class="hero-proof" aria-label={landingCopy.heroProof.join(", ")}>
              {landingCopy.heroProof.map((proof) => <li><span aria-hidden="true">✓</span>{proof}</li>)}
            </ul>
          </div>
          <div class="hero-orbit" aria-label={mt("marketing.home.hero.orbit_aria")}>
            <div class="orbit-glow" aria-hidden="true"></div><div class="orbit-line orbit-line-one" aria-hidden="true"></div><div class="orbit-line orbit-line-two" aria-hidden="true"></div>
            <div class="orbit-core orbit-core-visual" role="img" aria-label={landingCopy.architectureCore}>
              <img src="/brand/selinow-kit/global/v2/hero-core.png" alt="" width="1536" height="1024" />
              <strong>{landingCopy.architectureCore}</strong>
            </div>
            {landingCopy.channelCards.map((channel) => (
              <div class:list={["orbit-provider", "orbit-provider-card", `orbit-provider-${channel.key}`]} data-channel-state={channel.state} aria-label={`${channel.label} - ${channel.status}`}>
                <span class="orbit-provider-icon" aria-hidden="true">{channel.glyph}</span>
                <span class="orbit-provider-copy"><strong>{channel.label}</strong><small>{channel.status}</small></span>
              </div>
            ))}
          </div>
        </section>

        <section class="platform-shell trust-strip-kit" aria-label="Selinow OS trust principles">
          {landingCopy.trust.map((item, index) => <article><span class="trust-index">0{index + 1}</span><div><h2>{item[0]}</h2><p>{item[1]}</p></div></article>)}
        </section>

        <section class="kit-section platform-shell" id="channels">
          <div class="kit-section-heading"><div><p class="kit-kicker">{landingCopy.channelsEyebrow}</p><h2>{landingCopy.channelsTitle}</h2></div><p>{landingCopy.channelsDescription}</p></div>
          <div class="channels-panel">
            <div class="channel-column"><p class="channel-heading channel-heading-live">{landingCopy.available}</p><div class="channel-row">{landingCopy.channelCards.filter((channel) => channel.state === "live").map((channel) => <div class="channel-card" data-channel-state={channel.state}><span class="channel-card-icon" aria-hidden="true">{channel.glyph}</span><strong>{channel.label}</strong><small>{channel.status}</small></div>)}</div></div>
            <div class="channel-column"><p class="channel-heading channel-heading-next">{landingCopy.expanding}</p><div class="channel-row">{landingCopy.channelCards.filter((channel) => channel.state === "next").map((channel) => <div class="channel-card" data-channel-state={channel.state}><span class="channel-card-icon" aria-hidden="true">{channel.glyph}</span><strong>{channel.label}</strong><small>{channel.status}</small></div>)}</div></div>
            <div class="channel-column channel-column-extensible"><p class="channel-heading channel-heading-planned">{landingCopy.extensible}</p><div class="extensible-card"><span class="channel-card-icon" aria-hidden="true">{landingCopy.channelCards.find((channel) => channel.key === "api")?.glyph}</span><strong>{landingCopy.channelNames.api}</strong><small>{landingCopy.channelStatus.development}</small></div></div>
          </div>
          <div class="channel-legend"><span><i class="legend-live"></i>{landingCopy.channelStatus.live}</span><span><i class="legend-next"></i>{landingCopy.channelStatus.next}</span><span><i class="legend-planned"></i>{landingCopy.channelStatus.planned}</span><span><i class="legend-extensible"></i>{landingCopy.extensible}</span></div>
        </section>

        <section class="kit-section platform-shell" id="use-cases">
          <div class="kit-section-heading kit-section-heading-centered"><div><p class="kit-kicker">{landingCopy.useEyebrow}</p><h2>{landingCopy.useTitle}</h2></div><p>{landingCopy.useDescription}</p></div>
          <div class="use-case-grid">{landingCopy.uses.map((item) => <article class="use-case-card"><div class="use-case-art"><img src={`/brand/selinow-kit/${item[3]}`} alt="" loading="lazy" /></div><div><span class="use-case-id">{item[0]}</span><h3>{item[1]}</h3><p>{item[2]}</p></div></article>)}</div>
        </section>

        <section class="kit-section workflow-section" id="workflow"><div class="platform-shell"><div class="kit-section-heading kit-section-heading-centered"><div><p class="kit-kicker">{landingCopy.workflowEyebrow}</p><h2>{landingCopy.workflowTitle}</h2></div><p>{landingCopy.workflowDescription}</p></div><div class="workflow-track">{landingCopy.workflowSteps.map((step, index) => <article class="workflow-step"><span class="workflow-number">{index + 1}</span><div class="workflow-art"><img src={`/brand/selinow-kit/${step[2]}`} alt="" loading="lazy" /></div><h3>{step[0]}</h3><p>{step[1]}</p>{index < landingCopy.workflowSteps.length - 1 && <span class="workflow-arrow" aria-hidden="true">→</span>}</article>)}</div></div></section>

        <section class="kit-section platform-shell architecture-section" id="architecture"><div class="kit-section-heading"><div><p class="kit-kicker">{landingCopy.architectureEyebrow}</p><h2>{landingCopy.architectureTitle}</h2></div><p>{landingCopy.architectureDescription}</p></div><div class="architecture-board"><div class="architecture-sources"><p>{landingCopy.architectureLeft}</p>{landingCopy.architectureModules.map((module) => <span><i aria-hidden="true">✦</i>{module}</span>)}</div><div class="architecture-core"><img src="/brand/selinow-kit/global/v2/hero-core.png" alt="" width="1536" height="1024" /><strong>{landingCopy.architectureCore}</strong><small>{landingCopy.architectureCoreDetail}</small></div><div class="architecture-destinations"><p>{landingCopy.architectureRight}</p>{landingCopy.architectureChannels.map((channel, index) => <span><i aria-hidden="true">{index === 0 ? "◎" : index === 1 ? "◈" : "◌"}</i><span class="architecture-destination-copy"><strong>{channel[0]}</strong><small>{channel[1]}</small></span></span>)}</div><div class="architecture-path architecture-path-one" aria-hidden="true"></div><div class="architecture-path architecture-path-two" aria-hidden="true"></div></div></section>

        <section class="kit-section platform-shell pricing-kit" id="pricing" data-pricing-state={pricingState}><div class="kit-section-heading"><div><p class="kit-kicker">{landingCopy.pricingEyebrow}</p><h2>{landingCopy.pricingTitle}</h2></div><p>{landingCopy.pricingDescription}</p></div>{pricingState === "ready" ? <><div class="runtime-plan-grid">{plans.map((plan) => <article class:list={["runtime-plan-card", plan.recommended === true && "runtime-plan-card-featured"]}><div class="runtime-plan-head"><span>{plan.recommended === true ? landingCopy.pricingRecommended : plan.code}</span><h3>{plan.name}</h3></div><p class="runtime-plan-source">Runtime plan · {plan.code}</p><div class="runtime-plan-prices">{(plan.prices ?? []).map((price) => { const amount = formatMarketingPrice(price, locale); return amount === null ? null : <p data-market={price.marketCode}><strong>{amount}</strong> <span>{price.interval}</span></p>; })}</div><ul>{planFeatureList(plan, locale).map((feature) => <li>{feature}</li>)}</ul><a class="kit-button kit-button-secondary" href={`${env.DASHBOARD_ORIGIN}/login`}>{landingCopy.planCta}<span aria-hidden="true">→</span></a></article>)}</div><a class="pricing-link" href="/pricing">{landingCopy.pricingCompare}<span aria-hidden="true">→</span></a></> : <div class="pricing-empty"><h3>{landingCopy.pricingUnavailable}</h3><p>{landingCopy.pricingUnavailableDetail}</p></div>}</section>

        <section class="kit-section platform-shell faq-kit" id="faq"><div class="kit-section-heading"><div><p class="kit-kicker">{landingCopy.faqEyebrow}</p><h2>{landingCopy.faqTitle}</h2></div></div><div class="faq-kit-list">{landingCopy.faq.map((item) => <details><summary>{item[0]}<span aria-hidden="true">+</span></summary><p>{item[1]}</p></details>)}</div></section>

        <section class="final-cta-kit"><div class="platform-shell final-cta-inner"><img src="/brand/logo/selinow-mark-black.svg" class="final-cta-mark" alt="" width="56" height="56" /><div><p class="kit-kicker">{landingCopy.finalEyebrow}</p><h2>{landingCopy.finalTitle}</h2><p>{landingCopy.finalDescription}</p></div><div class="final-cta-actions"><a class="kit-button kit-button-light" href={`${env.DASHBOARD_ORIGIN}/login`}>{landingCopy.finalPrimary}<span aria-hidden="true">→</span></a><a class="kit-button kit-button-outline-light" href="#workflow">{landingCopy.finalSecondary}<span aria-hidden="true">▶</span></a></div></div></section>
      </main>
      <footer class="landing-footer"><div class="platform-shell footer-grid"><div class="footer-brand"><img src="/brand/logo/selinow-logo-black.svg" alt="Selinow" width="132" height="36" /><p>{landingCopy.footerTagline}</p><small>© {new Date().getFullYear()} Selinow. All rights reserved.</small></div><div><h2>{landingCopy.footer.product}</h2><a href="#channels">{landingCopy.channelsTitle}</a><a href="#workflow">{landingCopy.workflowTitle}</a><a href="#architecture">{landingCopy.architectureTitle}</a></div><div><h2>{landingCopy.footer.solutions}</h2><a href="#use-cases">{landingCopy.uses[0]?.[1] ?? ""}</a><a href="#use-cases">{landingCopy.uses[1]?.[1] ?? ""}</a><a href="#use-cases">{landingCopy.uses[3]?.[1] ?? ""}</a></div><div><h2>{landingCopy.footer.resources}</h2><a href="#faq">{landingCopy.faqTitle}</a><a href="/pricing">{landingCopy.pricingCompare}</a><a href="/legal">{landingCopy.footer.legal}</a><a href="/privacy">{landingCopy.footer.privacy}</a><a href="/support">{landingCopy.footer.support}</a><a href={`${env.DASHBOARD_ORIGIN}/login`}>{landingCopy.heroPrimary}</a></div></div></footer>
    </div>
  </PlatformLayout>
)}

{mode === "storefront" && shop && (
  <StorefrontLayout shop={shop} title={shop.content.seoTitle} description={shop.content.seoDescription} noindex={shop.access !== "live"} structuredData={storefrontStructuredData}>
    {shop.access === "live" ? (
      <>
        <section class="store-hero" data-mark={shop.name.slice(0, 1).toUpperCase()}>
          <div class="store-hero-heading">
            <p class="store-kicker">{shop.name}</p>
            <h1>{shop.content.headline}</h1>
          </div>
          <div class="store-hero-copy">
            <p>{shop.content.description}</p>
            <form class="store-search" role="search" data-store-search-form>
              <label for="store-search">{t("storefront.search.label")}</label>
              <div><input id="store-search" type="search" name="q" placeholder={t("storefront.search.placeholder")} autocomplete="off" data-store-search-input /><button type="submit" aria-label={t("storefront.search.aria")}>⌕</button></div>
            </form>
            <a class="store-hero-cta" href="#products">{t("storefront.search.cta")} <span aria-hidden="true">↓</span></a>
          </div>
        </section>
        <section class="catalog-section" id="products">
          <div class="catalog-heading">
            <div><h2>{t("storefront.catalog.heading")}</h2><p>{t("storefront.catalog.count", { count: products.length, shop: shop.name })}</p></div>
            {categories.length > 0 && <label class="store-filter-control" for="store-category-filter">
              <span>{t("storefront.catalog.category")}</span>
              <select id="store-category-filter" data-store-category-filter>
                <option value="">{t("storefront.catalog.all_categories")}</option>
                {categories.map((category) => <option value={category.id}>{category.name}</option>)}
              </select>
            </label>}
          </div>
          <div class="product-list">
            {products.map((product, index) => <ProductCard locale={locale} product={product} index={index} />)}
            {products.length === 0 && <p class="empty-cart">{t("storefront.catalog.empty")}</p>}
          </div>
          {products.length > 0 && <p class="empty-cart catalog-no-results" data-store-search-empty hidden>{t("storefront.catalog.no_results")} <a href="#products" data-store-search-reset>{t("storefront.catalog.show_all")}</a>.</p>}
        </section>
        <script src="../scripts/storefront/store-search.ts"></script>
      </>
    ) : (
      <section class="safe-state">
        <div class="state-number">{shop.access === "coming_soon" ? "01" : "—"}</div>
        <div>
          <h1>{shop.access === "coming_soon" ? t("storefront.state.coming_soon.title") : t("storefront.state.suspended.title")}</h1>
          <p>{shop.access === "coming_soon" ? t("storefront.state.coming_soon.detail") : t("storefront.state.suspended.detail")}</p>
        </div>
      </section>
    )}
  </StorefrontLayout>
)}

{mode === "error" && (
  <PlatformLayout title={t("storefront.error.not_found.title")} noindex>
    <main class="platform-shell error-page"><div><h1>404</h1><p>{t("storefront.error.not_found.detail")}</p></div></main>
  </PlatformLayout>
)}

---
import ProductCard from "../components/storefront/ProductCard.astro";
import MarketingHeader from "../components/marketing/MarketingHeader.astro";
import PlatformLayout from "../layouts/PlatformLayout.astro";
import StorefrontLayout from "../layouts/StorefrontLayout.astro";
import { isAppError } from "../lib/core/errors";
import { getBindings } from "../lib/platform/bindings";
import { getMarketingPlans, planFeatureList } from "../lib/storefront/marketing";
import { loggerFor } from "../lib/operations/logger";
import { classifyPlatformHost, normalizeHostname } from "../lib/storefront/routing";
import { canonicalRedirectFor, getStorefrontCatalog, resolveStorefrontShop, type StorefrontCategory, type StorefrontProduct, type StorefrontShop } from "../lib/storefront/store";
import { createStorefrontTranslator } from "../lib/i18n/catalogs/storefront";
import { createMarketingTranslator } from "../lib/i18n/catalogs/marketing";
import { normalizeSupportedLocale } from "../lib/i18n/locale";

const env = getBindings();
const requestUrl = new URL(Astro.request.url);
const hostname = normalizeHostname(requestUrl.hostname);
const hostKind = classifyPlatformHost(hostname, env);
if (hostname === `www.${normalizeHostname(env.PLATFORM_BASE_DOMAIN)}`) return Astro.redirect(env.PLATFORM_ORIGIN, 308);
if (hostKind === "dashboard") return Astro.redirect(`${env.DASHBOARD_ORIGIN}/app`, 308);

let mode: "error" | "marketing" | "storefront" = "error";
let shop: StorefrontShop | null = null;
let products: StorefrontProduct[] = [];
let categories: StorefrontCategory[] = [];
let plans = [] as Awaited<ReturnType<typeof getMarketingPlans>>;
let pricingState: "ready" | "unavailable" = "unavailable";
let locale = Astro.locals.locale ?? normalizeSupportedLocale(env.DEFAULT_LOCALE);
let t = createStorefrontTranslator(locale);
let mt = createMarketingTranslator(locale);

if (hostKind === "marketing") {
  mode = "marketing";
  try {
    plans = await getMarketingPlans(env);
    pricingState = plans.length > 0 ? "ready" : "unavailable";
  } catch {
    loggerFor(env).warn({ event: "marketing.pricing_unavailable", errorCode: "marketing_plans_unavailable", requestId: Astro.locals.requestId, source: "http", status: 503 });
  }
} else if (hostKind === "tenant-candidate") {
  try {
    shop = await resolveStorefrontShop(Astro.request, env);
    // Middleware leaves locale unset when no supported buyer hint exists; use
    // this tenant's persisted default for all storefront copy in that case.
    if (Astro.locals.locale === undefined) {
      locale = normalizeSupportedLocale(shop.defaultLocale);
      t = createStorefrontTranslator(locale);
      mt = createMarketingTranslator(locale);
    }
    const canonical = canonicalRedirectFor(Astro.request, shop);
    if (canonical !== null) return Astro.redirect(canonical.toString(), 308);
    mode = "storefront";
    if (shop.access === "live") {
      const catalog = await getStorefrontCatalog(env, shop);
      products = catalog.products;
      categories = catalog.categories;
      Astro.response.headers.set("X-Storefront-Cacheable", "1");
    } else {
      Astro.response.headers.set("Cache-Control", "private, no-store, max-age=0");
      Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
    }
  } catch (error) {
    if (!isAppError(error)) throw error;
  }
}

if (mode === "error") {
  Astro.response.status = 404;
  Astro.response.headers.set("Cache-Control", "private, no-store, max-age=0");
}
---

{mode === "marketing" && (
  <PlatformLayout
    title={mt("marketing.home.seo_title")}
    description={mt("marketing.home.seo_description")}
    locale={locale}
  >
    <MarketingHeader dashboardOrigin={env.DASHBOARD_ORIGIN} locale={locale} />
    <main id="main-content">
      <section class="platform-shell marketing-hero">
        <div class="hero-copy">
          <p class="eyebrow">{mt("marketing.home.hero.eyebrow")}</p>
          <h1>{mt("marketing.home.hero.title")}</h1>
          <p class="lead">{mt("marketing.home.hero.lead")}</p>
          <div class="hero-actions">
            <a class="button primary" href={`${env.DASHBOARD_ORIGIN}/login`}>{mt("marketing.home.hero.primary")} <span aria-hidden="true">→</span></a>
            <a class="button secondary" href="#workflow">{mt("marketing.home.hero.secondary")}</a>
          </div>
          <p class="hero-note">{mt("marketing.home.hero.note")}</p>
        </div>
        <aside class="hero-visual" aria-label={mt("marketing.home.flow.aria")}>
          <div class="visual-window-bar"><span></span><span></span><span></span><strong>{mt("marketing.home.flow.title")}</strong></div>
          <div class="visual-flow">
            <article class="visual-node visual-node-channel">
              <span class="visual-icon" aria-hidden="true">◌</span>
              <strong>{mt("marketing.home.flow.channel")}</strong>
              <p>{mt("marketing.home.flow.channel_detail")}</p>
            </article>
            <span class="visual-connector" aria-hidden="true">→</span>
            <article class="visual-node visual-node-order">
              <span class="visual-icon" aria-hidden="true">◎</span>
              <strong>{mt("marketing.home.flow.order")}</strong>
              <p>{mt("marketing.home.flow.order_detail")}</p>
            </article>
            <span class="visual-connector" aria-hidden="true">→</span>
            <article class="visual-node visual-node-payment">
              <span class="visual-icon" aria-hidden="true">✓</span>
              <strong>{mt("marketing.home.flow.payment")}</strong>
              <p>{mt("marketing.home.flow.payment_detail")}</p>
            </article>
            <span class="visual-connector" aria-hidden="true">→</span>
            <article class="visual-node visual-node-delivery">
              <span class="visual-icon" aria-hidden="true">↗</span>
              <strong>{mt("marketing.home.flow.delivery")}</strong>
              <p>{mt("marketing.home.flow.delivery_detail")}</p>
            </article>
          </div>
          <div class="visual-rail" aria-hidden="true"><span>Website</span><i></i><span>Telegram</span><i></i><span>PayOS</span><i></i><span>{mt("marketing.home.flow.inventory")}</span></div>
        </aside>
      </section>

      <section class="proof-strip" aria-label={mt("marketing.home.proof.aria")}>
        <div class="platform-shell">
          <p>{mt("marketing.home.proof.label")}</p>
          <ul><li>{mt("marketing.home.proof.digital_products")}</li><li>{mt("marketing.home.proof.communities")}</li><li>{mt("marketing.home.proof.creators")}</li><li>{mt("marketing.home.proof.telegram_teams")}</li></ul>
        </div>
      </section>

      <section class="marketing-band" id="workflow">
        <div class="platform-shell">
          <div class="band-intro">
            <p class="section-kicker">{mt("marketing.home.workflow.kicker")}</p>
            <h2>{mt("marketing.home.workflow.title")}</h2>
            <p>{mt("marketing.home.workflow.description")}</p>
          </div>
          <ol>
            <li><span>01</span><div><strong>{mt("marketing.home.workflow.step1.title")}</strong><p>{mt("marketing.home.workflow.step1.description")}</p></div></li>
            <li><span>02</span><div><strong>{mt("marketing.home.workflow.step2.title")}</strong><p>{mt("marketing.home.workflow.step2.description")}</p></div></li>
            <li><span>03</span><div><strong>{mt("marketing.home.workflow.step3.title")}</strong><p>{mt("marketing.home.workflow.step3.description")}</p></div></li>
            <li><span>04</span><div><strong>{mt("marketing.home.workflow.step4.title")}</strong><p>{mt("marketing.home.workflow.step4.description")}</p></div></li>
          </ol>
        </div>
      </section>

      <section class="platform-shell feature-section" id="features">
        <div class="section-heading">
          <div><p class="section-kicker">{mt("marketing.home.features.kicker")}</p><h2>{mt("marketing.home.features.title")}</h2></div>
          <p>{mt("marketing.home.features.description")}</p>
        </div>
        <div class="feature-grid feature-grid-three">
          <article class="feature-card"><span>{mt("marketing.home.features.sales.label")}</span><h3>{mt("marketing.home.features.sales.title")}</h3><p>{mt("marketing.home.features.sales.description")}</p><a href="#product-stage">{mt("marketing.home.features.sales.link")} <span aria-hidden="true">→</span></a></article>
          <article class="feature-card"><span>{mt("marketing.home.features.operations.label")}</span><h3>{mt("marketing.home.features.operations.title")}</h3><p>{mt("marketing.home.features.operations.description")}</p><a href="#product-stage">{mt("marketing.home.features.operations.link")} <span aria-hidden="true">→</span></a></article>
          <article class="feature-card"><span>{mt("marketing.home.features.automation.label")}</span><h3>{mt("marketing.home.features.automation.title")}</h3><p>{mt("marketing.home.features.automation.description")}</p><a href="#workflow">{mt("marketing.home.features.automation.link")} <span aria-hidden="true">→</span></a></article>
        </div>
      </section>

      <section class="platform-shell product-stage" id="product-stage">
        <div class="product-stage-copy">
          <p class="section-kicker">{mt("marketing.home.workspace.kicker")}</p>
          <h2>{mt("marketing.home.workspace.title")}</h2>
          <p>{mt("marketing.home.workspace.description")}</p>
          <ul class="check-list">
            <li>{mt("marketing.home.workspace.check.catalog")}</li>
            <li>{mt("marketing.home.workspace.check.states")}</li>
            <li>{mt("marketing.home.workspace.check.readiness")}</li>
            <li>{mt("marketing.home.workspace.check.audit")}</li>
          </ul>
          <a class="button secondary" href={`${env.DASHBOARD_ORIGIN}/login`}>{mt("marketing.home.workspace.cta")} <span aria-hidden="true">→</span></a>
        </div>
        <div class="product-stage-mock" aria-label={mt("marketing.home.workspace.mock_aria")}>
          <div class="mock-sidebar"><strong>Selinow</strong><span class="mock-active">{mt("marketing.home.workspace.overview")}</span><span>{mt("marketing.home.workspace.products")}</span><span>{mt("marketing.home.workspace.inventory")}</span><span>{mt("marketing.home.workspace.orders")}</span><span>{mt("marketing.home.workspace.channels")}</span><span>{mt("marketing.home.workspace.integrations")}</span></div>
          <div class="mock-main">
            <div class="mock-heading"><div><span class="mock-caption">{mt("marketing.home.workspace.your_store")}</span><strong>Workspace</strong></div><span class="mock-user">⋯</span></div>
            <div class="mock-status-grid"><div><span>{mt("marketing.home.workspace.channels")}</span><strong>Website + Telegram</strong><em>{mt("marketing.home.workspace.channel_status")}</em></div><div><span>{mt("marketing.home.workspace.payment")}</span><strong>PayOS</strong><em>{mt("marketing.home.workspace.readiness")}</em></div><div><span>{mt("marketing.home.workspace.fulfillment")}</span><strong>{mt("marketing.home.workspace.inventory")}</strong><em>{mt("marketing.home.workspace.server_confirmed")}</em></div></div>
            <div class="mock-ledger"><div class="mock-ledger-head"><span>{mt("marketing.home.workspace.ledger")}</span><span>{mt("marketing.home.workspace.status")}</span></div><div><span>{mt("marketing.home.workspace.discover_checkout")}</span><b>{mt("marketing.home.workspace.active")}</b></div><div><span>{mt("marketing.home.workspace.payment_verification")}</span><b>{mt("marketing.home.workspace.waiting_provider")}</b></div><div><span>{mt("marketing.home.workspace.fulfillment")}</span><b>{mt("marketing.home.workspace.retry_safe")}</b></div></div>
          </div>
          <p class="mock-disclaimer">{mt("marketing.home.workspace.disclaimer")}</p>
        </div>
      </section>

      <section class="use-cases" id="use-cases">
        <div class="platform-shell">
          <div><p class="section-kicker">{mt("marketing.home.use_cases.kicker")}</p><h2>{mt("marketing.home.use_cases.title")}</h2></div>
          <div class="case-grid">
            <article><span>{mt("marketing.home.use_cases.creator.label")}</span><h3>{mt("marketing.home.use_cases.creator.title")}</h3></article>
            <article><span>{mt("marketing.home.use_cases.community.label")}</span><h3>{mt("marketing.home.use_cases.community.title")}</h3></article>
            <article><span>{mt("marketing.home.use_cases.team.label")}</span><h3>{mt("marketing.home.use_cases.team.title")}</h3></article>
          </div>
        </div>
      </section>

      <section class="platform-shell trust-panel" id="trust">
        <div><p class="section-kicker">{mt("marketing.home.trust.kicker")}</p><h2>{mt("marketing.home.trust.title")}</h2></div>
        <p>{mt("marketing.home.trust.description")}</p>
      </section>

      <section class="platform-shell pricing-preview" data-pricing-state={pricingState}>
        <div class="section-heading">
          <div><p class="section-kicker">{mt("marketing.home.pricing.kicker")}</p><h2>{mt("marketing.home.pricing.title")}</h2></div>
          <p>{mt("marketing.home.pricing.description")}</p>
        </div>
        {pricingState === "ready" ? <>
          <div class="plan-grid">
            {plans.map((plan) => <article class="plan">
              <h3>{plan.name}</h3>
              <ul>{planFeatureList(plan, locale).map((feature) => <li>{feature}</li>)}</ul>
              <a class="button secondary" href={`${env.DASHBOARD_ORIGIN}/login`}>{mt("marketing.home.pricing.create")}</a>
            </article>)}
          </div>
          <a class="text-link" href="/pricing">{mt("marketing.home.pricing.compare")} <span aria-hidden="true">→</span></a>
        </> : <section class="pricing-unavailable" aria-labelledby="pricing-unavailable-title">
          <p class="section-kicker">{mt("marketing.home.pricing.data_kicker")}</p>
          <h3 id="pricing-unavailable-title">{mt("marketing.pricing.unavailable.title")}</h3>
          <p>{mt("marketing.pricing.unavailable.description")}</p>
        </section>}
      </section>

      <section class="platform-shell faq-section" id="faq">
        <div><p class="section-kicker">{mt("marketing.home.faq.kicker")}</p><h2>{mt("marketing.home.faq.title")}</h2></div>
        <div class="faq-list">
          <details><summary>{mt("marketing.home.faq.telegram.question")}</summary><p>{mt("marketing.home.faq.telegram.answer")}</p></details>
          <details><summary>{mt("marketing.home.faq.money.question")}</summary><p>{mt("marketing.home.faq.money.answer")}</p></details>
          <details><summary>{mt("marketing.home.faq.test.question")}</summary><p>{mt("marketing.home.faq.test.answer")}</p></details>
        </div>
      </section>

      <section class="final-cta">
        <div class="platform-shell"><img src="/brand/logo/selinow-mark-white.svg" alt="" width="64" height="64" /><div><p class="section-kicker">{mt("marketing.home.final.kicker")}</p><h2>{mt("marketing.home.final.title")}</h2></div><a class="button light" href={`${env.DASHBOARD_ORIGIN}/login`}>{mt("marketing.home.final.cta")} <span aria-hidden="true">→</span></a></div>
      </section>
    </main>
    <footer class="platform-shell platform-footer"><img src="/brand/logo/selinow-logo-black.svg" alt="Selinow" width="128" height="34" /><p>{mt("marketing.footer.tagline")}</p><p>© {new Date().getFullYear()} Selinow.</p></footer>
  </PlatformLayout>
)}

{mode === "storefront" && shop && (
  <StorefrontLayout shop={shop} title={shop.content.seoTitle} description={shop.content.seoDescription} noindex={shop.access !== "live"}>
    {shop.access === "live" ? (
      <>
        <section class="store-hero" data-mark={shop.name.slice(0, 1).toUpperCase()}>
          <div class="store-hero-heading">
            <p class="store-kicker">{shop.name}</p>
            <h1>{shop.content.headline}</h1>
          </div>
          <div class="store-hero-copy">
            <p>{shop.content.description}</p>
            <form class="store-search" role="search" data-store-search-form>
              <label for="store-search">{t("storefront.search.label")}</label>
              <div><input id="store-search" type="search" name="q" placeholder={t("storefront.search.placeholder")} autocomplete="off" data-store-search-input /><button type="submit" aria-label={t("storefront.search.aria")}>⌕</button></div>
            </form>
            <a class="store-hero-cta" href="#products">{t("storefront.search.cta")} <span aria-hidden="true">↓</span></a>
          </div>
        </section>
        <section class="catalog-section" id="products">
          <div class="catalog-heading">
            <div><h2>{t("storefront.catalog.heading")}</h2><p>{t("storefront.catalog.count", { count: products.length, shop: shop.name })}</p></div>
            {categories.length > 0 && <label class="store-filter-control" for="store-category-filter">
              <span>{t("storefront.catalog.category")}</span>
              <select id="store-category-filter" data-store-category-filter>
                <option value="">{t("storefront.catalog.all_categories")}</option>
                {categories.map((category) => <option value={category.id}>{category.name}</option>)}
              </select>
            </label>}
          </div>
          <div class="product-list">
            {products.map((product, index) => <ProductCard locale={locale} product={product} index={index} />)}
            {products.length === 0 && <p class="empty-cart">{t("storefront.catalog.empty")}</p>}
          </div>
          {products.length > 0 && <p class="empty-cart catalog-no-results" data-store-search-empty hidden>{t("storefront.catalog.no_results")} <a href="#products" data-store-search-reset>{t("storefront.catalog.show_all")}</a>.</p>}
        </section>
        <script src="../scripts/storefront/store-search.ts"></script>
      </>
    ) : (
      <section class="safe-state">
        <div class="state-number">{shop.access === "coming_soon" ? "01" : "—"}</div>
        <div>
          <h1>{shop.access === "coming_soon" ? t("storefront.state.coming_soon.title") : t("storefront.state.suspended.title")}</h1>
          <p>{shop.access === "coming_soon" ? t("storefront.state.coming_soon.detail") : t("storefront.state.suspended.detail")}</p>
        </div>
      </section>
    )}
  </StorefrontLayout>
)}

{mode === "error" && (
  <PlatformLayout title={t("storefront.error.not_found.title")} noindex>
    <main class="platform-shell error-page"><div><h1>404</h1><p>{t("storefront.error.not_found.detail")}</p></div></main>
  </PlatformLayout>
)}

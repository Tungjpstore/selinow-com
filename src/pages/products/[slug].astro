---
import PlatformLayout from "../../layouts/PlatformLayout.astro";
import StorefrontLayout from "../../layouts/StorefrontLayout.astro";
import Detail from "../../components/storefront/templates/Detail.astro";
import { isAppError } from "../../lib/core/errors";
import { getBindings } from "../../lib/platform/bindings";
import { canonicalRedirectFor, getStorefrontProduct, resolveStorefrontShop, type StorefrontProduct, type StorefrontShop } from "../../lib/storefront/store";
import { createStorefrontTranslator } from "../../lib/i18n/catalogs/storefront";
import { normalizeSupportedLocale } from "../../lib/i18n/locale";
import { schemaPrice } from "../../lib/seo";

const env = getBindings();
let shop: StorefrontShop | null = null;
let product: StorefrontProduct | null = null;
let related: StorefrontProduct[] = [];
let promotions: Awaited<ReturnType<typeof getStorefrontProduct>>["promotions"] = [];
try {
  shop = await resolveStorefrontShop(Astro.request, env);
  const canonical = canonicalRedirectFor(Astro.request, shop);
  if (canonical !== null) return Astro.redirect(canonical.toString(), 308);
  if (shop.access === "live" && Astro.params.slug) {
    const detail = await getStorefrontProduct(env, shop, Astro.params.slug);
    product = detail.product;
    related = detail.related;
    promotions = detail.promotions;
  }
} catch (error) { if (!isAppError(error)) throw error; }
if (shop === null || (shop.access === "live" && product === null)) Astro.response.status = 404;
if (shop?.access === "live" && product) Astro.response.headers.set("X-Storefront-Cacheable", "1");
else Astro.response.headers.set("Cache-Control", "private, no-store, max-age=0");
const locale = Astro.locals.locale ?? normalizeSupportedLocale(shop?.defaultLocale ?? env.DEFAULT_LOCALE);
const t = createStorefrontTranslator(locale);
const productUnavailable = shop?.access === "live" && product === null;
const pageTitle = product
  ? `${product.title} — ${shop?.name ?? "Selinow"}`
  : productUnavailable
    ? t("storefront.product.unavailable_title", { shop: shop?.name ?? t("storefront.product.contact") })
    : t("storefront.product.store_paused_title", { shop: shop?.name ?? t("storefront.product.contact") });
const productStructuredData = product && shop
  ? {
    "@context": "https://schema.org",
    "@type": "Product",
    name: product.title,
    description: product.description || t("storefront.product.description_fallback"),
    sku: product.variants.length === 1 ? product.variants[0]?.sku : undefined,
    brand: { "@type": "Brand", name: shop.name },
    url: `https://${shop.currentHostname}/products/${product.slug}`,
    offers: product.variants.map((variant) => ({
      "@type": "Offer",
      url: `https://${shop.currentHostname}/products/${product.slug}`,
      price: schemaPrice(variant.priceMinor, variant.currency),
      priceCurrency: variant.currency,
      availability: variant.stockState === "out_of_stock" ? "https://schema.org/OutOfStock" : "https://schema.org/InStock",
      itemCondition: "https://schema.org/NewCondition",
      sku: variant.sku,
    })),
  }
  : undefined;
const isBookingProduct = product?.variants.some((variant) => variant.durationMinutes !== undefined) ?? false;
const hasPromoClock = promotions.some((promotion) => promotion.endsAt !== null);
const wantsVoucherChips = shop?.template.id === "bustle" && promotions.length > 0;
---

{shop && <StorefrontLayout shop={shop} title={pageTitle} noindex={!product} abuseReportProductSlug={product?.slug} structuredData={productStructuredData}>
  {product ? <div data-detail-track={product.slug} data-detail-title={product.title}><Detail locale={locale} product={product} promotions={promotions} related={related} shop={shop} /></div> : productUnavailable ? <section class="safe-state"><div class="state-number">404</div><div><h1>{t("storefront.product.missing_title")}</h1><p>{t("storefront.product.missing_detail", { shop: shop.name })}</p><a class="store-button safe-state-action" href="/">{t("storefront.product.missing_action")}</a></div></section> : <section class="safe-state"><div class="state-number">—</div><div><h1>{shop.access === "coming_soon" ? t("storefront.state.coming_soon.title") : t("storefront.state.suspended.title")}</h1><p>{shop.access === "coming_soon" ? t("storefront.state.coming_soon.detail") : t("storefront.product.paused_detail")}</p></div></section>}
  {product && <script src="../../scripts/storefront/product-detail.ts"></script>}
  {product && product.images.length > 1 && <script src="../../scripts/storefront/gallery.ts"></script>}
  {product && hasPromoClock && <script src="../../scripts/storefront/promo-countdown.ts"></script>}
  {product && wantsVoucherChips && <script src="../../scripts/storefront/voucher-copy.ts"></script>}
  {product && isBookingProduct && <script src="../../scripts/storefront/slot-picker-inline.ts"></script>}
</StorefrontLayout>}

{shop === null && <PlatformLayout title={t("storefront.product.not_found_title")} noindex><main class="platform-shell error-page"><div><h1>404</h1><p>{t("storefront.product.not_found_detail")}</p></div></main></PlatformLayout>}
<script src="../../scripts/storefront/tm4-merchandising.ts"></script>

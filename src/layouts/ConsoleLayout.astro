---
/**
 * ConsoleLayout — the "Selinow Console" app shell (design v2).
 * docs/DASHBOARD_REDESIGN_V2_PROPOSAL_2026-08-16.md §6.1
 *
 * Task-first navigation, 236px sidebar (≥1024px), 48px topbar, bottom tab
 * bar + sheet on mobile. One hairline, no static shadows, no emoji — icons
 * come from components/console/Icon.astro. The storefront template context
 * is mirrored onto the shell (data-dashboard-template / -scheme) so the
 * console can inherit the shop's template accent later without touching
 * page code.
 */
import "../styles/selinow-tokens.css";
import "../styles/selinow-a11y.css";
import "../styles/console.css";
import Icon from "../components/console/Icon.astro";
import { authenticateRequest } from "../lib/auth/session";
import { getBindings } from "../lib/platform/bindings";
import { withSelectedShop } from "../lib/dashboard/shop-navigation";
import { createDashboardTranslator } from "../lib/i18n";

type ShopOption = { name: string; publicId: string };
type Props = {
  activePath: string;
  displayName: string;
  email: string;
  selectedShopName?: string | undefined;
  selectedShopPublicId?: string | undefined;
  shops?: readonly ShopOption[] | undefined;
  title: string;
  storefrontTemplate?: string | undefined;
  storefrontScheme?: string | undefined;
};

const {
  activePath,
  displayName,
  email,
  selectedShopName,
  selectedShopPublicId,
  shops = [],
  title,
  storefrontTemplate,
  storefrontScheme,
} = Astro.props;

const env = getBindings();
const auth = await authenticateRequest(Astro.request, env).catch(() => null);
if (auth === null) return Astro.redirect("/login");
const locale = Astro.locals.locale;
const t = createDashboardTranslator(locale);
const href = (path: string): string => withSelectedShop(path, selectedShopPublicId, Astro.url.origin);

type IconName = "bot" | "box" | "card" | "code" | "gauge" | "globe" | "home" | "key" | "orders" | "receipt" | "shield" | "users";
type NavItem = { href: string; icon: IconName; label: string; match: string };
type NavGroup = { label: string; items: readonly NavItem[] };
const nav: readonly NavGroup[] = [
  {
    label: t("dashboard.console.nav.sell"),
    items: [
      { href: href("/app"), icon: "home", label: t("dashboard.console.nav.overview"), match: "/app" },
      { href: href("/app/orders"), icon: "orders", label: t("dashboard.console.nav.orders"), match: "/app/orders" },
      { href: href("/app/customers"), icon: "users", label: t("dashboard.console.nav.customers"), match: "/app/customers" },
    ],
  },
  {
    label: t("dashboard.console.nav.catalog"),
    items: [
      { href: href("/app/products"), icon: "box", label: t("dashboard.console.nav.products"), match: "/app/products" },
      { href: href("/app/inventory"), icon: "key", label: t("dashboard.console.nav.inventory"), match: "/app/inventory" },
    ],
  },
  {
    label: t("dashboard.console.nav.automation"),
    items: [
      { href: href("/app/automation"), icon: "gauge", label: t("dashboard.console.nav.rules"), match: "/app/automation" },
    ],
  },
  {
    label: t("dashboard.console.nav.channels"),
    items: [
      { href: href("/app/store"), icon: "globe", label: t("dashboard.console.nav.website"), match: "/app/store" },
      { href: href("/app/integrations"), icon: "bot", label: t("dashboard.console.nav.telegram"), match: "/app/integrations" },
      { href: href("/app/payments"), icon: "card", label: t("dashboard.console.nav.payments"), match: "/app/payments" },
      { href: href("/app/domains"), icon: "globe", label: t("dashboard.console.nav.domains"), match: "/app/domains" },
    ],
  },
  {
    label: t("dashboard.console.nav.settings"),
    items: [
      { href: href("/app/members"), icon: "users", label: t("dashboard.console.nav.members"), match: "/app/members" },
      { href: href("/app/security"), icon: "shield", label: t("dashboard.console.nav.security"), match: "/app/security" },
      { href: href("/app/billing"), icon: "receipt", label: t("dashboard.console.nav.billing"), match: "/app/billing" },
      { href: href("/app/developer"), icon: "code", label: t("dashboard.console.nav.developer"), match: "/app/developer" },
    ],
  },
];
const isActive = (item: NavItem): boolean =>
  item.match === "/app" ? activePath === "/app" : activePath.startsWith(item.match);

// Mobile bottom tab: the five highest-frequency destinations.
const flatItems = nav.flatMap((group) => group.items);
const overviewItem: NavItem = { href: href("/app"), icon: "home", label: t("dashboard.console.nav.overview"), match: "/app" };
const pick = (match: string): NavItem => flatItems.find((item) => item.match === match) ?? overviewItem;
const mobileTabs: readonly NavItem[] = [
  pick("/app"),
  pick("/app/orders"),
  pick("/app/products"),
  pick("/app/automation"),
];
---

<!doctype html>
<html lang={locale ?? "vi"} data-console data-dashboard-template={storefrontTemplate} data-template-scheme={storefrontScheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Selinow</title>
  </head>
  <body data-app-shell data-csrf-cookie-name={`${env.SESSION_COOKIE_NAME}_csrf`} data-selected-shop-public-id={selectedShopPublicId}>
    <a class="console-skip" href="#console-content">{t("dashboard.console.shell.skip")}</a>

    <div class="console-shell">
      <aside class="console-sidebar" aria-label="Workspace">
        <a class="console-brand" href={href("/app")} aria-label="Selinow">
          <img src="/brand/logo/selinow-logo-primary.svg" alt="" width="112" height="28" />
        </a>
        <nav class="console-nav" aria-label={t("dashboard.console.shell.store")}>
          {nav.map((group) => (
            <section class="console-nav__group">
              <p class="console-nav__label">{group.label}</p>
              {group.items.map((item) => (
                <a class:list={["console-nav__item", isActive(item) && "is-active"]} href={item.href} aria-current={isActive(item) ? "page" : undefined}>
                  <Icon name={item.icon} />
                  <span>{item.label}</span>
                </a>
              ))}
            </section>
          ))}
        </nav>
      </aside>

      <div class="console-main">
        <header class="console-topbar">
          <div class="console-topbar__context">
            {selectedShopName
              ? <label class="console-shop">
                  <span class="console-shop__label">{t("dashboard.console.shell.store")}</span>
                  <span class="visually-hidden" id="console-shop-options">{t("dashboard.shell.select_shop")}</span>
                  <select class="console-shop__select" aria-labelledby="console-shop-options" data-console-shop-select>
                    {shops.map((shop) => (
                      <option value={shop.publicId} selected={shop.publicId === selectedShopPublicId}>{shop.name}</option>
                    ))}
                  </select>
                </label>
              : <span class="console-topbar__shopless">{t("dashboard.shell.no_shop")}</span>}
          </div>
          <div class="console-topbar__user">
            <span class="console-user__name">{displayName}</span>
            <span class="console-user__email">{email}</span>
            <button type="button" class="console-user__signout" data-app-logout>{t("dashboard.console.shell.sign_out")}</button>
          </div>
        </header>

        <main id="console-content" class="console-content" tabindex="-1">
          <slot />
        </main>
      </div>
    </div>

    <nav class="console-tabbar" aria-label="Primary">
      {mobileTabs.map((item) => (
        <a class:list={["console-tab", isActive(item) && "is-active"]} href={item.href} aria-current={isActive(item) ? "page" : undefined}>
          <Icon name={item.icon} size={20} />
          <span>{item.label}</span>
        </a>
      ))}
      <details class="console-tab console-tab--more">
        <summary>
          <Icon name="menu" size={20} />
          <span>{t("dashboard.console.nav.more")}</span>
        </summary>
        <div class="console-sheet" role="menu">
          {nav.slice(1).flatMap((group) => group.items.map((item) => (
            <a role="menuitem" href={item.href}><Icon name={item.icon} />{item.label}</a>
          )))}
        </div>
      </details>
    </nav>

    <script>
      import { withSelectedShop } from "../lib/dashboard/shop-navigation";

      const shell = document.querySelector<HTMLElement>("[data-app-shell]");
      const selectedShopPublicId = shell?.dataset.selectedShopPublicId;

      const shopSelect = document.querySelector("[data-console-shop-select]") as HTMLSelectElement | null;
      shopSelect?.addEventListener("change", () => {
        const next = shopSelect.value;
        const url = new URL(window.location.href);
        url.searchParams.set("shop", next);
        window.location.assign(url.toString());
      });

      const csrfCookieName = shell?.dataset.csrfCookieName;
      const readCookie = (name: string): string | null => document.cookie
        .split(";")
        .map((part) => part.trim())
        .find((part) => part.startsWith(`${name}=`))
        ?.slice(name.length + 1) ?? null;
      for (const logoutButton of document.querySelectorAll<HTMLButtonElement>("[data-app-logout]")) {
        logoutButton.addEventListener("click", async () => {
          if (csrfCookieName === undefined) return;
          const csrf = readCookie(csrfCookieName);
          if (csrf === null) return;
          const originalLabel = logoutButton.textContent ?? "";
          logoutButton.disabled = true;
          logoutButton.textContent = shell?.dataset.logoutPending ?? originalLabel;
          try {
            const response = await fetch("/api/auth/logout", {
              method: "POST",
              headers: { "X-CSRF-Token": csrf },
            });
            if (!response.ok) throw new Error("logout_failed");
            window.location.assign("/login");
          } catch {
            logoutButton.disabled = false;
            logoutButton.textContent = shell?.dataset.logoutFailed ?? originalLabel;
          }
        });
      }

      // Shop context follows every internal link rendered into the shell.
      if (shell !== null && selectedShopPublicId !== undefined) {
        const enhance = (anchor: HTMLAnchorElement): void => {
          const raw = anchor.getAttribute("href");
          if (raw === null) return;
          const enhanced = withSelectedShop(raw, selectedShopPublicId, window.location.origin);
          if (enhanced !== raw) anchor.setAttribute("href", enhanced);
        };
        const enhanceAll = (node: Element): void => {
          if (node instanceof HTMLAnchorElement) enhance(node);
          for (const anchor of node.querySelectorAll<HTMLAnchorElement>("a[href]")) enhance(anchor);
        };
        enhanceAll(shell);
        new MutationObserver((records) => {
          for (const record of records) {
            for (const node of record.addedNodes) {
              if (node instanceof Element) enhanceAll(node);
            }
          }
        }).observe(shell, { childList: true, subtree: true });
      }
    </script>
  </body>
</html>

<style is:global>
  [data-console] body {
    margin: 0;
    background: var(--sln-console-bg);
    color: var(--sln-console-ink);
    font: var(--sln-console-text);
    -webkit-font-smoothing: antialiased;
  }
  [data-console] .console-shell, [data-console] .console-shell * { box-sizing: border-box; }
  [data-console] .console-tabbar, [data-console] .console-tabbar * { box-sizing: border-box; }
  [data-console] .console-skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 8px 14px;
    background: var(--sln-console-ink);
    color: var(--sln-console-bg);
  }
  [data-console] .console-skip:focus { left: 8px; top: 8px; }

  [data-console] .console-shell { display: flex; min-height: 100vh; }

  [data-console] .console-sidebar {
    position: sticky;
    top: 0;
    align-self: flex-start;
    display: none;
    flex-direction: column;
    width: var(--sln-console-sidebar-w);
    height: 100vh;
    border-right: 1px solid var(--sln-console-line);
    background: var(--sln-console-surface);
  }
  [data-console] .console-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    height: var(--sln-console-topbar-h);
    padding: 0 16px;
    border-bottom: 1px solid var(--sln-console-line);
    color: var(--sln-console-ink);
    text-decoration: none;
    font: var(--sln-console-text-lg);
    font-weight: 600;
  }
  [data-console] .console-brand__mark {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: var(--sln-console-radius);
    background: var(--sln-console-ink);
    color: var(--sln-console-bg);
    font: 600 12px/1 var(--sln-font-sans);
  }
  [data-console] .console-nav { flex: 1; overflow-y: auto; padding: 10px 8px 24px; }
  [data-console] .console-nav__group + .console-nav__group { margin-top: 14px; }
  [data-console] .console-nav__label {
    margin: 0 0 4px;
    padding: 0 8px;
    color: var(--sln-console-ink-3);
    font: var(--sln-console-label);
    font-weight: 500;
  }
  [data-console] .console-nav__item {
    display: flex;
    align-items: center;
    gap: 9px;
    min-height: 32px;
    padding: 0 8px;
    border-radius: var(--sln-console-radius);
    color: var(--sln-console-ink-2);
    text-decoration: none;
    font: var(--sln-console-text-sm);
  }
  [data-console] .console-nav__item:hover { background: var(--sln-console-raised); color: var(--sln-console-ink); }
  [data-console] .console-nav__item.is-active { background: var(--sln-console-accent-subtle); color: var(--sln-console-accent); font-weight: 600; }
  [data-console] .console-nav__item.is-active svg { color: var(--sln-console-accent); }
  [data-console] .console-nav__item:focus-visible { outline: none; box-shadow: var(--sln-console-focus); }

  [data-console] .console-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  [data-console] .console-topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: var(--sln-console-topbar-h);
    padding: 0 20px;
    border-bottom: 1px solid var(--sln-console-line);
    background: color-mix(in srgb, var(--sln-console-bg) 92%, transparent);
    backdrop-filter: blur(6px);
  }
  [data-console] .console-shop { display: flex; align-items: center; gap: 8px; }
  [data-console] .console-shop__label { color: var(--sln-console-ink-3); font: var(--sln-console-label); }
  [data-console] .console-shop__select {
    height: 28px;
    padding: 0 8px;
    border: 1px solid var(--sln-console-line);
    border-radius: var(--sln-console-radius);
    background: var(--sln-console-surface);
    color: var(--sln-console-ink);
    font: var(--sln-console-text-sm);
  }
  [data-console] .console-topbar__shopless { color: var(--sln-console-ink-3); font: var(--sln-console-text-sm); }
  [data-console] .console-topbar__user { display: flex; align-items: center; gap: 10px; min-width: 0; }
  [data-console] .console-user__name {
    color: var(--sln-console-ink);
    font: var(--sln-console-text-sm);
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  [data-console] .console-user__email { color: var(--sln-console-ink-3); font: var(--sln-console-label); }
  @media (max-width: 767px) {
    [data-console] .console-user__email { display: none; }
    [data-console] .console-user__name { max-width: 120px; }
  }
  [data-console] .console-user__signout {
    height: 28px;
    padding: 0 10px;
    border: 1px solid var(--sln-console-line);
    border-radius: var(--sln-console-radius);
    background: var(--sln-console-surface);
    color: var(--sln-console-ink-2);
    font: var(--sln-console-label);
  }
  [data-console] .console-user__signout:hover { background: var(--sln-console-raised); color: var(--sln-console-ink); }

  [data-console] .console-content {
    flex: 1;
    width: 100%;
    max-width: var(--sln-console-content-max);
    margin: 0 auto;
    padding: 20px 20px 96px;
  }
  [data-console] .console-content:focus { outline: none; }

  [data-console] .console-tabbar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 30;
    display: flex;
    border-top: 1px solid var(--sln-console-line);
    background: color-mix(in srgb, var(--sln-console-surface) 96%, transparent);
    backdrop-filter: blur(8px);
    padding-bottom: env(safe-area-inset-bottom);
  }
  [data-console] .console-tab {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 8px 4px 10px;
    color: var(--sln-console-ink-3);
    text-decoration: none;
    font: var(--sln-console-label);
  }
  [data-console] .console-tab.is-active { color: var(--sln-console-ink); }
  [data-console] .console-tab--more summary { list-style: none; }
  [data-console] .console-tab--more summary::-webkit-details-marker { display: none; }
  [data-console] .console-sheet {
    position: fixed;
    inset-inline: 8px;
    bottom: calc(64px + env(safe-area-inset-bottom));
    z-index: 31;
    display: grid;
    border: 1px solid var(--sln-console-line);
    border-radius: var(--sln-console-radius-container);
    background: var(--sln-console-surface);
    box-shadow: var(--sln-console-shadow-overlay);
    overflow: hidden;
  }
  [data-console] .console-sheet a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--sln-console-line);
    color: var(--sln-console-ink);
    text-decoration: none;
    font: var(--sln-console-text-sm);
  }
  [data-console] .console-sheet a:last-child { border-bottom: 0; }

  @media (min-width: 1024px) {
    [data-console] .console-sidebar { display: flex; }
    [data-console] .console-tabbar { display: none; }
    [data-console] .console-content { padding-bottom: 40px; }
  }
</style>

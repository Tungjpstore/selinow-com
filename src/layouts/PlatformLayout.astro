---
import "../styles/selinow-tokens.css";
import "../styles/base.css";
import "../styles/primitives.css";
import "../styles/selinow-a11y.css";
import "../styles/platform.css";
import { createMarketingTranslator } from "../lib/i18n/catalogs/marketing";
import { directionForLocale, normalizeSupportedLocale } from "../lib/i18n/locale";

interface Props {
  canonical?: string;
  description?: string;
  locale?: unknown;
  noindex?: boolean;
  title: string;
}

const {
  canonical = `https://selinow.com${Astro.url.pathname}`,
  description,
  locale: requestedLocale = Astro.locals.locale,
  noindex = false,
  title,
} = Astro.props;
const locale = normalizeSupportedLocale(requestedLocale);
const t = createMarketingTranslator(locale);
const resolvedDescription = description === undefined ? t("marketing.layout.default_description") : description;
const socialImage = "https://selinow.com/brand/selinow-og-cover.png";
---

<!doctype html>
<html lang={locale} dir={directionForLocale(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={resolvedDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#F8FAFC" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Selinow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={t("marketing.layout.social_image_alt")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/selinow-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/selinow-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/selinow-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t("marketing.layout.skip_link")}</a>
    <slot />
  </body>
</html>

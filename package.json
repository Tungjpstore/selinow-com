{
  "name": "selinow-com",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=22.12.0 <26",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:smoke": "vitest run tests/smoke",
    "test:browser:auth:local": "node scripts/local-auth-browser-gate.mjs",
    "test:browser:public:local": "node scripts/local-public-browser-gate.mjs",
    "test:visual:staging": "playwright test --config playwright.config.ts",
    "test:visual:staging:update": "playwright test --config playwright.config.ts --update-snapshots",
    "build": "astro build",
    "build:staging": "node scripts/deploy.mjs --env staging --build-only",
    "platform:doctor": "node scripts/platform-doctor.mjs",
    "trigger:inventory": "node scripts/trigger-inventory.mjs",
    "platform:route-preflight": "node scripts/staging-route-preflight.mjs --env staging",
    "staging:phase-a:smoke": "node scripts/staging-phase-a-smoke.mjs --env staging",
    "dodo:uat:validate": "node scripts/dodo-uat-validate.mjs",
    "dodo:webhook:register": "node scripts/dodo-webhook-register.mjs",
    "payos:staging:attest": "node scripts/payos-staging-attest.mjs",
    "payos:uat:validate": "node scripts/payos-uat-validate.mjs",
    "platform:provision": "node scripts/platform-provision.mjs",
    "platform:admin-bootstrap": "node scripts/platform-admin-bootstrap.mjs",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:complete-release": "node scripts/db.mjs complete-release",
    "release:rollback:rehearsal": "node scripts/release-rollback-rehearsal.mjs",
    "release:worker:upload": "node scripts/release-worker-upload.mjs",
    "db:preflight": "node scripts/db.mjs preflight",
    "db:migrate:status": "node scripts/db.mjs status",
    "db:seed": "node scripts/db.mjs seed",
    "backup:create": "node scripts/backup.mjs",
    "restore:drill": "node scripts/restore-drill.mjs",
    "release:doctor": "node scripts/release-doctor.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:staging:manifest": "node scripts/staging-release-manifest.mjs",
    "release:production:bootstrap": "node scripts/production-bootstrap.mjs",
    "release:production:bootstrap:migrate": "node scripts/production-bootstrap-execute.mjs",
    "release:production:bootstrap:empty-baseline": "node scripts/production-bootstrap-empty-baseline.mjs",
    "release:production:canary": "node scripts/production-bootstrap-canary.mjs",
    "release:production:promote": "node scripts/production-bootstrap-promote.mjs",
    "release:production:plan": "node scripts/release-dry-run.mjs",
    "release:production:dry-run": "node scripts/release-dry-run.mjs --execute",
    "production:triggers": "node scripts/production-trigger.mjs --plan",
    "production:triggers:apply": "node scripts/production-trigger.mjs --apply --confirm-production",
    "production:triggers:rollback": "node scripts/production-trigger.mjs --rollback --confirm-production",
    "production:routes": "node scripts/production-continuation-route.mjs --plan",
    "production:routes:apply": "node scripts/production-continuation-route.mjs --apply --confirm-production",
    "production:routes:rollback": "node scripts/production-continuation-route.mjs --rollback --confirm-production",
    "release:pilot:smoke": "node scripts/release-pilot-smoke.mjs",
    "deploy:dry-run": "node scripts/deploy.mjs --env local --dry-run",
    "deploy:staging:dry-run": "node scripts/deploy.mjs --env staging --dry-run",
    "deploy:staging": "node scripts/deploy.mjs --env staging",
    "deploy": "node scripts/deploy.mjs",
    "cf-typegen": "node scripts/worker-typegen.mjs",
    "cf-typegen:staging": "node scripts/worker-typegen.mjs --env staging"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.4",
    "astro": "7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "26.1.1",
    "eslint": "10.8.0",
    "eslint-plugin-astro": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "undici": "7.29.0"
  }
}
